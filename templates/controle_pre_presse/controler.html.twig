{% extends 'base.html.twig' %}

{% block title %}Contrôle prépresse
{% endblock %}

{% block body %}
	<div
		class="side-app">

		{# ============================================================
																																																						       EN-TÊTE
																																																						       ============================================================ #}
		<div class="page-header">
			<div>
				<h1 class="page-title">Contrôle prépresse</h1>

				<p class="text-muted mb-0">
					Vérification des fichiers avant production
				</p>
			</div>

			<div>
				<a href="{{ path('app_controle_pre_presse_index') }}" class="btn btn-light">
					<i class="fe fe-arrow-left mr-1"></i>
					Retour
				</a>
			</div>
		</div>

		{# ============================================================
																																																						       MESSAGES FLASH
																																																						       ============================================================ #}
		{% for type, messages in app.flashes %}
			{% for message in messages %}
				<div class="alert alert-{{ type == 'error' ? 'danger' : type }}
																																																																																																																																																																		                        alert-dismissible fade show">
					{{ message }}

					<button type="button" class="close" data-dismiss="alert">
						&times;
					</button>
				</div>
			{% endfor %}
		{% endfor %}

		{# ============================================================
																																																						       INFORMATIONS DE LA COMMANDE
																																																						       ============================================================ #}
		<div class="row">

			<div class="col-xl-4 col-lg-4">
				<div class="card">
					<div class="card-header">
						<h3 class="card-title">
							<i class="fe fe-file-text mr-2"></i>
							Commande
						</h3>
					</div>

					<div class="card-body">
						<div class="mb-3">
							<small class="text-muted">
								Numéro de commande
							</small>

							<h4 class="mb-0">
								{{ commande.numero|default(
                                'CMD-' ~ commande.id
                            ) }}
							</h4>
						</div>

						<div class="mb-3">
							<small class="text-muted">Date</small>

							<div>
								{{ commande.dateCommande
                                ? commande.dateCommande|date('d/m/Y H:i')
                                : 'Non renseignée'
                            }}
							</div>
						</div>

						<div>
							<small class="text-muted">Client</small>

							<div>
								<strong>
									{{ commande.clients.nom|default(
                                    commande.clients.raisonSociale
                                    |default('Client non renseigné')
                                ) }}
								</strong>
							</div>
						</div>
					</div>
				</div>
			</div>

			{# ========================================================
																																																																																	           INFORMATIONS DU TRAVAIL
																																																																																	           ======================================================== #}
			<div class="col-xl-8 col-lg-8">
				<div class="card">
					<div class="card-header">
						<h3 class="card-title">
							<i class="fe fe-briefcase mr-2"></i>
							Travail à contrôler
						</h3>
					</div>

					<div class="card-body">
						{% set configuration = detail.produitConfiguration %}
						<div class="row">

							<div class="col-md-6 mb-3">
								<small class="text-muted text-primary">Désignation</small>

								<h4 class="mb-0">
									{{ detail.designation|default(
                                    detail.produit.nom
                                    |default('Travail sans désignation')
                                ) }}
								</h4>
							</div>

							<div class="col-md-2 mb-3">
								<small class="text-muted">Quantité</small>

								<h4 class="mb-0">
									{{ detail.quantite|default(1) }}
								</h4>
							</div>

							<div class="col-md-4 mb-3">
								<small class="text-muted">
									Nombre de fichiers
								</small>

								<h4 class="mb-0">
									{{ detail.fichiers|length }}
								</h4>
							</div>

							<div class="col-md-12 mt-2">
								<div class="border rounded bg-light text-primary p-3">
									<h5 class="mb-3">
										<i class="fe fe-settings mr-1"></i>
										Fiche technique de production
									</h5>

									<div class="row">
										<div class="col-md-4 mb-3">
											<small class="text-muted d-block">Produit</small>
											<strong>{{ detail.produit.nom|default(configuration.produit.nom|default(detail.designation|default('—'))) }}</strong>
										</div>

										<div class="col-md-4 mb-3">
											<small class="text-muted d-block">Type d’impression</small>
											<strong>{{ configuration.typeImpression.nom|default('Non renseigné') }}</strong>
										</div>

										<div class="col-md-4 mb-3">
											<small class="text-muted d-block">Support / matière</small>
											<strong>{{ configuration.support.nom|default('Non renseigné') }}</strong>
										</div>

										<div class="col-md-3 mb-3">
											<small class="text-muted d-block">Format</small>
											<strong>{{ configuration.format.nom|default('Sur mesure') }}</strong>
										</div>

										<div class="col-md-3 mb-3">
											<small class="text-muted d-block">Taille / dimensions</small>
											<strong>
												{% set configuration = detail.produitConfiguration %}

												{% if detail.longueur is not empty and detail.largeur is not empty %}
													{{ detail.longueur }}
													×
													{{ detail.largeur }}

												{% elseif configuration
    and configuration.format
    and configuration.format.nom is not empty
%}
													{{ configuration.format.nom }}

												{% else %}
													Non renseignée
												{% endif %}
											</strong>
										</div>

										<div class="col-md-3 mb-3">
											<small class="text-muted d-block">Quantité commandée</small>
											<strong>{{ detail.quantite|default(1) }}</strong>
										</div>

										<div class="col-md-3 mb-3">
											<small class="text-muted d-block">Mode de calcul</small>
											<strong>{{ configuration.modeCalcul|default('Non renseigné')|replace({'_': ' '})|capitalize }}</strong>
										</div>

										<div class="col-md-12">
											<small class="text-muted d-block mb-1">Finitions</small>
											{% if detail.finitions is defined and detail.finitions is not empty %}
												{% for finitionDetail in detail.finitions %}
													<span class="badge badge-info mr-1 mb-1">
														{{ finitionDetail.configurationFinition.finition.nom|default(finitionDetail.finition.nom|default('Finition')) }}
														{% if finitionDetail.quantite is defined and finitionDetail.quantite %}
															×
															{{ finitionDetail.quantite }}
														{% endif %}
													</span>
												{% endfor %}
											{% elseif configuration.configurationFinitions is defined and configuration.configurationFinitions is not empty %}
												{% for configurationFinition in configuration.configurationFinitions %}
													{% if configurationFinition.active|default(true) %}
														<span class="badge badge-secondary mr-1 mb-1">{{ configurationFinition.finition.nom|default('Finition') }}</span>
													{% endif %}
												{% endfor %}
											{% else %}
												<strong>Aucune finition</strong>
											{% endif %}
										</div>
									</div>
								</div>
							</div>

						</div>
					</div>
				</div>
			</div>
		</div>

		{# Formulaire autonome d'ajout d'un fichier traité.
																																								   Il est déclaré ici pour éviter d'imbriquer deux formulaires HTML. #}
		{% set jetonTemporaireFichierTraite = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' %}
		{% set indexTemporaireFichierTraite = 999999999 %}

		{% set modeleUrlMorceauFichierTraite = path('app_controle_pre_presse_fichier_traite_morceau', {
			jeton: jetonTemporaireFichierTraite,
			index: indexTemporaireFichierTraite
		}) %}

		{% set modeleUrlMorceauFichierTraite = modeleUrlMorceauFichierTraite|replace({
			(jetonTemporaireFichierTraite): '__JETON__',
			(indexTemporaireFichierTraite ~ ''): '__INDEX__'
		}) %}

		<form id="form-fichier-traite" method="post" enctype="multipart/form-data" action="{{ path('app_controle_pre_presse_ajouter_fichier_traite', {id: detail.id}) }}" data-upload-initialiser-url="{{ path('app_controle_pre_presse_fichier_traite_initialiser', {id: detail.id}) }}" data-upload-morceau-url="{{ modeleUrlMorceauFichierTraite }}"></form>

		{# ============================================================
																																																								       FORMULAIRE DU CONTRÔLE
																																																								       ============================================================ #}
		<form method="post" id="form-controle-pre-presse">

			<input
			type="hidden" name="_token" value="{{ csrf_token( 'controle_pre_presse_' ~ detail.id ) }}">

			{# ========================================================
																																																																																	           SÉLECTION DES FICHIERS
																																																																																	           ======================================================== #}
			<div class="card">
				<div class="card-header d-flex justify-content-between
																																																																																																																																																																		                        align-items-center">

					<h3 class="card-title">
						<i class="fe fe-paperclip mr-2"></i>
						Fichiers à contrôler
					</h3>

					<div class="custom-control custom-checkbox">
						<input type="checkbox" class="custom-control-input" id="selectionner-tous-fichiers">

						<label class="custom-control-label" for="selectionner-tous-fichiers">
							Tout sélectionner
						</label>
					</div>
				</div>

				<div class="card-body">
					{% if detail.fichiers is empty %}

						<div class="alert alert-warning mb-0">
							Aucun fichier n’est associé à ce travail.
						</div>

					{% else %}

						<div class="row">
							{% for fichier in detail.fichiers %}
								{% if fichier.actif %}
									<div class="col-xl-4 col-lg-6 col-md-6">
										<div class="card border fichier-card">
											<div class="card-body">

												<div class="custom-control
																																																																																																																																																																																																																																																																																																																																																																																										                                                        custom-checkbox mb-3">

													<input type="checkbox" class="custom-control-input
																																																																																																																																																																																																																																																																																																																																																																																										                                                           fichier-checkbox" id="fichier-{{ fichier.id }}" name="fichiers[]" value="{{ fichier.id }}">

													<label class="custom-control-label" for="fichier-{{ fichier.id }}">
														Sélectionner ce fichier
													</label>
												</div>

												<div class="d-flex
																																																																																																																																																																																																																																																																																																																																																																																										                                                        align-items-center">

													<div class="avatar
																																																																																																																																																																																																																																																																																																																																																																																																																					                                                            avatar-lg
																																																																																																																																																																																																																																																																																																																																																																																																																					                                                            bg-primary
																																																																																																																																																																																																																																																																																																																																																																																																																					                                                            text-white mr-3">
														<i class="fe fe-file"></i>
													</div>

													<div class="flex-fill" style="min-width: 0;">

														<strong class="d-block
																																																																																																																																																																																																																																																																																																																																																																																																																																																                                                                   text-truncate">
															{{ fichier.nomOriginal }}
														</strong>

														<small class="text-muted">
															{{ fichier.typeMime
                                                            |default(
                                                                'Type non renseigné'
                                                            )
                                                        }}
														</small>
													</div>
												</div>

												<div class="small text-muted mt-3">
													{% if fichier.designation %}
														<div>
															<strong>Désignation :</strong>
															{{ fichier.designation }}</div>
													{% endif %}
													<div>
														<strong>État :</strong>
														{{ fichier.etat|default('non renseigné')|replace({'_': ' '})|capitalize }}</div>
													<div>
														<strong>Face :</strong>
														{{ fichier.face|default('Non renseignée')|capitalize }}</div>
													<div>
														<strong>Version :</strong>
														{{ fichier.version|default(1) }}</div>
													{% if fichier.quantiteAProduire %}
														<div>
															<strong>Quantité à produire :</strong>
															{{ fichier.quantiteAProduire }}</div>
													{% endif %}
													{% if fichier.taille %}
														<div>
															<strong>Taille du fichier :</strong>
															{{ (fichier.taille / 1024 / 1024)|number_format(2, ',', ' ') }}
															Mo</div>
													{% endif %}
												</div>

												<hr>

												<div class="mb-2">
													<small class="text-muted">
														Statut :
													</small>

													{% if fichier.estPretPourImpression %}
														<span class="badge
																																																																																																																																																																																																																																																																																																																																																																																																																																																                                                                 badge-success">
															Prêt pour impression
														</span>
													{% elseif fichier.estUploadTermine %}
														<span class="badge
																																																																																																																																																																																																																																																																																																																																																																																																																																																                                                                 badge-info">
															Upload terminé
														</span>
													{% else %}
														<span class="badge
																																																																																																																																																																																																																																																																																																																																																																																																																																																                                                                 badge-warning">
															Upload en cours
														</span>
													{% endif %}
												</div>

												{% if fichier.id and fichier.actif %}
													<a href="{{ path( 'app_controle_pre_presse_visualiser_fichier', {id: fichier.id} ) }}" class="btn btn-primary" target="_blank">
														<i class="fa fa-eye mr-1"></i>
														Aperçu
													</a>

													<a href="{{ path( 'app_controle_pre_presse_telecharger_fichier', {id: fichier.id} ) }}" class="btn btn-outline-primary">
														<i class="fa fa-download mr-1"></i>
														Télécharger l’original
													</a>
												{% else %}
													<button type="button" class="btn btn-sm btn-outline-secondary btn-block" disabled>
														<i class="fe fe-alert-circle mr-1"></i>
														Fichier indisponible
													</button>
												{% endif %}

											</div>
										</div>
									</div>
								{% endif %}
							{% endfor %}
						</div>

					{% endif %}
				</div>
			</div>

			{# ========================================================
																																																																																	           ÉTAT INITIAL DU FICHIER
																																																																																	           ======================================================== #}
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">
						<i class="fe fe-git-branch mr-2"></i>
						État du fichier
					</h3>
				</div>

				<div class="card-body">
					<div class="row">

						<div class="col-md-6">
							<label class="custom-control
																																																																																																																																																																																																																																																			                                      custom-checkbox mb-3">

								<input type="checkbox" class="custom-control-input" id="fichierDejaTraite" name="fichierDejaTraite" value="1">

								<span class="custom-control-label">
									Fichier déjà traité
								</span>
							</label>

							<small class="text-muted d-block">
								Le fichier est prêt et nécessite seulement
																																																																																																																																																																																																																								                            un contrôle rapide.
							</small>
						</div>

						<div class="col-md-6">
							<label class="custom-control
																																																																																																																																																																																																																																																			                                      custom-checkbox mb-3">

								<input type="checkbox" class="custom-control-input" id="correctionNecessaire" name="correctionNecessaire" value="1">

								<span class="custom-control-label">
									Correction nécessaire
								</span>
							</label>

							<small class="text-muted d-block">
								Des anomalies doivent être corrigées avant
																																																																																																																																																																																																																								                            la validation.
							</small>
						</div>

					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">
						<i class="fe fe-upload-cloud mr-2"></i>
						Ajouter un fichier traité
					</h3>
				</div>

				<div class="card-body">
					<input form="form-fichier-traite" type="hidden" name="_token" value="{{ csrf_token( 'ajouter_fichier_traite_' ~ detail.id ) }}">

					<div class="row">
						<div class="col-md-6 mb-3">

							<label for="fichierSource">
								Fichier original correspondant
								<span class="text-danger">*</span>
							</label>

							<select form="form-fichier-traite" class="form-control" id="fichierSource" name="fichierSource" required>
								<option value="">Sélectionnez le fichier original</option>

								{% set fichierDisponible = false %}

								{% for fichier in detail.fichiers %}
									{% if fichier.actif and fichier.etat == 'original' %}
										{% set fichierDisponible = true %}

										<option value="{{ fichier.id }}">
											{{ fichier.nomOriginal|default('Fichier sans nom') }}

											{% if fichier.face %}
												—
												{{ fichier.face|capitalize }}
											{% endif %}

											— Version
											{{ fichier.version|default(1) }}
										</option>
									{% endif %}
								{% endfor %}

								{% if not fichierDisponible %}
									<option value="" disabled>
										Aucun fichier original disponible
									</option>
								{% endif %}
							</select>
						</div>

						<div class="col-md-6 mb-3">
							<label for="fichierTraite">
								Fichier traité
								<span class="text-danger">*</span>
							</label>

							<input form="form-fichier-traite" type="file" class="form-control" id="fichierTraite" name="fichierTraite" required>
						</div>

						<div class="col-md-4 mb-3">
							<label for="faceTraitee">Face</label>

							<select form="form-fichier-traite" class="form-control" id="faceTraitee" name="face">
								<option value="">Même face que l’original</option>
								<option value="recto">Recto</option>
								<option value="verso">Verso</option>
								<option value="recto-verso">Recto-verso</option>
								<option value="devant">Devant</option>
								<option value="dos">Dos</option>
								<option value="autre">Autre</option>
							</select>
						</div>

						<div class="col-md-8 mb-3">
							<label for="designationFichier">
								Désignation
							</label>

							<input form="form-fichier-traite" type="text" class="form-control" id="designationFichier" name="designation" placeholder="Exemple : Carte recto corrigée">
						</div>

						<div class="col-md-12 mb-3">
							<label for="observationFichier">
								Observation
							</label>

							<textarea form="form-fichier-traite" class="form-control" id="observationFichier" name="observation" rows="2" placeholder="Corrections effectuées..."></textarea>
						</div>

						<div class="col-md-12 text-right">
							<button form="form-fichier-traite" type="submit" class="btn btn-primary">
								<i class="fe fe-upload mr-1"></i>
								Ajouter le fichier traité
							</button>
						</div>
					</div>
				</div>
			</div>
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">
						<i class="fe fe-check-circle mr-2"></i>
						Fichiers traités pour impression
					</h3>
				</div>

				<div class="card-body">
					{% set nombreFichiersTraites = 0 %}

					<div class="row">
						{% for fichier in detail.fichiers %}
							{% if fichier.actif
                    and fichier.etat in [
                        'traite',
                        'pret_impression'
                    ]
                %}
								{% set nombreFichiersTraites =
                        nombreFichiersTraites + 1
                    %}

								<div class="col-xl-4 col-md-6">
									<div class="card border">
										<div class="card-body">
											<div class="d-flex align-items-center mb-3">
												<div class="avatar avatar-lg
																																																																																																																																																																																																																																																																																																																				                                                bg-success text-white mr-3">
													<i class="fe fe-file"></i>
												</div>

												<div style="min-width: 0;">
													<strong class="d-block text-truncate">
														{{ fichier.nomOriginal }}
													</strong>

													<small class="text-muted">
														Version
														{{ fichier.version }}
														{% if fichier.face %}
															—
															{{ fichier.face }}
														{% endif %}
													</small>
												</div>
											</div>

											{% if fichier.fichierSource %}
												<p class="small mb-2">
													<strong>Original :</strong>
													{{ fichier.fichierSource.nomOriginal }}
												</p>
											{% endif %}

											<p class="mb-3">
												{% if fichier.fichierProduction %}
													<span class="badge badge-success">
														Fichier de production
													</span>
												{% elseif fichier.etat ==
                                        'pret_impression'
                                    %}
													<span class="badge badge-info">
														Prêt pour impression
													</span>
												{% else %}
													<span class="badge badge-warning">
														Traité — à valider
													</span>
												{% endif %}
											</p>

											<a href="{{ path('app_controle_pre_presse_visualiser_fichier', { id: fichier.id }) }}" target="_blank" rel="noopener" class="btn btn-sm
																																																																																																																																																																																																																																																																																														                                           btn-outline-primary btn-block">
												<i class="fe fe-eye mr-1"></i>
												Visualiser
											</a>
										</div>
									</div>
								</div>
							{% endif %}
						{% endfor %}
