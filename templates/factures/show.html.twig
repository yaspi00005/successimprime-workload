{% block javascripts %}
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	{{ parent() }}

	<script>

		document.addEventListener('DOMContentLoaded', function () {

const boutonActualiser = document.getElementById('btn-actualiser-facture');

const formActualiser = document.getElementById('form-actualiser-facture');


if (boutonActualiser && formActualiser) {

boutonActualiser.addEventListener('click', function () {

if (typeof Swal !== 'undefined') {

Swal.fire({
icon: 'question',
title: 'Actualiser cette facture ?',
text: 'Les montants seront repris depuis la commande liée (les paiements déjà enregistrés ne sont pas modifiés).',
showCancelButton: true,
confirmButtonText: 'Oui, actualiser',
cancelButtonText: 'Fermer'
}).then(function (result) {
if (result.isConfirmed) {
formActualiser.submit();
}
});

return;
}

formActualiser.submit();
});
}


const button = document.getElementById('btn-annuler-facture');

const form = document.getElementById('form-annuler-facture');


if (! button || ! form) {
return;
}


button.addEventListener('click', function () { /*
                         * SweetAlert2.
                         */
if (typeof Swal !== 'undefined') {

Swal.fire({
icon: 'warning',

title: 'Annuler ce document ?',

text: 'Cette opération changera l’état du document en annulé.',

showCancelButton: true,

confirmButtonText: 'Oui, annuler',

cancelButtonText: 'Fermer',

confirmButtonColor: '#d33'
}).then(function (result) {

if (result.isConfirmed) {
form.submit();
}

});

return;
}


/*
                         * Fallback.
                         */
if (confirm('Voulez-vous vraiment annuler ce document ?')) {
form.submit();
}

});

});


document.addEventListener('DOMContentLoaded', function () {

document.querySelectorAll('.js-envoyer-whatsapp').forEach(function (bouton) {

bouton.addEventListener('click', function () {

const numero = bouton.dataset.numero || 'ce document';

Swal.fire({
icon: 'question',
title: 'Envoyer ' + numero + ' par WhatsApp ?',
text: 'Le PDF sera envoyé au numéro WhatsApp enregistré pour ce client.',
showCancelButton: true,
confirmButtonText: 'Envoyer',
cancelButtonText: 'Annuler'
}).then(function (resultat) {

if (! resultat.isConfirmed) {
return;
}

bouton.disabled = true;

fetch(bouton.dataset.url, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
Accept: 'application/json',
'X-Requested-With': 'XMLHttpRequest'
},
body: JSON.stringify(
{_token: bouton.dataset.token}
)
}).then(function (reponse) {
return reponse.json();
}).then(function (donnees) {
Swal.fire({
icon: donnees.success ? 'success' : 'error',
title: donnees.success ? 'Envoyé' : 'Erreur',
