{% extends 'security/_page_connexion.html.twig' %}

{#
	Changer son mot de passe : même page que la connexion (maquette CX02),
	avec les règles cochées au fil de la saisie. Le serveur vérifie les
	mêmes règles (UserController::changePassword).
#}

{% block title %}Changer mon mot de passe · Succès Imprim{% endblock %}

{% block carte %}
	{% set obligatoire = user.mustChangePassword|default(false) %}
	<h1>{{ obligatoire ? 'Choisissez votre mot de passe' : 'Changer mon mot de passe' }}</h1>
	<p class="si-connexion-sous-titre">
		{% if user.employe %}{{ user.employe.prenom }} {{ user.employe.nom }} · {% endif %}{{ user.username }}
	</p>
	{% if obligatoire %}
		<p class="si-mdp-info">Avant de continuer, remplacez le mot de passe qui vous a été donné par un mot de passe connu de vous seul.</p>
	{% endif %}

	{% for message in app.flashes('success') %}
		<div class="si-connexion-succes" role="status">{{ message }}</div>
	{% endfor %}

	<form method="post" action="{{ path('app_user_change_password') }}" autocomplete="off" class="js-form-mdp">
		<input type="hidden" name="_token" value="{{ csrf_token('change_password_' ~ user.id) }}">

		<label for="currentPassword">Mot de passe actuel</label>
		<div class="si-connexion-mdp">
			<input type="password" id="currentPassword" name="current_password" autocomplete="current-password" required autofocus>
			<button type="button" class="js-afficher" data-cible="currentPassword" aria-pressed="false">Afficher</button>
		</div>

		<label for="newPassword">Nouveau mot de passe</label>
		<div class="si-connexion-mdp">
			<input type="password" id="newPassword" name="new_password" autocomplete="new-password" required>
			<button type="button" class="js-afficher" data-cible="newPassword" aria-pressed="false">Afficher</button>
		</div>

		<label for="confirmPassword">Confirmer le nouveau mot de passe</label>
		<div class="si-connexion-mdp">
			<input type="password" id="confirmPassword" name="confirm_password" autocomplete="new-password" required>
			<button type="button" class="js-afficher" data-cible="confirmPassword" aria-pressed="false">Afficher</button>
		</div>

		<ul class="si-mdp-regles" aria-live="polite">
			<li data-regle="longueur">Au moins 8 caractères</li>
			<li data-regle="majuscule">Une lettre majuscule</li>
			<li data-regle="minuscule">Une lettre minuscule</li>
			<li data-regle="chiffre">Un chiffre</li>
			<li data-regle="special">Un caractère spécial</li>
			<li data-regle="identique">Les deux saisies sont identiques</li>
		</ul>

		<button type="submit" class="si-connexion-bouton">Enregistrer le nouveau mot de passe</button>
	</form>

	<p class="si-mdp-pied">
		{% if not obligatoire %}<a href="{{ path('app_home') }}">Retour à l'accueil</a> · {% endif %}<a href="{{ path('app_logout') }}">Se déconnecter</a>
	</p>

	<style>
		.si-mdp-info { margin: 0 0 1rem; font-size: .9rem; color: #475569; }
		.si-mdp-regles { list-style: none; margin: .25rem 0 1.25rem; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: .25rem .75rem; font-size: .82rem; color: #64748b; }
		.si-mdp-regles li::before { content: '○'; display: inline-block; width: 1.1em; }
		.si-mdp-regles li.ok { color: #15803d; }
		.si-mdp-regles li.ok::before { content: '✓'; }
		.si-mdp-pied { margin: 1rem 0 0; text-align: center; font-size: .88rem; }
		.si-mdp-pied a { color: #0F4590; }
		@media (max-width: 420px) { .si-mdp-regles { grid-template-columns: 1fr; } }
	</style>
	<script>
		(function () {
			var nouveau = document.getElementById('newPassword');
			var confirmation = document.getElementById('confirmPassword');
			var regles = {
				longueur: function (v) { return v.length >= 8; },
				majuscule: function (v) { return /[A-Z]/.test(v); },
				minuscule: function (v) { return /[a-z]/.test(v); },
				chiffre: function (v) { return /[0-9]/.test(v); },
				special: function (v) { return /[^A-Za-z0-9]/.test(v); },
				identique: function (v) { return v !== '' && v === confirmation.value; }
			};
			function verifier() {
				var v = nouveau.value;
				document.querySelectorAll('.si-mdp-regles li').forEach(function (li) {
					li.classList.toggle('ok', regles[li.dataset.regle](v));
				});
			}
			nouveau.addEventListener('input', verifier);
			confirmation.addEventListener('input', verifier);
		})();
	</script>
{% endblock %}

{% block note %}
	<p class="si-connexion-note">Ne communiquez jamais votre mot de passe, même à un collègue.</p>
{% endblock %}
