<!DOCTYPE html>
<html lang="fr">
{% set routeCourante = app.request.attributes.get('_route')|default('') %}

{% set peutVoirClients = is_granted('ROLE_CLIENT') %}
{% set peutVoirDevis = is_granted('ROLE_DEVIS') %}
{% set peutVoirCommandes = is_granted('ROLE_COMMANDE') %}
{% set peutVoirLivraison = is_granted('ROLE_LIVRAISON') %}
{% set peutVoirCommercial = peutVoirClients or peutVoirDevis or peutVoirCommandes or peutVoirLivraison %}

{% set peutVoirProduction = is_granted('ROLE_PRODUCTION_VOIR') %}
{% set peutGererProduction = is_granted('ROLE_PRODUCTION_GERER') %}
{% set peutVoirPrepresse = is_granted('ROLE_PREPRESSE') %}

{% set peutVoirStocks = is_granted('ROLE_ADMIN') %}

{% set peutVoirFactures = is_granted('ROLE_FACTURE') %}
{% set peutVoirPaiements = is_granted('ROLE_PAIEMENT_VOIR') %}
{% set peutVoirTresorerie = is_granted('ROLE_TRESORERIE_VOIR') %}
{% set peutSaisirTresorerie = is_granted('ROLE_TRESORERIE_SAISIR') %}
{% set peutVoirJournalCaisse = is_granted('ROLE_ADMIN') %}
{% set peutVoirComptesTresorerie = is_granted('ROLE_ADMIN') %}
{% set peutVoirRapprochement = is_granted('ROLE_RAPPROCHEMENT_BANCAIRE') %}
{% set peutVoirStatsGlobales = is_granted('ROLE_STATS_GLOBAL') %}
{% set peutVoirMesStats = is_granted('ROLE_STATS_PERSO') %}
{% set peutVoirGestion = peutVoirFactures or peutVoirPaiements or peutVoirTresorerie or peutVoirComptesTresorerie or peutVoirJournalCaisse or peutVoirRapprochement or peutVoirMesStats or peutVoirStatsGlobales %}

{% set peutVoirRh = is_granted('ROLE_ADMIN') %}
{% set peutVoirParametres = is_granted('ROLE_ADMIN') %}
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<meta name="robots" content="noindex, nofollow">
	<title>{% block title %}Tableau de bord{% endblock %} · Succès Imprim</title>
	<link rel="shortcut icon" type="image/png" href="{{ asset('theme/images/favicon.png') }}">
	<link rel="manifest" href="/manifest.webmanifest">
	<link rel="apple-touch-icon" href="{{ asset('images/icone-192.png') }}">
	<meta name="theme-color" content="#0F4590">
	<link href="{{ asset('theme/vendor/jquery-nice-select/css/nice-select.css') }}" rel="stylesheet">
	<link href="{{ asset('theme/vendor/select2/css/select2.min.css') }}" rel="stylesheet">
	<link href="{{ asset('theme/vendor/toastr/css/toastr.min.css') }}" rel="stylesheet">
	{% block stylesheets %}{% endblock %}
	{# Polices du thème servies par le site (docs/securite.md) : le thème les demandait à Google. #}
	<link href="{{ asset('vendor/poppins-v24/poppins.css') }}" rel="stylesheet">
	<link href="{{ asset('vendor/roboto-v51/roboto.css') }}" rel="stylesheet">
	<link href="{{ asset('theme/css/style.css') }}" rel="stylesheet">
	<link href="{{ asset('css/charte.css') }}" rel="stylesheet">
	<link href="{{ asset('css/admin.css') }}" rel="stylesheet">
	<link href="{{ asset('css/notifications-equipe.css') }}" rel="stylesheet">
</head>
<body>
	<div id="preloader">
		<div class="lds-ripple"><div></div><div></div></div>
	</div>

	<div id="main-wrapper">
		{# ---------- En-tête de la barre latérale : logo ---------- #}
		<div class="nav-header si-nav-header">
			<a href="{{ path('app_home') }}" class="brand-logo si-logo-carte">
				<img src="{{ asset('images/logo-succes-imprim.png') }}" alt="Succès Imprim" class="si-logo-complet">
				<span class="si-logo-mini">SI</span>
			</a>
			<div class="nav-control">
				<div class="hamburger">
					<span class="line"></span><span class="line"></span><span class="line"></span>
				</div>
			</div>
		</div>

		{# ---------- En-tête : fil d'Ariane, titre, recherche, compte ---------- #}
		{% set sectionCourante = section_admin(routeCourante) %}
		<div class="header si-header">
			<div class="header-content">
				<nav class="navbar navbar-expand">
					<div class="collapse navbar-collapse justify-content-between">
						<div class="header-left si-titre-page">
							{% if sectionCourante and routeCourante != 'app_home' %}
								<div class="si-fil-ariane">{{ libelle_section_admin(sectionCourante) }} <span>›</span> {# Le titre est déjà échappé à son rendu : sans |raw, « l'an » s'afficherait « l&#039;an ». #}{{ block('title')|striptags|trim|raw }}</div>
							{% endif %}
							<div class="dashboard_bar">{% block page_title %}{{ block('title') }}{% endblock %}</div>
						</div>
						<ul class="navbar-nav header-right">
							{% block header_actions %}{% endblock %}
							{# Le livreur seul n'a ni recherche ni messagerie : sa tournée et ses livraisons seulement (LivreurSeul). #}
							{% set livreurSeul = livreur_seul() %}
							{% if not livreurSeul %}
							<li class="nav-item si-recherche-item">
								<form action="{{ path('app_recherche') }}" method="get" class="si-recherche" role="search">
									<i class="fas fa-search"></i>
									<input type="search" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher client, commande, facture…" aria-label="Recherche globale" data-raccourci-recherche autocomplete="off">
									<kbd>Ctrl K</kbd>
								</form>
							</li>
							{% endif %}
							{# Guide utilisateur (docs/guide-utilisateur.md) : ERP local seulement. #}
							{% if not site_en_ligne() %}
								<li class="nav-item si-aide-item">
									<a class="nav-link si-aide-lien" href="{{ path('app_aide_index', {ecran: app.request.attributes.get('_route')}) }}" title="Aide : les fiches de votre rôle">
										<i class="far fa-question-circle" aria-hidden="true"></i><span class="si-aide-texte">Aide</span>
									</a>
								</li>
							{% endif %}
							{# Cloche (maquette NT01) : liste triée Urgent / À faire / Info, rechargée à l'ouverture et toutes les 30 s (docs/notifications-equipe.md). #}
							{% set nombreNotifs = notifications_equipe().non_lues + (livreurSeul ? 0 : mes_reclamations_a_notifier()|length) %}
							<li class="nav-item dropdown notification_dropdown si-cloche">
								<a class="nav-link" href="{{ path('app_notification_index') }}" role="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" title="Notifications" aria-label="Notifications{{ nombreNotifs > 0 ? ', ' ~ nombreNotifs ~ ' non lue' ~ (nombreNotifs > 1 ? 's') }}" data-si-cloche>
									<i class="fa fa-bell" aria-hidden="true"></i>
									<span class="badge light badge-danger rounded-circle" data-si-cloche-nombre{% if nombreNotifs == 0 %} hidden{% endif %}>{{ nombreNotifs > 99 ? '99+' : nombreNotifs }}</span>
								</a>
								<div class="dropdown-menu dropdown-menu-end si-cloche-menu" data-si-cloche-menu>
									{% include 'notification/_cloche_liste.html.twig' %}
								</div>
							</li>
							{% if not livreurSeul %}
							<li class="nav-item dropdown notification_dropdown si-masque-mobile">
								<a class="nav-link" href="{{ path('app_chat_index') }}" role="button" title="Messagerie">
									<i class="fa fa-comments"></i>
									{% set nombreMessages = mes_conversations_non_lues() %}
									{% if nombreMessages > 0 %}<span class="badge light badge-danger rounded-circle">{{ nombreMessages }}</span>{% endif %}
								</a>
							</li>
							{% endif %}
							<li class="nav-item dropdown header-profile">
								{% set nomAffiche = app.user.employe.prenom is defined and app.user.employe.prenom is not empty ? (app.user.employe.prenom ~ ' ' ~ app.user.employe.nom) : app.user.username %}
								<a class="nav-link" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{ nomAffiche }}">
									<span class="si-avatar">{{ (app.user.employe.prenom|default(app.user.username)|slice(0, 1) ~ app.user.employe.nom|default('')|slice(0, 1))|upper }}</span>
								</a>
								<div class="dropdown-menu dropdown-menu-end">
									<span class="dropdown-item-text fw-semibold">{{ nomAffiche }}</span>
									<div class="dropdown-divider"></div>
									{% if app.user.employe is defined and app.user.employe %}
										<a class="dropdown-item" href="{{ path('app_mon_espace_index') }}"><i class="fas fa-id-badge text-primary"></i><span class="ms-2">Mon espace</span></a>
										<a class="dropdown-item" href="{{ path('app_pointer_index') }}"><i class="fas fa-qrcode text-success"></i><span class="ms-2">Pointer</span></a>
									{% endif %}
									{% if not site_en_ligne() %}
										<a class="dropdown-item" href="{{ path('app_aide_index') }}"><i class="far fa-question-circle text-primary"></i><span class="ms-2">Aide et guide</span></a>
									{% endif %}
									<a class="dropdown-item" href="{{ path('app_user_change_password') }}"><i class="fas fa-key text-primary"></i><span class="ms-2">Changer mon mot de passe</span></a>
									<a class="dropdown-item" href="{{ path('app_logout') }}"><i class="fas fa-sign-out-alt text-danger"></i><span class="ms-2">Déconnexion</span></a>
								</div>
							</li>
						</ul>
					</div>
				</nav>
			</div>
		</div>

		{# ---------- Menu ---------- #}
		{% include 'partials/_menu.html.twig' %}

		{# ---------- Contenu ---------- #}
		<div class="content-body">
			{% include 'notification/_banniere.html.twig' %}
			<div class="container-fluid">
				{% for type in ['success', 'error', 'danger', 'warning', 'info'] %}
					{% for message in app.flashes(type) %}
						<div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show" role="alert">
							{{ message }}
							<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
						</div>
					{% endfor %}
				{% endfor %}
				{% block onglets_section %}{% include 'partials/_onglets_section.html.twig' %}{% endblock %}
				{% set moduleEnLecture = module_en_lecture(routeCourante) %}
				{% if moduleEnLecture %}
					<div class="si-lecture-seule" role="note"><i class="far fa-eye" aria-hidden="true"></i> {{ moduleEnLecture }} : vous pouvez consulter, pas modifier.</div>
				{% endif %}
				{% block breadcrumb %}{% endblock %}
				{% block body %}{% endblock %}
			</div>
		</div>

		{% include 'partials/_barre_mobile.html.twig' %}

		{# Petites fenêtres en bas (8 s, bouton direct) et son court : notifications-equipe.js. #}
		<div class="si-fenetres" data-si-fenetres aria-live="polite"></div>
		{% for idCommande in app.flashes('plafond_bloquant') %}{% include 'notification/_plafond_bloquant.html.twig' with {fenetre: fenetre_plafond(idCommande)} only %}{% endfor %}

		<div class="footer">
			<div class="copyright">
				<p>Succès Imprim, un service de MDG © {{ 'now'|date('Y') }}</p>
			</div>
		</div>
	</div>

	<script src="{{ asset('theme/vendor/global/global.min.js') }}"></script>
	<script src="{{ asset('theme/vendor/jquery-nice-select/js/jquery.nice-select.min.js') }}"></script>
	<script src="{{ asset('theme/vendor/select2/js/select2.full.min.js') }}"></script>
	<script src="{{ asset('theme/vendor/toastr/js/toastr.min.js') }}"></script>
	{% block vendor_javascripts %}{% endblock %}
	<script src="{{ asset('theme/js/custom.min.js') }}"></script>
	<script src="{{ asset('theme/js/dlabnav-init.js') }}"></script>
	{# Fenêtre de confirmation des suppressions et actions sensibles (data-confirmer, docs/corbeille.md). #}
	<script src="{{ asset('js/confirmation.js') }}" data-css="{{ asset('css/confirmation.css') }}"></script>
	{# admin.js charge les filtres des tableaux seulement sur les pages qui ont une liste (docs/filtres-tableaux.md). #}
	<script src="{{ asset('js/admin.js') }}" data-filtres-js="{{ asset('js/filtres-tableaux.js') }}" data-filtres-css="{{ asset('css/filtres-tableaux.css') }}" data-filtres-compte="{{ app.user ? app.user.id }}"></script>
	<script src="{{ asset('js/notifications-equipe.js') }}" data-etat="{{ path('app_notification_etat') }}" data-cloche="{{ path('app_notification_cloche') }}" data-son="{{ path('app_notification_son') }}" data-jeton="{{ csrf_token('notifications') }}" data-centre="{{ path('app_notification_index') }}" defer></script>
	{% block javascripts %}{% endblock %}
</body>
</html>
