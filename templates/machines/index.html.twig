{% block javascripts %}

	{{ parent() }}

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script src="{{ asset('assets/js/traitement_machines.js') }}"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () { /*
		     * ============================================================
		     * OUTILS
		     * ============================================================
		     */

function afficherErreur(message) {
Swal.fire({
icon: 'error',
title: 'Erreur',
text: message || 'Une erreur est survenue.'
});
}

function afficherSucces(message) {
return Swal.fire({
icon: 'success',
title: 'Succès',
text: message || 'Votre demande a été enregistrée.',
timer: 1800,
showConfirmButton: false
});
}

async function lireReponseJson(response) {
let data;

try {
data = await response.json();
} catch (e) {
throw new Error('La réponse du serveur est invalide.');
}

if (! response.ok || data.success === false) {
throw new Error(data.message || 'Une erreur est survenue.');
}

return data;
}

function valeur(id) {
const element = document.getElementById(id);

if (! element) {
return '';
}

return element.value.trim();
}

function definirValeur(id, value) {
const element = document.getElementById(id);

if (! element) {
return;
}

element.value = value ?? '';
}

/*
		     * ============================================================
		     * VALIDATION IP
		     * ============================================================
		     */

function adresseIpValide(ip) {
if (! ip) {
return false;
}

/*
		         * IPv4
		         */
const ipv4Regex = /^(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)(\.(25[0-5]|2[0-4]\d|1\d\d|[1-9]?\d)){3}$/;

if (ipv4Regex.test(ip)) {
return true;
}

/*
		         * Validation IPv6 simple.
		         * La validation définitive reste côté PHP.
		         */
if (ip.includes(':') && /^[0-9a-fA-F:]+$/.test(ip)) {
return true;
}

return false;
}

/*
		     * ============================================================
		     * BADGE ÉTAT
		     * ============================================================
		     */

function genererBadgeEtat(etat) {
switch (etat) {
case 'disponible':
return `
	<span class="badge badge-success">
		Disponible
	</span>
	`;

case 'maintenance':
return `
	<span class="badge badge-warning">
		Maintenance
	</span>
	`;

case 'hors_service':
return `
	<span class="badge badge-danger">
		Hors service
	</span>
	`;

case 'inactive':
return `
	<span class="badge badge-secondary">
		Inactive
	</span>
	`;

default:
return `
	<span class="badge badge-info">
		${
echapperHtml((etat || 'Non renseigné').replaceAll('_', ' '))
}
	</span>
	`;
}
}

/*
		     * ============================================================
		     * PROTECTION HTML
		     * ============================================================
		     */

function echapperHtml(value) {
if (value === null || value === undefined) {
return '';
}

const div = document.createElement('div');
div.textContent = String(value);

return div.innerHTML;
}

/*
		     * ============================================================
		     * CRÉATION MACHINE
		     * ============================================================
		     */

const createButton = document.getElementById('machineCreateSaveButton');

if (createButton) {

createButton.addEventListener('click', async function () {

const nom = valeur('machineCreateNom');

const adresseIp = valeur('machineCreateAdresseIp');

const marque = valeur('machineCreateMarque');

const modeles = valeur('machineCreateModeles');

const numeroSerie = valeur('machineCreateNumeroSerie');

const typeMachine = valeur('machineCreateTypeMachine');

const largeurImpression = valeur('machineCreateLargeurImpression');

const nbTetes = valeur('machineCreateNbTetes');

const dateAchat = valeur('machineCreateDateAchat');

const dateMiseService = valeur('machineCreateDateMiseService');

const compteurM2 = valeur('machineCreateCompteurM2');

const compteurHeures = valeur('machineCreateCompteurHeures');

const compteurFeuilles = valeur('machineCreateCompteurFeuilles');

const etat = valeur('machineCreateEtat');

const modeFacturation = valeur('machineCreateModeFacturation');

const prixAchat = valeur('machineCreatePrixAchat');

const dureeAmortissementMois = valeur('machineCreateDureeAmortissementMois');

const revenuAvantSuivi = valeur('machineCreateRevenuAvantSuivi');

const dateDebutSuivi = valeur('machineCreateDateDebutSuivi');

/*
		                 * Validation rapide côté navigateur.
		                 */
if (! nom) {
afficherErreur('Le nom de la machine est obligatoire.');
return;
}

if (! adresseIp) {
afficherErreur('L’adresse IP est obligatoire.');
return;
}

if (! adresseIpValide(adresseIp)) {
afficherErreur('L’adresse IP saisie est invalide.');
return;
}

if (! marque) {
afficherErreur('La marque est obligatoire.');
return;
}

if (! modeles) {
afficherErreur('Le modèle est obligatoire.');
return;
}

if (! numeroSerie) {
afficherErreur('Le numéro de série est obligatoire.');
return;
}

if (! typeMachine) {
afficherErreur('Le type de machine est obligatoire.');
return;
}

if (! largeurImpression) {
afficherErreur('La largeur d’impression est obligatoire.');
return;
}

const createUrl = document.getElementById('machineCreateUrl') ?. value;

const createToken = document.getElementById('machineCreateToken') ?. value;

if (! createUrl || ! createToken) {
afficherErreur('Configuration AJAX de création introuvable.');
return;
}

const confirmation = await Swal.fire({
icon: 'question',
title: 'Enregistrer la machine ?',
html: `
	<strong>
		${
echapperHtml(nom)
}
	</strong>
	<br>
	<span class="text-muted">
		IP : ${
echapperHtml(adresseIp)
}
	</span>
	`,
showCancelButton: true,
confirmButtonText: 'Oui, enregistrer',
cancelButtonText: 'Annuler'
});

if (! confirmation.isConfirmed) {
return;
}

const texteInitial = createButton.innerHTML;

createButton.disabled = true;
createButton.innerHTML = `
	<i class="fa fa-spinner fa-spin mr-1"></i>
	Enregistrement...
		                `;

try {

const formData = new FormData();

formData.append('_token', createToken);

formData.append('nom', nom);

formData.append('adresseIp', adresseIp);

formData.append('marque', marque);

formData.append('modeles', modeles);

formData.append('numeroSerie', numeroSerie);

formData.append('typeMachine', typeMachine);

formData.append('largeurImpression', largeurImpression);

formData.append('nbTetes', nbTetes || '0');

formData.append('dateAchat', dateAchat);

formData.append('dateMiseService', dateMiseService);

formData.append('compteurM2', compteurM2 || '0');

formData.append('compteurHeures', compteurHeures || '0');

formData.append('compteurFeuilles', compteurFeuilles || '0');

formData.append('etat', etat || 'disponible');

formData.append('modeFacturation', modeFacturation || 'metre_carre');

formData.append('prixAchat', prixAchat);

formData.append('dureeAmortissementMois', dureeAmortissementMois);

formData.append('revenuAvantSuivi', revenuAvantSuivi || '0');

formData.append('dateDebutSuivi', dateDebutSuivi);

const response = await fetch(createUrl, {
method: 'POST',
body: formData,
headers: {
'X-Requested-With': 'XMLHttpRequest'
}
});

const data = await lireReponseJson(response);

$('#machineCreateModal').modal('hide');

await afficherSucces(data.message);

/*
		                     * Rechargement simple et fiable.
		                     *
		                     * Cela garantit que :
		                     * - les tokens CSRF sont actualisés ;
		                     * - toutes les URLs Twig sont correctes ;
		                     * - aucune duplication de logique HTML.
		                     */
window.location.reload();

} catch (error) {

afficherErreur(error.message);

} finally {

createButton.disabled = false;
createButton.innerHTML = texteInitial;
}
});
}

