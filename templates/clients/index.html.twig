{% extends 'base.html.twig' %}

{#
	Clients (maquettes K01 et K06) : chiffres du haut, recherche, filtres
	par type et statut, en liste ou en cartes. Les montants suivent les
	droits : CA avec « Indicateurs commerciaux », soldes avec « Paiements ».
#}

{% block title %}Clients{% endblock %}

{% block header_actions %}
	{% if is_granted('ROLE_ADMIN') %}
		<li class="nav-item si-masque-mobile">
			<a href="{{ path('app_clients_export', filtres|filter((v, k) => k != 'page' and v)) }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-download me-1"></i>Export</a>
		</li>
	{% endif %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_clients_nouveau') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Nouveau client</a>
	</li>
	<li class="nav-item si-seul-mobile">
		<a href="{{ path('app_clients_nouveau', {mode: 'terrain'}) }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Nouveau</a>
	</li>
{% endblock %}

{% macro initiales(nom) %}{{ nom|split(' ')|filter(m => m matches '/^\\p{L}/u')|slice(0, 2)|map(m => m|first|upper)|join('') ?: '?' }}{% endmacro %}
{% macro lien(filtres, extra) %}{{ path('app_clients_index', filtres|merge({page: null})|merge(extra)|filter(v => v is not same as(null) and v is not same as('') and v is not same as(0))) }}{% endmacro %}
{% macro fmt(n) %}{{ n|number_format(0, ',', ' ') }} F{% endmacro %}
{% macro couleur(id) %}{{ ['#0F4590', '#E8590C', '#0E7C66', '#15A34A', '#6B7280', '#DB2777', '#2563EB', '#7C2D12', '#DC2626'][id % 9] }}{% endmacro %}

{% block body %}
	{% import _self as m %}
	{% set statutsCss = {actif: 'si-badge-vert', relance: 'si-badge-orange', inactif: '', nouveau: 'si-badge-bleu', bloque: 'si-badge-rouge'} %}

	<div class="row si-kpis">
		<div class="col-xl-3 col-6">
			<a class="card si-kpi" href="{{ m.lien(filtres, {statut: 'actif'}) }}"><div class="card-body">
				<span class="si-kpi-libelle">Clients actifs (12 mois)</span>
				<div class="si-kpi-valeur">{{ chiffres.actifs }}</div>
				<span class="si-tendance si-hausse">{{ chiffres.nouveaux_mois }} nouveau{{ chiffres.nouveaux_mois > 1 ? 'x' }} ce mois-ci</span>
			</div></a>
		</div>
		<div class="col-xl-3 col-6">
			<a class="card si-kpi" href="{{ path('app_prospects_index') }}"><div class="card-body">
				<span class="si-kpi-libelle">Prospects</span>
				<div class="si-kpi-valeur">{{ chiffres.prospects }}</div>
				<span class="si-tendance si-hausse">{{ chiffres.prospects_semaine }} nouveau{{ chiffres.prospects_semaine > 1 ? 'x' }} cette semaine</span>
			</div></a>
		</div>
		<div class="col-xl-3 col-6">
			<a class="card si-kpi" href="{{ m.lien(filtres, {statut: 'inactif'}) }}"><div class="card-body">
				<span class="si-kpi-libelle">Inactifs depuis 60 jours</span>
				<div class="si-kpi-valeur">{{ chiffres.inactifs }}</div>
				<span class="si-tendance {{ chiffres.inactifs > 0 ? 'si-baisse' : 'si-hausse' }}">{{ chiffres.inactifs > 0 ? 'à relancer (Campagnes)' : 'aucun' }}</span>
			</div></a>
		</div>
		{% if chiffres.creances is not null %}
			<div class="col-xl-3 col-6">
				<a class="card si-kpi" href="{{ path('app_creances_index') }}"><div class="card-body">
					<span class="si-kpi-libelle">Créances clients</span>
					<div class="si-kpi-valeur">{{ m.fmt(chiffres.creances) }}</div>
					<span class="si-tendance {{ chiffres.echu > 0 ? 'si-baisse' : 'si-hausse' }}">{{ chiffres.echu > 0 ? 'dont ' ~ m.fmt(chiffres.echu) ~ ' échus' : 'rien d’échu' }}</span>
				</div></a>
			</div>
		{% endif %}
	</div>

	<section class="card si-cl">
		<div class="si-cl-outils">
			<form method="get" action="{{ path('app_clients_index') }}" class="si-cl-recherche" role="search">
				{% for k in ['type', 'statut', 'suivi', 'tri'] %}{% if filtres[k] %}<input type="hidden" name="{{ k }}" value="{{ filtres[k] }}">{% endif %}{% endfor %}
				<i class="fas fa-search" aria-hidden="true"></i>
				<input type="search" name="q" value="{{ filtres.q }}" class="form-control form-control-sm" placeholder="Nom, téléphone, NIF…" aria-label="Rechercher un client">
			</form>
			<nav class="si-cl-types" aria-label="Type de client">
				<a href="{{ m.lien(filtres, {type: null}) }}" class="{{ not filtres.type ? 'active' }}">Tous</a>
				{% for k, l in constant('App\\Entity\\Clients::TYPES_COMPTE_LABELS') %}
					<a href="{{ m.lien(filtres, {type: k}) }}" class="{{ filtres.type == k ? 'active' }}">{{ l == 'Particulier' ? 'Particuliers' : (l == 'ONG' ? 'ONG' : l ~ 's') }}</a>
				{% endfor %}
			</nav>
			<form method="get" action="{{ path('app_clients_index') }}" class="si-cl-selects">
				{% for k in ['q', 'type'] %}{% if filtres[k] %}<input type="hidden" name="{{ k }}" value="{{ filtres[k] }}">{% endif %}{% endfor %}
				<select name="statut" class="form-select form-select-sm" aria-label="Statut" onchange="this.form.submit()">
					<option value="">Statut</option>
					{% for k, l in constant('App\\Service\\Clients\\ListeClients::STATUTS') %}<option value="{{ k }}"{{ filtres.statut == k ? ' selected' }}>{{ l }}</option>{% endfor %}
				</select>
				<select name="suivi" class="form-select form-select-sm" aria-label="Commercial" onchange="this.form.submit()">
					<option value="">Commercial</option>
					{% for u in commerciaux %}<option value="{{ u.id }}"{{ filtres.suivi == u.id ? ' selected' }}>{{ u|nom_pointage }}</option>{% endfor %}
				</select>
				<select name="tri" class="form-select form-select-sm" aria-label="Trier par" onchange="this.form.submit()">
					{% for k, l in constant('App\\Service\\Clients\\ListeClients::TRIS') %}
						{% if (k != 'ca' or is_granted('ROLE_STATS_VENTES')) and (k != 'solde' or is_granted('ROLE_PAIEMENT_VOIR')) %}<option value="{{ k }}"{{ filtres.tri == k ? ' selected' }}>Tri : {{ l }}</option>{% endif %}
					{% endfor %}
				</select>
			</form>
			<nav class="si-cl-vue" aria-label="Affichage">
				<a href="{{ m.lien(filtres, {vue: 'cartes', page: filtres.page > 1 ? filtres.page : null}) }}" class="{{ vue == 'cartes' ? 'active' }}">Cartes</a>
				<a href="{{ m.lien(filtres, {vue: 'liste', page: filtres.page > 1 ? filtres.page : null}) }}" class="{{ vue == 'liste' ? 'active' }}">Liste</a>
			</nav>
		</div>

		{% if lignes is empty %}
			<p class="si-cl-vide">{{ filtres.q ? 'Aucun client ne correspond à « ' ~ filtres.q ~ ' ».' : 'Aucun client avec ces filtres.' }} <a href="{{ path('app_clients_nouveau', filtres.q ? {nom: filtres.q} : {}) }}">Ajouter un client</a></p>
		{% elseif vue == 'cartes' %}
			<div class="si-cl-cartes">
				{% for l in lignes %}
					{% set c = l.client %}
					{% set tel = l.contact and l.contact.telephone ? l.contact.telephone : c.telephone %}
					<article class="si-cl-carte" style="--si-cl-couleur: {{ m.couleur(c.id) }}">
						<a href="{{ path('app_clients_show', {publicId: c.publicId}) }}" class="si-cl-entete">
							<span class="si-cl-avatar">{{ m.initiales(c.nomComplet) }}</span>
							<span><b>{{ c.nomComplet }}</b><small>{{ c.typeCompteLabel }}{{ l.contact ? ' · ' ~ l.contact.nom }}</small></span>
							<span class="si-badge {{ statutsCss[l.statut] }}">{{ constant('App\\Service\\Clients\\ListeClients::STATUTS')[l.statut] }}</span>
						</a>
						<div class="si-cl-chiffres">
							<div><small>CA 12 mois</small><b>{{ l.ca is null ? '•••' : (l.ca > 0 ? m.fmt(l.ca) : '—') }}</b></div>
							<div class="{{ l.du ? 'si-cl-du' }}"><small>Solde dû</small><b>{{ l.du is null ? '•••' : (l.du > 0 ? m.fmt(l.du) : '—') }}</b></div>
						</div>
						<p class="si-cl-activite"><span><i class="far fa-clock me-1"></i>{{ l.activite ? l.activite.texte ~ ' · ' ~ l.activite.date|date('d/m') : 'Aucune activité' }}</span><span>{{ l.suivi ? l.suivi|nom_pointage }}</span></p>
						<div class="si-cl-actions">
							{% if tel %}
								<a href="tel:+223{{ tel|replace({' ': ''})|slice(-8) }}" class="btn btn-light btn-sm" aria-label="Appeler {{ c.nomComplet }}"><i class="fas fa-phone"></i></a>
								<a href="https://wa.me/223{{ tel|replace({' ': ''})|slice(-8) }}" target="_blank" rel="noopener" class="btn btn-light btn-sm" aria-label="WhatsApp {{ c.nomComplet }}"><i class="fab fa-whatsapp"></i></a>
							{% endif %}
							{% if is_granted('ROLE_DEVIS') %}<a href="{{ path('app_devis_new', {client: c.id}) }}" class="btn btn-light btn-sm si-cl-devis"><i class="far fa-file-alt me-1"></i>Devis</a>{% endif %}
						</div>
					</article>
				{% endfor %}
			</div>
		{% else %}
			<div class="table-responsive">
				<table class="table si-cl-table">
					<thead>
						<tr>
							<th>Client</th>
							<th class="si-masque-mobile">Type</th>
							<th class="si-masque-mobile">Contact principal</th>
							{% if is_granted('ROLE_STATS_VENTES') %}<th class="text-end">CA 12 mois</th>{% endif %}
							<th class="si-masque-mobile">Dernière commande</th>
							{% if is_granted('ROLE_PAIEMENT_VOIR') %}<th class="text-end">Solde dû</th>{% endif %}
							<th>Statut</th>
							<th class="si-masque-mobile">Suivi par</th>
						</tr>
					</thead>
					<tbody>
						{% for l in lignes %}
							{% set c = l.client %}
							<tr onclick="if (!event.target.closest('a')) location.href = this.querySelector('a').href">
								<td><a href="{{ path('app_clients_show', {publicId: c.publicId}) }}" class="si-cl-nom"><span class="si-cl-avatar" style="--si-cl-couleur: {{ m.couleur(c.id) }}">{{ m.initiales(c.nomComplet) }}</span>{{ c.nomComplet }}</a></td>
								<td class="si-masque-mobile">{{ c.typeCompteLabel }}</td>
								<td class="si-masque-mobile">{{ l.contact ? l.contact.nom ~ (l.contact.fonction ? ' · ' ~ l.contact.fonction) : (c.organisation ? '—' : (c.telephone ? (c.telephone|length == 8 ? c.telephone|split('', 2)|join(' ') : c.telephone) : '—')) }}</td>
								{% if l.ca is not null %}<td class="text-end text-nowrap">{{ l.ca > 0 ? m.fmt(l.ca) : '—' }}</td>{% endif %}
								<td class="si-masque-mobile">{{ l.derniere ? l.derniere|date('d/m/Y') : '—' }}</td>
								{% if l.du is not null %}
									<td class="text-end text-nowrap">{% if l.du > 0 %}<b>{{ m.fmt(l.du) }}</b>{% if l.echu > 0 %}<br><small class="text-danger">{{ l.echu == l.du ? m.fmt(l.echu) ~ ' échu' : l.factures_echues ~ ' échue' ~ (l.factures_echues > 1 ? 's') }}</small>{% endif %}{% else %}—{% endif %}</td>
								{% endif %}
								<td><span class="si-badge {{ statutsCss[l.statut] }}">{{ constant('App\\Service\\Clients\\ListeClients::STATUTS')[l.statut] }}</span></td>
								<td class="si-masque-mobile">{{ l.suivi ? l.suivi|nom_pointage : '—' }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}

		<div class="si-cl-bas">
			<span>{{ lignes|length }} sur {{ total }} client{{ total > 1 ? 's' }}</span>
			{% if pages > 1 %}
				<nav class="si-cl-pages" aria-label="Pages">
					{% if page > 1 %}<a href="{{ m.lien(filtres, {page: page - 1}) }}" aria-label="Page précédente">‹</a>{% endif %}
					{% for p in 1..pages %}
						{% if p == 1 or p == pages or (p >= page - 2 and p <= page + 2) %}
							<a href="{{ m.lien(filtres, {page: p}) }}" class="{{ p == page ? 'active' }}">{{ p }}</a>
						{% elseif p == page - 3 or p == page + 3 %}<span>…</span>{% endif %}
					{% endfor %}
					{% if page < pages %}<a href="{{ m.lien(filtres, {page: page + 1}) }}" aria-label="Page suivante">›</a>{% endif %}
				</nav>
			{% endif %}
		</div>
	</section>
{% endblock %}
