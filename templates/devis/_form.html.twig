function ajouterFinitionManuelle(detail) {
const zone = detail.querySelector('.js-zone-finitions-manuelles');

if (! zone) {
return;
}


const liste = zone.querySelector('.js-liste-finitions-manuelles');

const prototype = zone.getAttribute('data-prototype');


if (! liste || ! prototype) {
return;
}


let index = Number.parseInt(zone.dataset.index || '0', 10);


if (!Number.isFinite(index)) {
index = 0;
}


const html = prototype.replace(/__finition_index__/g, String(index));


zone.dataset.index = String(index + 1);


const conteneur = document.createElement('div');

conteneur.innerHTML = html.trim();


const ligne = conteneur.firstElementChild;


if (! ligne) {
return;
}


liste.appendChild(ligne);


initialiserSelect2(ligne);


calculerDetail(detail);
}


/* =========================================================
       SELECT2
       ========================================================= */

function initialiserSelect2(scope) {
if (typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.select2 === 'undefined') {
return;
}


window.jQuery(scope).find('select.js-select-search').each(function () {

const select = window.jQuery(this);


if (select.hasClass('select2-hidden-accessible')) {
return;
}


select.select2({
width: '100%',

allowClear: true,

placeholder: select.data('placeholder') || 'Rechercher et sélectionner...',

language: {
noResults: function () {
return 'Aucun résultat trouvé';
},

searching: function () {
return 'Recherche...';
}
},

/*
 * filtrerOptions() marque les options non liees au produit
 * choisi avec option.disabled = true (Type d'impression /
 * Support / Format). Select2 construit sa propre liste
 * deroulante et ignore par defaut les attributs
 * "hidden"/"disabled" du <select> natif : sans ce matcher,
 * les options desactivees restaient visibles et
 * selectionnables dans le menu Select2, alors qu'elles ne
 * l'etaient plus dans le <select> natif.
 */
matcher: function (params, data) {
if (data.element && data.element.disabled) {
return null;
}

const terme = (params.term || '').trim().toUpperCase();

if (terme === '') {
return data;
}

const texte = (data.text || '').toUpperCase();

return texte.indexOf(terme) > -1 ? data : null;
}
});
});
}


/* =========================================================
       INITIALISATION D'UNE LIGNE
       ========================================================= */

function initialiserDetail(wrapper) {
const detail = wrapper.classList.contains('js-devis-detail') ? wrapper : wrapper.querySelector('.js-devis-detail');


if (! detail) {
console.error('Détail Devis introuvable.');

return;
}


if (detail.dataset.initialise === '1') {
return;
}


detail.dataset.initialise = '1';


initialiserSelect2(detail);


/*
         * Type ligne
         */
detail.querySelectorAll('[name$="[typeLigne]"]').forEach(function (champ) {

champ.addEventListener('change', function () {

console.log('Changement type ligne :', champ.value);

appliquerTypeLigne(detail);
});
});


/*
         * Article
         */
const article = champDetail(detail, 'article');

if (article) {
article.addEventListener('change', function () {

console.log('Article changé :', article.value);

chargerArticle(detail);
});


/*
             * Select2.
             */
if (typeof window.jQuery !== 'undefined' && typeof window.jQuery.fn.select2 !== 'undefined') {
window.jQuery(article).off('.devisArticle').on('select2:select.devisArticle select2:clear.devisArticle', function () {
chargerArticle(detail);
});
}
}


/*
         * Mode configuration
         */
detail.querySelectorAll('[name$="[modeConfiguration]"]').forEach(function (champ) {

champ.addEventListener('change', function () {

appliquerModeConfiguration(detail);


const produit = champDetail(detail, 'produit');


if (produit && produit.value) {
chargerConfigurationsProduit(detail, produit.value);
}
});
});


/*
         * Produit
         */
const produit = champDetail(detail, 'produit');

if (produit) {
const produitChange = function () {

console.log('Produit changé :', produit.value);

const optionProduit = produit.options[produit.selectedIndex];

const nomProduit = optionProduit && produit.value ? optionProduit.textContent.trim() : '';

definirValeurChamp(detail, 'designation', nomProduit, false);

/*
 * Alignement sur la commande : le prix et le mode de calcul
 * viennent directement du produit (Produits::prixBase), pas
 * d'une configuration catalogue -- chargerConfigurationsProduit()
 * ne fait que preparer un menu "Configuration" qui reste cache
 * (mode toujours "manuel", voir valeurModeConfiguration()).
 */
chargerInfosProduitBase(detail, produit.value);
};


produit.addEventListener('change', produitChange);


if (typeof window.jQuery !== 'undefined' && typeof window.jQuery.fn.select2 !== 'undefined') {
window.jQuery(produit).off('.devisProduit').on('select2:select.devisProduit select2:clear.devisProduit', produitChange);
}
}


/*
         * Configuration
         */
const configuration = champDetail(detail, 'configuration');

if (configuration) {
const configurationChange = function () {

if (valeurTypeLigne(detail) !== 'produit') {
return;
}


if (valeurModeConfiguration(detail) === 'automatique') {
chargerConfiguration(detail, configuration.value);
}
};


configuration.addEventListener('change', configurationChange);


if (typeof window.jQuery !== 'undefined' && typeof window.jQuery.fn.select2 !== 'undefined') {
window.jQuery(configuration).off('.devisConfiguration').on('select2:select.devisConfiguration select2:clear.devisConfiguration', configurationChange);
}
}


/*
         * Recalcul
         */
detail.addEventListener('input', function (event) {

if (event.target.closest('.js-calcul-detail') || event.target.closest('.js-finition-manuelle')) {
calculerDetail(detail);
}
});


detail.addEventListener('change', function (event) {

if (event.target.closest('.js-calcul-detail') || event.target.classList.contains('js-finition-selectionnee') || event.target.closest('.js-finition-manuelle')) {
calculerDetail(detail);
}
});


/*
         * Ajout finition.
         */
const ajouterFinition = detail.querySelector('.js-ajouter-finition');

if (ajouterFinition) {
ajouterFinition.addEventListener('click', function (event) {
event.preventDefault();

ajouterFinitionManuelle(detail);
});
}


/*
         * Suppression finition.
         */
detail.addEventListener('click', function (event) {

const bouton = event.target.closest('.js-supprimer-finition');

if (! bouton) {
return;
}


event.preventDefault();


const ligne = bouton.closest('.js-finition-manuelle');

if (ligne) {
ligne.remove();

calculerDetail(detail);
}
});


/*
         * Mode de calcul.
         */
const modeCalcul = champDetail(detail, 'modeCalcul');

if (modeCalcul) {
modeCalcul.addEventListener('change', function () {

if (valeurTypeLigne(detail) !== 'article') {
detail.dataset.modeDimension = ['metre', 'metre_carre'].includes(modeCalcul.value) ? 'mesure' : '';

actualiserDimensions(detail);
}


calculerDetail(detail);
});
}


/*
         * Valeurs initiales.
         */
appliquerTypeLigne(detail);


/*
         * Produit existant.
         */
if (produit && produit.value && valeurTypeLigne(detail) === 'produit') {
const configurationInitiale = configuration ? configuration.value : null;


chargerConfigurationsProduit(detail, produit.value, configurationInitiale);
}


/*
         * Article existant.
         */
if (article && article.value && valeurTypeLigne(detail) === 'article') {
chargerArticle(detail);
}


calculerDetail(detail);
}


