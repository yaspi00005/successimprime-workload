{% extends 'espace/app/_app.html.twig' %}

{% block title %}Factures et paiements{% endblock %}
{% block entete %}<a class="ec-retour" href="{{ path('app_espace_accueil') }}"><span class="fl">‹</span>Factures et paiements</a>{% endblock %}

{% block contenu %}
	<div class="ec-carte">
		<span class="ec-petit">Solde à payer</span>
		<div class="ec-solde" style="{{ solde.total > 0 ? '' : 'color:var(--vert)' }}">{{ solde.total|number_format(0, ',', ' ') }} FCFA</div>
		{% if solde.total > 0 %}
			<ul class="ec-liste">
				{% for c in solde.commandes %}
					<li class="ec-ligne"><div><b>{{ c|espace_titre }}</b><div class="ec-petit">{{ c.estSoldeOuverture ? 'Montant dû au démarrage du compte · réf. ' ~ c.numero : 'Commande ' ~ c.numero }}</div></div><a class="ec-bouton-petit" style="background:var(--orange)" href="{{ path('app_espace_payer', {id: c.publicId}) }}">Payer {{ c|espace_a_payer|number_format(0, ',', ' ') }} F</a></li>
				{% endfor %}
			</ul>
		{% elseif solde.enValidation <= 0 %}
			<p class="ec-petit" style="margin:0">Tout est réglé, merci.</p>
		{% endif %}
		{% if solde.enValidation > 0 %}<p class="ec-petit" style="margin:.5rem 0 0">{{ solde.enValidation|number_format(0, ',', ' ') }} FCFA payés par Orange Money attendent la validation de la caisse.</p>{% endif %}
	</div>

	<div class="ec-carte">
		<h2>Mes factures</h2>
		<ul class="ec-liste">
			{% for f in factures %}
				<li class="ec-ligne">
					<div><b>{{ f.numero }}{{ f.commande ? ' · ' ~ f.commande|espace_titre }}</b><div class="ec-petit"><a href="{{ path('app_espace_facture_pdf', {id: f.id}) }}" target="_blank">PDF ↓</a>{{ f.typeDocument == 'proforma' ? ' · Proforma' }}{{ f.dateFacture ? ' · ' ~ f.dateFacture|date('d/m/Y') }}</div></div>
					<div style="text-align:right;white-space:nowrap"><b>{{ f.totalTtc|number_format(0, ',', ' ') }} F</b><br>
						{% set p = f.statutPaiement %}<span class="ec-pastille {{ p == 'payee' ? 'vert' : (p == 'partielle' ? 'ambre' : 'rouge') }}">{{ p == 'payee' ? 'Payée' : (p == 'partielle' ? 'Acompte reçu' : 'À payer') }}</span>
					</div>
				</li>
			{% else %}
				<li class="ec-petit">Pas encore de facture.</li>
			{% endfor %}
		</ul>
	</div>
{% endblock %}
