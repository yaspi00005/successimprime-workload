{% extends 'base.html.twig' %}

{% set titre_travail = detail.designation|default(detail.produit.nom|default('Travail')) %}
{% set largeur_cm = detail.largeur ? (detail.largeur * 100)|round(1) : null %}
{% set hauteur_cm = detail.longueur ? (detail.longueur * 100)|round(1) : null %}
{% set dernier = detail.dernierControlePrePresse %}
{% set statuts_controle = {
	'a_controler': ['À contrôler', 'secondary'],
	'en_cours': ['En cours', 'info'],
	'correction_requise': ['Correction demandée', 'danger'],
	'en_attente_bat': ['BAT envoyé, en attente du client', 'warning'],
	'valide': ['Validé', 'success'],
	'rejete': ['Rejeté', 'danger'],
	'envoye_production': ['Envoyé en production', 'success']
} %}

{% block title %}Prépresse · {{ titre_travail }}{% if largeur_cm and hauteur_cm %} {{ largeur_cm|number_format(0, ',', ' ') }} × {{ hauteur_cm|number_format(0, ',', ' ') }}{% endif %} · {{ commande.clients ? commande.clients.nomComplet : 'Client' }}{% endblock %}

{# Version affichée et envoi du BAT : dans l'en-tête sur grand écran, dans une
   barre au-dessus de l'aperçu sur tablette et téléphone, où l'en-tête n'a pas
   la place (il poussait le menu du compte hors de l'écran). #}
{% macro choix_version(versions, fichierAffiche, suffixe) %}
	<form method="get" class="si-pp-version">
		<label class="visually-hidden" for="pp-version{{ suffixe }}">Version affichée</label>
		<select id="pp-version{{ suffixe }}" name="fichier" class="form-select form-select-sm" onchange="this.form.submit()">
			{% for fichier in versions %}
				<option value="{{ fichier.id }}" {{ fichierAffiche and fichier.id == fichierAffiche.id ? 'selected' }}>
					Version {{ fichier.version }}{{ fichier.etat in ['traite', 'pret_impression'] ? ' · corrigée' }}{{ fichier.face ? ' · ' ~ fichier.face }}
				</option>
			{% endfor %}
		</select>
	</form>
{% endmacro %}

{% macro bouton_bat() %}
	<button type="submit" form="form-controle-pre-presse" name="action" value="envoyer_bat" class="btn btn-danger btn-sm si-btn-entete bouton-controle" data-message="Envoyer cette version du BAT au client ? Le travail attendra sa réponse.">
		<i class="fas fa-paper-plane me-1"></i>Envoyer le BAT au client
	</button>
{% endmacro %}

{% block header_actions %}
	{% if versions is not empty %}
		<li class="nav-item si-prepresse-entete">{{ _self.choix_version(versions, fichierAffiche, '') }}</li>
		<li class="nav-item si-prepresse-entete">{{ _self.bouton_bat() }}</li>
	{% endif %}
	<li class="nav-item si-masque-mobile si-prepresse-entete"><a href="{{ path('app_montage_outil', {ligne: detail.id}) }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-th-large me-1"></i>Monter</a></li>
{% endblock %}

{% block body %}
	{% for bat in app.flashes('bat_whatsapp') %}
		<div class="alert alert-success d-flex flex-wrap align-items-center gap-2">
			<span class="me-auto">Prévenez le client que son BAT l'attend.</span>
			<a class="btn btn-success btn-sm" href="https://wa.me/{{ bat.numero }}?text={{ bat.message|url_encode }}" target="_blank" rel="noopener"><i class="fab fa-whatsapp me-1"></i>Envoyer par WhatsApp</a>
		</div>
	{% endfor %}

	<div class="si-prepresse-barre">
		{% if versions is not empty %}
			{{ _self.choix_version(versions, fichierAffiche, '-barre') }}
			{{ _self.bouton_bat() }}
		{% endif %}
		<a href="{{ path('app_montage_outil', {ligne: detail.id}) }}" class="btn btn-light btn-sm si-btn-entete si-masque-mobile"><i class="fas fa-th-large me-1"></i>Monter</a>
	</div>

	<div class="si-prepresse">
		{# ---------- Aperçu du fichier, cotes de la commande ---------- #}
		<section class="si-pp-apercu" aria-label="Aperçu du fichier">
			{% if fichierAffiche %}
				<figure class="si-pp-planche">
					<div class="si-pp-cote-v">{% if hauteur_cm %}<span>{{ hauteur_cm|number_format(hauteur_cm == hauteur_cm|round ? 0 : 1, ',', ' ') }} cm</span>{% endif %}</div>
					{% if typeApercu == 'image' %}
						<img src="{{ path('app_controle_pre_presse_visualiser_fichier', {id: fichierAffiche.id}) }}" alt="Version {{ fichierAffiche.version }} : {{ fichierAffiche.nomOriginal }}">
					{% elseif typeApercu == 'pdf' %}
						<iframe src="{{ path('app_controle_pre_presse_visualiser_fichier', {id: fichierAffiche.id}) }}#toolbar=0&view=Fit" title="Version {{ fichierAffiche.version }}"></iframe>
					{% else %}
						<div class="si-pp-sans-apercu">
							<i class="fas fa-file-alt"></i>
							<strong>{{ fichierAffiche.nomOriginal }}</strong>
							<span>Pas d'aperçu pour ce type de fichier : téléchargez-le pour l'ouvrir.</span>
						</div>
					{% endif %}
					<figcaption class="si-pp-cote-h">{% if largeur_cm %}{{ largeur_cm|number_format(largeur_cm == largeur_cm|round ? 0 : 1, ',', ' ') }} cm{% endif %}</figcaption>
				</figure>
				<div class="si-pp-fichier">
					<span><strong>{{ fichierAffiche.nomOriginal }}</strong> · version {{ fichierAffiche.version }}{% if fichierAffiche.taille %} · {{ (fichierAffiche.taille / 1048576)|number_format(1, ',', ' ') }} Mo{% endif %}</span>
					<span>
						<a href="{{ path('app_controle_pre_presse_visualiser_fichier', {id: fichierAffiche.id}) }}" target="_blank" rel="noopener"><i class="fas fa-expand me-1"></i>Plein écran</a>
						<a href="{{ path('app_controle_pre_presse_telecharger_fichier', {id: fichierAffiche.id}) }}"><i class="fas fa-download me-1"></i>Original</a>
					</span>
				</div>
			{% else %}
				<div class="si-pp-sans-apercu"><i class="fas fa-inbox"></i><span>Aucun fichier reçu pour ce travail.</span></div>
			{% endif %}
		</section>

		<div class="si-pp-cote-droit">
			{# ---------- Contrôle automatique ---------- #}
			<section class="card si-pp-carte">
				<h2>Contrôle automatique du fichier</h2>
				{% if analyse is empty %}
					<p class="text-muted mb-0">Le fichier n'est pas lisible sur le serveur : vérifiez-le à la main.</p>
				{% endif %}
				<ul class="si-pp-controles">
					{% for c in analyse %}
						<li>
							<span><strong>{{ c.libelle }}</strong><small>{{ c.valeur }}</small></span>
							<span class="si-pp-etat si-pp-{{ c.etat }}">{{ {ok: 'OK', attention: 'Attention', erreur: 'À corriger', a_verifier: 'À vérifier'}[c.etat] }}</span>
						</li>
					{% endfor %}
				</ul>
			</section>

			{# ---------- BAT annoté ---------- #}
			<section class="card si-pp-carte">
				<h2>BAT annoté
					{% if dernier %}<span class="badge bg-{{ statuts_controle[dernier.statut][1]|default('secondary') }}">{{ statuts_controle[dernier.statut][0]|default(dernier.statut) }}</span>{% endif %}
				</h2>
				<dl class="si-pp-fiche">
					<div><dt>Support</dt><dd>{{ detail.support.nom|default(detail.produitConfiguration.support.nom|default('—')) }}</dd></div>
					<div><dt>Machine</dt><dd>{{ detail.machine.nom|default('À choisir') }}</dd></div>
					<div><dt>Finition</dt><dd>
						{% for f in detail.finitions %}{{ f.nomFinition }}{{ not loop.last ? ' + ' }}{% else %}Aucune{% endfor %}
					</dd></div>
					<div><dt>Quantité</dt><dd>{{ detail.quantite|number_format(0, ',', ' ') }}</dd></div>
				</dl>
				{% if dernier and (dernier.anomalies or dernier.correctionsEffectuees) %}
					<p class="si-pp-note">
						{% if dernier.anomalies %}<span class="si-pp-puce">1</span><strong>Demande :</strong> « {{ dernier.anomalies }} »{% endif %}
						{% if dernier.correctionsEffectuees %} → {{ dernier.correctionsEffectuees }}{% endif %}
					</p>
				{% endif %}
				{% if detail.observation %}
					<p class="si-pp-note"><strong>Consigne de la commande :</strong> {{ detail.observation }}</p>
				{% endif %}
				{% if detail.controlesPrePresse is not empty %}
					<p class="si-pp-historique">Historique{{ detail.controlesPrePresse|length > 5 ? ' (5 derniers)' }} :
						{% for c in detail.controlesPrePresse|slice(0, 5)|reverse %}
							{{ c.statut == 'en_attente_bat' ? 'BAT envoyé' : statuts_controle[c.statut][0]|default(c.statut) }} {{ c.creeLe|date('d/m H:i') }}{% if c.controlePar %} par {{ c.controlePar.userIdentifier }}{% endif %}{{ not loop.last ? ' · ' }}
						{% endfor %}
					</p>
				{% endif %}
			</section>
		</div>
	</div>

	{# Formulaire autonome d'ajout d'un fichier traité.
	   Il est déclaré ici pour éviter d'imbriquer deux formulaires HTML. #}
	{% set jetonTemporaireFichierTraite = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' %}
	{% set indexTemporaireFichierTraite = 999999999 %}
	{% set modeleUrlMorceauFichierTraite = path('app_controle_pre_presse_fichier_traite_morceau', {jeton: jetonTemporaireFichierTraite, index: indexTemporaireFichierTraite})|replace({(jetonTemporaireFichierTraite): '__JETON__', (indexTemporaireFichierTraite ~ ''): '__INDEX__'}) %}
	<form id="form-fichier-traite" method="post" enctype="multipart/form-data" action="{{ path('app_controle_pre_presse_ajouter_fichier_traite', {id: detail.id}) }}" data-upload-initialiser-url="{{ path('app_controle_pre_presse_fichier_traite_initialiser', {id: detail.id}) }}" data-upload-morceau-url="{{ modeleUrlMorceauFichierTraite }}"></form>

	{# Cases pré-cochées quand le contrôle automatique est bon. #}
	{% set auto_ok = [] %}
	{% for c in analyse %}
		{% if c.etat == 'ok' %}
			{% set auto_ok = auto_ok|merge([{
				'Mode colorimétrique': 'profilCouleursConforme',
				'Polices': 'policesConformes',
				'Ratio des dimensions': 'dimensionsConformes'
			}[c.libelle]|default(c.libelle starts with 'Résolution' ? 'resolutionConforme' : '')]) %}
		{% endif %}
	{% endfor %}

	<form method="post" id="form-controle-pre-presse" class="si-pp-formulaire">
		<input type="hidden" name="_token" value="{{ csrf_token('controle_pre_presse_' ~ detail.id) }}">

		<section class="card si-pp-carte">
			<div class="si-pp-carte-tete">
				<h2>Fichiers contrôlés</h2>
				<label class="form-check mb-0">
					<input type="checkbox" class="form-check-input" id="selectionner-tous-fichiers">
					<span class="form-check-label">Tout sélectionner</span>
				</label>
			</div>
			<ul class="si-pp-fichiers">
				{% for fichier in versions %}
					<li>
						<label class="form-check mb-0">
							<input type="checkbox" class="form-check-input fichier-checkbox" id="fichier-{{ fichier.id }}" name="fichiers[]" value="{{ fichier.id }}" {{ fichierAffiche and fichier.id == fichierAffiche.id ? 'checked' }}>
							<span class="form-check-label">
								<strong>V{{ fichier.version }} · {{ fichier.nomOriginal }}</strong>
								<small>
									{{ fichier.etat|replace({'_': ' '})|capitalize }}{{ fichier.face ? ' · ' ~ fichier.face }}{{ fichier.designation ? ' · ' ~ fichier.designation }}
									· {% if fichier.estPretPourImpression %}prêt pour impression{% elseif fichier.estUploadTermine %}reçu{% else %}<span class="text-warning">envoi en cours</span>{% endif %}
								</small>
							</span>
						</label>
						<a href="{{ path('app_controle_pre_presse_controler', {id: detail.id, fichier: fichier.id}) }}" class="btn btn-light btn-sm">Voir</a>
					</li>
				{% endfor %}
			</ul>
			<details class="si-plus-options">
				<summary>Ajouter une version corrigée</summary>
				<input form="form-fichier-traite" type="hidden" name="_token" value="{{ csrf_token('ajouter_fichier_traite_' ~ detail.id) }}">
				<div class="row g-3 mt-1">
					<div class="col-md-6">
						<label for="fichierSource" class="form-label">Fichier original corrigé <span class="text-danger">*</span></label>
						<select form="form-fichier-traite" class="form-select" id="fichierSource" name="fichierSource" required>
							<option value="">Choisir l'original</option>
							{% for fichier in versions|filter(f => f.etat == 'original') %}
								<option value="{{ fichier.id }}">{{ fichier.nomOriginal|default('Fichier sans nom') }}{{ fichier.face ? ' — ' ~ fichier.face|capitalize }} — version {{ fichier.version }}</option>
							{% else %}
								<option value="" disabled>Aucun fichier original</option>
							{% endfor %}
						</select>
					</div>
					<div class="col-md-6">
						<label for="fichierTraite" class="form-label">Fichier corrigé <span class="text-danger">*</span></label>
						<input form="form-fichier-traite" type="file" class="form-control" id="fichierTraite" name="fichierTraite" required>
					</div>
					<div class="col-md-4">
						<label for="faceTraitee" class="form-label">Face</label>
						<select form="form-fichier-traite" class="form-select" id="faceTraitee" name="face">
							<option value="">Même face que l'original</option>
							<option value="recto">Recto</option>
							<option value="verso">Verso</option>
							<option value="recto-verso">Recto-verso</option>
							<option value="devant">Devant</option>
							<option value="dos">Dos</option>
							<option value="autre">Autre</option>
						</select>
					</div>
					<div class="col-md-8">
						<label for="designationFichier" class="form-label">Désignation</label>
						<input form="form-fichier-traite" type="text" class="form-control" id="designationFichier" name="designation" placeholder="Exemple : logo agrandi de 20 %">
					</div>
					<div class="col-12">
						<label for="observationFichier" class="form-label">Corrections faites</label>
						<textarea form="form-fichier-traite" class="form-control" id="observationFichier" name="observation" rows="2"></textarea>
					</div>
					<div class="col-12 text-end">
						<button form="form-fichier-traite" type="submit" class="btn btn-primary"><i class="fas fa-upload me-1"></i>Ajouter la version</button>
					</div>
				</div>
			</details>
		</section>

		<section class="card si-pp-carte">
			<div class="si-pp-carte-tete">
				<h2>Contrôle de l'infographiste</h2>
				<button type="button" class="btn btn-sm btn-outline-success" id="cocher-tous-controles"><i class="fas fa-check me-1"></i>Tout cocher</button>
			</div>
			<div class="si-pp-etat-fichier">
				<label class="form-check"><input type="checkbox" class="form-check-input" id="fichierDejaTraite" name="fichierDejaTraite" value="1"><span class="form-check-label">Fichier déjà prêt (contrôle rapide)</span></label>
				<label class="form-check"><input type="checkbox" class="form-check-input" id="correctionNecessaire" name="correctionNecessaire" value="1"><span class="form-check-label">Correction nécessaire avant validation</span></label>
			</div>
			{% set controlesTechniques = {
				'formatConforme': 'Format du fichier',
				'dimensionsConformes': 'Dimensions',
				'resolutionConforme': 'Résolution',
				'profilCouleursConforme': 'Profil de couleurs',
				'fondsPerdusConformes': 'Fonds perdus',
				'margesSecuriteConformes': 'Zone de sécurité',
				'policesConformes': 'Polices vectorisées',
				'orthographeVerifiee': 'Orthographe relue',
				'orientationConforme': 'Orientation',
				'nombrePagesConforme': 'Nombre de pages',
				'rectoVersoConforme': 'Recto-verso',
				'supportConforme': 'Support',
				'quantiteConforme': 'Quantité'
			} %}
			<div class="si-pp-cases">
				{% for champ, libelle in controlesTechniques %}
					<label class="form-check">
						<input type="checkbox" class="form-check-input controle-technique" id="{{ champ }}" name="{{ champ }}" value="1" {{ champ in auto_ok ? 'checked' }}>
						<span class="form-check-label">{{ libelle }}</span>
					</label>
				{% endfor %}
			</div>
			<div class="row g-3">
				<div class="col-md-6">
					<label for="anomalies" class="form-label">Demandes et anomalies</label>
					<textarea class="form-control" id="anomalies" name="anomalies" rows="3" placeholder="Exemple : agrandir le logo de 20 %"></textarea>
				</div>
				<div class="col-md-6">
					<label for="correctionsEffectuees" class="form-label">Corrections faites</label>
					<textarea class="form-control" id="correctionsEffectuees" name="correctionsEffectuees" rows="3" placeholder="Exemple : corrigé en version 2"></textarea>
				</div>
				<div class="col-12">
					<label for="observation" class="form-label">Observation</label>
					<textarea class="form-control" id="observation" name="observation" rows="2"></textarea>
				</div>
			</div>
			<div class="si-pp-etat-fichier mt-3">
				<label class="form-check"><input type="checkbox" class="form-check-input" id="batNecessaire" name="batNecessaire" value="1" {{ dernier and dernier.batNecessaire ? 'checked' }}><span class="form-check-label">BAT nécessaire</span></label>
				<label class="form-check"><input type="checkbox" class="form-check-input" id="batValide" name="batValide" value="1" {{ not (dernier and dernier.batNecessaire) ? 'disabled' }}><span class="form-check-label">BAT validé par le client</span></label>
			</div>
		</section>

		{% if controleCredit %}
			<section class="card si-pp-carte">
				<div class="alert alert-{{ controleCredit.autorise|default(false) ? 'success' : 'danger' }} mb-0">
					<i class="fas fa-{{ controleCredit.autorise|default(false) ? 'check-circle' : 'lock' }} me-1"></i>
					<strong>{{ controleCredit.autorise|default(false) ? 'Production autorisée.' : 'Production bloquée.' }}</strong>
					{# Le motif cite des montants : réservé à qui voit la caisse. #}
					{% if is_granted('ROLE_PAIEMENT_VOIR') %}
						{{ controleCredit.motif|default(controleCredit.autorise|default(false) ? '' : 'La situation du client ne permet pas l\'envoi en production.') }}
					{% elseif not controleCredit.autorise|default(false) %}
						Le compte du client doit être régularisé à la caisse avant l'impression.
					{% endif %}
				</div>
				{% if is_granted('ROLE_PAIEMENT_VOIR') %}
					<details class="si-plus-options mt-2">
						<summary>Situation du client</summary>
						<dl class="si-pp-fiche si-pp-fiche-4">
							<div><dt>Ancienneté</dt><dd>{{ controleCredit.ancienneteMois|default(0) }} mois</dd></div>
							<div><dt>Plafond</dt><dd>{{ controleCredit.plafondCredit|default(0)|number_format(0, ',', ' ') }} F</dd></div>
							<div><dt>Encours antérieur</dt><dd class="{{ controleCredit.encoursAnterieur|default(0) > controleCredit.plafondCredit|default(0) ? 'text-danger' }}">{{ controleCredit.encoursAnterieur|default(0)|number_format(0, ',', ' ') }} F</dd></div>
							<div><dt>Crédit disponible</dt><dd>{{ controleCredit.creditDisponible|default(0)|number_format(0, ',', ' ') }} F</dd></div>
							<div><dt>Commande</dt><dd>{{ controleCredit.totalCommande|default(0)|number_format(0, ',', ' ') }} F</dd></div>
							<div><dt>Avance</dt><dd class="text-success">{{ controleCredit.avanceCommande|default(0)|number_format(0, ',', ' ') }} F</dd></div>
							<div><dt>Reste</dt><dd>{{ controleCredit.resteCommande|default(0)|number_format(0, ',', ' ') }} F</dd></div>
							<div><dt>Impayées antérieures</dt><dd>{{ controleCredit.nombreCommandesAnterieuresImpayees|default(0) }}</dd></div>
						</dl>
					</details>
				{% endif %}
			</section>
		{% endif %}

		<div class="si-pp-actions">
			<a href="{{ path('app_controle_pre_presse_index') }}" class="btn btn-light me-auto"><i class="fas fa-arrow-left me-1"></i>Liste prépresse</a>
			<button type="submit" name="action" value="enregistrer" class="btn btn-outline-secondary bouton-controle" data-message="Enregistrer ce contrôle prépresse ?"><i class="fas fa-save me-1"></i>Enregistrer</button>
			<button type="submit" name="action" value="valider" class="btn btn-primary bouton-controle" data-message="Valider ce contrôle prépresse ? Le travail n'est pas encore envoyé en production."><i class="fas fa-check-circle me-1"></i>Valider</button>
			{% if controleCredit is null or controleCredit.autorise|default(false) %}
				<button type="submit" name="action" value="valider_production" class="btn btn-success bouton-controle" data-message="Valider et envoyer les fichiers en production ?"><i class="fas fa-print me-1"></i>Valider et envoyer en production</button>
			{% else %}
				<button type="button" class="btn btn-danger" disabled title="Compte du client à régulariser à la caisse"><i class="fas fa-lock me-1"></i>Production bloquée</button>
			{% endif %}
		</div>
	</form>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="{{ asset('vendor/sweetalert2/sweetalert2.all.min.js') }}"></script>
	<script>
		// Sans accès au CDN (serveur local hors ligne), les boîtes du navigateur prennent le relais.
		if (typeof window.Swal === 'undefined') {
			window.Swal = {fire: function (o) {
				return Promise.resolve({isConfirmed: o.showCancelButton ? window.confirm(o.text) : (window.alert(o.text), true)});
			}};
		}
		document.addEventListener('DOMContentLoaded', function () {
const selectionTous = document.getElementById('selectionner-tous-fichiers');

const fichiers = document.querySelectorAll('.fichier-checkbox');

const boutonToutCocher = document.getElementById('cocher-tous-controles');

const controles = document.querySelectorAll('.controle-technique');

const fichierDejaTraite = document.getElementById('fichierDejaTraite');

const correctionNecessaire = document.getElementById('correctionNecessaire');

const batNecessaire = document.getElementById('batNecessaire');

const batValide = document.getElementById('batValide');

const formulaire = document.getElementById('form-controle-pre-presse');

let boutonClique = null;

/* Sélectionner tous les fichiers */
if (selectionTous) {
selectionTous.addEventListener('change', function () {
fichiers.forEach(function (fichier) {
fichier.checked = selectionTous.checked;
});
});
}

/* Cocher ou décocher tous les contrôles */
if (boutonToutCocher) {
boutonToutCocher.addEventListener('click', function () {
const tousCoches = Array.from(controles).every(function (controle) {
return controle.checked;
});

controles.forEach(function (controle) {
controle.checked = ! tousCoches;
});

boutonToutCocher.innerHTML = tousCoches ? '<i class="fe fe-check mr-1"></i> Tout cocher' : '<i class="fe fe-x mr-1"></i> Tout décocher';
});
}

/* Les deux circuits sont incompatibles */
if (fichierDejaTraite && correctionNecessaire) {
fichierDejaTraite.addEventListener('change', function () {
if (fichierDejaTraite.checked) {
correctionNecessaire.checked = false;
}
});

correctionNecessaire.addEventListener('change', function () {
if (correctionNecessaire.checked) {
fichierDejaTraite.checked = false;
}
});
}

/* Activer la validation BAT seulement si nécessaire */
if (batNecessaire && batValide) {
batNecessaire.addEventListener('change', function () {
batValide.disabled = ! batNecessaire.checked;

if (! batNecessaire.checked) {
batValide.checked = false;
}
});
}

document.querySelectorAll('.bouton-controle').forEach(function (bouton) {
bouton.addEventListener('click', function () {
boutonClique = bouton;
});
});

if (formulaire) {
formulaire.addEventListener('submit', function (event) {
event.preventDefault();

const nombreFichiersSelectionnes = document.querySelectorAll('.fichier-checkbox:checked').length;

if (nombreFichiersSelectionnes === 0) {
Swal.fire({icon: 'warning', title: 'Aucun fichier sélectionné', text: 'Sélectionnez au moins un fichier à contrôler.'});

return;
}

const message = boutonClique ? boutonClique.dataset.message : 'Enregistrer ce contrôle prépresse ?';

Swal.fire({
icon: 'question',
title: 'Confirmation',
text: message,
showCancelButton: true,
confirmButtonText: 'Oui, continuer',
cancelButtonText: 'Annuler',
confirmButtonColor: '#28a745',
cancelButtonColor: '#6c757d'
}).then(function (resultat) {
if (! resultat.isConfirmed) {
return;
}

/*
                         * requestSubmit(boutonClique) conserve la valeur
                         * du bouton action : enregistrer, valider ou
                         * valider_production.
                         */
formulaire.removeEventListener('submit', arguments.callee);

if (boutonClique) {
const action = document.createElement('input');

action.type = 'hidden';
action.name = 'action';
action.value = boutonClique.value;

formulaire.appendChild(action);
}

formulaire.submit();
});
});
}
});
document.addEventListener('DOMContentLoaded', function () {
/*
 * ============================================================
 * ENVOI PAR MORCEAUX (fichier traité)
 * ============================================================
 *
 * Les champs de ce formulaire ("fichierTraite", "fichierSource"...)
 * ne sont pas imbriqués dans <form id="form-fichier-traite"> : ils y
 * sont rattachés via l'attribut form="form-fichier-traite" (pour
 * éviter d'imbriquer deux <form> HTML sur cette page). Il faut donc
 * les retrouver par leur id ou par [form="form-fichier-traite"],
 * jamais par formulaire.querySelector(...).
 */
const formulaireFichierTraite = document.getElementById('form-fichier-traite');

if (!formulaireFichierTraite) {
return;
}

const initialiserUrl = formulaireFichierTraite.dataset.uploadInitialiserUrl;
const morceauUrlModele = formulaireFichierTraite.dataset.uploadMorceauUrl;

if (!initialiserUrl || !morceauUrlModele) {
return;
}

const TAILLE_MORCEAU_FICHIER_TRAITE = 5 * 1024 * 1024;

function construireUrlMorceauFichierTraite(jeton, index) {
return morceauUrlModele
.replace('__JETON__', jeton)
.replace('__INDEX__', String(index));
}

formulaireFichierTraite.addEventListener('submit', function (event) {
const champFichier = document.getElementById('fichierTraite');

if (!champFichier || !champFichier.files || !champFichier.files.length) {
return;
}

event.preventDefault();

const fichier = champFichier.files[0];

const champToken = document.querySelector('[form="form-fichier-traite"][name="_token"]');
const bouton = document.querySelector('[form="form-fichier-traite"][type="submit"]');
const champFichierSource = document.getElementById('fichierSource');
const champFace = document.getElementById('faceTraitee');
const champDesignation = document.getElementById('designationFichier');
const champObservation = document.getElementById('observationFichier');

const texteBoutonInitial = bouton ? bouton.innerHTML : '';

if (bouton) {
bouton.disabled = true;
bouton.innerHTML = '<i class="fa fa-spinner fa-spin mr-1"></i> Envoi en cours... 0 %';
}

(async function () {
try {

const jetonCsrf = champToken ? champToken.value : '';

const nombreMorceaux = Math.max(
1,
Math.ceil(fichier.size / TAILLE_MORCEAU_FICHIER_TRAITE)
);

const reponseInit = await fetch(initialiserUrl, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'X-CSRF-TOKEN': jetonCsrf,
Accept: 'application/json'
},
body: JSON.stringify({
nom: fichier.name,
typeMime: fichier.type || 'application/octet-stream',
taille: fichier.size,
nombreMorceaux: nombreMorceaux,
fichierSource: champFichierSource ? champFichierSource.value : '',
face: champFace ? champFace.value : '',
designation: champDesignation ? champDesignation.value : '',
observation: champObservation ? champObservation.value : ''
})
});

const donneesInit = await reponseInit.json();

if (!reponseInit.ok || !donneesInit.jeton) {
throw new Error(donneesInit.message || "Impossible d'initialiser l'envoi.");
}

const jeton = donneesInit.jeton;

for (let index = 0; index < nombreMorceaux; index++) {

const debut = index * TAILLE_MORCEAU_FICHIER_TRAITE;
const fin = Math.min(fichier.size, debut + TAILLE_MORCEAU_FICHIER_TRAITE);

const donneesMorceauFormulaire = new FormData();
donneesMorceauFormulaire.append('morceau', fichier.slice(debut, fin), fichier.name);

const reponseMorceau = await fetch(construireUrlMorceauFichierTraite(jeton, index), {
method: 'POST',
headers: {
'X-CSRF-TOKEN': jetonCsrf
},
body: donneesMorceauFormulaire
});

const donneesMorceau = await reponseMorceau.json();

if (!reponseMorceau.ok) {
throw new Error(donneesMorceau.message || "L'envoi du fichier a été interrompu.");
}

const progression = typeof donneesMorceau.progression === 'number'
? donneesMorceau.progression
: Math.round(((index + 1) / nombreMorceaux) * 100);

if (bouton) {
bouton.innerHTML = '<i class="fa fa-spinner fa-spin mr-1"></i> Envoi en cours... ' + progression + ' %';
}
}

window.location.reload();

} catch (erreur) {

console.error(erreur);

const messageErreur = erreur.message || 'Une erreur est survenue pendant l’envoi du fichier.';

if (typeof window.Swal !== 'undefined') {
window.Swal.fire({
icon: 'error',
title: 'Échec de l’envoi',
text: messageErreur
});
} else {
window.alert(messageErreur);
}

if (bouton) {
bouton.disabled = false;
bouton.innerHTML = texteBoutonInitial;
}
}
})();
});
});
	</script>
