{% extends 'base.html.twig' %}

{% block title %}
	{{ article.designation }}
{% endblock %}

{% block body %}

	<div
		class="side-app">

		{# ==========================================================
				       EN-TÊTE
				       ========================================================== #}

		<div class="page-header">

			<ol class="breadcrumb">

				<li class="breadcrumb-item">
					<a href="{{ path('app_article_index') }}">
						Articles
					</a>
				</li>

				<li class="breadcrumb-item active">
					{{ article.reference }}
				</li>

			</ol>

			<div>

				<a href="{{ path( 'app_article_edit', { id: article.id } ) }}" class="btn btn-warning-light">
					<i class="fa fa-edit mr-1"></i>
					Modifier
				</a>

			</div>

		</div>


		{# ==========================================================
				       INFORMATIONS ARTICLE
				       ========================================================== #}

		<div class="card">

			<div class="card-header">

				<div class="card-title">

					<i class="fa fa-cube mr-2"></i>

					{{ article.reference }}
					—
					{{ article.designation }}

				</div>

			</div>

			<div
				class="card-body">


				{# ==================================================
								               SOLDES
								               ================================================== #}

				<div class="row">

					<div class="col-lg-3 col-md-6">

						<div class="card">

							<div class="card-body text-center">

								<small class="text-muted d-block">
									Stock physique
								</small>

								<div class="h2 mb-0">

									{{ stockPhysique
                                    |number_format(
                                        3,
                                        ',',
                                        ' '
                                    )
                                }}

								</div>

								<small class="text-muted">
									{{ article.unite }}
								</small>

							</div>

						</div>

					</div>


					<div class="col-lg-3 col-md-6">

						<div class="card">

							<div class="card-body text-center">

								<small class="text-muted d-block">
									Réservé
								</small>

								<div class="h2 text-warning mb-0">

									{{ stockReserve
                                    |number_format(
                                        3,
                                        ',',
                                        ' '
                                    )
                                }}

								</div>

								<small class="text-muted">
									{{ article.unite }}
								</small>

							</div>

						</div>

					</div>


					<div class="col-lg-3 col-md-6">

						<div class="card">

							<div class="card-body text-center">

								<small class="text-muted d-block">
									Disponible
								</small>

								<div class="h2 mb-0
																				                                {{
																				                                    stockDisponible <= 0
																				                                        ? 'text-danger'
																				                                        : 'text-success'
																				                                }}">

									{{ stockDisponible
                                    |number_format(
                                        3,
                                        ',',
                                        ' '
                                    )
                                }}

								</div>

								<small class="text-muted">
									{{ article.unite }}
								</small>

							</div>

						</div>

					</div>


					<div class="col-lg-3 col-md-6">

						<div class="card">

							<div class="card-body text-center">

								<small class="text-muted d-block">
									Seuil d’alerte
								</small>

								<div class="h2 mb-0">

									{{ article.stockMin
                                    |number_format(
                                        3,
                                        ',',
                                        ' '
                                    )
                                }}

								</div>

								<small class="text-muted">
									{{ article.unite }}
								</small>

							</div>

						</div>

					</div>

				</div>


				{# ==================================================
								               INFORMATIONS
								               ================================================== #}

				<div class="table-responsive">

					<table class="table table-bordered">

						<tbody>

							<tr>

								<th width="220">
									Référence
								</th>

								<td>
									{{ article.reference }}
								</td>

							</tr>


							<tr>

								<th>
									Désignation
								</th>

								<td>
									{{ article.designation }}
								</td>

							</tr>


							<tr>

								<th>
									Catégorie
								</th>

								<td>
									{{ article.categorie|default('—') }}
								</td>

							</tr>


							<tr>

								<th>
									Unité
								</th>

								<td>
									{{ article.unite }}
								</td>

							</tr>


							<tr>

								<th>
									Prix d’achat
								</th>

								<td>

									{% if article.prixAchat is not null %}

										{{ article.prixAchat
                                    |number_format(
                                        0,
                                        ',',
                                        ' '
                                    )
                                }}
										FCFA

									{% else %}

										—

									{% endif %}

								</td>

							</tr>


							<tr>

								<th>
									Prix de vente
								</th>

								<td>

									{% if article.prixVente is not null %}

										{{ article.prixVente
                                    |number_format(
                                        0,
                                        ',',
                                        ' '
                                    )
                                }}
										FCFA

									{% else %}

										—

									{% endif %}

								</td>

							</tr>


							<tr>

								<th>
									Fournisseur
								</th>

								<td>
									{% if article.fournisseur %}
										<a href="{{ path('app_fournisseur_show', {id: article.fournisseur.id}) }}">
											{{ article.fournisseur.nom }}
										</a>
									{% else %}
										—
									{% endif %}
								</td>

							</tr>


							{% if article.description %}

								<tr>

									<th>
										Description
									</th>

									<td>
										{{ article.description|nl2br }}
									</td>

								</tr>

							{% endif %}

						</tbody>

					</table>

				</div>


				<div class="mt-4">

					<a href="{{ path( 'app_stock_etat_show', { id: article.id } ) }}" class="btn btn-primary">

						<i class="fa fa-exchange mr-1"></i>

						Voir les mouvements de stock

					</a>

				</div>

			</div>

		</div>


		{# ==========================================================
				       NOUVELLE ENTRÉE DE STOCK
				       ========================================================== #}

		<div class="card">

			<div class="card-header">

				<div class="card-title">

					<i class="fa fa-arrow-down text-success mr-2"></i>

					Nouvelle entrée de stock

				</div>

			</div>

			<div class="card-body">

				<form method="post" action="{{ path( 'app_article_entree_stock', { id: article.id } ) }}">

					<input type="hidden" name="_token" value="{{ csrf_token( 'entree_stock_' ~ article.id ) }}">


					<div
						class="row">

						{# ==========================================
												                       QUANTITÉ
												                       ========================================== #}

						<div class="col-lg-3 col-md-6">

							<div class="form-group">

								<label>
									Quantité
								</label>

								<input type="number" name="quantite" class="form-control" min="0.001" step="0.001" required placeholder="0">

								<small class="form-text text-muted">

									Unité :
									<strong>
										{{ article.unite }}
									</strong>

								</small>

							</div>

						</div>


						{# ==========================================
												                       PRIX
												                       ========================================== #}

						<div class="col-lg-3 col-md-6">

							<div class="form-group">

								<label>
									Prix d'achat
								</label>

								<div class="input-group">

									<input type="number" name="prix" class="form-control" min="0" step="1" value="{{ article.prixAchat|default(0) }}">

									<div class="input-group-append">

										<span class="input-group-text">
											FCFA
										</span>

									</div>

								</div>

							</div>

						</div>


						{# ==========================================
												                       DATE
												                       ========================================== #}

						<div class="col-lg-3 col-md-6">

							<div class="form-group">

								<label>
									Date d'entrée
								</label>

								<input type="datetime-local" name="date" class="form-control" value="{{ 'now'|date('Y-m-d\\TH:i') }}" required>

							</div>

						</div>


						{# ==========================================
												                       BOUTON
												                       ========================================== #}

						<div class="col-lg-3 col-md-6">

							<div class="form-group">

								<label>&nbsp;</label>

								<button type="submit" class="btn btn-success btn-block">

									<i class="fa fa-plus-circle mr-1"></i>

									Ajouter au stock

								</button>

							</div>

						</div>

					</div>

				</form>

			</div>

		</div>


		{# ==========================================================
				       HISTORIQUE DES ENTRÉES
				       ========================================================== #}

		<div class="card">

			<div class="card-header">

				<div class="card-title">

					<i class="fa fa-history mr-2"></i>

					Dernières entrées de stock

				</div>

			</div>

			<div class="card-body">

				<div class="table-responsive">

					<table class="table table-bordered table-hover">

						<thead>

							<tr>

								<th>
									Date
								</th>

								<th class="text-right">
									Quantité
								</th>

								<th class="text-right">
									Prix
								</th>

							</tr>

						</thead>

						<tbody>

							{% for entree in article.stockEntrees|reverse %}

								<tr>

									<td>

										{% if entree.date %}

											{{ entree.date
                                        |date(
                                            'd/m/Y H:i'
                                        )
                                    }}

										{% else %}

											—

										{% endif %}

									</td>


									<td class="text-right">

										<strong class="text-success">

											+
											{{ entree.quantites
                                        |number_format(
                                            3,
                                            ',',
                                            ' '
                                        )
                                    }}

										</strong>

										<span class="text-muted">

											{{ article.unite }}

										</span>

									</td>


									<td class="text-right">

										{% if entree.prix is not null %}

											{{ entree.prix
                                        |number_format(
                                            0,
                                            ',',
                                            ' '
                                        )
                                    }}

											FCFA

										{% else %}

											—

										{% endif %}

									</td>

								</tr>

							{% else %}

								<tr>

									<td colspan="3" class="text-center text-muted py-4">

										<i class="fa fa-info-circle mr-1"></i>

										Aucune entrée de stock enregistrée.

									</td>

								</tr>

							{% endfor %}

						</tbody>

					</table>

				</div>

			</div>

		</div>

	</div>

{% endblock %}
