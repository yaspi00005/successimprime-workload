{% if is_granted('ROLE_ADMIN') %}
    <form method="post" action="{{ path('app_commandes_delete', {'id': commande.id}) }}" class="d-inline" {{ confirmer_suppression('la commande ' ~ commande.numero) }}>
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">
        <button class="btn btn-danger">
            <i class="fe fe-trash-2 mr-1"></i>
            Supprimer
        </button>
    </form>
{% endif %}
