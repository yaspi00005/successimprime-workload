{#
    Une commande dont le circuit a déjà commencé (production ou
    livraison) est normalement verrouillée. Le contrôleur autorise
    déjà un administrateur à accéder à l'édition dans ce cas (voir
    CommandesController::edit()) : le formulaire doit donc rester
    modifiable pour lui, sinon l'accès autorisé ne sert à rien
    (tous les champs restent bloqués visuellement).
#}
{% set commandeVerrouillee =
    circuitDejaCommence|default(false)
    and not is_granted('ROLE_ADMIN')
%}


{# ============================================================
   MACRO : FINITION MANUELLE
   ============================================================ #}

{% macro finition_manuelle(
    finition,
    commandeVerrouillee = false
) %}

	<div class="js-finition-manuelle border rounded p-3 mb-3">

		<div class="row align-items-end">

			<div class="col-lg-4 col-md-6">

				{{ form_row(finition.finition, {
                    label: 'Finition',
                    attr: {
                        class: 'form-control'
                    }
                }) }}

			</div>


			<div class="col-lg-2 col-md-6">

				{{ form_row(finition.prixApplique, {
                    label: 'Prix appliqué',
                    attr: {
                        class: 'form-control js-finition-prix',
                        min: 0
                    }
                }) }}

			</div>


			<div class="col-lg-2 col-md-6">

				{{ form_row(finition.modeCalcul, {
                    label: 'Mode de calcul',
                    attr: {
                        class: 'form-control js-finition-mode'
                    }
                }) }}

			</div>


			<div class="col-lg-2 col-md-6">

				{{ form_row(finition.quantite, {
                    label: 'Quantité',
                    attr: {
                        class: 'form-control js-finition-quantite',
                        min: 1
                    }
                }) }}

			</div>


			<div class="col-lg-2 col-md-6">

				{% if not commandeVerrouillee %}

					<button type="button" class="btn btn-danger-light btn-block js-supprimer-finition">
						<i class="fa fa-trash mr-1"></i>
						Supprimer
					</button>

				{% endif %}

			</div>

		</div>

	</div>

{% endmacro %}


{# ============================================================
   MACRO : DÉTAIL DE COMMANDE
   ============================================================ #}

{% macro champs_detail(
    detail,
    commandeVerrouillee = false
) %}

	<div
		class="travail-form js-commande-detail" data-detail-verrouille="{{ commandeVerrouillee ? '1' : '0' }}">

		{# ====================================================
																																																																           TYPE DE LIGNE
																																																																           ==================================================== #}

		<div class="travail-section">

			<div class="travail-section-title">
				<i class="fa fa-th-large"></i>
				Type de ligne
			</div>

			{{ form_label(
                detail.typeLigne,
                'Que souhaitez-vous ajouter ?'
            ) }}

			<div class="js-type-ligne text-primary">

				{{ form_widget(
                    detail.typeLigne
                ) }}

			</div>

			{{ form_errors(
                detail.typeLigne
            ) }}

			<small class="form-text text-muted">
				Produit / prestation :
																																																																																																																																                travail provenant du catalogue.
																																																																																																																																                Article en stock :
																																																																																																																																                vente directe d’un article physique.
																																																																																																																																                Saisie libre :
																																																																																																																																                désignation, quantité et prix libres.
			</small>

		</div>


		{# ====================================================
																																																																           PRODUIT / ARTICLE
																																																																           ==================================================== #}

		<div class="travail-section">

			<div class="travail-section-title">
				<i class="fa fa-cube"></i>
				Produit, article et configuration
			</div>


			{# MODE CONFIGURATION #}
			{#
			 # Procédure simplifiée : il n'y a plus qu'une seule façon de
			 # configurer une ligne Produit (choix libre parmi les
			 # type/support/format liés au produit). Ce champ reste dans
			 # le formulaire (valeur toujours forcée à "manuel" à
			 # l'enregistrement, voir CommandesController) mais n'est
			 # plus montré à l'utilisateur.
			 #}

			<div class="row js-zone-mode-configuration" style="display:none;">

				<div class="col-12">

					<div class="form-group text-primary">

						{{ form_label(
                            detail.modeConfiguration,
                            'Mode de configuration'
                        ) }}

						<div class="js-mode-configuration">

							{{ form_widget(
                                detail.modeConfiguration
                            ) }}

						</div>

						{{ form_errors(
                            detail.modeConfiguration
                        ) }}

						<small class="form-text text-muted">
							Automatique :
																																																																																																																																																																																																																																                            informations provenant du catalogue.
																																																																																																																																																																																																																																                            Manuel :
																																																																																																																																																																																																																																                            caractéristiques choisies manuellement.
						</small>

					</div>

				</div>

			</div>


			{# PRODUIT #}

			<div class="row js-zone-produit">

				<div class="col-lg-6 col-md-6">

					{{ form_row(detail.produit, {
                        label: 'Produit / prestation',
                        attr: {
                            class:
                                'form-control js-select-search',
                            'data-detail-field':
                                'produit',
                            'data-placeholder':
                                'Rechercher un produit...'
                        }
                    }) }}

				</div>


				<div class="col-lg-6 col-md-6
																																																																																																																																																																																																                    js-zone-configuration-automatique">

					{{ form_row(
                        detail.produitConfiguration,
                        {
                            label:
                                'Configuration du produit',

                            attr: {
                                class:
                                    'form-control js-select-search',

                                'data-detail-field':
                                    'configuration',

                                'data-placeholder':
                                    'Rechercher une configuration...'
                            }
                        }
                    ) }}

				</div>

			</div>


			{# ARTICLE STOCK #}

			<div class="row js-zone-article-stock" style="display:none;">

				<div class="col-lg-7 col-md-7">

					{{ form_row(detail.article, {
                        label: 'Article en stock',
                        attr: {
                            class:
                                'form-control js-select-search js-article-stock',

                            'data-detail-field':
                                'article',

                            'data-placeholder':
                                'Référence ou désignation...'
                        }
                    }) }}

				</div>


				<div class="col-lg-5 col-md-5">

					<div class="form-group">

						<label>
							Disponibilité
						</label>

						<div class="alert alert-light border mb-0">

							<span class="js-stock-article">
								Sélectionnez un article.
							</span>

						</div>

					</div>

				</div>

			</div>


			{# CONFIGURATION TECHNIQUE PRODUIT #}

			<div class="js-zone-champs-configuration">

				<div class="row">

					<div class="col-lg-4 col-md-6">

						{{ form_row(detail.typeImpression, {
                            label:
                                "Type d’impression",

                            attr: {
                                class:
                                    'form-control',

                                'data-detail-field':
                                    'typeImpression'
                            }
                        }) }}

					</div>


					<div class="col-lg-4 col-md-6">

						{{ form_row(detail.support, {
                            label:
                                "Support d’impression",

                            attr: {
                                class:
                                    'form-control',

                                'data-detail-field':
                                    'support'
                            }
                        }) }}

					</div>


					<div class="col-lg-4 col-md-6">

						{{ form_row(detail.format, {
                            label: 'Format',

                            attr: {
                                class:
                                    'form-control',

                                'data-detail-field':
                                    'format'
                            }
                        }) }}

					</div>

				</div>

				<small class="form-text text-muted
																																																																																																																																																																																																                    js-message-champs-auto">
					Ces champs proviennent de la configuration sélectionnée.
				</small>

			</div>

		</div>


		{# ====================================================
																																																																           DÉSIGNATION
																																																																           ==================================================== #}

		<div class="travail-section text-black">

			<div class="travail-section-title">
				<i class="fa fa-pencil"></i>
				Désignation
			</div>

			{{ form_row(detail.designation, {
                label: 'Désignation',

                attr: {
                    class: 'form-control text-primary',

                    'data-detail-field':
                        'designation',

                    placeholder:
                        'Ex. Bâche publicitaire 3 × 2 m'
                }
            }) }}

		</div>


		{# ====================================================
																																																																           CIRCUIT
																																																																           ==================================================== #}

		<div class="travail-section js-zone-circuit">

			<div class="travail-section-title">
				<i class="fa fa-random"></i>
				Circuit de traitement
			</div>


			<div class="row">

				<div class="col-lg-6">

					{{ form_row(
                        detail.prePresseNecessaire,
                        {
                            label:
                                'Passage en prépresse',

                            attr: {
                                class:
                                    'js-prepresse-necessaire'
                            }
                        }
                    ) }}

				</div>


				<div class="col-lg-6">

					{{ form_row(
                        detail.productionNecessaire,
                        {
                            label:
                                'Passage en production',

                            attr: {
                                class:
                                    'js-production-necessaire'
                            }
                        }
                    ) }}

				</div>

			</div>


			<div class="alert alert-info mb-0">

				<i class="fa fa-info-circle mr-1"></i>

				<span class="js-message-circuit-texte">
					Circuit de traitement de cette ligne.
				</span>

			</div>

		</div>


		{# ====================================================
																																																																           QUANTITÉ / DIMENSIONS / PRIX
																																																																           ==================================================== #}

		<div class="travail-section">

			<div class="travail-section-title">
				<i class="fa fa-calculator"></i>
				Dimensions, quantité et prix
			</div>

			<div class="row">

				<div class="col-lg-3 js-zone-largeur">

					{{ form_row(detail.largeur, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'largeur',

                            min: 0,
                            step: '0.01'
                        }
                    }) }}

				</div>


				<div class="col-lg-3 js-zone-longueur">

					{{ form_row(detail.longueur, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'longueur',

                            min: 0,
                            step: '0.01'
                        }
                    }) }}

				</div>


				<div class="col-lg-3 js-zone-surface">

					{{ form_row(detail.surface, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'surface',

                            readonly: true
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.quantite, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'quantite',

                            min: 1
                        }
                    }) }}

					<small class="form-text text-muted
																																																																																																																																																																																																                        js-message-quantite"></small>

				</div>


				<div class="col-lg-3 js-zone-nombre-faces">

					{{ form_row(detail.nombreFaces, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'nombreFaces',

                            min: 1
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.modeCalcul, {
                        label:
                            'Mode de calcul',

                        attr: {
                            class:
                                'form-control js-mode-calcul js-calcul-detail',

                            'data-detail-field':
                                'modeCalcul'
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.prixUnitaire, {
                        label:
                            'Prix unitaire',

                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'prixUnitaire',

                            min: 0
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.remise, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'remise',

                            min: 0
                        }
                    }) }}

					<small class="form-text text-muted js-remise-totale-detail">
						Remise totale : —
					</small>

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.tva, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'tva',

                            min: 0
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.totalHt, {
                        attr: {
                            'data-detail-field':
                                'totalHt',

                            readonly: true
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.totalTtc, {
                        attr: {
                            'data-detail-field':
                                'totalTtc',

                            readonly: true
                        }
                    }) }}

				</div>

			</div>

		</div>


		{# ====================================================
																																																																           FINITIONS
																																																																           ==================================================== #}

		<div class="travail-section js-zone-finitions">

			<div class="travail-section-title">
				<i class="fa fa-magic"></i>
				Finitions
			</div>


			<div class="js-zone-finitions-automatiques">

				<div class="finitions-box js-finitions-box" data-input-name="{{ detail.finitionsSelectionnees.vars.full_name }}">

					{{ form_widget(
                        detail.finitionsSelectionnees
                    ) }}

					{{ form_errors(
                        detail.finitionsSelectionnees
                    ) }}

				</div>

			</div>


			<div class="js-zone-finitions-manuelles" data-index="{{ detail.finitions|length }}" data-prototype="{{ _self.finition_manuelle( detail.finitions.vars.prototype, commandeVerrouillee )|e('html_attr') }}" style="display:none;">

				<div class="js-liste-finitions-manuelles">

					{% for finition in detail.finitions %}

						{{ _self.finition_manuelle(
                            finition,
                            commandeVerrouillee
                        ) }}

					{% endfor %}

				</div>


				{{ form_errors(
                    detail.finitions
                ) }}


				{% if not commandeVerrouillee %}

					<button type="button" class="btn btn-primary-light btn-sm js-ajouter-finition">
						<i class="fa fa-plus mr-1"></i>
						Ajouter une finition
					</button>

				{% endif %}

			</div>

		</div>


		{# ====================================================
																																																																           TECHNIQUE
																																																																           ==================================================== #}

		<div class="travail-section js-zone-technique">

			<div class="travail-section-title">
				<i class="fa fa-sliders"></i>
				Caractéristiques techniques
			</div>

			<div class="row js-technique-champs">

				<div class="col-lg-3">
					{{ form_row(detail.profilCouleurs) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.resolution) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.grammage) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.epaisseur) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.laminage) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.pliage) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.priorite) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.tempsEstime) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.tempsReel) }}
				</div>


				<div class="col-md-3">
					{{ form_row(detail.rectoVerso) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.oeillets) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.decoupe) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.emballage) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.batValide) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.etat) }}
				</div>

			</div>


			{{ form_row(
                detail.observation
            ) }}

		</div>


		{# ====================================================
																																																																           FICHIERS
																																																																           ==================================================== #}

		<div class="travail-section js-zone-fichiers">

			<div class="travail-section-title">
				<i class="fa fa-cloud-upload"></i>
				Fichiers du client
			</div>

			{{ form_widget(
                detail.jetonsFichiers,
                {
                    attr: {
                        class:
                            'js-jetons-fichiers'
                    }
                }
            ) }}

			<input type="file" class="form-control js-fichiers-client" multiple accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.svg,.ai,.eps,.psd,.cdr">

			<small class="form-text text-muted">
				Les fichiers volumineux sont envoyés automatiquement.
			</small>

			<div class="js-liste-uploads mt-3">

				{% for fichierExistant in detail.vars.value.fichiers|default([]) %}

					<div class="d-flex align-items-center border rounded p-2 mb-2">

						{% if fichierExistant.typeMime starts with 'image/' %}

						{#
						 * Pas d'aperçu <img> ici : le navigateur
						 * téléchargerait le fichier ORIGINAL en entier
						 * (souvent très volumineux -- TIFF/PSD haute
						 * résolution) juste pour l'afficher en 40x40,
						 * ce qui rendait la page de commande très
						 * lente, voire impossible à charger. Utiliser
						 * le bouton "Voir le fichier" pour l'ouvrir à
						 * la demande.
						 #}
						<i class="fa fa-picture-o mr-2" style="font-size:24px;"></i>

						{% else %}

						<i class="fa fa-file-o mr-2" style="font-size:24px;"></i>

						{% endif %}

						<div class="flex-grow-1">

							<div class="small font-weight-bold">
								{{ fichierExistant.nomOriginal }}
							</div>

							<div class="small text-muted">
								Déjà envoyé
							</div>

						</div>

						<a href="{{ path('app_fichier_visualiser', {id: fichierExistant.id}) }}" target="_blank" class="btn btn-sm btn-light ml-2" title="Voir le fichier">
							<i class="fa fa-eye"></i>
						</a>

					</div>

				{% endfor %}

			</div>

		</div>

	</div>

{% endmacro %}


{# ============================================================
   URLS UPLOAD
   ============================================================ #}

{% set jetonTemporaire =
    'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
%}

{% set indexTemporaire =
    999999999
%}


{% set modeleUrlMorceau = path(
    'app_fichier_upload_morceau',
    {
        jeton: jetonTemporaire,
        index: indexTemporaire
    }
) %}


{% set modeleUrlMorceau =
    modeleUrlMorceau|replace({
        (jetonTemporaire):
            '__JETON__',

        (indexTemporaire ~ ''):
            '__INDEX__'
    })
%}


{% set modeleUrlStatut = path(
    'app_fichier_upload_statut',
    {
        jeton: jetonTemporaire
    }
) %}


{% set modeleUrlStatut =
    modeleUrlStatut|replace({
        (jetonTemporaire):
            '__JETON__'
    })
%}


{% set modeleUrlSuppression = path(
    'app_fichier_upload_supprimer',
    {
        jeton: jetonTemporaire
    }
) %}


{% set modeleUrlSuppression =
    modeleUrlSuppression|replace({
        (jetonTemporaire):
            '__JETON__'
    })
%}


{# ============================================================
   FORMULAIRE
   ============================================================ #}

{{ form_start(form, {
    attr: {
        id:
            'commande-form',

        enctype:
            'multipart/form-data',

        'data-circuit-verrouille':
            commandeVerrouillee ? '1' : '0',

        'data-upload-csrf':
            csrf_token(
                'upload-commande'
            ),

        'data-upload-initialiser-url':
            path(
                'app_fichier_upload_initialiser'
            ),

        'data-upload-morceau-url':
            modeleUrlMorceau,

        'data-upload-statut-url':
            modeleUrlStatut,

        'data-upload-supprimer-url':
            modeleUrlSuppression,

        'data-brouillon-nouvelle':
            commande.id is null ? '1' : '0',

        'data-brouillon-csrf':
            csrf_token('brouillon-commande'),

        'data-brouillon-enregistrer-url':
            path('app_brouillon_enregistrer', {type: 'commande'}),

        'data-brouillon-verifier-url':
            path('app_brouillon_verifier', {type: 'commande'})
    }
}) }}


<div
	class="side-app">

	{# ========================================================
																																       HEADER
																																       ======================================================== #}

	<div class="page-header">

		<ol class="breadcrumb">

			<li class="breadcrumb-item">

				<a href="{{ path( 'app_commandes_index' ) }}">
					Commandes
				</a>

			</li>

			<li class="breadcrumb-item active">

				{{
                    form.vars.data.id
                        ? 'Modifier la commande'
                        : 'Nouvelle commande'
                }}

			</li>

		</ol>


		<a href="{{ path( 'app_commandes_index' ) }}" class="btn btn-sm btn-primary-light">
			<i class="fa fa-list mr-1"></i>
			Liste des commandes
		</a>

	</div>


	{% if not form.vars.valid %}

		<div class="alert alert-danger">
			{{ form_errors(form) }}
		</div>

	{% endif %}


	{% if commandeVerrouillee %}

		<div class="alert alert-warning">

			<i class="fa fa-lock mr-2"></i>

			<strong>
				Commande engagée dans son circuit.
			</strong>

			La structure des lignes ne peut plus être modifiée.

		</div>

	{% endif %}


	{# ========================================================
																																       CLIENT
																																       ======================================================== #}

	<div class="card">

		<div class="card-header">

			<div class="card-title">
				<i class="fa fa-user-circle mr-2"></i>
				Client
			</div>

		</div>


