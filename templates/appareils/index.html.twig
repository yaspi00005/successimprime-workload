{% extends 'base.html.twig' %}

{% block title %}Appareils autorisés{% endblock %}

{% block header_actions %}
	<li class="nav-item">
		<a href="#autoriser" class="btn btn-danger btn-sm si-btn-entete js-autoriser"><i class="fas fa-plus me-1"></i>Autoriser un appareil</a>
	</li>
{% endblock %}

{% block body %}
	{% if not en_ligne %}
		<div class="alert alert-info">Ces règles s'appliquent à l'administration en ligne. Sur le serveur local de l'atelier, la connexion reste celle du poste de travail.</div>
	{% endif %}

	<div class="row si-appareils">
		<div class="col-xl-8">
			<div class="card si-bloc">
				<div class="si-appareils-tete">
					<form method="get" class="si-recherche-liste">
						<input type="search" name="q" value="{{ recherche }}" class="form-control form-control-sm" placeholder="Appareil, utilisateur, adresse…" aria-label="Rechercher un appareil">
					</form>
				</div>
				{% if appareils is empty %}
					<p class="text-muted py-4 text-center mb-0">{{ recherche ? 'Aucun appareil ne correspond.' : 'Aucun appareil autorisé pour le moment.' }}</p>
				{% else %}
					<div class="table-responsive">
						<table class="table si-table align-middle mb-0">
							<thead>
								<tr>
									<th>Appareil</th>
									<th>Utilisateur</th>
									<th>Rôle en ligne</th>
									<th class="si-masque-mobile">Dernière connexion</th>
									<th>État</th>
									<th class="text-end"></th>
								</tr>
							</thead>
							<tbody>
								{% set etats = {
									autorise: ['Autorisé', 'si-pastille-vert'],
									refuse: ['Refusé', 'si-pastille-rouge'],
									bloque: ['Bloqué', 'si-pastille-rouge'],
									revoque: ['Révoqué', 'si-pastille-gris'],
								} %}
								{% set icones = {telephone: '📱', tablette: '📱', ordinateur: '💻'} %}
								{% for appareil in appareils %}
									{% set derniere = appareil.derniereConnexion %}
									<tr class="{{ appareil.etat == 'revoque' ? 'si-ligne-eteinte' }}">
										<td>
											<span class="si-appareil-nom"><span aria-hidden="true">{{ icones[appareil.type] }}</span> {{ appareil.etat in ['refuse', 'bloque'] ? (appareil.type == 'ordinateur' ? 'Ordinateur' : (appareil.type == 'tablette' ? 'Tablette' : 'Téléphone')) ~ ' inconnu' : appareil.nom }}</span>
											{% if appareil.etat in ['refuse', 'bloque'] %}
												<small class="d-block text-muted">{{ appareil.ip }}{{ appareil.identifiantTente ? ' · essai avec « ' ~ appareil.identifiantTente ~ ' »' }}</small>
											{% endif %}
										</td>
										<td>{{ appareil.nomUtilisateur }}</td>
										<td>{{ appareil.utilisateur ? appareil.roleEnLigneLibelle : '—' }}</td>
										<td class="si-masque-mobile text-nowrap">
											{% if derniere %}
												{{ derniere|date('Y-m-d') == 'now'|date('Y-m-d') ? 'Aujourd\'hui ' ~ derniere|date('H:i') : (derniere|date('Y-m-d') == 'yesterday'|date('Y-m-d') ? 'Hier ' ~ derniere|date('H:i') : derniere|date('d/m')) }}
											{% else %}
												<span class="text-muted">Jamais</span>
											{% endif %}
										</td>
										<td><span class="si-pastille {{ etats[appareil.etat][1] }}">{{ etats[appareil.etat][0] }}</span></td>
										<td class="text-end">
											{% if appareil.etat == 'autorise' %}
												<form method="post" action="{{ path('app_appareils_revoquer', {id: appareil.id}) }}" class="d-inline" onsubmit="return confirm('Révoquer « {{ appareil.nom|e('js') }} » ? Sa session en ligne s\'arrête tout de suite.');">
													<input type="hidden" name="_token" value="{{ csrf_token('appareil-' ~ appareil.id) }}">
													<button class="btn btn-sm si-btn-discret">Révoquer</button>
												</form>
											{% elseif appareil.etat == 'refuse' %}
												<form method="post" action="{{ path('app_appareils_bloquer', {id: appareil.id}) }}" class="d-inline">
													<input type="hidden" name="_token" value="{{ csrf_token('appareil-' ~ appareil.id) }}">
													<button class="btn btn-sm si-btn-discret">Bloquer</button>
												</form>
											{% else %}
												<span class="text-muted">—</span>
											{% endif %}
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				{% endif %}
			</div>
		</div>

		<div class="col-xl-4">
			<div class="card si-bloc si-appareil-nouveau" id="autoriser">
				<h2 class="si-bloc-titre text-center">Autoriser un nouvel appareil</h2>
				{% if invitation %}
					<img src="{{ invitation.qr }}" alt="QR à scanner avec l'appareil à autoriser" class="si-appareil-qr">
					<p class="text-center small text-muted mb-1">Scannez ce code avec l'appareil à autoriser · <span class="js-expire" data-expire="{{ invitation.expire }}">valable 5 min</span></p>
					<p class="text-center small mb-2"><strong>{{ invitation.nom }}</strong> pour {{ invitation.utilisateur }}</p>
					<details class="small text-center">
						<summary>Pas d'appareil photo ? Copier le lien</summary>
						<input type="text" class="form-control form-control-sm mt-2" value="{{ invitation.lien }}" readonly onclick="this.select()">
					</details>
					<a href="{{ path('app_appareils_index') }}" class="btn btn-sm si-btn-discret w-100 mt-2">Autoriser un autre appareil</a>
				{% else %}
					<form method="post" action="{{ path('app_appareils_inviter') }}">
						<input type="hidden" name="_token" value="{{ csrf_token('appareil-inviter') }}">
						<label class="form-label" for="appareil-utilisateur">Utilisateur</label>
						<select name="utilisateur" id="appareil-utilisateur" class="form-select form-select-sm" required>
							<option value="">Choisir…</option>
							{% for utilisateur in utilisateurs %}
								{% set employe = utilisateur.employe %}
								<option value="{{ utilisateur.id }}">{{ employe and (employe.prenom ~ employe.nom)|trim ? (employe.prenom ~ ' ' ~ employe.nom)|trim ~ ' (' ~ utilisateur.username ~ ')' : utilisateur.username }}</option>
							{% endfor %}
						</select>
						<label class="form-label mt-2" for="appareil-nom">Nom de l'appareil</label>
						<input type="text" name="nom" id="appareil-nom" class="form-control form-control-sm" maxlength="100" placeholder="Téléphone du gérant" required>
						<label class="form-label mt-2" for="appareil-role">Rôle en ligne</label>
						<select name="role" id="appareil-role" class="form-select form-select-sm" required>
							{% for cle, libelle in roles %}
								<option value="{{ cle }}"{{ cle == 'lecture' ? ' selected' }}>{{ libelle }}</option>
							{% endfor %}
						</select>
						<small class="text-muted d-block mt-1">Admin : tout ce que la personne a le droit de faire · Encaissement : encaisser et livrer · Lecture : consulter seulement.</small>
						<button class="btn btn-danger btn-sm w-100 mt-3">Afficher le QR</button>
					</form>
				{% endif %}
			</div>

			<div class="card si-bloc">
				<h2 class="si-bloc-titre">Règles d'accès en ligne</h2>
				<ul class="si-regles-acces">
					<li>Appareil autorisé + mot de passe + code reçu par SMS</li>
					<li>Session fermée après 15 min d'inactivité</li>
					<li>Alerte aux administrateurs si un appareil inconnu essaie</li>
					<li>Opérations financières en ligne = provisoires, validées sur l'ERP local</li>
				</ul>
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	<script>
		(function () {
			var expire = document.querySelector('.js-expire');
			if (expire) {
				var fin = parseInt(expire.dataset.expire, 10) * 1000;
				var maj = function () {
					var reste = Math.max(0, Math.round((fin - Date.now()) / 1000));
					expire.textContent = reste > 0 ? 'valable encore ' + Math.floor(reste / 60) + ':' + String(reste % 60).padStart(2, '0') : 'expiré, affichez-en un nouveau';
					if (reste === 0) { document.querySelector('.si-appareil-qr').style.opacity = '0.2'; clearInterval(minuterie); }
				};
				var minuterie = setInterval(maj, 1000);
				maj();
			}
			var bouton = document.querySelector('.js-autoriser');
			bouton.addEventListener('click', function () {
				var champ = document.getElementById('appareil-utilisateur');
				if (champ) { setTimeout(function () { champ.focus(); }, 50); }
			});
		})();
	</script>
{% endblock %}
