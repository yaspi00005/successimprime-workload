# Thème Workload (ThemeForest) : sous licence, jamais versionné.
# Réinstaller avec : php bin/console app:installer-theme /chemin/vers/WorkLoad-v1.2-28-Octuber-2022/xhtml
/public/theme/
/WorkLoad-*/

# Fichiers temporaires Google Drive
.tmp.driveupload/

# Fichiers envoyés par les utilisateurs (chat, pré-presse, étiquettes,
# employés…) : jamais dans le dépôt (audit de sécurité du 15/10/2026, D2).
# Seuls restent le filet de sécurité .htaccess et le dossier de l'écran TV.
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/tv/

# Médias du diaporama de l'écran d'accueil (images/vidéos déposées manuellement)
/public/uploads/tv/*
!/public/uploads/tv/.gitkeep

# Images du site vitrine générées au réenregistrement (originaux dans var/uploads/site/)
/public/uploads/site/

# Copies locales des migrations
/migrations copy/
*.dmg

# Sauvegardes de la base de données (données réelles de clients :
# ne doivent jamais partir sur GitHub, voir scripts/windows/backup_db.bat)
/backups/
*.sql

# Ajoute automatiquement par preparer_env_avant_git.py
/node_modules/
.env.local
.env.local.php
.env.*.local
/.phpunit.result.cache

# Fichiers systeme macOS
.DS_Store

# Données de démo (fichiers SQL générés, sans donnée réelle)
!donnees-demo/*.sql

# Copies de travail temporaires des assistants
/.claude/worktrees/
