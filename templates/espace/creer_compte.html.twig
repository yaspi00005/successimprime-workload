{% extends 'espace/_page.html.twig' %}

{% block title %}Créer mon compte · Succès Imprim{% endblock %}
{% block lien_haut %}Déjà client ? <a href="{{ path('app_espace_connexion') }}">Se connecter</a>{% endblock %}

{% block contenu %}
	<h1>Créer mon compte</h1>
	<p class="si-espace-sous-titre">Un code confirme votre compte, puis vous choisissez votre mot de passe. Si vous avez déjà commandé chez nous avec ce numéro, vous retrouverez vos commandes.</p>

	<form method="post" action="{{ path('app_espace_code') }}">
		<input type="hidden" name="_token" value="{{ csrf_token('espace-code') }}">
		<input type="hidden" name="intention" value="creation">
		<div class="si-espace-deux">
			<div>
				<label for="prenom">Prénom</label>
				<input type="text" id="prenom" name="prenom" maxlength="50" autocomplete="given-name">
			</div>
			<div>
				<label for="nom">Nom ou entreprise</label>
				<input type="text" id="nom" name="nom" maxlength="50" autocomplete="family-name" required>
			</div>
		</div>
		{% include 'espace/_telephone.html.twig' %}
		<label for="email">Adresse e-mail <small>(conseillé)</small></label>
		<input type="email" id="email" name="email" maxlength="180" autocomplete="email" placeholder="vous@exemple.com">
		<p class="si-espace-aide">Le code y arrive ; sans e-mail, il arrive par SMS. Déjà client chez nous avec ce numéro ? Le code part à l'adresse ou au numéro de votre fiche.</p>
		<button type="submit" class="si-espace-bouton">Recevoir le code</button>
	</form>
{% endblock %}
