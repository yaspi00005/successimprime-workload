{% extends 'base.html.twig' %}

{#
	Fiche d'une commande (maquette C02) : suivi en 7 etapes, lignes et
	production, paiements et historique. Donnees : SuiviCommandeService.
#}

{% set client = commande.clients %}
{% set estAdmin = is_granted('ROLE_ADMIN') %}
{% set peutModifier = is_granted('ROLE_COMMANDE') or estAdmin %}
{% set peutEncaisser = is_granted('ROLE_PAIEMENT_ENCAISSER') or estAdmin %}
{% set peutFacturer = is_granted('ROLE_FACTURE') or estAdmin %}
{% set peutVoirPaiements = is_granted('ROLE_PAIEMENT_VOIR') or estAdmin %}
{% set statutTravaux = commande.statutTravaux %}
{% set annulee = statutTravaux == 'annulee' %}
{% set verrouillee = lignes|filter(l => l.detail.statutProduction in ['en_production', 'terminee', 'prete_livraison', 'en_livraison', 'livree'])|length > 0 %}
{% set totalTtc = commande.totalTtc %}
{% set totalPaye = paiementsValides|reduce((somme, p) => somme + p.montant, 0) %}
{% set reste = max(totalTtc - totalPaye, 0) %}
{% set telephone = client and client.telephone ? client.telephone|replace({' ': '', '-': '', '.': '', '+': ''}) : null %}
{% if telephone and telephone|length == 8 %}{% set telephone = '223' ~ telephone %}{% endif %}
{% set couleursTags = ['bleu', 'magenta', 'orange', 'canard'] %}

{% block title %}Commande {{ commande.numero }}{% endblock %}

{% block page_title %}Commande{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/promotions.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
	{% if app.request.query.get('creee') %}
		{# Juste après la saisie (maquette C04, écran « Commande créée »). #}
		<div class="card si-bloc si-commande-creee">
			<span class="si-commande-creee-coche"><i class="fas fa-check"></i></span>
			<div class="flex-grow-1 min-w-0">
				<h3>{{ commande.statut ? 'Commande créée' : 'Brouillon enregistré' }} <strong>{{ commande.numero }}</strong></h3>
				<p class="text-muted mb-2">{{ client ? client.nomComplet : 'Client comptoir' }} · {{ totalTtc|number_format(0, ',', ' ') }} F TTC</p>
				<ul class="si-commande-creee-liste">
					{% if commande.statut %}
						<li><i class="fas fa-check"></i>Fiches de travail prêtes ({{ lignes|length }})</li>
						<li><i class="fas fa-check"></i>Lignes ajoutées à la file de production</li>
					{% else %}
						<li><i class="fas fa-pause"></i>Brouillon : rien n'est envoyé à l'atelier avant la confirmation</li>
					{% endif %}
				</ul>
			</div>
			<div class="si-commande-creee-actions">
				{% if telephone %}
					<a href="https://wa.me/{{ telephone }}?text={{ ('Bonjour, votre commande ' ~ commande.numero ~ ' chez Succès Imprim est enregistrée. Montant : ' ~ totalTtc|number_format(0, ',', ' ') ~ ' F.')|url_encode }}" class="btn btn-success btn-sm si-btn-entete" target="_blank" rel="noopener"><i class="fab fa-whatsapp me-1"></i>Prévenir le client</a>
				{% endif %}
				<a href="{{ path('app_commandes_new') }}" class="btn btn-sm si-btn-secondaire">Nouvelle commande</a>
			</div>
		</div>
	{% endif %}

	{% if commande.attendValidationEntreprise %}
		<div class="alert alert-info">
			<strong>Demande en attente chez le client.</strong> {{ commande.demandeePar ?? 'Une personne de l\'entreprise' }} l'a passée dans l'espace client ; un valideur de l'entreprise doit l'accepter avant qu'elle arrive ici à confirmer. Rien à faire pour l'instant.
		</div>
	{% elseif commande.estRefuseeParEntreprise %}
		<div class="alert alert-secondary">
			<strong>Refusée par le client</strong> ({{ commande.valideePar ?? 'valideur de l\'entreprise' }}){% if commande.motifRefusEntreprise %} : « {{ commande.motifRefusEntreprise }} »{% endif %}.
		</div>
	{% elseif commande.canal == 'en_ligne' and not commande.statut and not annulee %}
		<div class="alert alert-warning d-flex flex-wrap align-items-center gap-2">
			<div class="flex-grow-1"><strong>Commande passée par le client dans son espace.</strong> Le prix affiché est indicatif : vérifiez le prix et le fichier, puis confirmez-la. Elle ne part pas à l'atelier avant.{% if commande.codeSaisi and not commande.codePromo and not commande.motifCodePromo %} Le client a tapé le code promo <b>{{ commande.libelleCodePromo }}</b> : il est revérifié quand vous enregistrez.{% endif %}</div>
			{% if is_granted('ROLE_COMMANDE') %}<a href="{{ path('app_commandes_edit', {id: commande.id}) }}" class="btn btn-sm btn-danger">Vérifier et confirmer</a>{% endif %}
		</div>
	{% endif %}

	{% if commande.motifCodePromo %}
		<div class="alert alert-warning py-2"><i class="fas fa-ticket-alt me-1"></i><strong>Code promo {{ commande.libelleCodePromo }} non retenu.</strong> {{ commande.motifCodePromo }} La commande est restée sans cet avantage.</div>
	{% endif %}

	<div class="si-titre-fiche">
		<div class="min-w-0">
			<h2>{{ commande.numero }}</h2>
			<small class="text-muted">{{ client ? client.nomComplet : 'Client comptoir' }}{% if commande.dateLivraison %} · {{ commande.recupereParClient ? 'retrait' : 'livraison' }} {{ ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'][commande.dateLivraison|date('w')] }} {{ commande.dateLivraison|date('d/m') }}{% endif %}</small>
			{% if commande.objet %}<small class="d-block text-muted">Objet : {{ commande.objet }}</small>{% endif %}
		</div>
		<ul class="si-actions-fiche">
	<li class="nav-item si-masque-mobile">
		<button type="button" class="btn btn-light btn-sm si-btn-entete" onclick="window.print()"><i class="fas fa-print me-1"></i>Fiche de travail</button>
	</li>
	{% if facture and peutFacturer %}
		<li class="nav-item si-masque-mobile">
			<a href="{{ path('app_factures_pdf', {id: facture.id}) }}" class="btn btn-light btn-sm si-btn-entete" target="_blank"><i class="fas fa-file-pdf me-1"></i>Facture PDF</a>
		</li>
	{% elseif peutFacturer and not annulee %}
		<li class="nav-item si-masque-mobile">
			<a href="{{ path('app_factures_nouveau', {id: commande.id}) }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-file-invoice me-1"></i>Facturer</a>
		</li>
	{% endif %}
	{% if telephone %}
		<li class="nav-item si-masque-mobile">
			<a href="https://wa.me/{{ telephone }}?text={{ ('Bonjour, votre commande ' ~ commande.numero ~ ' chez Succès Imprim : ')|url_encode }}" class="btn btn-success btn-sm si-btn-entete" target="_blank" rel="noopener"><i class="fab fa-whatsapp me-1"></i>WhatsApp client</a>
		</li>
	{% endif %}
	{% if peutEncaisser and reste > 0 and not annulee %}
		<li class="nav-item si-masque-mobile">
			<a href="{{ path('app_commandes_paiement', {id: commande.id}) }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-cash-register me-1"></i>Encaisser</a>
		</li>
	{% endif %}
	<li class="nav-item dropdown">
		<button type="button" class="btn btn-light btn-sm si-btn-entete" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Autres actions"><i class="fas fa-ellipsis-h"></i></button>
		<div class="dropdown-menu dropdown-menu-end">
			{% if peutModifier and not annulee and (not verrouillee or estAdmin) %}
				<a class="dropdown-item" href="{{ path('app_commandes_edit', {id: commande.id}) }}"><i class="fas fa-pen me-2"></i>Modifier</a>
			{% endif %}
			{% if is_granted('ROLE_PREPRESSE') or estAdmin %}
				<a class="dropdown-item" href="{{ path('app_controle_pre_presse_index') }}"><i class="fas fa-check-double me-2"></i>Contrôle prépresse</a>
			{% endif %}
			<button type="button" class="dropdown-item d-md-none" onclick="window.print()"><i class="fas fa-print me-2"></i>Fiche de travail</button>
			{% if peutModifier and not annulee and (not verrouillee or estAdmin) %}
				<form method="post" action="{{ path('app_commandes_annuler', {id: commande.id}) }}" data-confirmer="Annuler la commande {{ commande.numero }} ? Un administrateur pourra la restaurer ensuite.">
					<input type="hidden" name="_token" value="{{ csrf_token('annuler-commande-' ~ commande.id) }}">
					<button type="submit" class="dropdown-item text-danger"><i class="fas fa-times-circle me-2"></i>Annuler la commande</button>
				</form>
			{% endif %}
			{% if annulee and estAdmin %}
				<form method="post" action="{{ path('app_commandes_restaurer', {id: commande.id}) }}" data-confirmer="Restaurer la commande {{ commande.numero }} ? Chaque ligne retrouvera son statut d'avant l'annulation.">
					<input type="hidden" name="_token" value="{{ csrf_token('restaurer-commande-' ~ commande.id) }}">
					<button type="submit" class="dropdown-item"><i class="fas fa-undo me-2"></i>Restaurer la commande</button>
				</form>
			{% endif %}
		</div>
	</li>
		</ul>
	</div>
	{# ---------- Suivi ---------- #}
	<div class="card si-bloc">
		<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
			<div class="d-flex flex-wrap align-items-center gap-2">
				{% set enCours = etapes|filter(e => e.etat == 'en_cours')|first %}
				<span class="si-pastille si-pastille-{{ annulee ? 'gris' : (enCours ? 'bleu' : 'vert') }}">{{ annulee ? 'Annulée' : (enCours ? enCours.libelle : 'Livrée') }}</span>
				<small class="text-muted">
					Créée le {{ commande.dateCommande ? commande.dateCommande|date('d/m à H:i') : '—' }}
					{% if commande.agents %} par {{ commande.agents.employe ? commande.agents.employe.prenom : commande.agents.username }}{% elseif commande.demandeePar %} en ligne par {{ commande.demandeePar }}{% if commande.valideePar and commande.validationEntreprise == 'validee' and commande.valideePar != commande.demandeePar %}, validée par {{ commande.valideePar }}{% endif %}{% endif %}
					{% if commande.agents and commande.demandeePar %} · commandée par <strong class="text-body">{{ commande.demandeePar }}</strong>{% endif %}
					{% if commande.bonCommande %} · bon de commande {{ commande.bonCommande }}{% endif %}
				</small>
			</div>
			{% if commande.dateLivraison %}
				<small class="text-muted">
					{{ commande.recupereParClient ? 'Retrait prévu' : 'Livraison prévue' }}
					<strong class="{{ commande.dateLivraison < date() and statutTravaux != 'livree' ? 'text-danger' : 'text-body' }}">{{ ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'][commande.dateLivraison|date('w')] }} {{ commande.dateLivraison|date('d/m') }}</strong>
				</small>
			{% endif %}
		</div>
		<ol class="si-etapes">
			{% for etape in etapes %}
				<li class="si-etape si-etape-{{ etape.etat }}{{ loop.index0 in [2, 5] ? ' si-etape-secondaire' : '' }}">
					<span class="si-etape-rond">{% if etape.etat == 'faite' %}<i class="fas fa-check"></i>{% else %}{{ loop.index }}{% endif %}</span>
					<span class="si-etape-libelle">{{ etape.libelle }}</span>
					<span class="si-etape-court">{{ ['Confirmée', 'Acompte', 'PAO', 'BAT', 'Impr.', 'Finition', 'Livrée'][loop.index0] }}</span>
					<small>{{ etape.detail|default(etape.etat == 'faite' ? '' : '—') }}</small>
				</li>
			{% endfor %}
		</ol>
	</div>

	{% set lignesProduitsClient = lignes|filter(l => l.detail.produitClient) %}
	{% if lignesProduitsClient is not empty %}
		{# ---------- « Mes produits » : demande, production, livraison (maquette P05) ---------- #}
		<div class="card si-bloc">
			<div class="si-bloc-tete"><h4>Quantité demandée, production et livraison</h4><span class="si-pastille si-pastille-rouge">Depuis « Mes produits »</span></div>
			<div class="table-responsive">
				<table class="table si-table align-middle mb-0 si-table-coordination">
					<thead>
						<tr><th>Produit client</th><th class="text-end">Demandé</th><th>Pour la production</th><th>BAT</th><th class="text-end">Produit</th><th class="text-end">Livré</th><th class="text-end">Reste</th><th>Statut</th></tr>
					</thead>
					<tbody>
						{% for ligne in lignesProduitsClient %}
							{% set detail = ligne.detail %}
							{% set pc = detail.produitClient %}
							<tr>
								<td data-libelle="Produit client"><strong>{{ pc.nom }}</strong><small class="d-block text-muted">{{ pc.reference }}</small></td>
								<td data-libelle="Demandé" class="text-end text-nowrap">{{ detail.quantiteDemandee is not null ? detail.quantiteDemandee|number_format(detail.quantiteDemandee == detail.quantiteDemandee|round ? 0 : 2, ',', ' ') ~ ' ' ~ {'m2': 'm²', 'piece': 'pièce' ~ (detail.quantiteDemandee > 1 ? 's'), 'lot': 'ex.'}[detail.uniteDemandee]|default('') : '—' }}</td>
								<td data-libelle="Pour la production"><span>
									{% if detail.modeCalcul == 'forfait' and detail.longueur %}
										<strong>{{ detail.longueur|number_format(2, ',', ' ')|trim('0', 'right')|trim(',', 'right') }} m</strong> sur laize {{ detail.largeur|number_format(2, ',', ' ') }} m
									{% elseif detail.largeur and detail.longueur %}
										<strong>{{ detail.quantite }} × {{ (detail.largeur * 100)|round(1) }} × {{ (detail.longueur * 100)|round(1) }} cm</strong> = {{ detail.surfaceTotale|number_format(2, ',', ' ')|trim('0', 'right')|trim(',', 'right') }} m²
									{% else %}
										<strong>{{ detail.quantite }}</strong> pièce{{ detail.quantite > 1 ? 's' }}
									{% endif %}
									{% if detail.machine %}<small class="d-block text-muted">{{ detail.machine.nom }}</small>{% endif %}</span>
								</td>
								<td data-libelle="BAT"><span class="si-pastille si-pastille-{{ pc.batValide ? 'vert' : 'orange' }}">{{ pc.batValide ? 'BAT réutilisé' : 'BAT à faire' }}</span></td>
								<td data-libelle="Produit" class="text-end">{{ detail.quantiteProduite }}</td>
								<td data-libelle="Livré" class="text-end">{{ detail.quantiteLivree }}</td>
								<td data-libelle="Reste" class="text-end">{{ detail.quantiteRestanteLivraison }}</td>
								<td data-libelle="Statut"><span class="si-pastille si-pastille-{{ ligne.etape == 'livree' ? 'vert' : (detail.quantiteLivree > 0 ? 'orange' : 'bleu') }}">{{ detail.quantiteLivree > 0 and ligne.etape != 'livree' ? 'Livraison partielle' : ligne.libelle }}</span></td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% endif %}

	<div class="row">
		{# ---------- Lignes et production ---------- #}
		<div class="col-xl-8">
			<div class="card si-bloc">
				<div class="si-bloc-tete"><h4>Lignes et production</h4></div>
				{% for ligne in lignes %}
					{% set detail = ligne.detail %}
					{% set type = detail.typeImpression %}
					{% set couleur = type ? couleursTags[type.id % 4] : 'gris' %}
					<div class="si-ligne-commande">
						<span class="si-vignette si-fond-{{ couleur }}"></span>
						<div class="flex-grow-1 min-w-0">
							<strong>{{ detail.designation|default(detail.produit ? detail.produit.nom : 'Travail') }} × {{ detail.quantite }}</strong>
							{% set caracteristiques = [] %}
							{% if detail.largeur and detail.longueur %}{% set caracteristiques = caracteristiques|merge([(detail.largeur * 100)|round(1) ~ ' × ' ~ (detail.longueur * 100)|round(1) ~ ' cm']) %}{% endif %}
							{% for finition in detail.finitions %}{% set caracteristiques = caracteristiques|merge([finition.nomFinition]) %}{% endfor %}
							{% if caracteristiques %}<small class="d-block text-muted">{{ caracteristiques|join(' · ') }}</small>{% endif %}
							{% if detail.demandeClient %}<small class="d-block"><i class="fas fa-comment me-1 text-muted"></i>Le client : « {{ detail.demandeClient }} »</small>{% endif %}
							<div class="d-flex flex-wrap gap-1 mt-1">
								<span class="si-pastille si-pastille-{{ ligne.etape in ['prete', 'sans_production', 'en_livraison', 'livree'] ? 'vert' : (ligne.etape == 'annulee' ? 'gris' : 'bleu') }}">{{ ligne.libelle }}</span>
								{% if detail.machine %}<span class="si-pastille si-pastille-gris">{{ detail.machine.nom }}</span>{% elseif type %}<span class="si-pastille si-pastille-gris">{{ type.nom }}</span>{% endif %}
								{% if ligne.bat %}<span class="si-pastille si-pastille-{{ ligne.bat starts with 'BAT validé' ? 'vert' : 'orange' }}">{{ ligne.bat }}</span>{% endif %}
								{% for fichier in detail.fichiers %}
									<a href="{{ path('app_fichier_visualiser', {id: fichier.id}) }}" class="si-pastille si-pastille-gris" target="_blank" title="{{ fichier.nomOriginal }}"><i class="fas fa-paperclip"></i></a>
								{% endfor %}
							</div>
							{{ include('promotions/_ligne.html.twig', {detail: detail, possibles: promotionsB2b[detail.id] ?? [], type: 'commande', peutDemander: peutModifier and not annulee}) }}
						</div>
						<div class="text-end text-nowrap">
							<strong>{{ detail.totalTtc|number_format(0, ',', ' ') }} F</strong>
							{% if ligne.cout %}
								<small class="d-block text-muted" {% if ligne.cout.manquants %}title="Coût incomplet : {{ ligne.cout.manquants|join(', ') }}"{% endif %}>
									Coût {{ ligne.cout.montant|number_format(0, ',', ' ') }} F{% if ligne.cout.manquants %} <i class="fas fa-exclamation-triangle text-warning"></i>{% endif %}
									{% if ligne.cout.marge is not null %}· <span class="{{ ligne.cout.marge < 35 ? 'text-danger' : 'text-success' }} fw-semibold">marge {{ ligne.cout.marge|number_format(0, ',', ' ') }} %</span>{% endif %}
								</small>
							{% endif %}
							{% if detail.productionDebuteePar %}<small class="d-block text-muted">Opérateur : {{ detail.productionDebuteePar.employe ? detail.productionDebuteePar.employe.prenom : detail.productionDebuteePar.username }}</small>{% endif %}
							{% if client and not detail.produitClient and detail.statutProduction in ['livree', 'en_livraison', 'terminee', 'prete_livraison'] and is_granted('ROLE_COMMANDE') %}
								<form method="post" action="{{ path('app_clients_produits_depuis_ligne', {publicId: client.publicId, id: detail.id}) }}" data-confirmer="Enregistrer « {{ detail.designation|default('ce travail') }} » comme produit du client ? Il pourra le recommander sans nouveau BAT.">
									<input type="hidden" name="_token" value="{{ csrf_token('produit-client-ligne-' ~ detail.id) }}">
									<button type="submit" class="btn btn-link btn-sm p-0 si-lien-discret d-block">Enregistrer comme produit du client</button>
								</form>
							{% endif %}
							{% if (is_granted('ROLE_LIVRAISON') or estAdmin) and detail.statutProduction not in ['livree', 'annulee'] %}
								<form method="post" action="{{ path('app_livraisons_livrer_directement', {id: detail.id}) }}" data-confirmer="Marquer « {{ detail.designation|default('ce travail') }} » comme livré, sans passer par le prépresse ni la production ? Le stock réservé sera sorti.">
									<input type="hidden" name="_token" value="{{ csrf_token('livraison_direct_' ~ detail.id) }}">
									<button type="submit" class="btn btn-link btn-sm p-0 si-lien-discret">Marquer livré</button>
								</form>
							{% endif %}
						</div>
					</div>
				{% else %}
					<p class="text-muted mb-0">Aucune ligne.</p>
				{% endfor %}
				{% if commande.codePromo %}
					<div class="d-flex justify-content-between align-items-start gap-2 pt-3 small si-cp-recap">
						<span class="text-muted"><i class="fas fa-ticket-alt me-1"></i>Code promo <b class="si-cp-code">{{ commande.libelleCodePromo }}</b>{{ commande.codePromo.promotion ? ' · ' ~ commande.codePromo.promotion.nom }}</span>
						{% if commande.remiseCodePromo > 0 %}<span class="text-end text-nowrap">−{{ commande.remiseCodePromoTtc|number_format(0, ',', ' ') }} F<small class="d-block text-muted">déjà déduit</small></span>{% endif %}
					</div>
				{% endif %}
				{# Frais de livraison (palier choisi à la saisie), déjà dans le total. #}
				{% if commande.fraisLivraison > 0 %}
					<div class="d-flex justify-content-between align-items-center pt-3 small">
						<span class="text-muted"><i class="fas fa-truck me-1"></i>Livraison</span>
						<span class="text-nowrap fw-semibold">{{ commande.fraisLivraison|number_format(0, ',', ' ') }} F</span>
					</div>
				{% endif %}
				<div class="d-flex justify-content-between align-items-center pt-3">
					<span class="text-muted">Total TTC</span>
					<strong class="fs-4">{{ totalTtc|number_format(0, ',', ' ') }} F</strong>
				</div>
				{% if marge and marge.taux is not null %}
					<div class="d-flex justify-content-between align-items-center small">
						<span class="text-muted">Marge brute{% if marge.incomplet %} <span class="text-warning" title="Des coûts manquent : voir Réglages, Coûts de revient">(coût incomplet)</span>{% endif %}</span>
						<span class="{{ marge.taux < 35 ? 'text-danger' : 'text-success' }} fw-semibold">{{ (marge.ht - marge.cout)|number_format(0, ',', ' ') }} F · {{ marge.taux|number_format(0, ',', ' ') }} %</span>
					</div>
				{% endif %}
				{% if commande.observation %}
					<p class="text-muted small mb-0 mt-2"><i class="fas fa-comment-alt me-1"></i>{{ commande.observation }}</p>
				{% endif %}
			</div>
			{% if (telephone or (peutEncaisser and reste > 0)) and not annulee %}
				<div class="si-actions-mobile d-md-none">
					{% if telephone %}<a href="https://wa.me/{{ telephone }}?text={{ ('Bonjour, votre commande ' ~ commande.numero ~ ' chez Succès Imprim : ')|url_encode }}" class="btn btn-success" target="_blank" rel="noopener"><i class="fab fa-whatsapp me-1"></i>WhatsApp</a>{% endif %}
					{% if peutEncaisser and reste > 0 %}<a href="{{ path('app_commandes_paiement', {id: commande.id}) }}" class="btn btn-danger"><i class="fas fa-cash-register me-1"></i>Encaisser</a>{% endif %}
				</div>
			{% endif %}
		</div>

		<div class="col-xl-4">
			{% if peutVoirPaiements %}
			{# ---------- Paiements ---------- #}
			<div class="card si-bloc">
				<div class="si-bloc-tete"><h4>Paiements</h4></div>
				{% for paiement in commande.paiements|filter(p => not p.estAnnule) %}
					<div class="si-paiement">
						<div>
							<strong>{{ constant('App\\Entity\\Paiements::MODES_LABELS')[paiement.mode]|default(paiement.mode) }}</strong>
							<small class="d-block text-muted">{{ paiement.date ? paiement.date|date('d/m H:i') }}</small>
						</div>
						<div class="text-end">
							<strong>{{ paiement.montant|number_format(0, ',', ' ') }}</strong>
							{% if paiement.montantTotalEncaisse > paiement.montant %}<small class="d-block text-muted" title="Fonds de soutien {{ paiement.montantFondsSoutien|number_format(0, ',', ' ') }} F, frais de retrait {{ paiement.montantFraisRetrait|number_format(0, ',', ' ') }} F : payés par le client en plus, hors commande">+ {{ (paiement.montantTotalEncaisse - paiement.montant)|number_format(0, ',', ' ') }} de frais</small>{% endif %}
							<span class="d-block si-pastille si-pastille-{{ paiement.estValide ? 'vert' : (paiement.estRejete ? 'rouge' : 'orange') }}">{{ paiement.estValide ? 'Validé' : (paiement.estRejete ? 'Rejeté' : 'À valider') }}</span>
						</div>
					</div>
				{% endfor %}
				{% if reste > 0 and not annulee %}
					<div class="si-paiement">
						<div>
							<strong>Reste à payer</strong>
							{% if commande.dateLivraison %}<small class="d-block text-muted">à la livraison, {{ commande.dateLivraison|date('d/m') }}</small>{% endif %}
						</div>
						<div class="text-end">
							<strong>{{ reste|number_format(0, ',', ' ') }}</strong>
							<span class="d-block si-pastille si-pastille-orange">À encaisser</span>
						</div>
					</div>
				{% endif %}
				{% set part = totalTtc > 0 ? (totalPaye * 100 / totalTtc)|round : 0 %}
				<div class="si-jauge-piste mt-3"><span class="si-fond-vert" style="width: {{ min(part, 100) }}%"></span></div>
				<small class="text-muted">{{ part }} % payé{% if reste > 0 %} · reste {{ reste|number_format(0, ',', ' ') }} F{% endif %}</small>
			</div>
			{% endif %}

			{# ---------- Livraison : livrée ou pas, quand, par qui, reçue par qui (docs/documents-livraisons.md) ---------- #}
			{% include 'commandes/_livraison.html.twig' %}

			{# ---------- Fidélité (docs/fidelite.md) ---------- #}
			{% include 'fidelite/_commande.html.twig' %}

			{# ---------- Client ---------- #}
			{% if client %}
				<div class="card si-bloc">
					<div class="si-bloc-tete">
						<h4>Client</h4>
						{% if is_granted('ROLE_CLIENT') %}<a href="{{ path('app_clients_show', {publicId: client.publicId}) }}">Fiche</a>{% endif %}
					</div>
					<strong>{{ client.nomComplet }}</strong>
					{% if client.telephone %}<small class="d-block text-muted">{{ client.telephone }}</small>{% endif %}
				</div>
			{% endif %}

			{# ---------- Historique ---------- #}
			<div class="card si-bloc">
				<div class="si-bloc-tete"><h4>Historique</h4></div>
				{% for evenement in historique %}
					<div class="si-historique">
						<small class="text-muted">{{ evenement.date|date(evenement.date|date('Y-m-d') == 'now'|date('Y-m-d') ? 'H:i' : 'd/m') }}</small>
						<span>{{ evenement.texte }}</span>
					</div>
				{% endfor %}
			</div>
		</div>
	</div>
{% endblock %}
