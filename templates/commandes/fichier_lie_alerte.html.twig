{% extends 'base.html.twig' %}

{# Alerte avant l'impression : le fichier lié n'est plus celui enregistré (docs/mes-produits.md, règle « Fichier modifié »). #}

{% block title %}Fichier lié à vérifier{% endblock %}

{% block body %}
	<div class="card si-bloc" style="max-width:640px">
		<h3 class="text-danger"><i class="fas fa-exclamation-triangle me-1"></i>
			{% if etat == 'modifie' %}Le fichier a changé depuis le lien{% elseif etat == 'hors_atelier' %}Fichier sur le serveur de l'atelier{% else %}Fichier introuvable{% endif %}
		</h3>
		<p>
			<b>{{ lien.nom }}</b> · commande {{ ligne.commande.numero }}, {{ ligne.produitClient.nom }}.<br>
			{% if etat == 'modifie' %}Son empreinte ne correspond plus à celle enregistrée le {{ lien.le|date('d/m') }} : quelqu'un l'a modifié dans le dossier du client. Faites-le revérifier par le prépresse avant d'imprimer.
			{% elseif etat == 'hors_atelier' %}Le site en ligne ne garde que la référence du fichier. Ouvrez-le depuis l'ERP de l'atelier.
			{% else %}Il n'est plus dans le dossier du client (déplacé ou renommé). Le prépresse doit le retrouver et refaire le lien.{% endif %}
		</p>
		<div class="d-flex flex-wrap gap-2">
			<a href="{{ path('app_commandes_show', {id: ligne.commande.id}) }}" class="btn btn-light btn-sm">Retour à la commande</a>
			{% if etat == 'modifie' and is_granted('ROLE_PREPRESSE') %}<a href="{{ path('app_commande_fichier_lie', {id: ligne.id, quandMeme: 1}|merge(app.request.query.get('role') == 'decoupe' ? {role: 'decoupe'} : {})) }}" class="btn btn-outline-danger btn-sm">Ouvrir quand même</a>{% endif %}
		</div>
	</div>
{% endblock %}
