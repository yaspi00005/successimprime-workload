{% extends 'base.html.twig' %}

{#
	Documents de facturation (maquette FD06) : tous les types du mois,
	leur statut, la commande liée ; fenêtre « Nouveau document » (FD01).
	Les onglets et l'encaissé suivent les droits de la personne.
#}

{% block title %}Documents de facturation{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/facturation.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
	{% set nomMois = moisChoix[mois|date('Y-m')]|default(mois|date('m/Y')) %}
	<div class="fd-page">
		<div class="fd-entete">
			<div>
				<div class="fd-fil">Ventes › Facturation</div>
				<h1>Documents de facturation</h1>
			</div>
			<div class="fd-actions">
				<a href="{{ path('app_factures_export', {mois: mois|date('Y-m'), type: type}) }}" class="btn fd-btn-blanc"><i class="fa fa-download me-1"></i>Exporter pour la comptabilité</a>
				<button type="button" class="btn btn-danger" data-fd-ouvrir="fd-nouveau">+ Nouveau document</button>
			</div>
		</div>

		<div class="fd-kpis">
			<div class="fd-kpi">
				<span>Facturé en {{ nomMois|split(' ')|first|lower }}</span>
				<b>{{ chiffres.facture|number_format(0, ',', ' ') }} F</b>
				<small>{{ chiffres.nbFactures }} facture{{ chiffres.nbFactures > 1 ? 's' }}{% if chiffres.avoirs > 0 %} · avoirs − {{ chiffres.avoirs|number_format(0, ',', ' ') }} F{% endif %}</small>
			</div>
			{% if voirEncaisse %}
				<div class="fd-kpi">
					<span>Encaissé</span>
					<b class="fd-vert">{{ chiffres.encaisse|number_format(0, ',', ' ') }} F</b>
					<small>{% if chiffres.aConfirmer > 0 %}dont {{ chiffres.aConfirmer|number_format(0, ',', ' ') }} F à confirmer{% else %}rien à confirmer{% endif %}</small>
				</div>
			{% endif %}
			<div class="fd-kpi">
				<span>À encaisser</span>
				<b class="fd-bleu">{{ voirEncaisse ? chiffres.aEncaisser|number_format(0, ',', ' ') ~ ' F' : chiffres.nbOuvertes }}</b>
				<small>{{ chiffres.nbOuvertes }} facture{{ chiffres.nbOuvertes > 1 ? 's' }} ouverte{{ chiffres.nbOuvertes > 1 ? 's' }}</small>
			</div>
			<div class="fd-kpi">
				<span>Échu</span>
				<b class="fd-rouge">{{ voirEncaisse ? chiffres.echu|number_format(0, ',', ' ') ~ ' F' : chiffres.nbEchues }}</b>
				<small>{{ chiffres.nbEchues }} facture{{ chiffres.nbEchues > 1 ? 's' }}{% if chiffres.nbEchues > 0 %} · relance auto{% endif %}</small>
			</div>
		</div>

		<div class="fd-carte">
			<form method="get" class="fd-barre">
				<div class="fd-pastilles bleu">
					<a href="{{ path('app_factures_index', {mois: mois|date('Y-m'), q: q}) }}" class="fd-pastille {{ type == '' ? 'actif' }}">Tous</a>
					{% for cle, libelle in onglets %}
						<a href="{{ path('app_factures_index', {mois: mois|date('Y-m'), type: cle, q: q}) }}" class="fd-pastille {{ type == cle ? 'actif' }}">{{ libelle }}</a>
					{% endfor %}
				</div>
				<div class="fd-filtres">
					<input type="hidden" name="type" value="{{ type }}">
					<input type="search" name="q" value="{{ q }}" class="form-control form-control-sm" placeholder="Numéro, client, commande" aria-label="Rechercher">
					<select name="mois" class="form-select form-select-sm" aria-label="Mois" onchange="this.form.submit()">
						{% for cle, libelle in moisChoix %}<option value="{{ cle }}" {{ cle == mois|date('Y-m') ? 'selected' }}>{{ libelle }}</option>{% endfor %}
					</select>
				</div>
			</form>

			<div class="table-responsive">
				<table class="fd-table fd-liste">
					<thead><tr><th>Type</th><th>Numéro</th><th>Client</th><th>Date</th><th class="num">Montant</th><th>Statut</th><th>Lié à</th><th></th></tr></thead>
					<tbody>
						{% for d in documents %}
							<tr>
								<td><span class="fd-badge {{ d.type }}">{{ d.libelle }}</span></td>
								<td><b>{% if d.url %}<a href="{{ d.url }}">{{ d.numero }}</a>{% else %}{{ d.numero }}{% endif %}</b></td>
								<td>{{ d.client }}</td>
								<td class="fd-muet">{{ d.date|date('d/m') }}</td>
								<td class="num"><b>{% if d.montant is not null %}{{ d.montant < 0 ? '− ' }}{{ (d.montant|abs)|number_format(0, ',', ' ') }} F{% else %}{{ d.montantTexte }}{% endif %}</b></td>
								<td><span class="fd-badge {{ d.classe }}">{{ d.statut }}</span></td>
								<td>{% if d.commande %}<a href="{{ d.commandeUrl }}" class="fd-lien">{{ d.commande }}</a>{% else %}<span class="fd-muet">—</span>{% endif %}</td>
								<td class="num">{% if d.pdf %}<a href="{{ d.pdf }}" target="_blank" class="fd-lien">PDF</a>{% endif %}</td>
							</tr>
						{% else %}
							<tr><td colspan="8" class="text-center fd-muet py-4">Aucun document en {{ nomMois|lower }}{{ q ? ' pour « ' ~ q ~ ' »' }}.</td></tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	{# FENÊTRE « NOUVEAU DOCUMENT » (FD01) #}
	<div class="fd-fond-modal" id="fd-nouveau" hidden>
		<form method="post" action="{{ path('app_factures_nouveau_document') }}" class="fd-page fd-modal" role="dialog" aria-modal="true" aria-labelledby="fd-nouveau-titre">
			<input type="hidden" name="_token" value="{{ csrf_token('nouveau-document') }}">
			<div class="d-flex justify-content-between align-items-center mb-3">
				<h2 id="fd-nouveau-titre" class="fd-modal-titre">Nouveau document de facturation</h2>
				<button type="button" class="btn-close" data-fd-fermer aria-label="Fermer"></button>
			</div>
			<div class="fd-types">
				{% set cartes = [
					{cle: 'devis', titre: 'Devis', texte: 'Proposer un prix au client avant la commande', note: 'Prix ferme 15 jours', couleur: 'devis', droit: nouveau.droits.devis},
					{cle: 'proforma', titre: 'Facture proforma', texte: 'Pour une administration ou un client qui doit obtenir un accord de paiement', note: 'Sans valeur comptable', couleur: 'proforma', droit: true},
					{cle: 'acompte', titre: 'Facture d\'acompte', texte: 'Demander l\'acompte qui lance la production', note: 'Déduite de la facture finale', couleur: 'acompte', droit: true},
					{cle: 'facture', titre: 'Facture', texte: 'Facturer une commande livrée ou retirée', note: 'Numéro définitif à la validation', couleur: 'facture', droit: true},
					{cle: 'avoir', titre: 'Avoir', texte: 'Annuler tout ou partie d\'une facture déjà validée', note: 'Une facture validée ne se modifie pas', couleur: 'avoir', droit: nouveau.droits.avoir},
					{cle: 'bl', titre: 'Bon de livraison', texte: 'Liste de ce qui est remis, signé à la réception', note: 'Code de réception ou signature', couleur: 'bl', droit: nouveau.droits.bl},
					{cle: 'recu', titre: 'Reçu de paiement', texte: 'Prouver un paiement reçu', note: 'Envoyé par WhatsApp automatiquement', couleur: 'recu', droit: nouveau.droits.recu},
				] %}
				{% for c in cartes %}
					<label class="fd-type {{ not c.droit ? 'fd-inactif' }}" {% if not c.droit %}title="Vous n'avez pas ce droit"{% endif %}>
						<input type="radio" name="type" value="{{ c.cle }}" {{ c.cle == 'facture' ? 'checked' }} {{ not c.droit ? 'disabled' }}>
						<b><span class="fd-puce {{ c.couleur }}"></span>{{ c.titre }}</b>
						<small>{{ c.texte }}</small>
						<em class="{{ c.couleur }}">{{ c.note }}</em>
					</label>
				{% endfor %}
				<div class="fd-type fd-info">Numérotation automatique par type<br><span>FAC · FA-2026-0001 · AV-2026-0001 · R-000123 · BL…</span></div>
			</div>

			{# Point de départ, selon le type choisi #}
			<div class="mt-3" data-depart="facture proforma acompte">
				<div class="fd-titre-bloc"><span data-titre-type>Facture</span> · partir de</div>
				<div class="fd-choix bleu">
					<label><input type="radio" name="depart" value="commande" checked><b>Une commande</b>
						<select name="commande" class="form-select form-select-sm mt-1" aria-label="Commande">
							{% for c in nouveau.commandes %}<option value="{{ c.id }}">{{ c.libelle }}</option>{% else %}<option value="">Aucune commande à facturer</option>{% endfor %}
						</select>
						<small class="fd-vert" data-seulement-pas="acompte">Lignes, remise et client repris automatiquement</small>
						<span class="d-flex align-items-center gap-2 mt-1" data-seulement-acompte><small>Acompte de</small>
							<select name="acompte" class="form-select form-select-sm" style="width:auto" aria-label="Part de l'acompte">
								{% for pc in [30, 50, 70, 100] %}<option value="{{ pc }}" {{ pc == 50 ? 'selected' }}>{{ pc }} %</option>{% endfor %}
							</select><small>de la commande</small></span></label>
					<label data-seulement="facture"><input type="radio" name="depart" value="devis" {{ nouveau.devis is empty ? 'disabled' }}><b>Un devis accepté</b>
						<select name="devis" class="form-select form-select-sm mt-1" aria-label="Devis accepté">
							{% for d in nouveau.devis %}<option value="{{ d.id }}">{{ d.libelle }}</option>{% else %}<option value="">Aucun devis accepté</option>{% endfor %}
						</select>
						<small>pour un travail sans commande atelier</small></label>
					<label><input type="radio" name="depart" value="vide"><b>Document vide</b><small>vente au comptoir, service : saisie d'abord en commande</small></label>
				</div>
			</div>
			<div class="mt-3" data-depart="bl recu" hidden>
				<div class="fd-titre-bloc">Pour la commande</div>
				<select name="commande" class="form-select" aria-label="Commande" disabled>
					{% for c in nouveau.commandes %}<option value="{{ c.id }}">{{ c.libelle }}</option>{% endfor %}
				</select>
			</div>
			<div class="mt-3" data-depart="avoir" hidden>
				<div class="fd-titre-bloc">Facture validée à corriger</div>
				<select name="facture" class="form-select" aria-label="Facture validée" disabled>
					{% for f in nouveau.factures %}<option value="{{ f.id }}">{{ f.libelle }}</option>{% else %}<option value="">Aucune facture validée</option>{% endfor %}
				</select>
			</div>
			<div class="mt-3 fd-muet" data-depart="devis" hidden>Le devis s'ouvre dans son écran : client, lignes, validité.</div>

			<div class="d-flex justify-content-end gap-2 mt-4">
				<button type="button" class="btn fd-btn-blanc" data-fd-fermer>Annuler</button>
				<button type="submit" class="btn btn-danger" data-bouton-creer>Créer la facture</button>
			</div>
		</form>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
	(function () {
		var fond = document.getElementById('fd-nouveau');
		if (!fond) return;
		var form = fond.querySelector('form');
		var noms = {devis: 'le devis', proforma: 'la proforma', facture: 'la facture', avoir: 'l\'avoir', bl: 'le bon de livraison', recu: 'le reçu'};
		var titres = {facture: 'Facture', proforma: 'Proforma', acompte: 'Facture d\'acompte'};
		noms.acompte = 'la facture d\'acompte';
		function ouvrir() { fond.hidden = false; form.querySelector('input[name=type]:checked').focus(); }
		function fermer() { fond.hidden = true; }
		function maj() {
			var type = (form.querySelector('input[name=type]:checked') || {}).value;
			form.querySelectorAll('[data-depart]').forEach(function (bloc) {
				var visible = bloc.dataset.depart.split(' ').indexOf(type) >= 0;
				bloc.hidden = !visible;
				bloc.querySelectorAll('select, input').forEach(function (c) { c.disabled = !visible || (c.type === 'radio' && c.dataset.verrou === '1'); });
			});
			form.querySelectorAll('[data-seulement]').forEach(function (l) {
				var ok = l.dataset.seulement === type;
				l.hidden = !ok;
				if (!ok) { var r = l.querySelector('input'); if (r.checked) form.querySelector('input[name=depart][value=commande]').checked = true; }
			});
			form.querySelectorAll('[data-seulement-acompte]').forEach(function (e) { e.hidden = type !== 'acompte'; e.querySelector('select').disabled = type !== 'acompte'; });
			form.querySelectorAll('[data-seulement-pas]').forEach(function (e) { e.hidden = e.dataset.seulementPas === type; });
			var t = form.querySelector('[data-titre-type]'); if (t && titres[type]) t.textContent = titres[type];
			form.querySelector('[data-bouton-creer]').textContent = 'Créer ' + (noms[type] || 'le document');
		}
		form.querySelectorAll('input[name=depart][disabled]').forEach(function (r) { r.dataset.verrou = '1'; });
		document.querySelectorAll('[data-fd-ouvrir="fd-nouveau"]').forEach(function (b) { b.addEventListener('click', ouvrir); });
		fond.querySelectorAll('[data-fd-fermer]').forEach(function (b) { b.addEventListener('click', fermer); });
		fond.addEventListener('click', function (e) { if (e.target === fond) fermer(); });
		document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !fond.hidden) fermer(); });
		form.addEventListener('change', function (e) {
			if (e.target.name === 'type') maj();
			if (e.target.tagName === 'SELECT') { var r = e.target.closest('label') && e.target.closest('label').querySelector('input[name=depart]'); if (r && !r.disabled) r.checked = true; }
		});
		maj();
		if (new URLSearchParams(location.search).get('nouveau') === '1') ouvrir();
	}());
	</script>
{% endblock %}
