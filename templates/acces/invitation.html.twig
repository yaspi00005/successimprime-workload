{% extends 'base.html.twig' %}

{% block title %}Invitation de {{ nom }}{% endblock %}

{% block body %}
	<div class="row">
		<div class="col-xl-7">
			<section class="card si-em-bloc">
				{% if lien %}
					<h2>Lien d'activation de {{ nom }}</h2>
					<p>Envoyez ce message maintenant : le lien ne s'affichera plus. Il marche 7 jours. {{ nom }} l'ouvre sur son téléphone, choisit son code PIN, et ce téléphone est enregistré.</p>
					<pre class="si-em-message">{{ message }}</pre>
					<div class="d-flex flex-wrap gap-2">
						<a class="btn btn-success" href="https://wa.me/{{ whatsapp }}?text={{ message|url_encode }}" target="_blank" rel="noopener"><i class="fab fa-whatsapp me-1"></i>Envoyer par WhatsApp</a>
						<a class="btn si-btn-discret" href="sms:+{{ whatsapp }}?body={{ message|url_encode }}">Envoyer par SMS</a>
						<button type="button" class="btn si-btn-discret" data-si-copier="{{ lien }}">Copier le lien</button>
						<a class="btn si-btn-discret" href="{{ path('app_acces_index', {_fragment: 'u' ~ utilisateur.id}) }}">Accès à l'application</a>
					</div>
				{% else %}
					<h2>Lien déjà affiché</h2>
					<p>Par sécurité, un lien d'activation ne s'affiche qu'une fois. Pour en envoyer un nouveau à {{ nom }}, utilisez « Renvoyer » : l'ancien ne marchera plus.</p>
					<a class="btn si-btn-discret" href="{{ path('app_acces_index', {_fragment: 'u' ~ utilisateur.id}) }}">Accès à l'application</a>
				{% endif %}
			</section>
		</div>
	</div>
	<script>
		document.querySelectorAll('[data-si-copier]').forEach(function (b) {
			b.addEventListener('click', function () {
				navigator.clipboard && navigator.clipboard.writeText(b.dataset.siCopier).then(function () { b.textContent = 'Lien copié'; });
			});
		});
	</script>
{% endblock %}
