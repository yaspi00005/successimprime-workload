{% extends 'base.html.twig' %}

{% set token = csrf_token(jeton) %}
{% set cli = b.commande.clients %}

{% block title %}Livraison {{ b.numero }}{{ cli ? ' · ' ~ cli.nomComplet }}{% endblock %}

{% block header_actions %}
	<li class="nav-item"><a href="{{ path('app_bons_livraison_imprimer', {id: b.id}) }}" class="btn btn-light btn-sm si-btn-entete" target="_blank"><i class="fas fa-file-pdf me-1"></i>Bon de livraison</a></li>
	{% if whatsapp %}<li class="nav-item"><a href="https://wa.me/{{ whatsapp }}?text={{ ('Bonjour, votre livraison ' ~ b.numero ~ (b.prevuLe ? ' est prévue le ' ~ b.prevuLe|date('d/m') : '') ~ (b.creneau ? ' entre ' ~ b.creneau|replace({'-': ' et '}) : '') ~ '. Succès Imprim')|url_encode }}" class="btn btn-success btn-sm" target="_blank" rel="noopener"><i class="fab fa-whatsapp me-1"></i>WhatsApp client</a></li>{% endif %}
{% endblock %}

{% block stylesheets %}<link href="{{ asset('css/livraisons.css') }}" rel="stylesheet">{% endblock %}

{% block body %}
	<div class="si-tr si-tr-detail">
		{# Livrée ou pas, à quel moment, par qui, reçue par qui. #}
		{% set e = b.etatSuivi %}
		{% set le = b.momentSuivi %}
		<section class="card si-lv-resume">
			<div><small>Statut</small><span class="si-lv-badge si-lv-badge-{{ e }}">{{ attribute(constant('App\\Entity\\BonLivraison::ETATS_SUIVI'), e) }}</span></div>
			<div><small>{{ e == 'livree' ? 'Remise le' : (e == 'echec' ? 'Échec le' : (e == 'en_tournee' ? 'Depuis' : 'Prévue le')) }}</small><b>{% if le %}{{ le|date('d/m/Y') }} à {{ le|date('H:i') }}{% elseif b.prevuLe %}{{ b.prevuLe|date_fr('EEE d/MM') }}{{ b.creneau ? ' · ' ~ b.creneau }}{% else %}non planifiée{% endif %}</b></div>
			<div><small>Livreur</small><b>{{ b.livreurSuivi ? b.livreurSuivi|nom_pointage : 'à choisir' }}</b></div>
			<div><small>{{ e == 'echec' ? 'Raison' : 'Reçue par' }}</small><b{{ e == 'echec' ? ' class="si-lv-motif"' }}>{{ e == 'echec' ? b.echecMotif : (b.receptionnaireSuivi ?? '—') }}</b></div>
			{% if e != 'echec' and b.echecLe %}<div style="grid-column: 1 / -1"><small>Échec précédent</small><b class="si-lv-motif">{{ b.echecLe|date('d/m/Y H:i') }}{{ b.echecPar ? ' · ' ~ b.echecPar|nom_pointage }} : {{ b.echecMotif }}</b></div>{% endif %}
		</section>

		<section class="card si-tr-etapes">
			{% for cle, libelle in constant('App\\Entity\\BonLivraison::ETAPES') %}
				{% set le = b.etapes[cle] %}
				<div class="si-tr-etape{{ le ? ' si-tr-fait' }}">
					<span>{{ le ? '✓' : loop.index }}</span>
					<b>{{ libelle }}</b>
					<small>{{ le ? le|date('H:i') : '—' }}</small>
				</div>
			{% endfor %}
		</section>

		<div class="si-tr-colonnes">
			<div>
				<section class="card si-ac-bloc">
					<h2>Contenu</h2>
					<div class="table-responsive">
						<table class="table align-middle">
							<thead><tr><th>Article</th><th class="text-end">Commandé</th><th class="text-end">Livré</th><th class="text-end">Reste</th></tr></thead>
							<tbody>
								{% for l in b.lignes %}
									{% set livre = b.statut == 'livre' ? l.quantiteLivree : 0 %}
									<tr><td>{{ l.designation }}</td><td class="text-end">{{ l.quantiteCommandee }}</td><td class="text-end">{{ b.statut == 'livre' ? livre : '—' }}</td><td class="text-end">{% if b.statut == 'livre' and l.quantiteCommandee > livre %}<span class="si-tr-badge si-tr-reste">{{ l.quantiteCommandee - livre }}</span>{% else %}{{ b.statut == 'livre' ? 0 : '—' }}{% endif %}</td></tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</section>
				<section class="card si-ac-bloc">
					<h2>Preuves de livraison</h2>
					<div class="si-tr-preuves">
						{% for f in b.photos %}<a href="{{ path('app_livraisons_bl_preuve', {id: b.id, f: f}) }}" target="_blank"><img src="{{ path('app_livraisons_bl_preuve', {id: b.id, f: f}) }}" alt="Photo {{ loop.index }} de la remise"></a>{% endfor %}
						{% if b.signature %}
							<figure class="si-tr-sign"><img src="{{ path('app_livraisons_bl_preuve', {id: b.id, f: b.signature}) }}" alt="Signature du client"><figcaption>{{ b.signataire ?? 'Signature' }}</figcaption></figure>
						{% else %}
							<div class="si-tr-attente">Signature attendue</div>
						{% endif %}
					</div>
					{% if b.remisePosition %}
						<p class="si-pg-note mt-2 mb-0"><i class="fas fa-location-dot me-1"></i>Remise faite à <a href="https://www.openstreetmap.org/?mlat={{ b.remisePosition[0] }}&mlon={{ b.remisePosition[1] }}#map=18/{{ b.remisePosition[0] }}/{{ b.remisePosition[1] }}" target="_blank" rel="noopener">{{ b.remisePosition[0]|number_format(5, '.') }}, {{ b.remisePosition[1]|number_format(5, '.') }}</a></p>
					{% elseif b.statut == 'livre' %}
						<p class="si-pg-note mt-2 mb-0">Position GPS non reçue à la remise.</p>
					{% endif %}
				</section>
				{% if b.statut == 'livre' and b.livreur %}
					<section class="card si-ac-bloc">
						<h2>Points du livreur · {{ b.livreur|nom_pointage }}</h2>
						<ul class="si-tr-heures">
							{% for l in points.lignes %}
								<li><span>{{ l.libelle }}</span><span class="si-tr-pts{{ l.points < 0 ? ' si-tr-pts-moins' }}">{{ l.points >= 0 ? '+' }}{{ l.points }} pts</span></li>
							{% else %}
								<li><span>Aucun point sur cette livraison.</span></li>
							{% endfor %}
							{% if points.attente %}<li><span>Encaissement : compté si la caisse le valide le jour de la remise</span><span class="si-tr-badge">En attente</span></li>{% endif %}
						</ul>
						{% if b.retardJustifie %}
							<form method="post" action="{{ path('app_livraisons_bl_points', {id: b.id, action: 'annuler_retard'}) }}" class="si-tr-provisoire mt-2 d-flex justify-content-between align-items-center gap-2"><input type="hidden" name="_token" value="{{ csrf_token(jeton) }}"><span>Retard justifié : {{ b.retardJustifie }}</span><button class="btn btn-light btn-sm si-btn-entete">Annuler</button></form>
						{% elseif retard is not null and retard > constant('App\\Service\\SuiviMetiers\\PointsLivreur::RETARD_MAX') %}
							<form method="post" action="{{ path('app_livraisons_bl_points', {id: b.id, action: 'justifier'}) }}" class="d-flex gap-2 mt-2"><input type="hidden" name="_token" value="{{ csrf_token(jeton) }}"><input name="motif" required maxlength="150" class="form-control form-control-sm" placeholder="Retard de {{ retard|minutes }} : motif (panne, client absent…)"><button class="btn btn-light btn-sm si-btn-entete text-nowrap">Justifier</button></form>
						{% endif %}
						{% if b.erreurLivraison %}
							<form method="post" action="{{ path('app_livraisons_bl_points', {id: b.id, action: 'annuler_erreur'}) }}" class="si-tr-provisoire mt-2 d-flex justify-content-between align-items-center gap-2"><input type="hidden" name="_token" value="{{ csrf_token(jeton) }}"><span>Erreur notée : {{ b.erreurLivraison }}</span><button class="btn btn-light btn-sm si-btn-entete">Annuler</button></form>
						{% else %}
							<form method="post" action="{{ path('app_livraisons_bl_points', {id: b.id, action: 'erreur'}) }}" class="d-flex gap-2 mt-2"><input type="hidden" name="_token" value="{{ csrf_token(jeton) }}"><input name="motif" required maxlength="150" class="form-control form-control-sm" placeholder="Colis abîmé ou erreur de livraison : motif"><button class="btn btn-light btn-sm si-btn-entete text-nowrap">Noter</button></form>
						{% endif %}
					</section>
				{% endif %}
			</div>

			<aside>
				{# Montants : avec le droit Paiements (comme le planning des livraisons) ou pour qui encaisse. #}
				{% if is_granted('ROLE_PAIEMENT_VOIR') or is_granted('ROLE_PAIEMENT_ENCAISSER') %}
				<section class="card si-ac-bloc">
					<h2>Encaissement à la livraison</h2>
					<p class="d-flex justify-content-between mb-2"><span>Reste à payer</span><b>{{ reste|number_format(0, ',', ' ') }} F</b></p>
					{% if b.paiementLivraison %}
						<p class="si-p-ok mb-0">{{ b.paiementLivraison.montant|number_format(0, ',', ' ') }} F {{ attribute(constant('App\\Entity\\BonLivraison::MODES_ENCAISSEMENT'), b.encaisseMode) ?? '' }} · validé à la caisse.</p>
					{% elseif b.encaissementProvisoire %}
						<p class="mb-2"><b>{{ b.encaisseMontant|number_format(0, ',', ' ') }} F</b> · {{ attribute(constant('App\\Entity\\BonLivraison::MODES_ENCAISSEMENT'), b.encaisseMode) }} · {{ b.encaisseLe|date('d/m H:i') }}</p>
						<p class="si-tr-provisoire">Saisi par le livreur : provisoire jusqu'à la validation à la caisse.</p>
						{% if comptes is not empty %}
							<form method="post" action="{{ path('app_livraisons_bl_encaissement', {id: b.id}) }}" class="si-py-form">
								<input type="hidden" name="_token" value="{{ token }}">
								<label>Compte qui reçoit<select name="compte" class="form-select form-select-sm" required><option value="">—</option>{% for c in comptes %}<option value="{{ c.id }}"{{ b.encaisseMode == 'orange_money' and 'orange' in c.nom|lower ? ' selected' }}>{{ c.nom }}</option>{% endfor %}</select></label>
								<button class="btn btn-primary btn-sm">Valider l'encaissement</button>
							</form>
						{% endif %}
					{% elseif b.encaisseMode == 'credit' %}
						<p class="mb-0">Crédit client : rien encaissé à la livraison.</p>
					{% else %}
						<p class="text-muted mb-0">Rien encaissé pour l'instant.</p>
					{% endif %}
				</section>
				{% endif %}
				<section class="card si-ac-bloc">
					<h2>Planification</h2>
					{% if b.statut == 'brouillon' %}<p class="si-pg-note">Le bon doit être validé (préparé) pour apparaître dans la tournée.</p>{% endif %}
					{% if e == 'echec' %}<p class="si-tr-provisoire">Échec : choisissez un nouveau jour (et un livreur) puis enregistrez, la livraison revient dans sa tournée.</p>{% endif %}
					<form method="post" action="{{ path('app_livraisons_bl_planifier', {id: b.id}) }}" class="si-py-form">
						<input type="hidden" name="_token" value="{{ token }}">
						<label>Livreur<select name="livreur" class="form-select form-select-sm"><option value="">—</option>{% for l in livreurs %}<option value="{{ l.id }}"{{ l == b.livreur ? ' selected' }}>{{ l|nom_pointage }}</option>{% endfor %}</select></label>
						<label>Jour<input type="date" name="jour" class="form-control form-control-sm" value="{{ b.prevuLe ? b.prevuLe|date('Y-m-d') }}"></label>
						<label>Créneau<input name="creneau" maxlength="20" class="form-control form-control-sm" value="{{ b.creneau }}" placeholder="14:00-16:00"></label>
						<label>Ordre dans la tournée<input type="number" name="ordre" min="1" class="form-control form-control-sm" value="{{ b.ordreTournee }}"></label>
						<button class="btn btn-primary btn-sm">Enregistrer</button>
					</form>
				</section>
			</aside>
		</div>
	</div>
{% endblock %}
