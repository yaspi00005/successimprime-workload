{% extends 'base.html.twig' %}

{% block title %}
	Livraisons
{% endblock %}

{% block body %}

	<div
		class="side-app">

		{# ==========================================================
										       PAGE HEADER
										       ========================================================== #}
		<div class="page-header">

			<ol class="breadcrumb">

				<li class="breadcrumb-item">
					<a href="#">
						Gestion commerciale
					</a>
				</li>

				<li class="breadcrumb-item active">
					Livraisons
				</li>

			</ol>

		</div>


		{# ==========================================================
										       COMPTEURS
										       ========================================================== #}
		<div class="row">

			<div class="col-xl-3 col-md-6">

				<div class="card">

					<div class="card-body">

						<div class="d-flex align-items-center">

							<div class="mr-3">

								<span class="avatar avatar-lg bg-primary-transparent text-primary">

									<i class="fa fa-box"></i>

								</span>

							</div>

							<div>

								<div class="text-muted">
									Prêtes à livrer
								</div>

								<h3 class="mb-0">
									{{ compteurs.prete|default(0) }}
								</h3>

							</div>

						</div>

					</div>

				</div>

			</div>


			<div class="col-xl-3 col-md-6">

				<div class="card">

					<div class="card-body">

						<div class="d-flex align-items-center">

							<div class="mr-3">

								<span class="avatar avatar-lg bg-warning-transparent text-warning">

									<i class="fa fa-truck"></i>

								</span>

							</div>

							<div>

								<div class="text-muted">
									En livraison
								</div>

								<h3 class="mb-0">
									{{ compteurs.en_livraison|default(0) }}
								</h3>

							</div>

						</div>

					</div>

				</div>

			</div>


			<div class="col-xl-3 col-md-6">

				<div class="card">

					<div class="card-body">

						<div class="d-flex align-items-center">

							<div class="mr-3">

								<span class="avatar avatar-lg bg-success-transparent text-success">

									<i class="fa fa-check-circle"></i>

								</span>

							</div>

							<div>

								<div class="text-muted">
									Livrées
								</div>

								<h3 class="mb-0">
									{{ compteurs.livree|default(0) }}
								</h3>

							</div>

						</div>

					</div>

				</div>

			</div>


			<div class="col-xl-3 col-md-6">

				<div class="card">

					<div class="card-body">

						<div class="d-flex align-items-center">

							<div class="mr-3">

								<span class="avatar avatar-lg bg-info-transparent text-info">

									<i class="fa fa-shopping-cart"></i>

								</span>

							</div>

							<div>

								<div class="text-muted">
									Livraisons directes
								</div>

								<h3 class="mb-0">
									{{ compteurs.directe|default(0) }}
								</h3>

							</div>

						</div>

					</div>

				</div>

			</div>

		</div>


		{# ==========================================================
										       FILTRES
										       ========================================================== #}
		<div class="card mb-4">

			<div class="card-header">

				<h3 class="card-title mb-0">
					<i class="fa fa-filter mr-1"></i>
					Recherche et filtres
				</h3>

			</div>

			<div class="card-body">

				<form method="get" action="{{ path('app_livraisons_index') }}">

					<div
						class="row">

						{# RECHERCHE #}
						<div class="col-lg-4 col-md-6">

							<div class="form-group">

								<label class="form-label">
									Recherche
								</label>

								<input type="text" name="q" class="form-control" value="{{ filtres.q|default('') }}" placeholder="Produit, désignation..." autocomplete="off">

							</div>

						</div>


						{# STATUT #}
						<div class="col-lg-2 col-md-6">

							<div class="form-group">

								<label class="form-label">
									Statut
								</label>

								<select name="statut" class="form-control">

									<option value="">
										Tous
									</option>

									<option value="prete_livraison" {% if filtres.statut|default('') == 'prete_livraison' %} selected {% endif %}>
										Prête livraison
									</option>

									<option value="en_livraison" {% if filtres.statut|default('') == 'en_livraison' %} selected {% endif %}>
										En livraison
									</option>

									<option value="livree" {% if filtres.statut|default('') == 'livree' %} selected {% endif %}>
										Livrée
									</option>

								</select>

							</div>

						</div>


						{# ORIGINE #}
						<div class="col-lg-2 col-md-6">

							<div class="form-group">

								<label class="form-label">
									Origine
								</label>

								<select name="origine" class="form-control">

									<option value="">
										Toutes
									</option>

									<option value="production" {% if filtres.origine|default('') == 'production' %} selected {% endif %}>
										Production
									</option>

									<option value="directe" {% if filtres.origine|default('') == 'directe' %} selected {% endif %}>
										Livraison directe
									</option>

								</select>

							</div>

						</div>


						{# DATE DEBUT #}
						<div class="col-lg-2 col-md-6">

							<div class="form-group">

								<label class="form-label">
									Du
								</label>

								<input type="date" name="date_debut" class="form-control" value="{{ filtres.date_debut|default('') }}">

							</div>

						</div>


						{# DATE FIN #}
						<div class="col-lg-2 col-md-6">

							<div class="form-group">

								<label class="form-label">
									Au
								</label>

								<input type="date" name="date_fin" class="form-control" value="{{ filtres.date_fin|default('') }}">

							</div>

						</div>


						{# RETRAIT #}
						<div class="col-lg-2 col-md-6">

							<div class="form-group">

								<label class="form-label">
									Retrait
								</label>

								<select name="retrait" class="form-control">

									<option value="">
										Tous
									</option>

									<option value="livreur" {% if filtres.retrait|default('') == 'livreur' %} selected {% endif %}>
										Livrée par nous
									</option>

									<option value="client" {% if filtres.retrait|default('') == 'client' %} selected {% endif %}>
										Récupérée par le client
									</option>

								</select>

							</div>

						</div>

					</div>


					<div class="d-flex justify-content-end">

						<a href="{{ path('app_livraisons_index') }}" class="btn btn-light mr-2">
							<i class="fa fa-undo mr-1"></i>
							Réinitialiser
						</a>

						<button type="submit" class="btn btn-primary">
							<i class="fa fa-search mr-1"></i>
							Rechercher
						</button>

					</div>

				</form>

			</div>

		</div>


		{# ==========================================================
										       LISTE (REGROUPÉE PAR COMMANDE)
										       ========================================================== #}

		{% macro carteCommande(groupe) %}

			<div class="card mb-3">

				<div class="card-header d-flex justify-content-between align-items-center flex-wrap">

					<div>

						<h3 class="card-title mb-0">

							{% if groupe.commande %}

								<a href="{{ path('app_commandes_show', { id: groupe.commande.id }) }}">
									Commande #{{ groupe.commande.numero|default(groupe.commande.id) }}
								</a>

							{% else %}

								Commande inconnue

							{% endif %}

						</h3>

						<small class="text-muted">

							{% if groupe.commande and groupe.commande.clients %}
								{{ groupe.commande.clients.nomComplet }}
								·
							{% endif %}

							{{ groupe.nbLignes }}
							ligne{{ groupe.nbLignes > 1 ? 's' : '' }}

						</small>

					</div>

					<div>

						{% if groupe.commande and groupe.commande.recupereParClient %}

							<span class="badge badge-secondary mr-1">
								<i class="fa fa-user mr-1"></i>
								Récupérée par le client
							</span>

						{% endif %}

						{% if groupe.toutesLivrees %}

							<span class="badge badge-success">
								<i class="fa fa-check-circle mr-1"></i>
								Commande entièrement livrée
							</span>

						{% elseif groupe.aucuneLivree %}

							<span class="badge badge-warning">
								Rien de livré ({{ groupe.nbLignes }} ligne{{ groupe.nbLignes > 1 ? 's' : '' }} en attente)
							</span>

						{% else %}

							<span class="badge badge-info">
								Livraison partielle : {{ groupe.nbLivrees }} / {{ groupe.nbLignes }} lignes livrées
							</span>

						{% endif %}

					</div>

				</div>


				<div class="card-body d-flex justify-content-between align-items-center flex-wrap">

					<div>

						{% if groupe.commande and groupe.commande.clients %}

							{% set client = groupe.commande.clients %}

							<div>
								<i class="fa fa-user text-muted mr-1"></i>
								{{ client.nomComplet }}
							</div>

							{% if client.telephone %}
								<div class="small text-muted">
									<i class="fa fa-phone mr-1"></i>
									{{ client.telephone }}
								</div>
							{% endif %}

						{% else %}

							<span class="text-muted">
								Aucun client renseigné
							</span>

						{% endif %}

					</div>

					<div>

						{% if groupe.commande %}

							<a href="{{ path( 'app_livraisons_commande', { id: groupe.commande.id } ) }}" class="btn btn-primary">
								<i class="fa fa-eye mr-1"></i>
								Voir
							</a>

						{% endif %}

					</div>

				</div>

			</div>

		{% endmacro %}


		{% if groupesALivrer|length == 0 and groupesLivrees|length == 0 and (rechercheActive or compteurs.livree|default(0) == 0) %}

			<div class="card">
				<div class="card-body text-center text-muted py-5">
					<i class="fa fa-truck fa-3x mb-3"></i>
					<div>
						Aucune livraison trouvée.
					</div>
				</div>
			</div>

		{% endif %}


		{% if groupesALivrer|length > 0 %}

			<h3 class="mb-3">
				<i class="fa fa-truck mr-1"></i>
				À livrer
				<span class="badge badge-light">{{ groupesALivrer|length }}</span>
			</h3>

			{% for groupe in groupesALivrer %}
				{{ _self.carteCommande(groupe) }}
			{% endfor %}

		{% endif %}


		{% if not rechercheActive and compteurs.livree|default(0) > 0 %}

			<div class="card mt-4">
				<div class="card-body text-center text-muted py-4">
					<i class="fa fa-check-circle fa-2x mb-2"></i>
					<div>
						{{ compteurs.livree }} commande{{ compteurs.livree > 1 ? 's' : '' }} déjà livrée{{ compteurs.livree > 1 ? 's' : '' }}.
					</div>
					<div class="small">
						Utilisez la recherche ci-dessus pour les retrouver (elles ne sont pas affichées ici pour garder la page rapide).
					</div>
				</div>
			</div>

		{% elseif groupesLivrees|length > 0 %}

			<h3 class="mb-3 mt-4">
				<i class="fa fa-check-circle mr-1"></i>
				Livrées
				<span class="badge badge-light">{{ groupesLivrees|length }}</span>
			</h3>

			{% for groupe in groupesLivrees %}
				{{ _self.carteCommande(groupe) }}
			{% endfor %}

		{% endif %}

	</div>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>
		document.addEventListener('DOMContentLoaded', function () {

document.querySelectorAll('.js-confirmer-livraison').forEach(function (formulaire) {

formulaire.addEventListener('submit', function (event) {

event.preventDefault();

const designation = formulaire.dataset.designation || 'cet article';

const quantite = formulaire.dataset.quantite || '';

Swal.fire({
icon: 'question',

title: 'Confirmer la livraison ?',

html: 'Confirmer la livraison de ' + '<strong>' + designation + '</strong> ?' + '<br><br>' + 'Quantité : <strong>' + quantite + '</strong>' + '<br><br>' + '<small>' + 'La sortie de stock sera enregistrée.' + '</small>',

showCancelButton: true,

confirmButtonText: 'Oui, confirmer',

cancelButtonText: 'Annuler',

reverseButtons: true

}).then(function (resultat) {

if (resultat.isConfirmed) {
formulaire.submit();
}

});

});

});

});
	</script>
{% endblock %}
