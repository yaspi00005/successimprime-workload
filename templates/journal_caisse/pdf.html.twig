<!DOCTYPE html>

<html lang="fr">

	<head>

		<meta charset="UTF-8">

		<title>Journal de caisse</title>

		<style>

			@page {
				margin: 14mm 12mm;
			}

			* {
				box-sizing: border-box;
			}

			body {
				margin: 0;
				font-family: DejaVu Sans, sans-serif;
				font-size: 8px;
				line-height: 1.35;
				color: #202938;
			}

			h1 {
				font-size: 16px;
				margin: 0 0 4px 0;
				color: #1643a3;
			}

			.periode {
				font-size: 10px;
				color: #555;
				margin-bottom: 14px;
			}

			table {
				width: 100%;
				border-collapse: collapse;
				margin-bottom: 18px;
			}

			th, td {
				border: 1px solid #d7dde5;
				padding: 4px 5px;
				text-align: left;
			}

			th {
				background-color: #1643a3;
				color: #ffffff;
				font-size: 8px;
			}

			.text-right {
				text-align: right;
			}

			.section-title {
				font-size: 12px;
				font-weight: bold;
				color: #1643a3;
				margin: 16px 0 6px 0;
			}

			.resume-cards td {
				border: none;
				padding: 6px 10px;
			}

			.resume-label {
				color: #666;
				font-size: 8px;
			}

			.resume-valeur {
				font-size: 12px;
				font-weight: bold;
			}

			.total-row td {
				font-weight: bold;
				background-color: #f2f4f8;
			}

		</style>

	</head>

	<body>

		<h1>Journal de caisse</h1>

		<div class="periode">
			Période du {{ filtres.dateDebut|date('d/m/Y') }} au {{ filtres.dateFin|date('d/m/Y') }}
			— généré le {{ "now"|date('d/m/Y H:i') }}
		</div>

		<div class="section-title">Résumé de la période</div>

		<table class="resume-cards">
			<tr>
				<td>
					<div class="resume-label">Entrées</div>
					<div class="resume-valeur">{{ rapportGlobal.entrees|number_format(0, ',', ' ') }} FCFA</div>
				</td>
				<td>
					<div class="resume-label">Sorties</div>
					<div class="resume-valeur">{{ rapportGlobal.sorties|number_format(0, ',', ' ') }} FCFA</div>
				</td>
				<td>
					<div class="resume-label">Variation de trésorerie</div>
					<div class="resume-valeur">{{ rapportGlobal.variationTresorerie|number_format(0, ',', ' ') }} FCFA</div>
				</td>
				<td>
					<div class="resume-label">Résultat net</div>
					<div class="resume-valeur">{{ rapportGlobal.resultatNet|number_format(0, ',', ' ') }} FCFA</div>
				</td>
			</tr>
		</table>

		<div class="section-title">Détail des comptes</div>

		<table>
			<thead>
				<tr>
					<th>Compte</th>
					<th>Type</th>
					<th>Portée</th>
					<th class="text-right">Mouvements (période)</th>
					<th>Dernier mouvement</th>
					<th class="text-right">Solde actuel (FCFA)</th>
				</tr>
			</thead>
			<tbody>
				{% for ligneCompte in soldes.comptes %}
					<tr>
						<td>{{ ligneCompte.compte.nom }}</td>
						<td>{{ ligneCompte.compte.typeLabel }}</td>
						<td>{{ ligneCompte.compte.porteeLabel }}</td>
						<td class="text-right">{{ ligneCompte.nombreMouvementsPeriode }}</td>
						<td>{{ ligneCompte.dernierMouvementPeriode ? ligneCompte.dernierMouvementPeriode|date('d/m/Y H:i') : '—' }}</td>
						<td class="text-right">{{ ligneCompte.solde|number_format(0, ',', ' ') }}</td>
					</tr>
				{% endfor %}
				<tr class="total-row">
					<td colspan="5">Total</td>
					<td class="text-right">{{ soldes.total|number_format(0, ',', ' ') }}</td>
				</tr>
			</tbody>
		</table>

		<div class="section-title">Mouvements de la période ({{ journalGlobal.nombre }})</div>

		<table>
			<thead>
				<tr>
					<th>Date</th>
					<th>Référence</th>
					<th>Type</th>
					<th>Compte source</th>
					<th>Compte destination</th>
					<th>Catégorie</th>
					<th>Libellé</th>
					<th>Agent</th>
					<th class="text-right">Entrée</th>
					<th class="text-right">Sortie</th>
					<th class="text-right">Transfert</th>
				</tr>
			</thead>
			<tbody>
				{% for ligne in journalGlobal.lignes %}
					{% set mouvement = ligne.mouvement %}
					<tr>
						<td>{{ mouvement.dateOperation ? mouvement.dateOperation|date('d/m/Y H:i') : '—' }}</td>
						<td>{{ mouvement.reference }}</td>
						<td>{{ mouvement.typeLabel }}</td>
						<td>{{ mouvement.compteSource ? mouvement.compteSource.nom : '—' }}</td>
						<td>{{ mouvement.compteDestination ? mouvement.compteDestination.nom : '—' }}</td>
						<td>{{ mouvement.categorieLabel }}</td>
						<td>{{ mouvement.libelle }}</td>
						<td>{{ mouvement.agent ? mouvement.agent.username : '—' }}</td>
						<td class="text-right">{{ ligne.entree > 0 ? ligne.entree|number_format(0, ',', ' ') : '' }}</td>
						<td class="text-right">{{ ligne.sortie > 0 ? ligne.sortie|number_format(0, ',', ' ') : '' }}</td>
						<td class="text-right">{{ ligne.transfert > 0 ? ligne.transfert|number_format(0, ',', ' ') : '' }}</td>
					</tr>
				{% else %}
					<tr>
						<td colspan="11" class="text-right" style="text-align: center;">Aucun mouvement sur cette période.</td>
					</tr>
				{% endfor %}
				<tr class="total-row">
					<td colspan="8">Total</td>
					<td class="text-right">{{ journalGlobal.totalEntrees|number_format(0, ',', ' ') }}</td>
					<td class="text-right">{{ journalGlobal.totalSorties|number_format(0, ',', ' ') }}</td>
					<td class="text-right">{{ journalGlobal.transferts|number_format(0, ',', ' ') }}</td>
				</tr>
			</tbody>
		</table>

	</body>

</html>
