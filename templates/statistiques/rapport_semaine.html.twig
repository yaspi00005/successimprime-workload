{% extends 'base.html.twig' %}
{% import 'statistiques/_macros.html.twig' as st %}

{#
	Rapport de la semaine : la version de la personne connectée. Les blocs
	n'existent que si RapportSemaine les a calculés (r.sections) : les
	montants et l'encaissement ne sont jamais dans la page sans le droit.
#}

{# Écart avec la semaine d'avant : « ▲ +12 % vs semaine 40 ». #}
{% macro ecart(valeur, avant, semaine) %}
	{% if avant is not null and avant > 0 %}
		{% set pct = ((valeur - avant) * 100 / avant)|round %}
		<span class="{{ pct >= 0 ? 'si-s-hausse' : 'si-s-baisse' }}"><i class="fas fa-caret-{{ pct >= 0 ? 'up' : 'down' }}"></i> {{ pct >= 0 ? '+' : '−' }}{{ pct|abs }} % vs semaine {{ semaine.avant.numero }}</span>
	{% else %}
		<span class="si-s-neutre">semaine {{ semaine.avant.numero }} : {{ avant ?? 0 }}</span>
	{% endif %}
{% endmacro %}

{% block title %}Rapport de la semaine{% endblock %}
{% block page_title %}Rapport de la semaine{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/statistiques.css') }}" rel="stylesheet">
{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_rapport_semaine_pdf', {semaine: semaine.code}) }}" class="btn btn-primary btn-sm si-btn-entete"><i class="far fa-file-pdf me-1"></i>Télécharger le PDF</a>
	</li>
{% endblock %}

{% block body %}
	{% set e = r.entreprise %}
	{% set p = r.perso %}
	{% set s = r.sections %}
	<div class="si-stats si-st">
		<header class="si-st-semaine-tete">
			<div>
				<h2>{{ semaine.titre }} · {{ semaine.libelle }}</h2>
				<p>
					{% if envoi %}Rapport envoyé le {{ envoi.envoyeLe|date('d/m/Y à H:i') }}.{% else %}{{ reglages }}.{% endif %}
					Chiffres recalculés à l’ouverture, selon vos droits.
				</p>
			</div>
			<nav class="si-st-semaine-nav" aria-label="Autres semaines">
				{% if precedente %}<a class="btn btn-sm si-st-nav-btn" href="{{ path('app_rapport_semaine', {semaine: precedente.code}) }}"><i class="fas fa-chevron-left me-1"></i>Semaine {{ precedente.numero }}</a>{% endif %}
				{% if suivante %}<a class="btn btn-sm si-st-nav-btn" href="{{ path('app_rapport_semaine', {semaine: suivante.code}) }}">Semaine {{ suivante.numero }}<i class="fas fa-chevron-right ms-1"></i></a>{% endif %}
			</nav>
		</header>
		<p>
			<span class="si-st-version"><i class="fas fa-user-shield"></i>
				{% if s.montants %}Version Direction : chiffres de l’entreprise
				{% elseif s.entreprise %}Chiffres de l’entreprise, sans les montants de vente
				{% else %}Votre version : vos propres chiffres{% endif %}
			</span>
		</p>

		{% if r.alertes is not empty or e is not null %}
			<section class="card si-st-bloc" aria-label="Alertes">
				<h2>À surveiller</h2>
				{% if r.alertes is empty %}
					<p class="si-st-rien mb-0"><i class="fas fa-check-circle me-1"></i>Rien d’anormal cette semaine.</p>
				{% else %}
					<ul class="si-st-alertes">
						{% for a in r.alertes %}
							<li class="{{ a.niveau == 'danger' ? 'danger' }}">
								<i class="fas {{ a.niveau == 'danger' ? 'fa-exclamation-circle' : 'fa-exclamation-triangle' }}"></i>
								<span>{{ a.texte }}</span>
								{% if a.route %}<a href="{{ path(a.route) }}">Voir</a>{% endif %}
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</section>
		{% endif %}

		{% if e is not null %}
			<h2 class="si-st-section-titre">Entreprise</h2>
			<div class="si-stats-kpis si-st-chiffres">
				{% if s.montants %}
					<article class="card si-stats-kpi">
						<h2>CA facturé</h2>
						<strong>{{ st.valeur(e.ca, 'fcfa') }}</strong>
						{{ _self.ecart(e.ca, e.ca_avant ?? null, semaine) }}
						{% if e.objectif_semaine is not null %}<small>objectif de la semaine {{ st.valeur(e.objectif_semaine, 'fcfa') }} ({{ (e.ca * 100 / e.objectif_semaine)|round }} %)</small>{% endif %}
					</article>
				{% endif %}
				<article class="card si-stats-kpi">
					<h2>Commandes</h2>
					<strong>{{ e.commandes }}</strong>
					{{ _self.ecart(e.commandes, e.commandes_avant, semaine) }}
				</article>
				<article class="card si-stats-kpi">
					<h2>m² imprimés</h2>
					<strong>{{ st.valeur(e.surface, 'm2') }}</strong>
					{{ _self.ecart(e.surface, e.surface_avant, semaine) }}
				</article>
				<article class="card si-stats-kpi">
					<h2>Nouveaux clients</h2>
					<strong>{{ e.nouveaux_clients }}</strong>
					<small>première commande cette semaine</small>
				</article>
				<article class="card si-stats-kpi">
					<h2>Devis signés</h2>
					<strong>{{ e.devis_signes }}</strong>
					<small>{{ e.devis_emis }} devis émis dans la semaine</small>
				</article>
				{% if s.encaissement %}
					<article class="card si-stats-kpi">
						<h2>Encaissé</h2>
						<strong>{{ st.valeur(e.encaisse, 'fcfa') }}</strong>
						<small>{{ e.taux_encaissement is not null ? 'taux d’encaissement ' ~ e.taux_encaissement|round ~ ' %' : 'aucune facture émise' }}</small>
					</article>
					<article class="card si-stats-kpi">
						<h2>Créances</h2>
						<strong>{{ st.valeur(e.creances, 'fcfa') }}</strong>
						<small>{{ e.factures_echues }} facture{{ e.factures_echues > 1 ? 's' }} échue{{ e.factures_echues > 1 ? 's' }}</small>
					</article>
				{% endif %}
			</div>

			<div class="si-st-semaine-grille">
				<section class="card si-st-bloc">
					<h2>Par agent</h2>
					<table class="table si-st-table">
						<thead><tr>
							<th>Agent</th>
							<th class="text-end">Commandes</th>
							{% if s.montants %}<th class="text-end">CA facturé</th>{% endif %}
						</tr></thead>
						<tbody>
							{% for a in e.agents %}
								<tr>
									<td>{{ a.nom }}</td>
									<td class="text-end">{{ a.commandes }}</td>
									{% if s.montants %}<td class="text-end">{{ st.valeur(a.ca, 'fcfa') }}</td>{% endif %}
								</tr>
							{% else %}
								<tr><td colspan="3" class="si-st-gris">Aucune commande ni facture cette semaine.</td></tr>
							{% endfor %}
						</tbody>
					</table>
				</section>
				{% if s.montants %}
					<div>
						{% if e.mois is not null %}
							{{ st.carte(e.mois|merge({libelle: 'CA facturé de ' ~ constant('App\\Service\\Finances\\Periode::MOIS')[e.mois.mois|date('n')], format: 'fcfa', cumul: true}), 'CA du mois au dimanche ' ~ semaine.dimanche|date('d/m')) }}
						{% endif %}
						<section class="card si-stats-categories si-st-bloc mt-3">
							<h2>Top catégories</h2>
							{% if e.categories is empty %}
								<p class="si-st-gris mb-0">Aucune facture cette semaine.</p>
							{% else %}
								<ul>
									{% for c in e.categories %}
										<li><span>{{ c.nom }}</span><strong>{{ st.valeur(c.montant, 'fcfa') }}</strong><span class="si-st-gris">{{ c.part }} %</span></li>
									{% endfor %}
								</ul>
							{% endif %}
						</section>
					</div>
				{% endif %}
			</div>
		{% endif %}

		{# La Direction sans activité à son nom n'a pas besoin du bloc vide. #}
		{% if s.perso and (p is not null or e is null) %}
			<h2 class="si-st-section-titre">Mes chiffres</h2>
			{% if p is null %}
				<p class="card si-st-vide">Aucune activité enregistrée à votre nom cette semaine.</p>
			{% else %}
				<div class="si-stats-kpis si-st-chiffres">
					<article class="card si-stats-kpi">
						<h2>Mes ventes facturées</h2>
						<strong>{{ st.valeur(p.ca, 'fcfa') }}</strong>
						{{ _self.ecart(p.ca, p.ca_avant, semaine) }}
						{% if p.objectif_semaine is not null %}<small>mon objectif de la semaine {{ st.valeur(p.objectif_semaine, 'fcfa') }} ({{ (p.ca * 100 / p.objectif_semaine)|round }} %)</small>{% endif %}
					</article>
					<article class="card si-stats-kpi">
						<h2>Mes commandes</h2>
						<strong>{{ p.commandes }}</strong>
						<small>{{ p.devis_emis }} devis émis · {{ p.devis_signes }} signé{{ p.devis_signes > 1 ? 's' }}</small>
					</article>
					<article class="card si-stats-kpi">
						<h2>Encaissé par moi</h2>
						<strong>{{ st.valeur(p.encaisse, 'fcfa') }}</strong>
						<small>paiements validés</small>
					</article>
					<article class="card si-stats-kpi">
						<h2>Mes travaux terminés</h2>
						<strong>{{ p.travaux }}</strong>
						<small>{{ st.valeur(p.surface, 'm2') }} en production</small>
					</article>
				</div>
				{% if p.mois is not null %}
					<div class="si-st-objectifs-cartes si-st-cartes-etroites mt-3">
						{{ st.carte(p.mois|merge({libelle: 'Mes ventes du mois', format: 'fcfa', cumul: true}), 'Mes ventes du mois au dimanche ' ~ semaine.dimanche|date('d/m')) }}
					</div>
				{% endif %}
			{% endif %}
		{% endif %}

		<nav class="si-stats-rapports" aria-label="Autres pages">
			<span>Voir aussi :</span>
			{% if droits.perso %}<a href="{{ path('app_mes_statistiques') }}">Mes statistiques</a>{% endif %}
			{% if droits.global %}<a href="{{ path('app_statistiques_index') }}">Statistiques et rapports</a><a href="{{ path('app_statistiques_objectifs') }}">Objectifs du mois</a>{% endif %}
			{% if droits.admin %}<a href="{{ path('app_reglages_parametres_panneau', {tuile: 'statistiques'}) }}">Réglages du rapport</a>{% endif %}
		</nav>
		<p class="si-stats-note">Semaine du lundi 0 h au dimanche 24 h. CA facturé : factures émises (TTC) ; objectif de la semaine : objectif du mois au prorata des jours. Devis signés : transformés en commande dans la semaine, ou acceptés et datés de la semaine. Encaissé : paiements validés. Créances, factures échues et commandes en retard : situation au moment du calcul.</p>
	</div>
{% endblock %}
