{% extends 'base.html.twig' %}

{% block title %}
	Machines
{% endblock %}

{% block body %}

	<div
		class="side-app">

		{# ==========================================================
								       PAGE HEADER
								       ========================================================== #}
		<div class="page-header">

			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="#">Paramètres</a>
				</li>

				<li class="breadcrumb-item active" aria-current="page">
					Machines
				</li>
			</ol>

			<div>
				<a href="{{ path('app_machines_rentabilite') }}" class="btn btn-outline-primary mr-2">
					<i class="fa fa-line-chart mr-1"></i>
					Rentabilité
				</a>

				<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#machineCreateModal">
					<i class="fa fa-plus mr-1"></i>
					Ajouter une machine
				</button>
			</div>

		</div>
		{# PAGE HEADER END #}


		{# ==========================================================
								       LISTE
								       ========================================================== #}
		<div class="row row-cards">

			<div
				class="col-lg-12">

				{# Recherche #}
				<div class="input-group mb-4">

					<input type="text" id="machineSearch" class="form-control" placeholder="Rechercher une machine, une IP, une marque, un modèle..." autocomplete="off">

					<div class="input-group-append">
						<button type="button" class="btn btn-primary-light">
							<i class="fa fa-search" aria-hidden="true"></i>
						</button>
					</div>

				</div>


				<div class="card">

					<div class="card-header
																												                           border-bottom-0
																												                           d-flex
																												                           justify-content-between
																												                           align-items-center">
						<div>
							<h3 class="card-title mb-0">
								Machines de production
							</h3>

							<small class="text-muted">
								{{ machines|length }}
								machine{{ machines|length > 1 ? 's' : '' }}
								enregistrée{{ machines|length > 1 ? 's' : '' }}
							</small>
						</div>

						<div>
							<span class="badge badge-info p-2">
								<i class="fa fa-network-wired mr-1"></i>
								Identification par IP
							</span>
						</div>
					</div>


					<div class="e-table">

						<div class="table-responsive
																																                               table-lg
																																                               br-bl-10
																																                               br-br-10">

							<table class="table
																																                                   table-bordered
																																                                   table-hover
																																                                   mb-0" id="machineTable">

								<thead>
									<tr>

										<th>
											Machine
										</th>

										<th>
											Adresse IP
										</th>

										<th>
											Marque / Modèle
										</th>

										<th>
											Type
										</th>

										<th class="text-center">
											Largeur
										</th>

										<th class="text-center">
											Têtes
										</th>

										<th class="text-center">
											Compteurs
										</th>

										<th class="text-center">
											État
										</th>

										<th class="text-center">
											Actions
										</th>

									</tr>
								</thead>


								<tbody id="machineTableBody">

									{% for machine in machines %}

										<tr
											id="machine-row-{{ machine.id }}" class="machine-row" data-machine-id="{{ machine.id }}">

											{# ==================================================
																																												                                           MACHINE
																																												                                           ================================================== #}
											<td class="align-middle">

												<strong>
													{{ machine.nom }}
												</strong>

												{% if machine.numeroSerie %}
													<div class="small text-muted">
														Série :
														{{ machine.numeroSerie }}
													</div>
												{% endif %}

											</td>


											{# ==================================================
																																												                                           IP
																																												                                           ================================================== #}
											<td class="align-middle">

												{% if machine.adresseIp %}

													<span class="badge
																																																												                                                           badge-primary
																																																												                                                           machine-ip-badge">
														<i class="fa fa-desktop mr-1"></i>
														{{ machine.adresseIp }}
													</span>

												{% else %}

													<span class="badge badge-danger">
														IP non configurée
													</span>

												{% endif %}

											</td>


											{# ==================================================
																																												                                           MARQUE / MODÈLE
																																												                                           ================================================== #}
											<td class="align-middle">

												<strong>
													{{ machine.marque|default('—') }}
												</strong>

												{% if machine.modeles %}
													<div class="small text-muted">
														{{ machine.modeles }}
													</div>
												{% endif %}

											</td>


											{# ==================================================
																																												                                           TYPE
																																												                                           ================================================== #}
											<td class="align-middle">

												{{ machine.typeMachine|default('—') }}

											</td>


											{# ==================================================
																																												                                           LARGEUR
																																												                                           ================================================== #}
											<td class="text-center
																																																				                                                   align-middle">
												{{ machine.largeurImpression|default('—') }}
											</td>


											{# ==================================================
																																												                                           TÊTES
																																												                                           ================================================== #}
											<td class="text-center
																																																				                                                   align-middle">
												{{ machine.nbTetes is not null
                                                ? machine.nbTetes
                                                : '—'
                                            }}
											</td>


											{# ==================================================
																																												                                           COMPTEURS
																																												                                           ================================================== #}
											<td class="text-center
																																																				                                                   align-middle">

												<div>
													<small class="text-muted">
														m² :
													</small>

													<strong>
														{{ machine.compteurM2
                                                        is not null
                                                        ? machine.compteurM2|number_format(2, ',', ' ')
                                                        : 0
                                                    }}
													</strong>
												</div>

												<div>
													<small class="text-muted">
														Heures :
													</small>

													<strong>
														{{ machine.compteurHeures
                                                        is not null
                                                        ? machine.compteurHeures
                                                        : 0
                                                    }}
													</strong>
												</div>

												<div>
													<small class="text-muted">
														Feuilles :
													</small>

													<strong>
														{{ machine.compteurFeuilles|default(0) }}
													</strong>
												</div>

											</td>


											{# ==================================================
																																												                                           ÉTAT
																																												                                           ================================================== #}
											<td class="text-center
																																																				                                                   align-middle">

												{% set etat = machine.etat|default('disponible') %}

												{% if etat == 'disponible' %}

													<span class="badge badge-success">
														Disponible
													</span>

												{% elseif etat == 'maintenance' %}

													<span class="badge badge-warning">
														Maintenance
													</span>

												{% elseif etat == 'hors_service' %}

													<span class="badge badge-danger">
														Hors service
													</span>

												{% elseif etat == 'inactive' %}

													<span class="badge badge-secondary">
														Inactive
													</span>

												{% else %}

													<span class="badge badge-info">
														{{ etat
                                                        |replace({'_': ' '})
                                                        |capitalize
                                                    }}
													</span>

												{% endif %}

											</td>


											{# ==================================================
																																												                                           ACTIONS
																																												                                           ================================================== #}
											<td class="text-center
																																																				                                                   align-middle">

												<div
													class="btn-group align-top">

													{# MODIFIER #}
													<button type="button" class="
																																																								                                                        btn
																																																								                                                        btn-sm
																																																								                                                        btn-primary-light
																																																								                                                        btn-edit-machine
																																																								                                                    " data-bs-toggle="modal" data-bs-target="#machineEditModal" data-id="{{ machine.id }}" data-get-url="{{ path( 'app_machines_get_ajax', { id: machine.id } ) }}" data-update-url="{{ path( 'app_machines_update_ajax', { id: machine.id } ) }}" data-update-token="{{ csrf_token( 'update_machine_' ~ machine.id ) }}" title="Modifier">
														<i class="fa fa-edit"></i>
													</button>


													{# SUPPRIMER #}
													<button type="button" class="
																																																								                                                        btn
																																																								                                                        btn-sm
																																																								                                                        btn-danger-light
																																																								                                                        btn-delete-machine
																																																								                                                    " data-id="{{ machine.id }}" data-url="{{ path( 'app_machines_delete_ajax', { id: machine.id } ) }}" data-token="{{ csrf_token( 'delete_machine_' ~ machine.id ) }}" data-nom="{{ machine.nom }}" title="Supprimer">
														<i class="fa fa-trash"></i>
													</button>

												</div>

											</td>

										</tr>

									{% else %}

										<tr id="machineEmptyRow">
											<td colspan="9" class="text-center
																																																				                                                   text-muted
																																																				                                                   py-5">
												<i class="fa
																																																				                                                       fa-print
																																																				                                                       fa-3x
																																																				                                                       mb-3"></i>

												<div>
													Aucune machine enregistrée.
												</div>
											</td>
										</tr>

									{% endfor %}

								</tbody>

							</table>

						</div>

					</div>

				</div>

			</div>

		</div>

	</div>


	{# ==========================================================
				   URLS / TOKENS GLOBAUX
				   ========================================================== #}

	<input type="hidden" id="machineCreateUrl" value="{{ path('app_machines_create_ajax') }}">

	<input
	type="hidden" id="machineCreateToken" value="{{ csrf_token('create_machine') }}">


	{# ==========================================================
				   MODAL : AJOUTER UNE MACHINE
				   ========================================================== #}

	<div class="modal fade" id="machineCreateModal" tabindex="-1" role="dialog" aria-labelledby="machineCreateModalLabel" aria-hidden="true">

		<div class="modal-dialog
												               modal-xl" role="document">

			<div class="modal-content">

				<div class="modal-header">

					<div>
						<h5 class="modal-title" id="machineCreateModalLabel">
							Ajouter une machine
						</h5>

						<small class="text-muted">
							L'adresse IP permettra d'identifier
																												                        automatiquement le poste de production.
						</small>
					</div>

					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>

				</div>


				<div class="modal-body">

					<div
						class="row">

						{# NOM #}
						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineCreateNom">
									Nom
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineCreateNom" class="form-control" placeholder="Exemple : Eco-solvant 3.2 m" autocomplete="off">

							</div>

						</div>


						{# IP #}
						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineCreateAdresseIp">
									Adresse IP
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineCreateAdresseIp" class="form-control" placeholder="Exemple : 192.168.1.20" autocomplete="off">

								<small class="form-text text-muted">
									Cette adresse doit être fixe et unique.
								</small>

							</div>

						</div>


						{# MARQUE #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateMarque">
									Marque
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineCreateMarque" class="form-control" placeholder="Exemple : Yinghe" autocomplete="off">

							</div>

						</div>


						{# MODÈLE #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateModeles">
									Modèle
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineCreateModeles" class="form-control" placeholder="Exemple : YH-3200" autocomplete="off">

							</div>

						</div>


						{# NUMÉRO SÉRIE #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateNumeroSerie">
									Numéro de série
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineCreateNumeroSerie" class="form-control" autocomplete="off">

							</div>

						</div>


						{# TYPE MACHINE #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateTypeMachine">
									Type de machine
									<span class="text-danger">*</span>
								</label>

								<select id="machineCreateTypeMachine" class="form-control">
									<option value="">
										Sélectionner
									</option>

									<option value="eco_solvant">
										Eco-solvant
									</option>

									<option value="dtf">
										DTF
									</option>

									<option value="laser">
										Laser
									</option>

									<option value="sublimation">
										Sublimation
									</option>

									<option value="uv">
										UV
									</option>

									<option value="decoupe">
										Découpe
									</option>

									<option value="autre">
										Autre
									</option>
								</select>

							</div>

						</div>


						{# LARGEUR #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateLargeurImpression">
									Largeur d'impression
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineCreateLargeurImpression" class="form-control" placeholder="Exemple : 3.2 m">

							</div>

						</div>


						{# NB TÊTES #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateNbTetes">
									Nombre de têtes
									<span class="text-danger">*</span>
								</label>

								<input type="number" id="machineCreateNbTetes" class="form-control" min="0" step="1" value="0">

							</div>

						</div>


						{# DATE ACHAT #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateDateAchat">
									Date d'achat
								</label>

								<input type="date" id="machineCreateDateAchat" class="form-control">

							</div>

						</div>


						{# DATE MISE SERVICE #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateDateMiseService">
									Date de mise en service
								</label>

								<input type="date" id="machineCreateDateMiseService" class="form-control">

							</div>

						</div>


						{# ÉTAT #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateEtat">
									État
								</label>

								<select id="machineCreateEtat" class="form-control">
									<option value="disponible" selected>
										Disponible
									</option>

									<option value="maintenance">
										Maintenance
									</option>

									<option value="hors_service">
										Hors service
									</option>

									<option value="inactive">
										Inactive
									</option>
								</select>

							</div>

						</div>


						{# COMPTEUR M2 #}
						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineCreateCompteurM2">
									Compteur m²
								</label>

								<input type="number" id="machineCreateCompteurM2" class="form-control" min="0" step="0.01" value="0">

							</div>

						</div>


						{# COMPTEUR HEURES #}
						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineCreateCompteurHeures">
									Compteur heures
								</label>

								<input type="number" id="machineCreateCompteurHeures" class="form-control" min="0" step="1" value="0">

							</div>

						</div>


						{# COMPTEUR FEUILLES #}
						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineCreateCompteurFeuilles">
									Compteur feuilles (A4-équivalent)
								</label>

								<input type="number" id="machineCreateCompteurFeuilles" class="form-control" min="0" step="1" value="0">

							</div>

						</div>


						<div class="col-12">
							<hr>
							<h6 class="text-muted">Rentabilité / amortissement</h6>
						</div>


						{# MODE FACTURATION #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateModeFacturation">
									Mode de facturation
								</label>

								<select id="machineCreateModeFacturation" class="form-control">
									<option value="metre_carre" selected>
										Au mètre carré
									</option>

									<option value="feuille">
										À la feuille (A4/A3)
									</option>
								</select>

							</div>

						</div>


						{# PRIX ACHAT #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreatePrixAchat">
									Prix d'achat (F CFA)
								</label>

								<input type="number" id="machineCreatePrixAchat" class="form-control" min="0" step="1">

							</div>

						</div>


						{# DURÉE AMORTISSEMENT #}
						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineCreateDureeAmortissementMois">
									Durée d'amortissement (mois)
								</label>

								<input type="number" id="machineCreateDureeAmortissementMois" class="form-control" min="0" step="1">

							</div>

						</div>


						{# REVENU AVANT SUIVI #}
						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineCreateRevenuAvantSuivi">
									Revenu recap (avant suivi dans l'appli)
								</label>

								<input type="number" id="machineCreateRevenuAvantSuivi" class="form-control" min="0" step="1" value="0">

								<small class="form-text text-muted">
									Total déjà facturé par cette machine avant le début du suivi via les commandes (ex : classeur d'amortissement existant).
								</small>

							</div>

						</div>


						{# DATE DÉBUT SUIVI #}
						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineCreateDateDebutSuivi">
									Date de début du suivi
								</label>

								<input type="date" id="machineCreateDateDebutSuivi" class="form-control">

								<small class="form-text text-muted">
									Seules les commandes à partir de cette date seront comptées (pour ne pas doubler le revenu recap).
								</small>

							</div>

						</div>

					</div>

				</div>


				<div class="modal-footer">

					<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
						Annuler
					</button>

					<button type="button" id="machineCreateSaveButton" class="btn btn-primary">
						<i class="fa fa-save mr-1"></i>
						Enregistrer la machine
					</button>

				</div>

			</div>

		</div>

	</div>


	{# ==========================================================
				   MODAL : MODIFIER UNE MACHINE
				   ========================================================== #}

	<div class="modal fade" id="machineEditModal" tabindex="-1" role="dialog" aria-labelledby="machineEditModalLabel" aria-hidden="true">

		<div class="modal-dialog
												               modal-xl" role="document">

			<div class="modal-content">

				<div class="modal-header">

					<div>
						<h5 class="modal-title" id="machineEditModalLabel">
							Modifier la machine
						</h5>

						<small class="text-muted">
							Une modification de l'adresse IP
																												                        modifie l'identification automatique
																												                        du poste de production.
						</small>
					</div>

					<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>

				</div>


				<div class="modal-body">

					<input type="hidden" id="machineEditId">

					<input type="hidden" id="machineEditUpdateUrl">

					<input type="hidden" id="machineEditUpdateToken">


					<div class="row">

						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineEditNom">
									Nom
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineEditNom" class="form-control" autocomplete="off">

							</div>

						</div>


						<div class="col-md-6">

							<div class="form-group">

								<label class="form-label" for="machineEditAdresseIp">
									Adresse IP
									<span class="text-danger">*</span>
								</label>

								<input type="text" id="machineEditAdresseIp" class="form-control" autocomplete="off">

							</div>

						</div>


						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineEditMarque">
									Marque
								</label>

								<input type="text" id="machineEditMarque" class="form-control">

							</div>

						</div>


						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineEditModeles">
									Modèle
								</label>

								<input type="text" id="machineEditModeles" class="form-control">

							</div>

						</div>


						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineEditNumeroSerie">
									Numéro de série
								</label>

								<input type="text" id="machineEditNumeroSerie" class="form-control">

							</div>

						</div>


						<div class="col-md-4">

							<div class="form-group">

								<label class="form-label" for="machineEditTypeMachine">
