  if(S.bleed>0)tries.push([{bleed:0},'sans fond perdu (seulement si le fond est blanc)']);
  ['A4','A3','SRA3'].filter(k=>k!==S.sheet).forEach(k=>tries.push([{sheetWH:SHEETS[k]},'sur '+k]));
  tries.forEach(([o,txt])=>{const L=bestLayout(params(o));if(L.n>=t)out.push(`${L.n} poses ${txt}.`)});return out.slice(0,3);}

/* ---------- main update ---------- */
let LAST=null;
function update(){
  $('customSheet').hidden=S.sheet!=='custom';$('gapBox').hidden=S.cut!=='sep';$('pctBox').hidden=S.fit!=='manual';$('customFmt').hidden=S.fmt!=='custom';
  const L=bestLayout(params());const G=geom(files.recto);LAST={L,G};
  const side=(S.view==='verso'&&files.verso)?'verso':'recto';
  $('stage').innerHTML=render(L,G,side);
  $('sum').textContent=L.n?`${L.n} poses · ${L.cols} × ${L.rows}`:'Aucune pose possible';
  $('sumTag').textContent=`${S.sheet==='custom'?fmtN(L.W,0)+' × '+fmtN(L.H,0):S.sheet} ${L.W>L.H?'paysage':'portrait'}${side==='verso'?' · verso':''}`;
  $('dims').innerHTML=L.n?`<span>Format fini <b>${fmtN(S.tw)} × ${fmtN(S.th)} mm</b></span><span>Fond perdu <b>${fmtN(S.bleed)} mm</b></span><span>1re coupe à <b>${fmtN(L.x0)} mm</b> du bord gauche et <b>${fmtN(L.y0)} mm</b> du haut</span><span>Bloc imprimé <b>${fmtN(L.bw)} × ${fmtN(L.bh)} mm</b></span>`:'';
  const A=analyse(L,G);const V={ok:['✓','Faisable',`${L.n} poses par feuille, prêt à exporter.`],warn:['!','Faisable avec réserves','Lisez les points en orange avant d\'imprimer.'],bad:['✕','Pas faisable en l\'état','Voir les solutions ci-dessous et le comparatif des feuilles.']}[A.level];
  $('verdict').className='verdict v-'+A.level;$('verdict').innerHTML=`<div class="ic">${V[0]}</div><div><b>${V[1]}</b><span>${V[2]}</span></div>`;
  $('checks').innerHTML=A.ck.map(c=>`<li><i class="i-${c[0]}">${{ok:'✓',warn:'!',bad:'✕',info:'i'}[c[0]]}</i><div>${esc(c[1])}${c[2]?`<small>${esc(c[2])}</small>`:''}</div></li>`).join('');
  const sheetsNeed=L.n?Math.ceil(S.qty/L.n):0,extra=Math.ceil(sheetsNeed*S.waste/100);const cuts=L.n?(S.cut==='common'?(L.cols+1)+(L.rows+1):2*L.cols+2*L.rows):0;
  $('prod').innerHTML=L.n?`<span>Feuilles pour ${S.qty.toLocaleString('fr-FR')} ex.</span><b>${sheetsNeed}</b><span>Gâche (${S.waste} %)</span><b>+ ${extra}</b><span>Feuilles à sortir</span><b>${sheetsNeed+extra}${files.verso?' (recto-verso)':''}</b><span>Exemplaires obtenus</span><b>${((sheetsNeed+extra)*L.n).toLocaleString('fr-FR')}</b><span>Coupes au massicot par paquet</span><b>${cuts}</b>`:'<span>Aucune pose</span><b>—</b>';
  let best=0;const rows=['A4','A3','SRA3'].map(k=>{const l=bestLayout(params({sheetWH:SHEETS[k]}));const sh=l.n?Math.ceil(S.qty/l.n):0;return [k,l.n,sh,l.n?Math.round(100*l.n*S.tw*S.th/(l.W*l.H)):0]});
