{% extends 'immobilisations/_base.html.twig' %}
{% import 'immobilisations/_macros.html.twig' as im %}

{% block title %}Immobilisations › Relevé de compteurs{% endblock %}
{% block page_title %}Relevé · {{ machine.nom }}{% endblock %}

{% block header_actions %}
	<li class="nav-item">
		<a href="{{ path('app_immobilisations_releves', {id: machine.id}) }}" class="btn btn-light btn-sm si-btn-entete">Historique des relevés</a>
	</li>
{% endblock %}

{% block body %}
	<div class="si-fin si-imm">
		<section class="card" style="max-width: 760px;">
			{% set nom_mois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'][mois|date('n') - 1] %}
			<h2>Compteurs à la fin {{ nom_mois in ['avril', 'août', 'octobre'] ? 'd\'' : 'de ' }}{{ nom_mois }} {{ mois|date('Y') }}</h2>
			<p class="si-fin-gris small">Recopiez les compteurs tels que la machine les affiche (totaux depuis l'installation), à la fin du mois ou le 1er du mois suivant, et joignez la photo de l'écran des compteurs.{% if machine.releveA4A3 %} Une page A3 compte pour 2 pages A4.{% endif %}</p>
			{% if releve %}<p class="si-fin-statut si-fin-statut-bleu">Relevé déjà saisi le {{ releve.saisiLe|date('d/m/Y') }} : l'enregistrer à nouveau le corrige.</p>{% endif %}
			<form method="post" enctype="multipart/form-data" action="{{ path('app_immobilisations_releve', {id: machine.id}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('releve-' ~ machine.id) }}">
				<div class="mb-3" style="max-width: 240px;">
					<label class="form-label small fw-semibold" for="mois">Mois relevé</label>
					<input type="month" class="form-control" id="mois" name="mois" value="{{ mois|date('Y-m') }}" max="{{ 'now'|date('Y-m') }}" onchange="location.href='{{ path('app_immobilisations_releve', {id: machine.id}) }}?mois=' + this.value">
				</div>
				{% if machine.releveA4A3 %}
					<div class="si-imm-compteurs">
						{% for cle, def in compteurs %}
							<div>
								<label class="form-label small fw-semibold" for="{{ cle }}">{{ def[0] }}</label>
								<input class="form-control" id="{{ cle }}" name="{{ cle }}" inputmode="numeric" value="{{ releve ? releve.valeur(cle) }}" placeholder="{{ precedent and precedent.valeur(cle) is not null ? 'mois précédent : ' ~ precedent.valeur(cle)|number_format(0, ',', ' ') }}">
							</div>
						{% endfor %}
					</div>
				{% else %}
					<div style="max-width: 320px;">
						<label class="form-label small fw-semibold" for="compteur">Compteur ({{ machine.unitePluriel }})</label>
						<input class="form-control" id="compteur" name="compteur" inputmode="decimal" value="{{ releve ? releve.compteur }}" placeholder="{{ precedent and precedent.equivalent is not null ? 'mois précédent : ' ~ im.n(precedent.equivalent) }}">
					</div>
				{% endif %}
				<div class="mt-3" style="max-width: 420px;">
					<label class="form-label small fw-semibold" for="photo">Photo du compteur</label>
					<input class="form-control" type="file" id="photo" name="photo" accept="image/jpeg,image/png" capture="environment">
					{% if releve and releve.photo %}<small class="si-fin-gris">Une photo est déjà jointe ; une nouvelle la remplace.</small>{% endif %}
				</div>
				<button class="btn btn-danger mt-3">Enregistrer le relevé</button>
			</form>
		</section>
	</div>
{% endblock %}
