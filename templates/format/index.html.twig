{% extends 'base.html.twig' %}

{% block title %}User index
{% endblock %}

{% block body %}
	<!-- PAGE-HEADER -->
	<div class="side-app">
	<div class="page-header">
		<ol class="breadcrumb">
			<li class="breadcrumb-item">
				<a href="#">Utilisateurs</a>
			</li>
			<li class="breadcrumb-item active" aria-current="page">Liste des Utilisateurs</li>
		</ol>
		<div>
			<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#formatCreateModal">
				<i class="fa fa-plus mr-1"></i>
				Ajouter un format
			</button>

			<button type="button" id="finitionMassPublishButton" class="btn btn-success">
				<i class="fa fa-eye mr-1"></i>
				Publier
			</button>

			<button type="button" id="finitionMassUnpublishButton" class="btn btn-warning">
				<i class="fa fa-eye-slash mr-1"></i>
				Dépublier
			</button>

			<button type="button" id="finitionMassDeleteButton" class="btn btn-danger">
				<i class="fa fa-trash mr-1"></i>
				Supprimer
			</button>


		</div>
	</div>
	</div>
	<!-- PAGE-HEADER END -->

	<!-- ROW OPEN -->
	<div
		class="row row-cards">

		<!-- COL-END -->
		<div class="col-lg-8 col-xl-12">
			<div class="input-group mb-5">
				<input type="text" class="form-control" placeholder="">
				<div class="input-group-append ">
					<button type="button" class="btn btn-primary-light">
						<i class="fa fa-search" aria-hidden="true"></i>
					</button>
				</div>
			</div>
			<div class="card">
				<div class="card-header border-bottom-0 p-4">
					<h2 class="card-title">1 - 30 of 546 users</h2>
					<div class="page-options d-flex float-right">
						<select class="form-control custom-select w-auto">
							<option value="asc">Latest</option>
							<option value="desc">Oldest</option>
						</select>
					</div>
				</div>
				<div class="e-table">
					<div class="table-responsive table-lg br-bl-10 br-br-10">
						<input type="hidden" id="finitionMassActionUrl" value="{{ path('app_finition_mass_action') }}">

						<input type="hidden" id="finitionMassActionToken" value="{{ csrf_token('finition_mass_action') }}">
						<table class="table table-bordered mb-0">

							<thead>
								<tr>
									<th>Ordre</th>
									<th>Nom</th>
									<th>Dimensions</th>
									<th>Description</th>
									<th>Types d’impression compatibles</th>
									<th class="text-center">Statut</th>
									<th class="text-center">Actions</th>
								</tr>
							</thead>

							<tbody>

								{% for format in formats %}

									<tr id="format-row-{{ format.id }}">

										<td class="text-center align-middle">
											{{ format.ordre }}
										</td>

										<td class="align-middle">
											<strong>{{ format.nom }}</strong>
										</td>

										<td class="align-middle text-nowrap">
											{{ format.largeur }}
											×
											{{ format.hauteur }}
											{{ format.unite }}
										</td>

										<td class="align-middle">
											{{ format.description }}
										</td>

										<td class="align-middle">

											{% for typeImpression in format.typesImpressions %}

												<span class="badge badge-info mb-1">
													{{ typeImpression.nom }}
												</span>

											{% else %}

												<span class="text-muted">
													Aucun type associé
												</span>

											{% endfor %}

										</td>

										<td class="text-center align-middle">

											{% if format.publie %}

												<span class="badge badge-success">
													Publié
												</span>

											{% else %}

												<span class="badge badge-danger">
													Non publié
												</span>

											{% endif %}

										</td>

										<td class="text-center align-middle">

											<div class="btn-group align-top">

												<button type="button" class="btn btn-sm btn-primary-light btn-edit-format" data-bs-toggle="modal" data-bs-target="#formatEditModal" data-get-url="{{ path( 'app_format_get_ajax', {id: format.id} ) }}" data-update-url="{{ path( 'app_format_update_ajax', {id: format.id} ) }}" data-update-token="{{ csrf_token( 'update_format_' ~ format.id ) }}" title="Modifier">
													<i class="fa fa-edit"></i>
												</button>

												<button type="button" class="btn btn-sm {{ format.publie
																																																																																																																																															                                ? 'btn-warning-light'
																																																																																																																																															                                : 'btn-success-light'
																																																																																																																																															                            }} btn-toggle-format" data-url="{{ path( 'app_format_toggle_publication', {id: format.id} ) }}" data-token="{{ csrf_token( 'toggle_format_' ~ format.id ) }}" data-nom="{{ format.nom }}" data-publie="{{ format.publie ? '1' : '0' }}" title="{{ format.publie ? 'Dépublier' : 'Publier' }}">
													{% if format.publie %}
														<i class="fa fa-eye-slash"></i>
													{% else %}
														<i class="fa fa-eye"></i>
													{% endif %}
												</button>

												<button type="button" class="btn btn-sm btn-danger-light btn-delete-format" data-url="{{ path( 'app_format_delete_ajax', {id: format.id} ) }}" data-token="{{ csrf_token( 'delete_format_' ~ format.id ) }}" data-nom="{{ format.nom }}" title="Supprimer">
													<i class="fa fa-trash"></i>
												</button>

											</div>

										</td>

									</tr>

								{% else %}

									<tr>
										<td colspan="7" class="text-center text-muted">
											Aucun format trouvé
										</td>
									</tr>

								{% endfor %}

							</tbody>

						</table>
					</div>
				</div>
			</div>

		</div>
		<!-- COL-END -->
		<div class="modal fade" id="formatCreateModal" tabindex="-1" role="dialog" aria-hidden="true">
			<div class="modal-dialog modal-lg" role="document">
				<div class="modal-content">

					<div class="modal-header">
						<h5 class="modal-title">
							Ajouter un format
						</h5>

						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>

					<div class="modal-body">

						<input type="hidden" id="formatCreateUrl" value="{{ path('app_format_create_ajax') }}">

						<input type="hidden" id="formatCreateToken" value="{{ csrf_token('create_format') }}">

						<div class="form-group">
							<label class="form-label" for="formatCreateNom">
								Nom du format
							</label>

							<input type="text" id="formatCreateNom" class="form-control" placeholder="Exemple : A4">
						</div>

						<div class="row">

							<div class="col-md-4">
								<div class="form-group">
									<label class="form-label" for="formatCreateLargeur">
										Largeur
									</label>

									<input type="number" id="formatCreateLargeur" class="form-control" min="1" step="1" placeholder="210">
								</div>
							</div>

							<div class="col-md-4">
								<div class="form-group">
									<label class="form-label" for="formatCreateHauteur">
										Hauteur
									</label>

									<input type="number" id="formatCreateHauteur" class="form-control" min="1" step="1" placeholder="297">
								</div>
							</div>

							<div class="col-md-4">
								<div class="form-group">
									<label class="form-label" for="formatCreateUnite">
										Unité
									</label>

									<select id="formatCreateUnite" class="form-control">
										<option value="mm">Millimètre</option>
										<option value="cm">Centimètre</option>
										<option value="m">Mètre</option>
									</select>
								</div>
							</div>

						</div>

						<div class="form-group">
							<label class="form-label" for="formatCreateDescription">
								Description
							</label>

							<textarea id="formatCreateDescription" class="form-control" rows="3" placeholder="Exemple : Format standard adapté aux impressions papier."></textarea>
						</div>

						<div class="form-group">
							<div class="form-label">
								Types d’impression compatibles
							</div>

							<div class="selectgroup selectgroup-pills">

								{% for typeImpression in typesImpressions %}

									<label class="selectgroup-item">
										<input type="checkbox" value="{{ typeImpression.id }}" class="selectgroup-input format-create-type-impression">

										<span class="selectgroup-button">
											{{ typeImpression.nom }}
										</span>
									</label>

								{% else %}

									<span class="text-muted">
										Aucun type d’impression disponible
									</span>

								{% endfor %}

							</div>
						</div>

						<div class="form-group mb-0">
							<label class="custom-switch">
								<input type="checkbox" id="formatCreatePublie" class="custom-switch-input" checked>

								<span class="custom-switch-indicator"></span>

								<span class="custom-switch-description">
									Publier ce format
								</span>
							</label>
						</div>

					</div>

					<div class="modal-footer">

						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
							Annuler
						</button>

						<button type="button" class="btn btn-primary" id="formatCreateSaveButton">
							<i class="fa fa-save mr-1"></i>
							Enregistrer
						</button>

					</div>

				</div>
			</div>
		</div>
		<div class="modal fade" id="formatEditModal" tabindex="-1" role="dialog" aria-hidden="true">
			<div class="modal-dialog modal-lg" role="document">
				<div class="modal-content">

					<div class="modal-header">
						<h5 class="modal-title">
							Modifier le format
						</h5>

						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>

					<div class="modal-body">

						<input type="hidden" id="formatEditUpdateUrl">

						<input type="hidden" id="formatEditToken">

						<div class="form-group">
							<label class="form-label" for="formatEditNom">
								Nom du format
							</label>

							<input type="text" id="formatEditNom" class="form-control">
						</div>

						<div class="row">

							<div class="col-md-4">
								<div class="form-group">
									<label class="form-label" for="formatEditLargeur">
										Largeur
									</label>

									<input type="number" id="formatEditLargeur" class="form-control" min="1" step="1">
								</div>
							</div>

							<div class="col-md-4">
								<div class="form-group">
									<label class="form-label" for="formatEditHauteur">
										Hauteur
									</label>

									<input type="number" id="formatEditHauteur" class="form-control" min="1" step="1">
								</div>
							</div>

							<div class="col-md-4">
								<div class="form-group">
									<label class="form-label" for="formatEditUnite">
										Unité
									</label>

									<select id="formatEditUnite" class="form-control">
										<option value="mm">Millimètre</option>
										<option value="cm">Centimètre</option>
										<option value="m">Mètre</option>
									</select>
								</div>
							</div>

						</div>

						<div class="form-group">
							<label class="form-label" for="formatEditDescription">
								Description
							</label>

							<textarea id="formatEditDescription" class="form-control" rows="3"></textarea>
						</div>

						<div class="form-group">
							<div class="form-label">
								Types d’impression compatibles
							</div>

							<div class="selectgroup selectgroup-pills">

								{% for typeImpression in typesImpressions %}

									<label class="selectgroup-item">
										<input type="checkbox" value="{{ typeImpression.id }}" class="selectgroup-input format-edit-type-impression">

										<span class="selectgroup-button">
											{{ typeImpression.nom }}
										</span>
									</label>

								{% endfor %}

							</div>
						</div>

						<div class="form-group mb-0">
							<label class="custom-switch">
								<input type="checkbox" id="formatEditPublie" class="custom-switch-input">

								<span class="custom-switch-indicator"></span>

								<span class="custom-switch-description">
									Publier ce format
								</span>
							</label>
						</div>

					</div>

					<div class="modal-footer">

						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
							Annuler
						</button>

						<button type="button" class="btn btn-primary" id="formatEditSaveButton">
							<i class="fa fa-save mr-1"></i>
							Enregistrer les modifications
						</button>

					</div>

				</div>
			</div>
		</div>
	</div>
	<!-- ROW CLOSED -->
{% endblock %}
{% block javascripts %}
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="../assets/js/traitement _format.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

{% endblock %}
