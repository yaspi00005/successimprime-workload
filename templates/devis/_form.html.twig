{# ============================================================
   MACRO : FINITION MANUELLE
   ============================================================ #}

{% macro finition_manuelle(finition) %}

	<div class="js-finition-manuelle border rounded p-3 mb-3">

		<div class="row align-items-end">

			<div class="col-lg-4 col-md-6">

				{{ form_row(finition.finition, {
                    label: 'Finition',
                    attr: {
                        class: 'form-control js-select-search'
                    }
                }) }}

			</div>

			<div class="col-lg-2 col-md-6">

				{{ form_row(finition.prixApplique, {
                    label: 'Prix appliqué',
                    attr: {
                        class: 'form-control js-finition-prix',
                        min: 0
                    }
                }) }}

			</div>

			<div class="col-lg-2 col-md-6">

				{{ form_row(finition.modeCalcul, {
                    label: 'Mode de calcul',
                    attr: {
                        class: 'form-control js-finition-mode'
                    }
                }) }}

			</div>

			<div class="col-lg-2 col-md-6">

				{{ form_row(finition.quantite, {
                    label: 'Quantité',
                    attr: {
                        class: 'form-control js-finition-quantite',
                        min: 1
                    }
                }) }}

			</div>

			<div class="col-lg-2 col-md-6">

				<button type="button" class="btn btn-danger-light btn-block js-supprimer-finition">
					<i class="fa fa-trash mr-1"></i>
					Supprimer
				</button>

			</div>

		</div>

	</div>

{% endmacro %}


{# ============================================================
   MACRO : DÉTAIL DE DEVIS
   ============================================================ #}

{% macro champs_detail(detail) %}

	<div
		class="travail-form js-devis-detail">

		{# ========================================================
																										       TYPE DE LIGNE
																										       ======================================================== #}

		<div class="travail-section">

			<div class="travail-section-title">
				<i class="fa fa-th-large"></i>
				Type de ligne
			</div>

			<div class="form-group">

				{{ form_label(
                detail.typeLigne,
                'Que souhaitez-vous ajouter ?'
            ) }}

				<div class="js-type-ligne">

					{{ form_widget(
                    detail.typeLigne
                ) }}

				</div>

				{{ form_errors(
                detail.typeLigne
            ) }}

				<small class="form-text text-muted">
					Produit / prestation :
																																																																	                élément provenant du catalogue.
																																																																	                Article en stock :
																																																																	                vente directe d'un article physique.
																																																																	                Saisie libre :
																																																																	                désignation, quantité et prix libres.
				</small>

			</div>

		</div>


		{# ========================================================
																										       PRODUIT / ARTICLE / CONFIGURATION
																										       ======================================================== #}

		<div class="travail-section">

			<div class="travail-section-title">
				<i class="fa fa-cube"></i>
				Produit, article et configuration
			</div>


			{# MODE CONFIGURATION PRODUIT #}

			<div class="js-zone-mode-configuration" style="display:none;">

				<div class="form-group">

					{{ form_label(
                    detail.modeConfiguration,
                    'Mode de configuration'
                ) }}

					<div class="js-mode-configuration">

						{{ form_widget(
                        detail.modeConfiguration
                    ) }}

					</div>

					{{ form_errors(
                    detail.modeConfiguration
                ) }}

					<small class="form-text text-muted js-aide-mode">
						Automatique :
																																																																														                    configuration et tarif provenant du catalogue.
																																																																														                    Manuel :
																																																																														                    choisissez les caractéristiques du produit.
					</small>

				</div>

			</div>


			{# ====================================================
																																							           PRODUIT
																																							           ==================================================== #}

			<div class="row js-zone-produit">

				<div class="col-lg-4 col-md-6">

					{{ form_row(detail.produit, {
                    label: 'Produit / prestation',
                    attr: {
                        class:
                            'form-control js-select-search',

                        'data-detail-field':
                            'produit',

                        'data-placeholder':
                            'Rechercher un produit...'
                    }
                }) }}

				</div>


				<div class="
																																																																														                    col-lg-8
																																																																														                    col-md-6
																																																																														                    js-zone-configuration-automatique
																																																																														                ">

					{{ form_row(
                    detail.produitConfiguration,
                    {
                        label:
                            'Configuration du produit',

                        attr: {
                            class:
                                'form-control js-select-search',

                            'data-detail-field':
                                'configuration',

                            'data-placeholder':
                                'Rechercher une configuration...'
                        }
                    }
                ) }}

					<small class="form-text text-muted">
						Le type d'impression, le support,
																																																																														                    le format et le prix seront récupérés
																																																																														                    automatiquement.
					</small>

				</div>

			</div>


			{# ====================================================
																																							           ARTICLE EN STOCK
																																							           ==================================================== #}

			<div class="row js-zone-article-stock" style="display:none;">

				<div class="col-lg-7 col-md-7">

					{{ form_row(detail.article, {
                    label: 'Article en stock',

                    attr: {
                        class:
                            'form-control js-select-search js-article-stock',

                        'data-detail-field':
                            'article',

                        'data-placeholder':
                            'Référence ou désignation...'
                    }
                }) }}

				</div>


				<div class="col-lg-5 col-md-5">

					<div class="form-group">

						<label>
							Informations de l'article
						</label>

						<div class="
																																																																																																								                            alert
																																																																																																								                            alert-light
																																																																																																								                            border
																																																																																																								                            mb-0
																																																																																																								                        ">

							<span class="js-stock-article">
								Sélectionnez un article.
							</span>

						</div>

					</div>

				</div>

			</div>


			{# ====================================================
																																							           DÉSIGNATION
																																							           ==================================================== #}

			<div class="row">

				<div class="col-12">

					{{ form_row(detail.designation, {
                    label: 'Désignation',

                    attr: {
                        class:
                            'form-control',

                        'data-detail-field':
                            'designation',

                        placeholder:
                            'Désignation du travail'
                    }
                }) }}

				</div>

			</div>


			{# ====================================================
																																							           CONFIGURATION TECHNIQUE PRODUIT
																																							           ==================================================== #}

			<div class="js-zone-champs-configuration">

				<div class="row">

					<div class="col-lg-4 col-md-6">

						{{ form_row(
                        detail.typeImpression,
                        {
                            label:
                                "Type d’impression",

                            attr: {
                                class:
                                    'form-control js-select-search',

                                'data-detail-field':
                                    'typeImpression',

                                'data-placeholder':
                                    "Rechercher un type d’impression..."
                            }
                        }
                    ) }}

					</div>


					<div class="col-lg-4 col-md-6">

						{{ form_row(
                        detail.support,
                        {
                            label:
                                "Support d’impression",

                            attr: {
                                class:
                                    'form-control js-select-search',

                                'data-detail-field':
                                    'support',

                                'data-placeholder':
                                    'Rechercher un support...'
                            }
                        }
                    ) }}

					</div>


					<div class="col-lg-4 col-md-6">

						{{ form_row(
                        detail.format,
                        {
                            label:
                                'Format',

                            attr: {
                                class:
                                    'form-control js-select-search',

                                'data-detail-field':
                                    'format',

                                'data-placeholder':
                                    'Rechercher un format...'
                            }
                        }
                    ) }}

					</div>

				</div>


				<small class="
																																																																														                    form-text
																																																																														                    text-muted
																																																																														                    js-message-champs-auto
																																																																														                ">
					Ces champs proviennent de la configuration sélectionnée.
				</small>

			</div>

		</div>


		{# ========================================================
																										       DIMENSIONS / QUANTITÉ / PRIX
																										       ======================================================== #}

		<div class="travail-section">

			<div class="travail-section-title">
				<i class="fa fa-arrows-alt"></i>
				Dimensions, quantité et prix
			</div>

			<div class="row">

				<div class="col-lg-3 col-md-6 js-zone-largeur">

					{{ form_row(detail.largeur, {
                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'largeur',

                        min: 0,
                        step: '0.01'
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6 js-zone-longueur">

					{{ form_row(detail.longueur, {
                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'longueur',

                        min: 0,
                        step: '0.01'
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6 js-zone-surface">

					{{ form_row(detail.surface, {
                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'surface',

                        readonly: true
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6">

					{{ form_row(detail.quantite, {
                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'quantite',

                        min: 1
                    }
                }) }}

					<small class="
																																																																														                        form-text
																																																																														                        text-muted
																																																																														                        js-message-quantite
																																																																														                    "></small>

				</div>


				<div class="col-lg-3 col-md-6 js-zone-nombre-faces">

					{{ form_row(detail.nombreFaces, {
                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'nombreFaces',

                        min: 1
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6">

					{{ form_row(detail.modeCalcul, {
                    label:
                        'Mode de calcul',

                    attr: {
                        class:
                            'form-control js-mode-calcul js-calcul-detail',

                        'data-detail-field':
                            'modeCalcul'
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6">

					{{ form_row(detail.prixUnitaire, {
                    label:
                        'Prix unitaire',

                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'prixUnitaire',

                        min: 0
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6">

					{{ form_row(detail.remise, {
                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'remise',

                        min: 0
                    }
                }) }}

					<small class="form-text text-muted js-remise-totale-detail">
						Remise totale : —
					</small>

				</div>


				<div class="col-lg-3 col-md-6">

					{{ form_row(detail.tva, {
                    attr: {
                        class:
                            'form-control js-calcul-detail',

                        'data-detail-field':
                            'tva',

                        min: 0
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6">

					{{ form_row(detail.totalHt, {
                    attr: {
                        readonly: true,
                        'data-detail-field':
                            'totalHt'
                    }
                }) }}

				</div>


				<div class="col-lg-3 col-md-6">

					{{ form_row(detail.totalTtc, {
                    attr: {
                        readonly: true,
                        'data-detail-field':
                            'totalTtc'
                    }
                }) }}

				</div>

			</div>

		</div>


		{# ========================================================
																										       FINITIONS
																										       ======================================================== #}

		<div class="travail-section js-zone-finitions">

			<div class="travail-section-title">
				<i class="fa fa-magic"></i>
				Finitions
			</div>


			<div class="js-zone-finitions-automatiques">

				<div class="finitions-box js-finitions-box" data-input-name="{{ detail.finitionsSelectionnees.vars.full_name }}">

					{{ form_widget(
                    detail.finitionsSelectionnees
                ) }}

					{{ form_errors(
                    detail.finitionsSelectionnees
                ) }}

				</div>

				<small class="form-text text-muted">
					Les finitions disponibles proviennent de la configuration.
																																																																	                Les finitions obligatoires sont automatiquement sélectionnées.
				</small>

			</div>


			<div class="js-zone-finitions-manuelles" data-index="{{ detail.finitions|length }}" data-prototype="{{ _self.finition_manuelle( detail.finitions.vars.prototype )|e('html_attr') }}" style="display:none;">

				<div class="js-liste-finitions-manuelles">

					{% for finition in detail.finitions %}

						{{ _self.finition_manuelle(
                        finition
                    ) }}

					{% endfor %}

				</div>

				{{ form_errors(
                detail.finitions
            ) }}

				<button type="button" class="
																																																																														                    btn
																																																																														                    btn-primary-light
																																																																														                    btn-sm
																																																																														                    js-ajouter-finition
																																																																														                ">
					<i class="fa fa-plus mr-1"></i>
					Ajouter une finition
				</button>

			</div>

		</div>


		{# ========================================================
																										       CARACTÉRISTIQUES TECHNIQUES
																										       ======================================================== #}

		<div class="travail-section js-zone-technique">

			<div class="travail-section-title">
				<i class="fa fa-sliders"></i>
				Caractéristiques techniques
			</div>

			<div class="row">

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.profilCouleurs) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.resolution) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.grammage) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.epaisseur) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.laminage) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.pliage) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.priorite) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.tempsEstime) }}
				</div>

				<div class="col-lg-3 col-md-6">
					{{ form_row(detail.tempsReel) }}
				</div>

			</div>


			<div class="row">

				<div class="col-md-3">
					{{ form_row(detail.rectoVerso) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.oeillets) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.decoupe) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.emballage) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.batValide) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.etat) }}
				</div>

			</div>

			{{ form_row(
            detail.observation
        ) }}

		</div>

	</div>

{% endmacro %}


{# ============================================================
   FORMULAIRE
   ============================================================ #}

{{ form_start(form, {
    attr: {
        id: 'devis-form',

        'data-brouillon-nouvelle':
            form.vars.data.id is null ? '1' : '0',

        'data-brouillon-csrf':
            csrf_token('brouillon-devis'),

        'data-brouillon-enregistrer-url':
            path('app_brouillon_enregistrer', {type: 'devis'}),

        'data-brouillon-verifier-url':
            path('app_brouillon_verifier', {type: 'devis'})
    }
}) }}


<div
	class="side-app">

	{# ========================================================
													       HEADER
													       ======================================================== #}

	<div class="page-header">

		<ol class="breadcrumb">

			<li class="breadcrumb-item">

				<a href="{{ path( 'app_devis_index' ) }}">
					Devis
				</a>

			</li>

			<li class="breadcrumb-item active">

				{{
                    form.vars.data.id
                        ? 'Modifier le devis'
                        : 'Nouveau devis'
                }}

			</li>

		</ol>


		<a href="{{ path( 'app_devis_index' ) }}" class="btn btn-sm btn-primary-light">
			<i class="fa fa-list mr-1"></i>
			Liste des devis
		</a>

	</div>


	{% if not form.vars.valid %}

		<div class="alert alert-danger">
			{{ form_errors(form) }}
		</div>

	{% endif %}


	{# ========================================================
													       CLIENT
													       ======================================================== #}

	<div class="card">

		<div class="card-header">

			<div class="card-title">
				<i class="fa fa-user-circle mr-2"></i>
				Client
			</div>

		</div>

		<div class="card-body">

			<div class="row">

				<div class="col-lg-6">

					{{ form_row(form.clients, {
                        label: 'Client',

                        attr: {
                            class:
                                'form-control js-select-search',

                            'data-placeholder':
                                'Rechercher un client...'
                        }
                    }) }}

				</div>

				<div class="col-lg-6">

					{{ form_row(form.emetteur, {
                        label: 'Émetteur',

                        attr: {
                            class: 'form-control custom-select'
                        }
                    }) }}

				</div>

			</div>

		</div>

	</div>


	{# ========================================================
													       FACTURATION À UN TIERS
													       ======================================================== #}

	<div class="card">

		<div class="card-header">

			<div class="card-title">
				<i class="fa fa-exchange mr-2"></i>
				Facturation à un tiers
			</div>

		</div>

		<div class="card-body">

			<div class="custom-control custom-checkbox mb-3">

				{{ form_widget(form.facturerAUnTiers, {
                        attr: {
                            class: 'custom-control-input js-facturer-a-un-tiers'
                        }
                    }) }}

				{{ form_label(form.facturerAUnTiers, null, {
                        label_attr: {
                            class: 'custom-control-label'
                        }
                    }) }}

			</div>

			<small class="form-text text-muted mb-3 d-block">
				Le demandeur du devis n'est pas toujours celui qui paie
																												(ex : un employé demande, son entreprise règle).
																												Cochez cette case pour indiquer les coordonnées du payeur ;
																												elles remplaceront celles du client sur le PDF.
			</small>

			<div class="row js-zone-facturer-a-un-tiers" style="display:none;">

				<div class="col-md-6">
					{{ form_row(form.nomFacturation, {
                            label: 'Nom du payeur',
                            attr: { class: 'form-control' }
                        }) }}
				</div>

				<div class="col-md-6">
					{{ form_row(form.adresseFacturation, {
                            label: 'Adresse de facturation',
                            attr: { class: 'form-control' }
                        }) }}
				</div>

				<div class="col-md-6">
					{{ form_row(form.telephoneFacturation, {
                            label: 'Téléphone du payeur',
                            attr: { class: 'form-control' }
                        }) }}
				</div>

				<div class="col-md-6">
					{{ form_row(form.emailFacturation, {
                            label: 'Email du payeur',
                            attr: { class: 'form-control' }
                        }) }}
				</div>

			</div>

		</div>

	</div>


	{# ========================================================
													       INFORMATIONS DEVIS
													       ======================================================== #}

	<div class="card">

		<div class="card-header">

			<div class="card-title">
				<i class="fa fa-file-text-o mr-2"></i>
				Informations du devis
			</div>

		</div>

		<div class="card-body">

			<div class="row">

				<div class="col-md-6 col-xl-3">

					<div class="form-group">

						<label>
							Numéro
						</label>

						<input type="text" class="form-control" disabled value="{{ form.vars.data.numero |default( 'Généré automatiquement' ) }}">

					</div>

				</div>


				<div class="col-md-6 col-xl-3">

					{{ form_row(form.statut, {
                        label: 'Statut'
                    }) }}

				</div>


				<div class="col-md-6 col-xl-3">

					{{ form_row(form.etat, {
                        label: 'État'
                    }) }}

				</div>


				<div class="col-md-6 col-xl-3">

					{{ form_row(form.tva, {
                        label: 'TVA (%)'
                    }) }}

				</div>


				<div class="col-md-12 col-xl-6">

					{{ form_row(form.observation, {
                        label: 'Observation',

                        attr: {
                            rows: 3,
                            placeholder:
                                'Informations complémentaires...'
                        }
                    }) }}

				</div>

			</div>

		</div>

	</div>


	{# ========================================================
													       DÉTAILS
													       ======================================================== #}

	<div class="card">

		<div class="
																																																				                card-header
																																																				                d-flex
																																																				                justify-content-between
																																																				                align-items-center
																																																				            ">

			<div>

				<div class="card-title mb-0">

					<i class="fa fa-shopping-cart mr-2"></i>

					Produits, articles et prestations

				</div>

				<small class="text-muted">
					Produit catalogue,
																																																																	                    article en stock ou saisie libre.
				</small>

			</div>


			<button type="button" id="add-detail" class="btn btn-success-light">
				<i class="fa fa-plus mr-1"></i>
				Ajouter un détail
			</button>

		</div>


		<div class="card-body">

			{{ form_errors(
                form.devisDetails
            ) }}


			<div id="collection-details" data-index="{{ form.devisDetails|length }}" data-prototype="{{ _self.champs_detail( form.devisDetails.vars.prototype )|e('html_attr') }}">

				{% for detail in form.devisDetails %}

					<div class="
