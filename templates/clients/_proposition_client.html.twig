{#
	Fiche client : changement de raison sociale ou de NIF demandé dans
	l'espace client (Mon compte, maquette EC04), à appliquer ou refuser.
	Jamais appliqué tout seul.
#}
{% if is_granted('ROLE_CLIENT') %}
	{% for p in propositions_client(client) %}
		<div class="si-cf-doublon si-mc-proposition">
			<b><i class="fas fa-user-edit me-1"></i>Changement demandé en ligne</b>
			<span>
				{{ p.auteur ?? 'Le client' }}, le {{ p.creeLe|date('d/m/Y à H:i') }} :
				{% for champ, v in p.champs %}{{ constant('App\\Entity\\PropositionClient::CHAMPS')[champ][0] ?? champ }} « {{ v.avant ?? '—' }} » → « {{ v.apres ?? '—' }} »{{ not loop.last ? ' ; ' }}{% endfor %}
			</span>
			<form method="post" action="{{ path('app_messages_clients_proposition', {id: p.id, decision: 'appliquer'}) }}" data-confirmer="Appliquer ce changement à la fiche ?">
				<input type="hidden" name="_token" value="{{ csrf_token('messages-clients') }}">
				<button class="btn btn-success btn-sm">Appliquer</button>
			</form>
			<form method="post" action="{{ path('app_messages_clients_proposition', {id: p.id, decision: 'refuser'}) }}" class="si-mc-refus">
				<input type="hidden" name="_token" value="{{ csrf_token('messages-clients') }}">
				<input type="text" name="motif" maxlength="255" class="form-control form-control-sm" placeholder="Motif (lu par le client)">
				<button class="btn btn-light btn-sm">Refuser</button>
			</form>
		</div>
	{% endfor %}
{% endif %}
