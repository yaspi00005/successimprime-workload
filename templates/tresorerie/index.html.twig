{% extends 'base.html.twig' %}

{% block title %}Trésorerie et dépenses{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_rapprochement_bancaire_index') }}" class="btn btn-light btn-sm si-btn-entete">Rapprochement</a>
	</li>
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_mouvement_tresorerie_index') }}" class="btn btn-light btn-sm si-btn-entete">Mouvements</a>
	</li>
	<li class="nav-item">
		<a href="{{ path('app_mouvement_tresorerie_new') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Dépense</a>
	</li>
{% endblock %}

{% block body %}
	{% set solde_prevu = prevision.entrees - prevision.charges %}
	<div class="si-tresorerie">
		<div class="si-tresorerie-cartes">
			<article class="card si-tresorerie-carte">
				<h2>{{ groupes.banque.libelle }}</h2>
				<strong>{{ groupes.banque.solde|number_format(0, ',', ' ') }} F</strong>
				{% if a_rapprocher > 0 %}
					<a href="{{ path('app_rapprochement_bancaire_index') }}" class="si-t-attention">{{ a_rapprocher }} mouvement{{ a_rapprocher > 1 ? 's' }} à rapprocher</a>
				{% else %}
					<span class="si-t-ok">à jour au {{ 'now'|date('d/m') }}</span>
				{% endif %}
			</article>
			<article class="card si-tresorerie-carte">
				<h2>{{ groupes.mobile.libelle }}</h2>
				<strong>{{ groupes.mobile.solde|number_format(0, ',', ' ') }} F</strong>
				<span class="si-t-neutre">{{ groupes.mobile.comptes }} compte{{ groupes.mobile.comptes > 1 ? 's' }} marchand{{ groupes.mobile.comptes > 1 ? 's' }}</span>
			</article>
			<article class="card si-tresorerie-carte">
				<h2>{{ groupes.caisse.libelle }}</h2>
				<strong>{{ groupes.caisse.solde|number_format(0, ',', ' ') }} F</strong>
				{% if nb_caisses == 0 %}
					<span class="si-t-neutre">aucune caisse</span>
				{% elseif caisses_cloturees >= nb_caisses %}
					<span class="si-t-ok">clôturée{{ nb_caisses > 1 ? 's' }} aujourd’hui</span>
				{% else %}
					<a href="{{ path('app_caisse_index') }}" class="si-t-alerte">clôture ce soir{% if nb_caisses > 1 %} ({{ caisses_cloturees }}/{{ nb_caisses }}){% endif %}</a>
				{% endif %}
			</article>
			<article class="card si-tresorerie-carte">
				<h2>Prévision à {{ constant('App\\Service\\TableauTresorerie::JOURS_PREVUS') }} j</h2>
				<strong class="{{ solde_prevu < 0 ? 'text-danger' }}">{{ solde_prevu >= 0 ? '+' : '−' }}{{ (solde_prevu|abs)|number_format(0, ',', ' ') }} F</strong>
				<span class="si-t-ok">{{ prevision.entrees|number_format(0, ',', ' ') }} attendus − {{ prevision.charges|number_format(0, ',', ' ') }} de charges</span>
			</article>
		</div>

		<section class="card si-tresorerie-courbe">
			<header>
				<h2>Trésorerie prévisionnelle</h2>
				<span>{{ constant('App\\Service\\TableauTresorerie::JOURS_PASSES') }} j passés · {{ constant('App\\Service\\TableauTresorerie::JOURS_PREVUS') }} j prévus</span>
			</header>
			<svg viewBox="-4 -14 608 254" class="si-tresorerie-svg" role="img" aria-label="Solde total aujourd’hui {{ total|number_format(0, ',', ' ') }} F, prévu dans {{ constant('App\\Service\\TableauTresorerie::JOURS_PREVUS') }} jours {{ (total + solde_prevu)|number_format(0, ',', ' ') }} F">
				<defs>
					<linearGradient id="si-t-degrade" x1="0" y1="0" x2="0" y2="1">
						<stop offset="0" stop-color="#0F4590" stop-opacity=".22"/>
						<stop offset="1" stop-color="#0F4590" stop-opacity="0"/>
					</linearGradient>
				</defs>
				<path d="{{ trace.aire }}" fill="url(#si-t-degrade)"/>
				<path d="{{ trace.reel }}" fill="none" stroke="#0F4590" stroke-width="2.5" stroke-linejoin="round"/>
				{% if trace.prevu %}<path d="{{ trace.prevu }}" fill="none" stroke="#0F4590" stroke-width="2.5" stroke-dasharray="6 5" stroke-linejoin="round"/>{% endif %}
				<line x1="{{ trace.x_aujourdhui }}" x2="{{ trace.x_aujourdhui }}" y1="-6" y2="220" stroke="#DC2626" stroke-width="1.5" stroke-dasharray="4 4"/>
				<text x="{{ trace.x_aujourdhui + 6 }}" y="0" fill="#DC2626" font-size="12">aujourd’hui</text>
			</svg>
			<p class="si-tresorerie-legende">
				<span>Max {{ trace.max|number_format(0, ',', ' ') }} F</span>
				<span>Trait plein : réel · pointillés : créances attendues moins charges récurrentes et tâches du planning</span>
			</p>
		</section>

		<section class="card si-tresorerie-depenses">
			<header>
				<h2>Dépenses du mois</h2>
				<span>par catégorie</span>
			</header>
			{% set max_dep = max(depenses|map(d => d.montant)|merge([1])) %}
			<ul>
				{% for d in depenses %}
					<li>
						<span>{{ d.libelle }}</span>
						<span class="si-t-jauge" aria-hidden="true"><span style="width: {{ (d.montant / max_dep * 100)|round }}%"></span></span>
						<strong>{{ d.montant|number_format(0, ',', ' ') }}</strong>
					</li>
				{% else %}
					<li class="si-t-vide">Aucune dépense validée ce mois-ci.</li>
				{% endfor %}
			</ul>
			{% if charges is not empty %}
				<h3>Charges prévues</h3>
				<ul>
					{% for c in charges|slice(0, 6) %}
						<li><span>{{ c.date|date('d/m') }} · {{ c.libelle }}</span><strong>{{ c.montant|number_format(0, ',', ' ') }}</strong></li>
					{% endfor %}
				</ul>
				<a href="{{ path('app_decaissement_recurrent_index') }}" class="si-t-lien">Charges récurrentes</a>
			{% endif %}
		</section>
	</div>
{% endblock %}
