async function chargerConfigurationsProduit(detail, produitId, configurationInitiale = null) {
if (valeurTypeLigne(detail) !== 'produit') {
return;
}


const configurationSelect = champDetail(detail, 'configuration');


if (! configurationSelect) {
return;
}


configurationsParDetail.set(detail, []);


viderSelect(configurationSelect, produitId ? 'Chargement...' : 'Sélectionnez un produit');


if (! produitId) {
return;
}


try {
const url = construireUrl(configurationsProduitUrl, produitId);


console.log('Chargement configurations :', url);


const reponse = await fetch(url, {
headers: {
Accept: 'application/json'
}
});


if (! reponse.ok) {
throw new Error('Impossible de charger les configurations.');
}


const resultat = await reponse.json();


const configurations = Array.isArray(resultat) ? resultat : (resultat.configurations || resultat.data || []);


configurationsParDetail.set(detail, configurations);


viderSelect(configurationSelect, 'Sélectionnez une configuration');


configurations.forEach(function (configuration) {

const option = document.createElement('option');

option.value = configuration.id;

option.textContent = configuration.libelle || configuration.nom || ('Configuration ' + configuration.id);

configurationSelect.appendChild(option);
});


configurationSelect.disabled = false;


let configurationId = configurationInitiale;


if (! configurationId && configurations.length === 1) {
configurationId = configurations[0].id;
}


if (configurationId) {
configurationSelect.value = String(configurationId);

actualiserSelect2(configurationSelect);


await chargerConfiguration(detail, configurationId);
}

} catch (erreur) {
console.error(erreur);


viderSelect(configurationSelect, 'Erreur de chargement');
}
}


async function chargerConfiguration(detail, configurationId) {
if (valeurTypeLigne(detail) !== 'produit') {
return;
}


if (! configurationId) {
return;
}


try {
const url = construireUrl(configurationUrl, configurationId);


console.log('Chargement configuration :', url);


const reponse = await fetch(url, {
headers: {
Accept: 'application/json'
}
});


if (! reponse.ok) {
throw new Error('Impossible de charger la configuration.');
}


const resultat = await reponse.json();


const configuration = resultat.configuration || resultat.data || resultat;


detail.dataset.modeDimension = String(configuration.modeDimension || '');

detail.dataset.modeCalcul = String(configuration.modeCalcul || 'unite');

detail.dataset.quantiteMin = String(configuration.quantiteMinimale ?? configuration.quantiteMin ?? 1);

detail.dataset.quantiteMax = String(configuration.quantiteMaximale ?? configuration.quantiteMax ?? '');


definirValeurChamp(detail, 'designation', configuration.designation || '', false);

definirValeurChamp(detail, 'typeImpression', configuration.typeImpression, false);

definirValeurChamp(detail, 'support', configuration.support, false);

definirValeurChamp(detail, 'format', configuration.format, false);


if (configuration.prixBase !== null && configuration.prixBase !== undefined) {
definirValeurChamp(detail, 'prixUnitaire', configuration.prixBase, false);
}


definirValeurChamp(detail, 'modeCalcul', configuration.modeCalcul || 'unite', false);


/*
             * Quantités
             */
const quantite = champDetail(detail, 'quantite');

const minimum = Math.max(1, Number(detail.dataset.quantiteMin || 1));

const maximum = detail.dataset.quantiteMax !== '' ? Number(detail.dataset.quantiteMax) : null;


if (quantite) {
quantite.min = String(minimum);

if (maximum !== null && Number.isFinite(maximum)) {
quantite.max = String(maximum);

} else {
quantite.removeAttribute('max');
}


if (! quantite.value || Number(quantite.value) < minimum) {
quantite.value = String(minimum);
}
}


const messageQuantite = detail.querySelector('.js-message-quantite');


if (messageQuantite) {
if (maximum !== null && Number.isFinite(maximum)) {
messageQuantite.textContent = 'Quantité autorisée : ' + minimum + ' à ' + maximum + '.';

} else {
messageQuantite.textContent = 'Quantité minimale : ' + minimum + '.';
}
}


/*
             * Dimensions
             */
if (detail.dataset.modeDimension === 'mesure') {
definirValeurChamp(detail, 'largeur', cmDepuisMetres(configuration.largeurDefaut ?? configuration.largeur ?? ''), false);

definirValeurChamp(detail, 'longueur', cmDepuisMetres(configuration.longueurDefaut ?? configuration.longueur ?? ''), false);
}


/*
             * Finitions
             */
const finitionsBox = detail.querySelector('.js-finitions-box');


if (finitionsBox) {
const nomChamp = finitionsBox.dataset.inputName;


finitionsBox.innerHTML = '';


const finitions = configuration.finitions || configuration.configurationFinitions || [];


if (! finitions.length) {
finitionsBox.innerHTML = '<span class="text-muted">' + 'Aucune finition disponible.' + '</span>';
}


finitions.forEach(function (finition) {

const donnees = finition.finition || finition;

const identifiant = finition.id ?? donnees.id;


if (! identifiant) {
return;
}


const wrapper = document.createElement('div');

wrapper.className = 'form-check form-check-inline';


const checkbox = document.createElement('input');

checkbox.type = 'checkbox';

checkbox.className = 'form-check-input js-finition-selectionnee';

checkbox.name = nomChamp + '[]';

checkbox.value = String(identifiant);

checkbox.dataset.prix = String(finition.prix ?? donnees.prix ?? 0);

checkbox.dataset.modeCalcul = String(finition.modeCalcul || 'forfait');

checkbox.checked = Boolean(finition.obligatoire || finition.selectionneeParDefaut);


if (finition.obligatoire) {
checkbox.addEventListener('click', function (event) {
event.preventDefault();

checkbox.checked = true;
});
}


const label = document.createElement('label');

label.className = 'form-check-label ml-1';


label.textContent = donnees.nom || finition.nom || 'Finition';


if (Number(finition.prix || 0) > 0) {
label.textContent += ' — ' + Number(finition.prix).toLocaleString('fr-FR') + ' FCFA';
}


wrapper.appendChild(checkbox);

wrapper.appendChild(label);

finitionsBox.appendChild(wrapper);
});
}


actualiserDimensions(detail);

calculerDetail(detail);

} catch (erreur) {
console.error('Erreur configuration :', erreur);
}
}


