/*
 * ====================================================
 * FORMAT / DIMENSIONS SELON LE PRODUIT
 * ====================================================
 *
 * - Produit sans surface/longueur (forfait, unité...) : ni
 *   format, ni largeur/longueur, juste quantité et prix.
 * - Produit avec surface/longueur et des formats liés : liste
 *   de formats, dont le choix remplit largeur/longueur.
 * - Produit avec surface/longueur mais aucun format lié :
 *   largeur/longueur à saisir directement.
 */
function appliquerZoneFormatDimensions(detail, infosProduit, formats, conserverValeurs = false) {
const besoinDimensions = Boolean(infosProduit.utiliseSurface) || Boolean(infosProduit.utiliseLongueur);

const aDesFormats = besoinDimensions && formats.length > 0;

afficher(detail, '.js-zone-format', aDesFormats);

afficher(detail, '.js-zone-largeur', besoinDimensions);

afficher(detail, '.js-zone-longueur', besoinDimensions);

detail.dataset.formatsDimensions = JSON.stringify(
formats.map(function (f) {
return {
id: f.id,
largeur: f.largeur,
hauteur: f.hauteur,
unite: f.unite
};
})
);

if (! besoinDimensions && ! conserverValeurs) {
definirValeur(detail, 'format', '');
definirValeur(detail, 'largeur', '');
definirValeur(detail, 'longueur', '');
}
}


/*
 * Convertit une dimension de Format (mm, cm ou m selon le
 * champ "unité" du format) vers des centimètres, pour remplir
 * Largeur (cm) / Longueur (cm).
 */
function convertirVersCm(valeur, unite) {
const nombre = Number(valeur);

if (! isFinite(nombre) || nombre <= 0) {
return null;
}

const u = String(unite || 'mm').trim().toLowerCase();

if (u === 'mm') {
return nombre / 10;
}

if (u === 'cm') {
return nombre;
}

if (u === 'm') {
return nombre * 100;
}

/*
 * Unité non reconnue : mieux vaut laisser le champ vide qu'une
 * valeur fausse.
 */
return null;
}


function appliquerDimensionsFormatSelectionne(detail) {
const champFormat = champDetail(detail, 'format');

if (! champFormat || ! champFormat.value) {
return;
}

let formats = [];

try {
formats = JSON.parse(detail.dataset.formatsDimensions || '[]');
} catch (e) {
formats = [];
}

const formatChoisi = formats.find(function (f) {
return String(f.id) === String(champFormat.value);
});

if (! formatChoisi) {
return;
}

const largeurCm = convertirVersCm(formatChoisi.largeur, formatChoisi.unite);

const longueurCm = convertirVersCm(formatChoisi.hauteur, formatChoisi.unite);

if (largeurCm !== null) {
definirValeur(detail, 'largeur', largeurCm);
}

if (longueurCm !== null) {
definirValeur(detail, 'longueur', longueurCm);
}

calculerDetail(detail);
}


/*
 * chargementInitial : ligne deja enregistree qu'on affiche. Sa
 * designation, son prix, sa remise, son mode de calcul, son format, sa
 * largeur et sa longueur restent tels qu'enregistres, meme si le
 * catalogue a change : un simple « Enregistrer » ne doit jamais effacer
 * une dimension ni changer le prix d'une ligne (remise convertie a la
 * bascule, total d'origine conserve). Le catalogue ne s'applique que
 * quand on choisit un autre produit ou un autre client.
 */
async function chargerOptionsManuelles(detail, chargementInitial = false) {
if (valeurTypeLigne(detail) !== 'produit') {
return;
}

const produit = champDetail(detail, 'produit');

if (! produit || ! produit.value) {
return;
}


try {

const response = await fetch(construireUrl(optionsManuellesUrl, produit.value));

const json = await response.json();

if (! response.ok || ! json.success) {
throw new Error(json.message || 'Impossible de charger le produit.');
}

const infosProduit = json.produit || {};


if (! chargementInitial) {
definirValeur(detail, 'designation', infosProduit.nom || '');

definirValeur(detail, 'prixUnitaire', infosProduit.prixBase || 0);

definirValeur(detail, 'remise', clientEstB2B() ? Math.round((infosProduit.prixBase || 0) * (infosProduit.remiseB2B || 0) / 100) : 0);

definirValeur(detail, 'modeCalcul', infosProduit.modeCalcul || 'unite');
}


filtrerOptions(champDetail(detail, 'typeImpression'), (json.typesImpression || []).map(function (t) {
return t.id;
}));

filtrerOptions(champDetail(detail, 'support'), (json.supports || []).map(function (s) {
return s.id;
}));

filtrerOptions(champDetail(detail, 'format'), (json.formats || []).map(function (f) {
return f.id;
}));

appliquerZoneFormatDimensions(detail, infosProduit, json.formats || [], chargementInitial);

/*
 * Finitions compatibles avec le produit : memorisees sur le
 * detail pour filtrer aussi bien les lignes de finition deja
 * presentes que celles ajoutees plus tard via "Ajouter une
 * finition" (voir appliquerFiltreFinitions() et l'ecouteur de
 * .js-ajouter-finition dans initialiserDetail()).
 */
detail.dataset.finitionsAutorisees = (json.finitions || []).map(function (f) {
return f.id;
}).join(',');

appliquerFiltreFinitions(detail);


calculerDetail(detail);


} catch (e) {

console.error(e);
}
}


