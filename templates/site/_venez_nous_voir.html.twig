{#
	Accueil, sous l'accroche : bandeau « Venez nous voir » avec la vraie
	façade de la boutique (photos du local du 17/10/2026, PhotosSite),
	l'adresse de l'entreprise (Réglages › Entreprises), les horaires du
	réglage Horaires, « Itinéraire » (position de la boutique, sinon une
	recherche Google Maps sur l'adresse) et « WhatsApp ». Bloc autonome :
	il écrit lui-même sa petite feuille de style (docs/site-vitrine.md).
#}
{% set visite = site_visite() %}
{% set photo_facade = site_photo(constant('App\\Service\\Site\\PhotosSite::FACADE')) %}
{{ site_styles('css/site-local.css') }}
<section class="si-visite" aria-labelledby="si-visite-titre">
	<div class="si-cadre">
		<div class="si-visite-carte"{% if photo_facade %} data-revele{% endif %}>
			{% if photo_facade %}
				<figure class="si-visite-photo">
					{{ include('site/_photo.html.twig', {photo: photo_facade, sizes: '(max-width: 860px) calc(100vw - 58px), (max-width: 1180px) 50vw, 600px'}) }}
				</figure>
			{% endif %}
			<div class="si-visite-texte">
				<span class="si-visite-sur">Notre boutique</span>
				<h2 id="si-visite-titre">Venez nous voir</h2>
				<p class="si-visite-ligne">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
					<span><strong>Boutique {{ visite.nom }}</strong>{{ visite.adresse }}</span>
				</p>
				<p class="si-visite-ligne">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7Z"/></svg>
					<span>
						<strong>{{ visite.horaires.texte }}</strong>
						<span class="si-visite-etat{{ visite.horaires.ouvert ? ' si-visite-ouvert' }}">{{ visite.horaires.etat }}</span>
					</span>
				</p>
				<div class="si-visite-actions">
					<a href="{{ visite.itineraire }}" class="si-bouton si-bouton-bleu si-bouton-grand" target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.7 11.3 12.7 2.3a1 1 0 0 0-1.4 0l-9 9a1 1 0 0 0 0 1.4l9 9a1 1 0 0 0 1.4 0l9-9a1 1 0 0 0 0-1.4ZM14 14.5V12h-4v3H8v-4a1 1 0 0 1 1-1h5V7.5l3.5 3.5Z"/></svg>
						Itinéraire
					</a>
					{% if visite.whatsapp %}
						<a href="{{ visite.whatsapp }}" class="si-bouton si-visite-wa si-bouton-grand" target="_blank" rel="noopener">
							{{ include('site/_icone_whatsapp.svg.twig') }}
							WhatsApp
						</a>
					{% endif %}
				</div>
			</div>
		</div>
	</div>
</section>
