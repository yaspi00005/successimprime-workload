{{ form_start(form) }}

<div class="row">

    <div class="col-md-4">
        <div class="form-group">
            {{ form_label(form.code) }}
            {{ form_widget(form.code) }}
            {{ form_help(form.code) }}
            {{ form_errors(form.code) }}
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group">
            {{ form_label(form.nom) }}
            {{ form_widget(form.nom) }}
            {{ form_errors(form.nom) }}
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group">
            {{ form_label(form.type) }}
            {{ form_widget(form.type) }}
            {{ form_errors(form.type) }}
        </div>
    </div>

</div>

<div class="row">

    <div
        id="blocNomBanque"
        class="col-md-4 champ-bancaire"
    >
        <div class="form-group">
            {{ form_label(form.nomBanque) }}
            {{ form_widget(form.nomBanque) }}
            {{ form_errors(form.nomBanque) }}
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group">
            {{ form_label(form.numeroCompte) }}
            {{ form_widget(form.numeroCompte) }}
            {{ form_errors(form.numeroCompte) }}
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group">
            {{ form_label(form.titulaireCompte) }}
            {{ form_widget(form.titulaireCompte) }}
            {{ form_errors(form.titulaireCompte) }}
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-4">
        <div class="form-group">
            {{ form_label(form.soldeInitial) }}
            {{ form_widget(form.soldeInitial) }}
            {{ form_help(form.soldeInitial) }}
            {{ form_errors(form.soldeInitial) }}
        </div>
    </div>

    <div class="col-md-4">
        <div class="form-group">
            {{ form_label(form.devise) }}
            {{ form_widget(form.devise) }}
            {{ form_errors(form.devise) }}
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-4">
        <div class="custom-control custom-checkbox mb-3">
            {{ form_widget(form.autoriserDecouvert) }}
            {{ form_label(form.autoriserDecouvert) }}
            {{ form_errors(form.autoriserDecouvert) }}
        </div>
    </div>

    <div class="col-md-4">
        <div class="custom-control custom-checkbox mb-3">
            {{ form_widget(form.actif) }}
            {{ form_label(form.actif) }}
            {{ form_errors(form.actif) }}
        </div>
    </div>

</div>

<div class="form-group">
    {{ form_label(form.description) }}
    {{ form_widget(form.description) }}
    {{ form_errors(form.description) }}
</div>

<div class="text-right mt-4">

    <a
        href="{{ path('app_compte_tresorerie_index') }}"
        class="btn btn-secondary"
    >
        <i class="fa fa-arrow-left mr-1"></i>
        Annuler
    </a>

    <button
        type="submit"
        class="btn btn-primary"
    >
        <i class="fa fa-save mr-1"></i>
        {{ bouton_label|default('Enregistrer') }}
    </button>

</div>

{{ form_end(form) }}

<script>
document.addEventListener('DOMContentLoaded', function () {
    const typeCompte = document.querySelector(
        '[data-role="compte-type"]'
    );

    const blocNomBanque = document.getElementById(
        'blocNomBanque'
    );

    if (!typeCompte || !blocNomBanque) {
        return;
    }

    function actualiserChamps() {
        const estBanque = typeCompte.value === 'banque';

        blocNomBanque.style.display = estBanque
            ? ''
            : 'none';

        const champNomBanque = blocNomBanque.querySelector(
            'input'
        );

        if (champNomBanque) {
            champNomBanque.required = estBanque;

            if (!estBanque) {
                champNomBanque.value = '';
            }
        }
    }

    typeCompte.addEventListener(
        'change',
        actualiserChamps
    );

    actualiserChamps();
});
</script>