{% extends 'base.html.twig' %}

{% block title %}
	Commande
	{{ commande.reference|default('#' ~ commande.id) }}
{% endblock %}


{% block body %}

	{# ================================================================
						   DONNÉES PRINCIPALES
						   ================================================================ #}

	{% set reference =
		commande.reference
			|default(
				'CMD-' ~ '%05d'|format(commande.id)
			)
	%}

	{% set client =
		commande.clients|default(null)
	%}

	{% set details =
		commande.commandesDetails|default([])
	%}

	{#
				 # commande.statut / commande.etat sont des booléens (paiement en
				 # attente / travaux en cours), pas un statut de travail -- le
				 # badge ci-dessous doit se baser sur commande.statutTravaux (la
				 # même méthode déjà utilisée par commandes/index.html.twig), qui
				 # calcule un vrai statut ('annulee', 'preparation', 'livraison',
				 # 'livree', 'vide') à partir de l'état de production des lignes.
				 #}
	{% set statutTravaux =
		commande.statutTravaux
	%}


	{# ================================================================
						   PERMISSIONS
						   ================================================================ #}

	{% set estAdmin =
		is_granted('ROLE_ADMIN')
	%}

	{% set peutVoirCommande =
		is_granted('ROLE_COMMANDE')
		or estAdmin
	%}

	{% set peutModifierCommande =
		is_granted('ROLE_COMMANDE')
		or estAdmin
	%}

	{% set peutVoirPaiements =
		is_granted('ROLE_PAIEMENT_VOIR')
		or estAdmin
	%}

	{% set peutEncaisser =
		is_granted('ROLE_PAIEMENT_ENCAISSER')
		or estAdmin
	%}

	{% set peutFacturer =
		is_granted('ROLE_FACTURE')
		or estAdmin
	%}

	{% set peutControlePrePresse =
		is_granted('ROLE_PREPRESSE')
		or estAdmin
	%}

	{% set peutVoirProduction =
		is_granted('ROLE_PRODUCTION_VOIR')
		or estAdmin
	%}

	{% set peutImprimerCommande =
		peutVoirCommande
		or peutFacturer
		or peutControlePrePresse
		or peutVoirProduction
		or estAdmin
	%}


	{# ================================================================
						   VERROUILLAGE PRODUCTION
						   ================================================================
						   
						   Dès qu'une ligne est réellement entrée en production,
						   une personne non Admin ne peut plus modifier la commande.
						   ================================================================ #}

	{% set commandeVerrouilleeProduction = false %}

	{% for detail in details %}

		{% set statutProduction =
			detail.statutProduction
				|default('a_produire')
		%}

		{% if statutProduction in [
			'en_cours',
			'en_pause',
			'terminee',
			'terminée',
			'prete_livraison',
			'en_livraison',
			'livree',
			'livrée'
		] %}

			{% set commandeVerrouilleeProduction = true %}

		{% endif %}

	{% endfor %}


	{# ================================================================
						   MONTANTS
						   ================================================================ #}

	{% set totalTtc =
		commande.totalTtc|default(0)
	%}

	{% set totalPaye =
		commande.totalPaye|default(0)
	%}

	{% set resteAPayer =
		commande.resteAPayer
			|default(
				totalTtc - totalPaye
			)
	%}


	<div
		class="side-app">


		{# ============================================================
												   EN-TÊTE
												   ============================================================ #}

		<div class="page-header">

			<ol class="breadcrumb">

				<li class="breadcrumb-item">
					<a href="{{ path('app_commandes_index') }}">
						Commandes
					</a>
				</li>

				<li class="breadcrumb-item active" aria-current="page">
					{{ reference }}
				</li>

			</ol>

			{% if commande.modifieLe %}
				<div class="text-muted small mb-2">
					<i class="fe fe-edit-2 mr-1"></i>
					Modifié le
					{{ commande.modifieLe|date('d/m/Y à H:i') }}
					{% if commande.modifiePar %}
						par
						{{ commande.modifiePar.username }}
					{% endif %}
				</div>
			{% endif %}


			<div>

				{# ====================================================
																								   RETOUR
																								   ==================================================== #}

				<a href="{{ path('app_commandes_index') }}" class="btn btn-sm btn-light mr-2 mb-2">
					<i class="fe fe-arrow-left mr-1"></i>

					Retour
				</a>


				{# ====================================================
																								   PAIEMENT
																								   ==================================================== #}

				{% if peutEncaisser and commande.statutTravaux != 'annulee' %}

					{% if resteAPayer > 0 %}

						<a href="{{ path( 'app_commandes_paiement', { id: commande.id } ) }}" class="btn btn-sm btn-info mr-2 mb-2">
							<i class="fa fa-money mr-1"></i>

							Encaisser un paiement
						</a>

					{% else %}

						<button type="button" class="btn btn-sm btn-success mr-2 mb-2" disabled>
							<i class="fa fa-check-circle mr-1"></i>

							Commande soldée
						</button>

					{% endif %}

				{% endif %}


				{% if
					peutModifierCommande
					and commande.statutTravaux != 'annulee'
					and (
						not commandeVerrouilleeProduction
						or estAdmin
					)
				%}

					<form method="post" action="{{ path( 'app_commandes_annuler', { id: commande.id } ) }}" class="js-confirm-form d-inline" data-message="Annuler la commande {{ commande.numero }} ? Un administrateur pourra la restaurer ensuite si besoin.">

						<input type="hidden" name="_token" value="{{ csrf_token( 'annuler-commande-' ~ commande.id ) }}">

						<button type="submit" class="btn btn-sm btn-outline-danger mr-2 mb-2">
							<i class="fe fe-x-circle mr-1"></i>
							Annuler la commande
						</button>

					</form>

				{% endif %}


				{% if statutTravaux == 'annulee' and estAdmin %}

					<form method="post" action="{{ path( 'app_commandes_restaurer', { id: commande.id } ) }}" class="js-confirm-form d-inline" data-message="Restaurer la commande {{ commande.numero }} ? Chaque ligne retrouvera le statut de production qu'elle avait avant l'annulation.">

						<input type="hidden" name="_token" value="{{ csrf_token( 'restaurer-commande-' ~ commande.id ) }}">

						<button type="submit" class="btn btn-sm btn-outline-success mr-2 mb-2">
							<i class="fe fe-rotate-ccw mr-1"></i>
							Restaurer la commande
						</button>

					</form>

				{% endif %}


				{# ====================================================
																								   FACTURATION
																								   ==================================================== #}

				{% if peutFacturer %}

					<a href="{{ path( 'app_factures_nouveau', { id: commande.id } ) }}" class="btn btn-sm btn-success mr-2 mb-2">
						<i class="fa fa-file-text-o mr-1"></i>

						Créer un document de facturation
					</a>

				{% endif %}


				{# ====================================================
																								   MODIFIER
																								   ==================================================== #}

				{% if
					peutModifierCommande
					and commande.statutTravaux != 'annulee'
					and (
						not commandeVerrouilleeProduction
						or estAdmin
					)
				%}

					<a href="{{ path( 'app_commandes_edit', { id: commande.id } ) }}" class="btn btn-sm btn-primary mr-2 mb-2">
						<i class="fe fe-edit-2 mr-1"></i>

						Modifier
					</a>

				{% elseif
					commandeVerrouilleeProduction
					and commande.statutTravaux != 'annulee'
					and not estAdmin
				%}

					<button type="button" class="btn btn-sm btn-secondary mr-2 mb-2" disabled title="La production a déjà démarré">
						<i class="fa fa-lock mr-1"></i>

						Commande verrouillée
					</button>

				{% endif %}


				{# ====================================================
																								   CONTRÔLE PRÉPRESSE
																								   ==================================================== #}

				{% if peutControlePrePresse %}

					<a href="{{ path( 'app_controle_pre_presse_index' ) }}" class="btn btn-sm btn-warning mr-2 mb-2">
						<i class="fe fe-check-square mr-1"></i>

						Contrôle prépresse
					</a>

				{% endif %}


				{# ====================================================
																								   IMPRIMER
																								   ==================================================== #}

				{% if peutImprimerCommande %}

					<button type="button" class="btn btn-sm btn-secondary mr-2 mb-2" onclick="window.print()">
						<i class="fe fe-printer mr-1"></i>

						Imprimer
					</button>

				{% endif %}

			</div>

		</div>


		{# ============================================================
												   MESSAGES FLASH
												   ============================================================ #}

		{% for type, messages in app.flashes %}

			{% for message in messages %}

				<div class="
																																				alert
																																				alert-{{
																																					type == 'error'
																																						? 'danger'
																																						: type
																																				}}
																																				alert-dismissible
																																				fade
																																				show
																																			">

					{{ message }}

					<button type="button" class="close" data-dismiss="alert">
						&times;
					</button>

				</div>

			{% endfor %}

		{% endfor %}


		{# ============================================================
												   ALERTE PRODUCTION
												   ============================================================ #}

		{% if commandeVerrouilleeProduction %}

			<div class="alert alert-warning">

				<div class="d-flex align-items-center">

					<i class="fa fa-lock fa-2x mr-3"></i>

					<div>

						<strong class="d-block">
							Commande verrouillée par la production
						</strong>

						<span>
							Au moins un travail de cette commande
																																										est déjà entré en production.
						</span>

						{% if estAdmin %}

							<div class="mt-1">

								<strong>
									Vous êtes administrateur :
																																																						la modification reste autorisée.
								</strong>

							</div>

						{% else %}

							<div class="mt-1">


								modifier cette commande.

							</div>

						{% endif %}

					</div>

				</div>

			</div>

		{% endif %}


		<div
			class="row">


			{# ========================================================
																		   COLONNE PRINCIPALE
																		   ======================================================== #}

			<div class="col-xl-8 col-lg-8">


				<div class="card">

					<div class="
																																										card-header
																																										d-flex
																																										justify-content-between
																																										align-items-center
																																									">

						<div>

							<h3 class="card-title mb-1">
								Détails de la commande
							</h3>

							<small class="text-muted">
								{{ reference }}
								{% if commande.dateCommande %}
									·
									{{ commande.dateCommande|date('d/m/Y') }}
								{% endif %}
							</small>

						</div>


						<div>

							{% if statutTravaux == 'annulee' %}

								<span class="badge badge-danger">
									Annulée
								</span>


							{% elseif statutTravaux == 'livree' %}

								<span class="badge badge-success">
									Terminée
								</span>


							{% elseif statutTravaux == 'livraison' %}

								<span class="badge badge-warning">
									En livraison
								</span>


							{% elseif statutTravaux == 'preparation' %}

								<span class="badge badge-info">
									En préparation
								</span>


							{% else %}

								<span class="badge badge-primary">
									Enregistrée
								</span>

							{% endif %}

						</div>

					</div>


					<div class="card-body">

						{% if details is empty %}

							<div class="alert alert-info mb-0">

								Aucun travail n’est associé
																																																à cette commande.

							</div>


						{% else %}


							{% for detail in details %}

								{% set configuration =
									detail.produitConfiguration
										|default(null)
								%}


								<div
									class="border rounded mb-4">


									{# ========================================
																																																						   EN-TÊTE DU TRAVAIL
																																																						   ======================================== #}

									<div class="
																																																																		bg-light
																																																																		border-bottom
																																																																		p-3
																																																																		d-flex
																																																																		justify-content-between
																																																																		align-items-center
																																																																		text-primary
																																																																	">

										<div>

											<h5 class="mb-1">

												{{
													detail.produit.nom
														|default(
															detail.designation
																|default(
																	'Produit non renseigné'
																)
														)
												}}

											</h5>

											<small class="text-primary">

												Travail n°
												{{ loop.index }}

											</small>

											<small class=" d-block" title="À utiliser en préfixe du nom de fichier pour l'import depuis le dossier partagé">

												Réf: #{{ detail.id }}

											</small>

										</div>


										<strong>

											{{
												detail.totalTtc
													|default(0)
													|number_format(
														0,
														',',
														' '
													)
											}}

											FCFA

										</strong>

									</div>


									<div
										class="p-3">


										{# ====================================
																																																												   INFORMATIONS TECHNIQUES
																																																												   ==================================== #}

										<div class="row">


											<div class="col-md-4 mb-3">

												<small class="text-muted d-block">
													Type d’impression
												</small>

												<strong>
													{{
														configuration
															.typeImpression
															.nom
															|default('—')
													}}
												</strong>

											</div>


											<div class="col-md-4 mb-3">

												<small class="text-muted d-block">
													Support
												</small>

												<strong>
													{{
														configuration
															.support
															.nom
															|default('—')
													}}
												</strong>

											</div>


											<div class="col-md-4 mb-3">

												<small class="text-muted d-block">
													Format
												</small>

												<strong>
													{{
														configuration
															.format
															.nom
															|default('—')
													}}
												</strong>

											</div>


											<div class="col-md-3 mb-3">

												<small class="text-muted d-block">
													Quantité
												</small>

												<strong>
													{{ detail.quantite|default(1) }}
												</strong>

											</div>


											<div class="col-md-3 mb-3">

												<small class="text-muted d-block">
													Dimensions
												</small>

												<strong>

													{% if
														detail.largeur|default(0)
														or
														detail.longueur|default(0)
													%}

														{{ detail.largeur|default(0) }}
														×
														{{ detail.longueur|default(0) }}

													{% else %}

														—

													{% endif %}

												</strong>

											</div>


											<div class="col-md-3 mb-3">

												<small class="text-muted d-block">
													Surface
												</small>

												<strong>

													{{
														detail.surface
															|default(0)
															|number_format(
																2,
																',',
																' '
															)
													}}

													m²

												</strong>

											</div>


											<div class="col-md-3 mb-3">

												<small class="text-muted d-block">
													Prix unitaire
												</small>

												<strong>

													{{
														detail.prixUnitaire
															|default(0)
															|number_format(
																0,
																',',
																' '
															)
													}}

													FCFA

												</strong>

											</div>

										</div>


										{# ====================================
																																																												   FINITIONS
																																																												   ==================================== #}

										{% if
											detail.finitions
												|default([])
												is not empty
										%}

											<div class="mt-2">

												<h6 class="mb-2">
													Finitions
												</h6>


												<div class="table-responsive">

													<table class="
																																																																																										table
																																																																																										table-sm
																																																																																										table-bordered
																																																																																										mb-0
																																																																																									">

														<thead class="bg-light">

															<tr>

																<th>
																	Finition
																</th>

																<th>
																	Mode de calcul
																</th>

																<th class="text-center">
																	Quantité
																</th>

																<th class="text-right">
																	Prix appliqué
																</th>

																<th class="text-right">
																	Montant
																</th>

															</tr>

														</thead>


														<tbody>

															{% for finition in detail.finitions %}

																<tr>

																	<td>

																		{{
																			finition
																				.configurationFinition
																				.finition
																				.nom
																				|default(
																					'Finition'
																				)
																		}}

																	</td>


																	<td>

																		{{
																			finition
																				.modeCalcul
																				|default(
																					'forfait'
																				)
																				|replace({
																					'_': ' '
																				})
																				|capitalize
																		}}

																	</td>


																	<td class="text-center">

																		{{
																			finition.quantite
																				|default(1)
																		}}

																	</td>


																	<td class="text-right">

																		{{
																			finition
																				.prixApplique
																				|default(0)
																				|number_format(
																					0,
																					',',
																					' '
																				)
																		}}

																		FCFA

																	</td>


																	<td class="
																																																																																																																		text-right
																																																																																																																		font-weight-bold
																																																																																																																	">

																		{{
																			finition
																				.montant
																				|default(0)
																				|number_format(
																					0,
																					',',
																					' '
																				)
																		}}

																		FCFA

																	</td>

																</tr>

															{% endfor %}

														</tbody>

													</table>

												</div>

											</div>

										{% endif %}


										{# ====================================
																																																												   DESCRIPTION
																																																												   ==================================== #}

										{% if detail.description|default('') %}

											<div class="mt-3">

												<small class="text-muted d-block">
													Description / consignes
												</small>

												<div class="
																																																																																				border
																																																																																				rounded
																																																																																				bg-light
																																																																																				p-2
																																																																																			">

													{{ detail.description|nl2br }}

												</div>

											</div>

										{% endif %}


										{# ====================================
																																																												   OBSERVATION
																																																												   ==================================== #}

										{% if detail.observation|default('') %}

											<div class="mt-3">

												<small class="text-muted d-block">
													Observation
												</small>

												<div class="
																																																																																				border
																																																																																				rounded
																																																																																				bg-light
																																																																																				p-2
																																																																																			">

													{{ detail.observation|nl2br }}

												</div>

											</div>

										{% endif %}


										{# ====================================
																																																												   FICHIERS CLIENT
																																																												   ==================================== #}

										{% set fichiers =
											detail.fichiers|default([])
										%}


										{% if fichiers is not empty %}

											<div class="mt-3">

												<h6 class="mb-2">

													<i class="fe fe-paperclip mr-1"></i>

													Fichiers du client

												</h6>


												<div class="list-group">

													{% for fichier in fichiers %}

														<div class="
																																																																																																list-group-item
																																																																																																d-flex
																																																																																																flex-wrap
																																																																																																justify-content-between
																																																																																																align-items-center
																																																																																															">

															<div class="
																																																																																																						mr-3
																																																																																																						mb-2
																																																																																																						mb-sm-0
																																																																																																					">

																<i class="
																																																																																																							fe
																																																																																																							fe-file
																																																																																																							text-primary
																																																																																																							mr-2
																																																																																																						"></i>

																<strong>

																	{{
																		fichier.nomOriginal
																			|default(
																				'Fichier joint'
																			)
																	}}

																</strong>


																{% if
																	fichier.taille
																		|default(0)
																	>
																	0
																%}

																	<small class="text-muted ml-2">

																		{{
																			(
																				fichier.taille
																				/
																				1024
																			)
																				|number_format(
																					1,
																					',',
																					' '
																				)
																		}}

																		Ko

																	</small>

																{% endif %}

															</div>


															<a href="{{ path( 'app_fichier_visualiser', { id: fichier.id } ) }}" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-primary">

																<i class="fe fe-eye mr-1"></i>

																Visualiser

															</a>

														</div>

													{% endfor %}

												</div>

											</div>

										{% endif %}


										{# ====================================
																																																												   TOTAUX DU TRAVAIL
																																																												   ==================================== #}

										<div class="row mt-3">

											<div class="col-md-4">

												<small class="text-muted d-block">
													Total HT
												</small>

												<strong>

													{{
														detail.totalHt
															|default(0)
															|number_format(
																0,
																',',
																' '
															)
													}}

													FCFA

												</strong>

											</div>


											<div class="col-md-4">

												<small class="text-muted d-block">
													TVA
												</small>

												<strong>
													{{ detail.tva|default(0) }}
													%
												</strong>

											</div>


											<div class="col-md-4 text-md-right">

												<small class="text-muted d-block">
													Total TTC
												</small>

												<strong class="text-primary">

													{{
														detail.totalTtc
															|default(0)
															|number_format(
																0,
																',',
																' '
															)
													}}

													FCFA

												</strong>

											</div>

										</div>

										<div class="row mt-3">

											<div class="col-12">

												{% if (is_granted('ROLE_LIVRAISON') or estAdmin) and detail.statutProduction != 'livree' %}

													<form method="post" action="{{ path( 'app_livraisons_livrer_directement', { id: detail.id } ) }}" class="js-confirm-form" data-message="Marquer « {{ detail.designation|default('ce travail') }} » comme livré, sans passer par le contrôle prépresse ni la production ? Le stock réservé sera définitivement sorti.">

														<input type="hidden" name="_token" value="{{ csrf_token( 'livraison_direct_' ~ detail.id ) }}">

														<button type="submit" class="btn btn-sm btn-success">
															<i class="fe fe-truck mr-1"></i>
															Marquer comme livré
														</button>

													</form>

												{% endif %}

											</div>

										</div>

									</div>

								</div>

							{% endfor %}

						{% endif %}

					</div>

				</div>

			</div>


			{# ========================================================
																		   COLONNE DROITE
																		   ======================================================== #}

			<div
				class="col-xl-4 col-lg-4">


				{# ====================================================
																								   CLIENT
																								   ==================================================== #}

				<div class="card">

					<div class="card-header">

						<h3 class="card-title">
							Client
						</h3>

					</div>


					<div class="card-body">

						<h5 class="mb-2">

							{{
								client.raisonSociale
									|default(
										client.nomComplet
											|default(
												client.nom
													|default(
														'Client non renseigné'
													)
											)
									)
							}}

						</h5>


						{% if client.telephone|default('') %}

							<p class="mb-2">

								<i class="
																																																							fe
																																																							fe-phone
																																																							mr-2
																																																							text-primary
																																																						"></i>

								{{ client.telephone }}

							</p>

						{% endif %}


						{% if client.email|default('') %}

							<p class="mb-2">

								<i class="
																																																							fe
																																																							fe-mail
																																																							mr-2
																																																							text-primary
																																																						"></i>

								{{ client.email }}

							</p>

						{% endif %}


						{% if client.adresse|default('') %}

							<p class="mb-0">

								<i class="
																																																							fe
																																																							fe-map-pin
																																																							mr-2
																																																							text-primary
																																																						"></i>

								{{ client.adresse }}

							</p>

						{% endif %}

					</div>

				</div>


				{# ====================================================
																								   RÉCAPITULATIF
																								   ==================================================== #}

				<div class="card">

					<div class="card-header">

						<h3 class="card-title">
							Récapitulatif
						</h3>

					</div>


					<div class="card-body">

						<div class="
																																																d-flex
																																																justify-content-between
																																																mb-3
																																															">

							<span>
								Total HT
							</span>

							<strong>

								{{
									commande.totalHt
										|default(0)
										|number_format(
											0,
											',',
											' '
										)
								}}

								FCFA

							</strong>

						</div>


						<div class="
																																																d-flex
																																																justify-content-between
																																																mb-3
																																															">

							<span>
								Remise
							</span>

							<strong>

								{{
									commande.remise
										|default(0)
										|number_format(
											0,
											',',
											' '
										)
								}}

								FCFA

							</strong>

						</div>


						<div class="
																																																d-flex
																																																justify-content-between
																																																mb-3
																																															">

							<span>
								TVA
							</span>

							<strong>
								{{ commande.tva|default(0) }}
								%
							</strong>

						</div>


						<hr>


						<div class="
																																																d-flex
																																																justify-content-between
																																																mb-3
																																															">

							<span class="h5 mb-0">
								Total TTC
							</span>

							<strong class="
																																																						h5
																																																						mb-0
																																																						text-primary
																																																					">

								{{
									totalTtc
										|number_format(
											0,
											',',
											' '
										)
								}}

								FCFA

							</strong>

						</div>


						<div class="
																																																d-flex
																																																justify-content-between
																																																mb-3
																																															">

							<span>
								Montant payé
							</span>

							<strong class="text-success">

								{{
									totalPaye
										|number_format(
											0,
											',',
											' '
										)
								}}

								FCFA

							</strong>

						</div>


						<div class="
																																																d-flex
																																																justify-content-between
																																															">

							<span>
								Reste à payer
							</span>

							<strong class="{{ resteAPayer > 0 ? 'text-danger' : 'text-success' }}">

								{{
									resteAPayer
										|number_format(
											0,
											',',
											' '
										)
								}}

								FCFA

							</strong>

						</div>


						{# ================================================
																																				   ACTION PAIEMENT DANS LE RÉCAPITULATIF
																																				   ================================================ #}

						{% if peutEncaisser and commande.statutTravaux != 'annulee' %}

							<hr>


							{% if resteAPayer > 0 %}

								<a href="{{ path( 'app_commandes_paiement', { id: commande.id } ) }}" class="btn btn-info btn-block">
									<i class="fa fa-money mr-1"></i>

									Encaisser un paiement
								</a>

							{% else %}

								<div class="
																																																												alert
																																																												alert-success
																																																												text-center
																																																												mb-0
																																																											">

									<i class="fa fa-check-circle mr-1"></i>

									<strong>
										Commande entièrement payée
									</strong>

								</div>

							{% endif %}

						{% endif %}

					</div>

				</div>


				{# ====================================================
																								   OBSERVATION COMMANDE
																								   ==================================================== #}

				{% if commande.observation|default('') %}

					<div class="card">

						<div class="card-header">

							<h3 class="card-title">
								Observation
							</h3>

						</div>


						<div class="card-body">

							{{ commande.observation|nl2br }}

						</div>

					</div>

				{% endif %}

			</div>

		</div>

	</div>

{% endblock %}


{% block stylesheets %}

	{{ parent() }}

	<style>

		@media print {

			.app-sidebar,
			.header,
			.page-header .btn,
			.breadcrumb,
			.footer {

				display: none !important;

			}


			.side-app,
			.app-content,
			.main-content {

				margin: 0 !important;
				padding: 0 !important;

			}


			.card {

				border: 1px solid #ddd !important;
				box-shadow: none !important;
				break-inside: avoid;

			}

		}
	</style>

{% endblock %}


{% block javascripts %}

	{{ parent() }}

	<script>
		document.addEventListener('DOMContentLoaded', function () {

const formulaires = document.querySelectorAll('.js-confirm-form');

formulaires.forEach(function (formulaire) {

formulaire.addEventListener('submit', function (event) {

const message = formulaire.dataset.message || 'Voulez-vous continuer ?';

if (!window.confirm(message)) {
event.preventDefault();
}

});

});

});
	</script>

{% endblock %}
