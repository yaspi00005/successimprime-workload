{% extends 'base.html.twig' %}

{#
	Fidélité, écran de la direction (docs/fidelite.md) : la fidélité par
	article, les clients dormeurs et leur promo de réveil, le journal.
#}

{% import 'fidelite/_macros.html.twig' as f %}

{% block title %}Fidélité{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile"><a href="{{ path('app_reglages_parametres_index', {tuile: 'fidelite'}) }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-sliders-h me-1"></i>Valeurs générales</a></li>
	{% if not en_ligne %}
		<li class="nav-item"><a href="{{ path('app_fidelite_regle_nouvelle') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Règle d'article</a></li>
	{% endif %}
{% endblock %}

{% block body %}
	{% if onglet == 'articles' %}
	<section class="card si-fi-programme">
		<div>
			<span class="si-fi-sur">Programme {{ reglages.actif ? 'en cours' : 'arrêté' }}</span>
			<strong>Particuliers seulement · 1 point = {{ reglages.valeurPoint }} F</strong>
		</div>
		<ul>
			<li><b>Grand format</b>{{ f.nombre(reglages.pointsParM2) }} points par m², au-delà de {{ f.nombre(reglages.seuilM2) }} m² payés</li>
			<li><b>Autres articles</b>{{ f.nombre(reglages.tauxAutre) }} % du montant, au-delà de {{ reglages.seuilMontant|number_format(0, ',', ' ') }} F payés</li>
			<li><b>Délai de paiement</b>×{{ reglages.multiplicateurJour }} payé le jour même · ×{{ reglages.multiplicateurDelai }} sous {{ reglages.delaiHeures }} h · rien après</li>
			<li><b>Validité</b>{{ reglages.validiteMois }} mois, les plus anciens utilisés d'abord</li>
		</ul>
	</section>
	{% endif %}

	{% if en_ligne %}
		<p class="si-pg-note"><i class="fas fa-info-circle me-1"></i>Site en ligne : la fidélité se gère sur l'ERP de l'imprimerie, ces écrans sont en lecture.</p>
	{% endif %}

	<div class="card si-bloc">
		<nav class="si-onglets si-onglets-carte" aria-label="Écrans de la fidélité">
			{% for cle, libelle in onglets %}
				<a href="{{ path('app_fidelite_index', {onglet: cle}) }}" class="{{ onglet == cle ? 'actif' }}">{{ libelle }}</a>
			{% endfor %}
		</nav>

		{% if onglet == 'articles' %}
			<p class="si-pg-note">Une règle remplace les valeurs générales pour un article, entre ses dates : points par unité (m², pièce ou lot) ou % du montant, valeur du point en francs, plage à atteindre. Désactivée, l'article ne rapporte rien. Les valeurs propres à un client passent avant.</p>
			{% if regles is empty %}
				<p class="si-ac-vide">Aucune règle : tous les articles suivent les valeurs générales.</p>
			{% else %}
				<div class="table-responsive">
					<table class="table si-table si-fi-table mb-0">
						<thead><tr><th>Article</th><th>Bonification</th><th>Gain</th><th class="text-end">1 point</th><th>Plage</th><th>Période</th><th class="si-masque-mobile">Modifiée</th><th></th></tr></thead>
						<tbody>
							{% for r in regles %}
								{% set m2 = r.produit.modeCalcul == 'metre_carre' %}
								{% set etat = r.debut|date('Ymd') > maintenant|date('Ymd') ? 'a_venir' : (r.fin and r.fin|date('Ymd') < maintenant|date('Ymd') ? 'terminee' : 'en_cours') %}
								<tr class="{{ etat != 'en_cours' ? 'si-fi-passee' }}">
									<td><b>{{ r.produit.nom }}</b>{% if r.note %}<small class="d-block text-muted">{{ r.note }}</small>{% endif %}</td>
									<td>{% if r.actif %}<span class="si-pastille si-pastille-vert">Active</span>{% else %}<span class="si-pastille si-pastille-rouge">Désactivée</span>{% endif %}</td>
									<td class="text-nowrap">{{ r.actif ? f.gain(r, m2) : 'aucun point' }}</td>
									<td class="text-end text-nowrap">{{ r.actif ? r.valeurPoint ~ ' F' : '—' }}</td>
									<td>{{ r.actif ? f.plage(r, m2) : '—' }}</td>
									<td class="text-nowrap">
										{{ r.debut|date('d/m/Y') }} → {{ r.fin ? r.fin|date('d/m/Y') : 'sans fin' }}
										<small class="d-block {{ etat == 'en_cours' ? 'text-success' : 'text-muted' }}">{{ {en_cours: 'En cours', a_venir: 'À venir', terminee: 'Terminée'}[etat] }}</small>
									</td>
									<td class="si-masque-mobile text-nowrap"><small class="text-muted d-block">{{ r.modifieLe|date('d/m/Y H:i') }}</small><small class="text-muted d-block">{{ r.modifiePar ? r.modifiePar.userIdentifier }}</small></td>
									<td class="text-end">{% if not en_ligne %}<a href="{{ path('app_fidelite_regle_modifier', {id: r.id}) }}" class="btn btn-sm btn-primary-light" title="Modifier"><i class="fa fa-edit"></i></a>{% endif %}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}

		{% elseif onglet == 'dormeurs' %}
			<form method="get" class="si-fi-filtre">
				<input type="hidden" name="onglet" value="dormeurs">
				<label for="jours">Clients sans commande depuis</label>
				<input type="number" id="jours" name="jours" min="1" max="1000" value="{{ jours }}" class="form-control form-control-sm">
				<span>jours</span>
				<button class="btn btn-sm btn-light">Afficher</button>
			</form>
			<p class="si-pg-note">Offrez une promo de réveil : une remise sur la prochaine commande, que le client voit dans son espace (rubrique Fidélité) et que l'atelier applique sur la commande. Le message WhatsApp ne cite ni montant ni taux ; rien pour les fiches de démonstration.</p>
			{% if dormeurs is empty %}
				<p class="si-ac-vide">Aucun client sans commande depuis {{ jours }} jours.</p>
			{% else %}
				<div class="table-responsive">
					<table class="table si-table si-fi-table mb-0">
						<thead><tr><th>Client</th><th>Dernière commande</th><th class="text-end si-masque-mobile">Commandes</th><th>Promo de réveil</th><th></th></tr></thead>
						<tbody>
							{% for d in dormeurs %}
								<tr>
									<td><a href="{{ path('app_clients_show', {publicId: d.client.publicId}) }}#fidelite"><b>{{ d.client.nomComplet }}</b></a><small class="d-block text-muted">{{ d.client.code }}{{ d.client.telephone ? ' · ' ~ d.client.telephone }}</small></td>
									<td class="text-nowrap">{{ d.derniere|date('d/m/Y') }}<small class="d-block text-muted">il y a {{ d.jours }} jours</small></td>
									<td class="text-end si-masque-mobile">{{ d.commandes }}</td>
									<td>
										{% if d.promo %}
											<span class="si-pastille si-pastille-vert">−{{ f.nombre(d.promo.taux) }} % {{ d.promo.estDuJourSeulement ? "aujourd'hui" : "jusqu'au " ~ d.promo.fin|date('d/m') }}</span>
										{% elseif not en_ligne %}
											<form method="post" action="{{ path('app_fidelite_reveil_offrir', {publicId: d.client.publicId}) }}" class="si-fi-offrir">
												<input type="hidden" name="_token" value="{{ csrf_token('fidelite-reveil') }}">
												<input type="hidden" name="retour" value="{{ app.request.requestUri }}">
												<label class="visually-hidden" for="taux-{{ loop.index }}">Remise en %</label>
												<span class="si-fi-champ">−<input type="number" id="taux-{{ loop.index }}" name="taux" min="1" max="50" step="0.5" value="{{ reveil.taux }}" class="form-control form-control-sm"> %</span>
												<select name="duree" class="form-select form-select-sm" aria-label="Durée">
													<option value="0">aujourd'hui seulement</option>
													{% for n in [3, 7, 15, 30]|merge([reveil.duree])|filter(n => n > 0)|sort|reduce((u, n) => n in u ? u : u|merge([n]), []) %}
														<option value="{{ n }}"{{ n == reveil.duree ? ' selected' }}>{{ n }} jours</option>
													{% endfor %}
												</select>
												<button class="btn btn-sm btn-danger">Offrir</button>
											</form>
										{% else %}—{% endif %}
									</td>
									<td class="text-end text-nowrap">
										{% if d.promo and not en_ligne %}
											<form method="post" action="{{ path('app_fidelite_reveil_annuler', {id: d.promo.id}) }}" class="d-inline" data-confirmer="Retirer la promo de réveil de {{ d.client.nomComplet }} ?" data-confirmer-detail="Le client ne pourra plus l'utiliser." data-confirmer-bouton="Retirer" data-confirmer-danger>
												<input type="hidden" name="_token" value="{{ csrf_token('fidelite-reveil') }}">
												<input type="hidden" name="retour" value="{{ app.request.requestUri }}">
												<button class="btn btn-sm btn-light" title="Retirer la promo">Retirer</button>
											</form>
										{% endif %}
										{% if d.whatsapp %}<a href="{{ d.whatsapp }}" target="_blank" rel="noopener" class="btn btn-sm btn-success" title="Écrire sur WhatsApp"><i class="fab fa-whatsapp"></i></a>{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
				{% if dormeurs|length >= 100 %}<p class="si-pg-note">Les 100 plus récemment endormis.</p>{% endif %}
			{% endif %}

		{% else %}
			{% if journal is empty %}
				<p class="si-ac-vide">Rien encore.</p>
			{% else %}
				<ul class="si-fi-journal">
					{% for j in journal %}
						<li>
							<span class="si-fi-quand">{{ j.le|date('d/m/Y') }}<small>{{ j.le|date('H:i') }}</small></span>
							<div>
								<b>{{ j.action }}</b>{% if j.sujet %} · {% if j.lien %}<a href="{{ j.lien }}">{{ j.sujet }}</a>{% else %}{{ j.sujet }}{% endif %}{% endif %}
								{% if j.details %}<small class="d-block text-muted">{{ j.details|join(' · ') }}</small>{% endif %}
							</div>
							<span class="si-fi-qui">{{ j.qui ? j.qui.userIdentifier : 'système' }}</span>
						</li>
					{% endfor %}
				</ul>
			{% endif %}
		{% endif %}
	</div>
{% endblock %}
