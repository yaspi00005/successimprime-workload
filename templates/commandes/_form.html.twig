function appliquerFiltreFinitions(detail) {
if (detail.dataset.finitionsAutorisees === undefined) {
return;
}

const ids = detail.dataset.finitionsAutorisees === '' ? [] : detail.dataset.finitionsAutorisees.split(',');

detail.querySelectorAll('.js-finition-manuelle select.js-select-search').forEach(function (select) {
