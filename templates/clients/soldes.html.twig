{% extends 'base.html.twig' %}

{% block title %}
	Soldes clients
{% endblock %}

{% block body %}

	<div class="side-app">

		<div class="page-header">

			<div>

				<h1 class="page-title">
					Soldes clients
				</h1>

				<ol class="breadcrumb">

					<li class="breadcrumb-item">
						<a href="{{ path('app_clients_index') }}">
							Clients
						</a>
					</li>

					<li class="breadcrumb-item active">
						Soldes
					</li>

				</ol>

			</div>

		</div>


		{% include "alert.html.twig" %}


		<div class="card">

			<div class="card-header d-flex justify-content-between align-items-center">

				<h3 class="card-title mb-0">
					Clients chez qui de l'argent est resté (monnaie non rendue)
				</h3>

				<div class="text-muted small">
					{{ clients|length }} client{{ clients|length > 1 ? 's' : '' }} — total :
					<strong>{{ total|number_format(0, ',', ' ') }} FCFA</strong>
				</div>

			</div>

			<div class="table-responsive">

				<table class="table table-bordered table-hover mb-0">

					<thead>

						<tr>
							<th>Code</th>
							<th>Client</th>
							<th>Téléphone</th>
							<th class="text-right">Solde</th>
							<th class="text-center">Actions</th>
						</tr>

					</thead>

					<tbody>

						{% for client in clients %}

							<tr>

								<td class="align-middle">
									{{ client.code }}
								</td>

								<td class="align-middle">
									<a href="{{ path('app_clients_show', { publicId: client.publicId }) }}">
										{{ client.nomComplet }}
									</a>
								</td>

								<td class="align-middle">
									{{ client.telephone|default('—') }}
								</td>

								<td class="align-middle text-right">
									<strong class="text-money-positive">
										{{ client.soldeCredit|number_format(0, ',', ' ') }} FCFA
									</strong>
								</td>

								<td class="align-middle text-center">
									<a href="{{ path('app_clients_show', { publicId: client.publicId }) }}" class="btn btn-sm btn-primary-light" title="Voir la fiche">
										<i class="fa fa-eye"></i>
									</a>
								</td>

							</tr>

						{% else %}

							<tr>
								<td colspan="5" class="text-center text-muted py-5">
									Aucun client n'a de solde en ce moment.
								</td>
							</tr>

						{% endfor %}

					</tbody>

				</table>

			</div>

		</div>

	</div>

{% endblock %}
