async function embedFor(doc,F,G,cache){
  const src=sourceFor(F,G);const key=F.id+':'+(src.ext||0);if(cache[key])return cache[key];let e;
  if(F.kind==='pdf'&&!src.ext){const sd=await PDFLib.PDFDocument.load(F.bytes,{ignoreEncryption:true});const p=await doc.embedPage(sd.getPage(0),F.box);e={o:p,pdf:true,nw:G.nw,nh:G.nh}}
  else{let bytes;if(src.canvas){bytes=await (await fetch(src.url)).arrayBuffer();e={o:await doc.embedPng(bytes)}}
    else if(F.mime==='image/jpeg'&&F.bytes){e={o:await doc.embedJpg(F.bytes)}}else if(F.bytes&&F.mime==='image/png'){e={o:await doc.embedPng(F.bytes)}}
    else{bytes=await (await fetch(F.url)).arrayBuffer();e={o:await doc.embedPng(bytes)}}
    e.nw=src.nw;e.nh=src.nh}
  cache[key]=e;return e}
function cmRot(deg){const r=deg*Math.PI/180;return [Math.cos(r),Math.sin(r),-Math.sin(r),Math.cos(r),0,0]}
