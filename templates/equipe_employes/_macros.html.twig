{% macro initiales(nom) %}{{ nom|split(' ')|filter(m => m matches '/^\\p{L}/u')|slice(0, 2)|map(m => m|first|upper)|join('') ?: '?' }}{% endmacro %}
{% macro couleur(id) %}{{ ['#DC2626', '#E8590C', '#DB2777', '#1F2937', '#2563EB', '#0E7C66', '#7C2D12', '#6B7280', '#0F4590'][id % 9] }}{% endmacro %}
{% macro statut(s) %}{% set c = {actif: 'si-em-vert', invite: 'si-em-orange', expire: 'si-em-rouge', suspendu: 'si-em-rouge', sans: '', retire: 'si-em-rouge'} %}<span class="si-em-badge {{ c[s] ?? '' }}">{{ {actif: 'Accès app', invite: 'Invitation envoyée', expire: 'Invitation expirée', suspendu: 'Suspendu', sans: 'Sans accès', retire: 'Accès retiré'}[s] ?? s }}</span>{% endmacro %}
{% macro quand(d, maintenant) %}{% if d is null %}—{% elseif d|date('Y-m-d') == maintenant|date('Y-m-d') %}aujourd'hui {{ d|date('H:i') }}{% elseif d|date('Y-m-d') == maintenant|date_modify('-1 day')|date('Y-m-d') %}hier {{ d|date('H:i') }}{% else %}{{ d|date('d/m/Y') }}{% endif %}{% endmacro %}
{% macro avatar(e, classe, gris) %}{% import _self as mm %}{% if e.photos %}<img src="{{ asset('uploads/employes/' ~ e.photos) }}" alt="" class="si-em-avatar {{ classe }}">{% else %}<span class="si-em-avatar {{ classe }}" style="background: {{ gris|default(false) ? '#9CA3AF' : mm.couleur(e.id) }}">{{ mm.initiales(e.nomComplet) }}</span>{% endif %}{% endmacro %}
