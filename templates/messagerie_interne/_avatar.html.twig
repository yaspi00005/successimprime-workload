{# Avatar d'une personne : initiales sur une couleur tirée de son numéro. Variables : u, classe. #}
{% set teintes = ['#0F4590', '#0E7C66', '#DB2777', '#C46A00', '#7C3AED', '#1F2937', '#2563EB', '#B91C1C'] %}
<span class="mi-av {{ classe ?? '' }}" style="background: {{ teintes[(u ? u.id : 0) % 8] }}" aria-hidden="true">{{ u|initiales_equipe }}</span>
