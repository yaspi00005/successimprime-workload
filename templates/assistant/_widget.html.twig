{#
	Bouton de l'assistant (docs/assistant-client.md), inclus par le site
	(contexte « site ») et par l'espace client connecté (« espace »). Léger
	en 3G : seul ce bouton est dans la page ; le panneau (assistant.css et
	assistant.js) ne se charge qu'au premier clic. Rien sans clé de l'API ou
	quand la tuile Réglages › Assistant du site est éteinte.
#}
{% set assistant = assistant_widget(contexte) %}
{% if assistant %}
	<style>
		.as-bouton { position: fixed; z-index: 55; right: 18px; bottom: 88px; display: flex; align-items: center; gap: 8px; height: 52px; min-width: 52px; padding: 0 16px 0 14px; border: 0; border-radius: 26px; background: #0F4590; color: #fff; font: 600 15px/1 "Segoe UI", system-ui, -apple-system, Roboto, Arial, sans-serif; box-shadow: 0 8px 24px rgba(15, 35, 75, .28); cursor: pointer; }
		.as-bouton svg { width: 24px; height: 24px; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
		.as-bouton:focus-visible { outline: 3px solid #FDC82A; outline-offset: 3px; }
		.as-bouton.as-charge { opacity: .75; cursor: progress; }
		.as-bouton.as-espace { right: 14px; bottom: calc(76px + env(safe-area-inset-bottom)); }
		body:has(.ec-total, .ec-pc-barre) .as-bouton.as-espace { bottom: calc(150px + env(safe-area-inset-bottom)); }
		@media (max-width: 899px) { body:has(.si-calc-vivant) .as-bouton.as-site { bottom: 156px; } }
		@media (max-width: 599px) { .as-bouton { width: 52px; padding: 0; justify-content: center; } .as-bouton.as-site { right: 21px; } .as-bouton-texte { display: none; } }
		@media (min-width: 900px) {
			.as-bouton.as-espace { right: 24px; bottom: 24px; }
			body:has(.ec-total, .ec-pc-barre) .as-bouton.as-espace { bottom: 96px; }
		}
	</style>
	<button type="button" id="as-bouton" class="as-bouton as-{{ assistant.contexte }}" aria-haspopup="dialog" aria-expanded="false" aria-controls="as-panneau" aria-label="Une question ? Ouvrir l'assistant"
		data-contexte="{{ assistant.contexte }}"
		data-url-message="{{ assistant.urls.message }}"
		data-url-note="{{ assistant.urls.note }}"
		data-url-historique="{{ assistant.urls.historique }}"
		data-accueil="{{ assistant.accueil }}"
		data-suggestions="{{ assistant.suggestions|json_encode }}"
		data-css="{{ asset('css/assistant.css') }}"
		data-js="{{ asset('js/assistant.js') }}"
		{%- if assistant.contexte == 'espace' %} data-csrf="{{ csrf_token('espace') }}"{% endif %}>
		<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20.5l1.4-4.6A8 8 0 1 1 21 12z"/><path d="M8.5 11h.01M12 11h.01M15.5 11h.01"/></svg>
		<span class="as-bouton-texte">Une question ?</span>
	</button>
	<script>
		(function () {
			var b = document.getElementById('as-bouton');
			if (!b) { return; }
			b.addEventListener('click', function () {
				if (window.SIAssistant) { window.SIAssistant.basculer(); return; }
				if (b.getAttribute('data-charge')) { return; }
				b.setAttribute('data-charge', '1');
				b.classList.add('as-charge');
				var l = document.createElement('link');
				l.rel = 'stylesheet';
				l.href = b.getAttribute('data-css');
				document.head.appendChild(l);
				var s = document.createElement('script');
				s.src = b.getAttribute('data-js');
				s.onload = function () { b.classList.remove('as-charge'); window.SIAssistant.ouvrir(); };
				s.onerror = function () { b.classList.remove('as-charge'); b.removeAttribute('data-charge'); };
				document.body.appendChild(s);
			});
		})();
	</script>
{% endif %}
