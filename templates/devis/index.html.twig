{% extends 'base.html.twig' %}

{#
	Liste des devis (maquette GC03, docs/devis.md) : les devis du mois par
	statut, le taux d'acceptation, ce qui attend une réponse, ce qui est à
	relancer aujourd'hui, puis le tableau filtré par statut.
#}

{% block title %}Devis{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/devis.css') }}" rel="stylesheet">
{% endblock %}

{% block header_actions %}
	{% if is_granted('ROLE_COMMANDE') %}
		<li class="nav-item si-masque-mobile"><a href="{{ path('app_commandes_index') }}" class="btn btn-light btn-sm si-btn-entete">Commandes</a></li>
	{% endif %}
	<li class="nav-item"><a href="{{ path('app_devis_new') }}" class="btn btn-danger btn-sm"><i class="fas fa-plus me-1"></i>Nouveau devis</a></li>
{% endblock %}

{% macro nom_client(c) %}{{ c ? (c.raisonSociale ?: c.nomComplet) : 'Client inconnu' }}{% endmacro %}
{% macro initiales(nom) %}{% set mots = nom|trim|split(' ')|filter(m => m is not empty) %}{{ (mots|first|default('?')|first ~ (mots|length > 1 ? mots[1]|first : ''))|upper }}{% endmacro %}

{% block body %}
	{% set nomMois = mois|date_fr('MMMM') %}
	{% set statutsBarre = [
		{cle: 'brouillon', libelle: 'Brouillon'},
		{cle: 'envoye', libelle: 'Envoyé'},
		{cle: 'vu', libelle: 'Vu'},
		{cle: 'accepte', libelle: 'Accepté'},
		{cle: 'refuse', libelle: 'Refusé'},
		{cle: 'expire', libelle: 'Expiré'},
	] %}
	{% set parametres = {mois: mois|date('Y-m')} %}

	<div class="si-dv">
		<div class="si-dv-kpis">
			<article class="card si-dv-kpi si-dv-kpi-barre">
				<div class="si-dv-kpi-tete">
					<h2>Devis {{ nomMois matches '/^[aeiouéèêh]/i' ? 'd\'' : 'de ' }}{{ nomMois }} par statut · {{ total }}</h2>
					<nav class="si-dv-mois" aria-label="Changer de mois">
						<a href="{{ path('app_devis_index', {mois: moisPrecedent|date('Y-m'), filtre: filtre ?: null}) }}" aria-label="Mois précédent"><i class="fas fa-chevron-left"></i></a>
						{% if moisSuivant %}<a href="{{ path('app_devis_index', {mois: moisSuivant|date('Y-m'), filtre: filtre ?: null}) }}" aria-label="Mois suivant"><i class="fas fa-chevron-right"></i></a>{% endif %}
					</nav>
				</div>
				<div class="si-dv-barre" role="img" aria-label="Répartition des devis du mois par statut">
					{% for s in statutsBarre %}
						{% if compteurs[s.cle] > 0 %}<span class="si-dv-s-{{ s.cle }}" style="flex-grow: {{ compteurs[s.cle] }}" title="{{ s.libelle }} · {{ compteurs[s.cle] }}"></span>{% endif %}
					{% endfor %}
					{% if total == 0 %}<span class="si-dv-s-vide" style="flex-grow: 1"></span>{% endif %}
				</div>
				<ul class="si-dv-legende">
					{% for s in statutsBarre %}
						<li><i class="si-dv-s-{{ s.cle }}"></i>{{ s.libelle }} {{ compteurs[s.cle] }}</li>
					{% endfor %}
				</ul>
			</article>
			<article class="card si-dv-kpi">
				<h2>Taux d'acceptation</h2>
				<strong class="{{ taux is not null and taux >= 50 ? 'si-p-ok' }}">{{ taux is null ? '—' : taux ~ ' %' }}</strong>
				<span>{{ acceptes }} accepté{{ acceptes > 1 ? 's' }} sur {{ envoyes }} envoyé{{ envoyes > 1 ? 's' }}</span>
			</article>
			<article class="card si-dv-kpi">
				<h2>En attente de réponse</h2>
				<strong>{{ attente.montant|number_format(0, ',', ' ') }} F</strong>
				<span>{{ attente.nombre }} devis envoyé{{ attente.nombre > 1 ? 's' }} ou vu{{ attente.nombre > 1 ? 's' }}</span>
			</article>
			<article class="card si-dv-kpi">
				<h2>À relancer aujourd'hui</h2>
				<strong class="{{ aRelancer is not empty ? 'si-dv-orange' }}">{{ aRelancer|length }}</strong>
				<span>{{ whatsAppAuto ? 'relance WhatsApp automatique' : 'relance WhatsApp en un clic' }}</span>
			</article>
		</div>

		<div class="si-dv-outils">
			<nav class="si-dv-puces" aria-label="Filtrer par statut">
				<a href="{{ path('app_devis_index', parametres|merge({q: q ?: null})) }}" class="{{ filtre == '' ? 'est-active' }}">Tous · {{ total }}</a>
				{% for cle, f in filtres %}
					<a href="{{ path('app_devis_index', parametres|merge({filtre: cle, q: q ?: null})) }}" class="{{ filtre == cle ? 'est-active' }}">{{ f.libelle }} · {{ compteurs[cle] }}</a>
				{% endfor %}
			</nav>
			<form method="get" action="{{ path('app_devis_index') }}" class="si-dv-recherche" role="search">
				<input type="hidden" name="mois" value="{{ mois|date('Y-m') }}">
				{% if filtre %}<input type="hidden" name="filtre" value="{{ filtre }}">{% endif %}
				<i class="fas fa-search" aria-hidden="true"></i>
				<input type="search" name="q" value="{{ q }}" maxlength="60" placeholder="N°, client, téléphone, objet" aria-label="Rechercher un devis">
			</form>
		</div>

		{% if recherche %}
			<p class="si-dv-note">Recherche « {{ q }} » sur tous les mois{{ filtre ? ', ' ~ filtres[filtre].libelle|lower }}. <a href="{{ path('app_devis_index', parametres|merge({filtre: filtre ?: null})) }}">Effacer</a></p>
		{% endif %}

		<section class="card si-dv-liste">
			{% if devis is empty %}
				<p class="si-dv-vide">{{ recherche ? 'Aucun devis ne correspond.' : 'Aucun devis ce mois-ci' ~ (filtre ? ' avec ce statut' : '') ~ '.' }} <a href="{{ path('app_devis_new') }}">Faire un devis</a></p>
			{% else %}
				<table class="table si-dv-table">
					<thead>
						<tr><th>N°</th><th>Client</th><th>Objet</th><th class="text-end">Montant</th><th>Statut</th><th>Suivi</th><th>Par</th><th></th></tr>
					</thead>
					<tbody>
						{% for d in devis %}
							{% set nom = _self.nom_client(d.clients)|trim %}
							{% set suivi = suivis[d.id] %}
							{% set cleStatut = d.statut == 'converti' ? 'accepte' : d.statut %}
							{% set agent = d.agents ? (d.agents.employe and d.agents.employe.prenom ? d.agents.employe.prenom : d.agents.username) : null %}
							<tr>
								<td class="si-dv-numero" data-label="N°"><a href="{{ path('app_devis_show', {id: d.id}) }}">{{ d.numero ?: '#' ~ d.id }}</a></td>
								<td class="si-dv-client" data-label="Client"><span class="si-dv-avatar si-dv-a{{ (d.clients ? d.clients.id : 0) % 6 }}">{{ _self.initiales(nom) }}</span>{{ nom }}</td>
								<td class="si-dv-objet" data-label="Objet">{{ objets[d.id] ?: '—' }}{% if d.horsImprimerie %} <span class="si-badge-hors">Hors imprimerie</span>{% endif %}</td>
								<td class="text-end si-dv-montant" data-label="Montant">{{ d.totalTtc|number_format(0, ',', ' ') }} F</td>
								<td data-label="Statut"><span class="si-dv-statut si-dv-st-{{ cleStatut }}">{{ d.statutLibelle }}</span></td>
								<td class="si-dv-suivi si-dv-ton-{{ suivi.ton }}" data-label="Suivi">{{ suivi.texte }}</td>
								<td class="si-dv-par" data-label="Par">{{ agent ?? '—' }}</td>
								<td class="si-dv-action">
									{% if d.statut == 'brouillon' %}
										<a href="{{ path('app_devis_edit', {id: d.id}) }}">Terminer</a>
									{% elseif d.id in idsARelancer %}
										<form method="post" action="{{ path('app_devis_relancer', {id: d.id}) }}" target="_blank" class="js-dv-relance">
											<input type="hidden" name="_token" value="{{ csrf_token('devis-' ~ d.id) }}">
											<button type="submit">Relancer</button>
										</form>
									{% elseif d.statut == 'expire' %}
										<a href="{{ path('app_devis_show', {id: d.id}) }}#nouvelle-version">Relancer</a>
									{% elseif d.commande %}
										<a href="{{ path('app_commandes_show', {id: d.commande.id}) }}">Voir {{ d.commande.numero|split('-')|first }}</a>
									{% else %}
										<a href="{{ path('app_devis_show', {id: d.id}) }}">Ouvrir</a>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				{% if tronque %}<p class="si-dv-note px-3">Les 150 premiers résultats sont affichés : précisez la recherche.</p>{% endif %}
			{% endif %}
		</section>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		// Relance ouverte dans WhatsApp (nouvel onglet) : la liste se met à jour au retour.
		document.querySelectorAll('.js-dv-relance').forEach(function (f) {
			f.addEventListener('submit', function () { window.setTimeout(function () { window.location.reload(); }, 1500); });
		});
	</script>
{% endblock %}
