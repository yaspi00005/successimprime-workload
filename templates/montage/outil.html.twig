<style>
.si-retour{margin-left:auto;display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.si-retour a.btn{text-decoration:none}
.si-ligne{font-weight:700;color:var(--blue)}
#siMsg{flex-basis:100%;margin:0}
</style>
<script>
(() => {
  const C = window.SI_MONTAGE || {}, M = window.SIMontage, $ = id => document.getElementById(id), msg = $('siMsg');
  const regler = (id, v) => { if (v === null || v === undefined || !$(id)) return; if ($(id).type === 'checkbox') { $(id).checked = !!v; $(id).dispatchEvent(new Event('change')); } else { $(id).value = v; $(id).dispatchEvent(new Event('input')); } };
  regler('margin', C.marge); regler('bleed', C.fondPerdu); regler('marks', C.traitsCoupe); regler('qty', C.quantite);
  const formatLigne = () => { if (!C.largeurMm || !C.hauteurMm) return; const f = $('fmt'); f.value = 'custom'; f.dispatchEvent(new Event('change')); regler('tw', C.largeurMm); regler('th', C.hauteurMm); };
  if (C.fichierUrl) {
    msg.textContent = 'Chargement de « ' + (C.fichierNom || 'fichier') + ' »…';
    fetch(C.fichierUrl, {credentials: 'same-origin'}).then(r => { if (!r.ok) throw new Error('fichier introuvable'); return r.blob(); })
      .then(b => M.loadFile('recto', new File([b], C.fichierNom || 'fichier', {type: b.type})))
      .then(() => { if (!/\.pdf$/i.test(C.fichierNom || '')) formatLigne(); msg.textContent = 'Fichier de la commande chargé : ' + (C.fichierNom || '') + '.'; })
      .catch(e => { msg.textContent = 'Le fichier de la commande n\'a pas pu être chargé (' + e.message + '). Choisissez-le à la main.'; formatLigne(); });
  } else if (C.ligne) { formatLigne(); msg.textContent = 'Aucun fichier sur cette ligne : choisissez-le à la main.'; }

  // Feuilles acceptées (tuile Montage, puis fiche de la machine) et marge de la machine.
  const formats = list => { const ok = (list && list.length ? list : C.formats) || []; let actif = null;
    [...$('sheetSeg').children].forEach(b => { const k = b.textContent.trim(); const garde = k === 'Perso' || ok.includes(k); b.hidden = !garde; if (garde && !actif && k !== 'Perso') actif = b; });
    if (M.S.sheet !== 'custom' && !ok.includes(M.S.sheet) && actif) actif.click(); };
  const machines = C.machines || [], choix = $('siMachine');
  if (machines.length) {
    $('siMachineF').hidden = false;
    choix.innerHTML = '<option value="">Toutes machines</option>' + machines.map(m => '<option value="' + m.id + '">' + m.nom.replace(/[<>&"]/g, '') + '</option>').join('');
    choix.addEventListener('change', () => { const m = machines.find(x => String(x.id) === choix.value); regler('margin', m && m.marge !== null ? m.marge : C.marge); formats(m ? m.formats : null); });
  }
  formats(null);
  if (machines.length === 1) { choix.value = String(machines[0].id); choix.dispatchEvent(new Event('change')); }

  let dernier = null;
  document.addEventListener('si-montage-pdf', e => { dernier = e.detail; const b = $('siRanger'); if (b) { b.disabled = false; b.title = ''; } });
  const ranger = $('siRanger');
  if (ranger) ranger.addEventListener('click', async () => {
    if (!dernier) return;
    ranger.disabled = true; msg.textContent = 'Envoi du montage…';
    const d = new FormData();
    d.append('_token', C.jeton); d.append('nom', dernier.name);
    ['poses', 'feuille', 'quantite', 'gache', 'feuilles'].forEach(k => d.append(k, dernier[k] ?? ''));
    d.append('verso', dernier.verso ? '1' : '0'); if (choix && choix.value) d.append('machine', choix.value);
