<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8">
	<title>{{ facture.numero|default('Facture') }}</title>
	{#
		Modèle unique de facture (maquettes I01 et I02) : l'en-tête, les
		couleurs, les mentions et les QR viennent de l'entreprise émettrice
		(Réglages › Entreprises). Mise en page en tableaux pour Dompdf.
	#}
	{% set c = entreprise.couleurs %}
	<style>
		@page { margin: 0; }
		* { box-sizing: border-box; }
		body { margin: 0; font-family: DejaVu Sans, sans-serif; font-size: 8.6px; line-height: 1.4; color: #1f2937; }
		.page { padding: 0 15mm 24mm; }
		table { width: 100%; border-collapse: collapse; }
		td { vertical-align: top; }
		.bandes td { height: 5px; padding: 0; }
		.muted { color: #6b7280; }
		.fort { font-weight: bold; }
		.droite { text-align: right; }
		.centre { text-align: center; }

		.entete { margin-top: 9mm; }
		.logo { max-height: 48px; max-width: 190px; }
		.nom { font-size: 11px; font-weight: bold; margin-top: 6px; color: #111827; }
		.coord { font-size: 7.6px; color: #4b5563; margin-top: 2px; }
		.titre { font-size: 24px; font-weight: bold; letter-spacing: .5px; color: {{ c[1] }}; }
		.numero { font-size: 11px; font-weight: bold; color: #111827; }
		.dates { font-size: 7.8px; color: #4b5563; margin-top: 3px; }

		.bloc-client { background: #f3f5f9; padding: 9px 11px; }
		.etiquette { font-size: 6.8px; font-weight: bold; letter-spacing: 1px; text-transform: uppercase; color: #6b7280; }
		.client-nom { font-size: 11px; font-weight: bold; color: #111827; margin-top: 2px; }
		.cadre-qr { border: 1.4px solid {{ c[0] }}; padding: 6px; }
		.cadre-qr img { width: 58px; height: 58px; }
		.cadre-qr b { color: {{ c[0] }}; }

		.lignes { margin-top: 12px; }
		.lignes th { background: {{ c[0] }}; color: #fff; font-size: 7.6px; text-align: left; padding: 6px 7px; }
		.lignes th.droite { text-align: right; }
		.lignes th.centre { text-align: center; }
		.lignes td { padding: 6px 7px; border-bottom: 1px solid #e5e7eb; }
		.lignes tr.paire td { background: #f8fafc; }
		.designation { font-weight: bold; color: #111827; }
		.designation .nc-technique { font-weight: normal; font-size: 0.85em; color: #6B7280; }
		.detail { font-size: 7.2px; color: #6b7280; }

		.totaux td { padding: 4px 7px; border-bottom: 1px solid #eef0f4; }
		.totaux .final td { background: {{ c[0] }}; color: #fff; font-size: 11px; font-weight: bold; padding: 7px; border: 0; }
		.lettres { background: #f3f5f9; padding: 7px 10px; margin-top: 12px; font-size: 8px; }
		.objet { margin-top: 10px; font-size: 9px; color: #111827; }
		.objet b { color: {{ c[0] }}; }
		.nb { border: 1px solid #d5dce6; border-left: 3px solid {{ c[0] }}; padding: 6px 9px; margin-top: 12px; font-size: 7.8px; color: #374151; }
		.nb b { color: #111827; }

		.cadre-om { border: 1.4px solid #f97316; padding: 7px; }
		.cadre-om img { width: 58px; height: 58px; }
		.signature img { max-height: 70px; max-width: 160px; }
		.annulee { color: #b91c1c; font-size: 13px; font-weight: bold; border: 2px solid #b91c1c; padding: 4px 10px; display: inline-block; }

		.pied { position: fixed; bottom: 8mm; left: 15mm; right: 15mm; border-top: 1px solid #e5e7eb; padding-top: 5px; font-size: 6.8px; color: #6b7280; }
		.pied img { height: 18px; }
	</style>
</head>
<body>
	{% if facture.etat == 'brouillon' %}<div style="position: fixed; top: 38%; left: 8%; font-size: 110px; font-weight: bold; color: rgba(222, 16, 40, 0.12); transform: rotate(-30deg);">BROUILLON</div>{% endif %}
	{% set estTiers = facture.facturerAUnTiers|default(false) %}
	{% set details = commande.commandesDetails|default([]) %}
	{% set avecRemise = details|filter(d => d.montantRemise|default(0) > 0)|length > 0 %}

	<table class="bandes"><tr>
		{% for couleur in c %}<td style="background: {{ couleur }}"></td>{% endfor %}
	</tr></table>

	<div class="pied">
		<table><tr>
			{% if images.logoPied %}<td style="width: 26px; vertical-align: middle"><img src="{{ images.logoPied }}" alt=""></td>{% endif %}
			<td style="vertical-align: middle">
				{% if entreprise.nomCommercial and entreprise.mention %}{{ entreprise.nomCommercial }} · {{ entreprise.mention }}<br>{% endif %}
				{{ entreprise.mentionsLegales }}
				{% if facture.codeSuivi %} · Code de vérification : <b>{{ facture.codeSuivi }}</b>{% endif %}
			</td>
		</tr></table>
	</div>

	<div class="page">
		<table class="entete"><tr>
			<td style="width: 58%">
				{% if images.logo %}<img src="{{ images.logo }}" class="logo" alt="{{ entreprise.nomAffiche }}">{% endif %}
				<div class="nom">{{ entreprise.nomAffiche }}</div>
				<div class="coord">
					{% if entreprise.nomCommercial %}{{ entreprise.mention ?: 'Nom commercial de ' ~ entreprise.raisonSociale }}<br>{% elseif entreprise.mention %}{{ entreprise.mention }}<br>{% endif %}
					{% if entreprise.activite %}{{ entreprise.activite }}<br>{% endif %}
					{{ [entreprise.adresse, entreprise.rccm ? 'RCCM ' ~ entreprise.rccm, entreprise.nif ? 'NIF ' ~ entreprise.nif]|filter(v => v)|join(' · ') }}<br>
					{{ [entreprise.telephone, entreprise.email, entreprise.siteWeb]|filter(v => v)|join(' · ') }}
				</div>
			</td>
			<td class="droite">
				<div class="titre">{{ facture.estProforma ? 'PROFORMA' : 'FACTURE' }}</div>
				<div class="numero">{{ facture.numero ? 'N° ' ~ facture.numero : 'N° attribué à la validation' }}</div>
				<div class="dates">
					Date : {{ facture.dateFacture|date('d/m/Y') }}<br>
					Commande : {{ commande.numero|default('CMD-' ~ commande.id) }}<br>
					{% if commande.bonCommande %}Votre bon de commande : {{ commande.bonCommande }}<br>{% endif %}
					{% if commande.demandeePar %}Commandé par : {{ commande.demandeePar }}<br>{% endif %}
					Échéance : {{ facture.dateEcheance ? facture.dateEcheance|date('d/m/Y') : 'à réception' }}
				</div>
				{% if facture.estAnnulee %}<div style="margin-top: 6px"><span class="annulee">ANNULÉE</span></div>{% endif %}
			</td>
		</tr></table>

		<table style="margin-top: 12px"><tr>
			<td class="bloc-client" style="width: {{ qrSuivi ? '62%' : '100%' }}">
				<div class="etiquette">{{ estTiers ? 'Facturé à' : 'Client' }}</div>
				{% if estTiers %}
					<div class="client-nom">{{ facture.nomFacturation|default('Payeur') }}</div>
					{{ [facture.adresseFacturation, facture.telephoneFacturation, facture.emailFacturation]|filter(v => v)|join(' · ') }}
					{% if client %}<div class="muted" style="font-size: 7px; margin-top: 3px">Demandeur : {{ client.raisonSociale|default(client.nomComplet|default(client.nom|default('Client'))) }}</div>{% endif %}
				{% elseif client %}
					<div class="client-nom">{{ client.raisonSociale|default(client.nomComplet|default(client.nom|default('Client'))) }}</div>
					{{ [client.adresse|default(null), client.telephone|default(null), client.email|default(null)]|filter(v => v)|join(' · ') }}
				{% endif %}
			</td>
			{% if qrSuivi %}
				<td style="width: 3%"></td>
				<td class="cadre-qr">
					<table><tr>
						<td style="width: 64px"><img src="{{ qrSuivi }}" alt="QR de suivi"></td>
						<td style="vertical-align: middle"><b>Suivre cette facture en ligne</b><br><span class="muted">Statut, paiement, PDF et vérification d'authenticité</span></td>
					</tr></table>
				</td>
			{% endif %}
		</tr></table>

		{# Objet de la commande (« Impressions »…), copié sur la facture à sa création. #}
		{% if facture.objet|default(null) %}<div class="objet"><b>Objet :</b> {{ facture.objet }}</div>{% endif %}

		{% set fraisLivraison = facture.fraisLivraison|default(0) %}
		<table class="lignes">
			<thead><tr>
				<th class="centre" style="width: 5%">N°</th>
				<th>Désignation</th>
				<th class="centre" style="width: 9%">Qté</th>
				<th class="droite" style="width: 15%">PU (F)</th>
				{% if avecRemise %}<th class="droite" style="width: 12%">Remise (F)</th>{% endif %}
				<th class="droite" style="width: 17%">Total (F)</th>
			</tr></thead>
			<tbody>
				{% for detail in details %}
					<tr class="{{ loop.index is even ? 'paire' }}">
						<td class="centre muted">{{ loop.index }}</td>
						<td>
							<div class="designation">{{ detail|ligne_client }}</div>
							{% if detail.observation|default('') %}<div class="detail">{{ detail.observation }}</div>{% endif %}
						</td>
						<td class="centre">
							{{ detail.quantite|default(1) }}
							{% if detail.modeCalcul|default('') == 'metre_carre' %}<div class="detail">{{ detail.surfaceTotale|default(0)|number_format(2, ',', ' ') }} m²{% if pieces_m2_ligne(detail, true) %} · {{ pieces_m2_ligne(detail, true) }}{% endif %}</div>{% endif %}
						</td>
						<td class="droite">{{ detail.prixUnitaire|default(0) > 0 ? detail.prixUnitaire|number_format(0, ',', ' ') : '—' }}</td>
						{% if avecRemise %}<td class="droite">{{ detail.montantRemise|default(0) > 0 ? '− ' ~ (detail.montantRemise)|number_format(0, ',', ' ') : '—' }}</td>{% endif %}
						<td class="droite fort">{{ (detail.totalTtc|default(detail.totalHt|default(0)))|number_format(0, ',', ' ') }}</td>
					</tr>
				{% else %}
					<tr><td colspan="6" class="centre muted">Aucune ligne.</td></tr>
				{% endfor %}
				{# Frais de livraison : une ligne visible, déjà comprise dans le total HT. #}
				{% if fraisLivraison > 0 %}
					<tr class="{{ (details|length + 1) is even ? 'paire' }}">
						<td class="centre muted">{{ details|length + 1 }}</td>
						<td><div class="designation">Livraison</div></td>
						<td class="centre">1</td>
						<td class="droite">{{ fraisLivraison|number_format(0, ',', ' ') }}</td>
						{% if avecRemise %}<td class="droite">—</td>{% endif %}
						<td class="droite fort">{{ fraisLivraison|number_format(0, ',', ' ') }}</td>
					</tr>
				{% endif %}
			</tbody>
		</table>

		<table style="margin-top: 10px"><tr>
			<td style="width: 52%; padding-right: 14px">
				{% if facture.observation|default('') %}
					<div class="etiquette">Observation</div>
					<div style="margin-bottom: 8px">{{ facture.observation }}</div>
				{% endif %}
				{% if entreprise.banque or entreprise.compteBancaire %}
					<div class="etiquette">Coordonnées bancaires</div>
					<div style="margin-bottom: 8px">{{ entreprise.banque }} {{ entreprise.compteBancaire }}</div>
				{% endif %}
			</td>
			<td>
				<table class="totaux">
					{# Code promo de la commande (docs/promotions.md) : déjà déduit des lignes, montré à part. #}
					{% set remiseCode = commande.remiseCodePromo|default(0) %}
					{% if remiseCode > 0 %}
						<tr><td>Total HT avant code promo</td><td class="droite">{{ (facture.totalHt + remiseCode)|number_format(0, ',', ' ') }} F</td></tr>
						<tr><td>Code promo {{ commande.libelleCodePromo }}</td><td class="droite">− {{ remiseCode|number_format(0, ',', ' ') }} F</td></tr>
					{% endif %}
					{# Remise globale : une ligne visible, déduite du sous-total HT ; Total HT = après remise, TTC = HT + TVA. #}
					{% if facture.remise > 0 %}
						<tr><td>Sous-total HT</td><td class="droite">{{ (facture.totalHt)|number_format(0, ',', ' ') }} F</td></tr>
						<tr><td>Remise globale</td><td class="droite">− {{ (facture.remise)|number_format(0, ',', ' ') }} F</td></tr>
					{% endif %}
					<tr><td>Total HT</td><td class="droite">{{ max(0, facture.totalHt - facture.remise)|number_format(0, ',', ' ') }} F</td></tr>
					{% if facture.montantTva > 0 %}<tr><td>TVA{{ facture.tva > 0 ? ' ' ~ facture.tva ~ ' %' }}</td><td class="droite">{{ (facture.montantTva)|number_format(0, ',', ' ') }} F</td></tr>{% endif %}
					{% if facture.surfacturation and facture.montantSurfacturation > 0 %}
						<tr><td>Majoration{{ facture.tauxSurfacturation ? ' (' ~ facture.tauxSurfacturation ~ ' %)' }}</td><td class="droite">+ {{ (facture.montantSurfacturation)|number_format(0, ',', ' ') }} F</td></tr>
					{% endif %}
					{# Facture : total, déjà payé (même 0) et reste à payer, comme l'ancien modèle. #}
					{% if facture.comptabilisee %}
						<tr><td class="fort">Total TTC</td><td class="droite fort">{{ (facture.totalTtc)|number_format(0, ',', ' ') }} F</td></tr>
						<tr><td>Déjà payé</td><td class="droite">{{ facture.montantPaye > 0 ? '− ' }}{{ (facture.montantPaye)|number_format(0, ',', ' ') }} F</td></tr>
						<tr class="final"><td>Reste à payer</td><td class="droite">{{ (facture.resteAPayer)|number_format(0, ',', ' ') }} F</td></tr>
					{% else %}
						<tr class="final"><td>Total TTC{{ facture.estProforma ? '' : ' à payer' }}</td><td class="droite">{{ (facture.totalTtc)|number_format(0, ',', ' ') }} F</td></tr>
					{% endif %}
				</table>
			</td>
		</tr></table>

		{% if montantLettres %}<div class="lettres">{{ montantLettres }}</div>{% endif %}

		<table style="margin-top: 14px"><tr>
			<td style="width: 46%">
				{% if qrPaiement %}
					<div class="cadre-om">
						<table><tr>
							<td style="width: 64px"><img src="{{ qrPaiement }}" alt="QR de paiement"></td>
							<td style="vertical-align: middle">
								<b>Payer par Orange Money</b><br>
								{% if entreprise.marchandOrangeMoney %}Marchand {{ entreprise.nomAffiche }} · {{ entreprise.marchandOrangeMoney }}<br>{% endif %}
								Référence : {{ facture.numero|default('commande ' ~ commande.numero) }}
							</td>
						</tr></table>
					</div>
				{% endif %}
			</td>
			<td style="width: 4%"></td>
			<td>
				{% if facture.estProforma %}
					<div class="etiquette">Conditions</div>
					Proforma valable 30 jours, sans valeur comptable.
				{% endif %}
			</td>
			{% if images.signature %}
				<td class="signature droite" style="width: 26%">
					<div class="etiquette">Cachet et signature</div>
					<img src="{{ images.signature }}" alt="">
				</td>
			{% endif %}
		</tr></table>

		{# Conditions de paiement de l'entreprise (Réglages › Entreprises) ; vide : pas de bloc. #}
		{% if entreprise.conditionsPaiement|default('') %}
			<div class="nb"><b>NB :</b> {{ entreprise.conditionsPaiement|nl2br }}</div>
		{% endif %}
	</div>
</body>
</html>
