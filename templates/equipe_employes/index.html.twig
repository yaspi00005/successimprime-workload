{% extends 'base.html.twig' %}

{#
	Employés avec et sans accès (maquette E01). Chaque employé a un dossier ;
	l'accès à l'application est en plus. Les boutons d'accès sont réservés
	à un administrateur.
#}

{% block title %}Employés{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_equipe_employes_index', app.request.query.all|merge({format: 'csv'})) }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-download me-1"></i>Export</a>
	</li>
	<li class="nav-item">
		<a href="{{ path('app_equipe_employes_nouveau') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Nouvel employé</a>
	</li>
{% endblock %}

{% block body %}
	{% import 'equipe_employes/_macros.html.twig' as m %}
	{% set admin = is_granted('ROLE_ADMIN') %}

	<div class="row si-kpis">
		<div class="col-xl-3 col-6">
			<a class="card si-kpi" href="{{ path('app_equipe_employes_index') }}"><div class="card-body">
				<span class="si-kpi-libelle">Employés</span>
				<div class="si-kpi-valeur">{{ nombres.tous }}</div>
				<span class="si-tendance si-hausse">{% for k, n in contrats %}{{ n }} {{ {cdi: 'CDI', cdd: 'CDD', essai: 'essai', stage: 'stage', journalier: 'journalier'}[k] ?? 'sans contrat' }}{{ not loop.last ? ' · ' }}{% else %}aucun{% endfor %}</span>
			</div></a>
		</div>
		<div class="col-xl-3 col-6">
			<a class="card si-kpi" href="{{ path('app_equipe_employes_index', {filtre: 'avec'}) }}"><div class="card-body">
				<span class="si-kpi-libelle">Avec accès à l'app</span>
				<div class="si-kpi-valeur">{{ nombres.avec }}</div>
				<span class="si-tendance si-hausse">{{ telephones }} téléphone{{ telephones > 1 ? 's' }} enregistré{{ telephones > 1 ? 's' }}</span>
			</div></a>
		</div>
		<div class="col-xl-3 col-6">
			<a class="card si-kpi" href="{{ path('app_equipe_employes_index', {filtre: 'sans'}) }}"><div class="card-body">
				<span class="si-kpi-libelle">Sans accès</span>
				<div class="si-kpi-valeur">{{ nombres.sans }}</div>
				<span class="si-tendance si-hausse">pointage sur la tablette de l'entrée</span>
			</div></a>
		</div>
		<div class="col-xl-3 col-6">
			<a class="card si-kpi" href="{{ path('app_equipe_employes_index', {filtre: 'invitation'}) }}"><div class="card-body">
				<span class="si-kpi-libelle">Invitations en attente</span>
				<div class="si-kpi-valeur">{{ nombres.invitation }}</div>
				<span class="si-tendance {{ invitations ? 'si-baisse' : 'si-hausse' }}">{% if invitations %}{{ invitations|first.employe.prenom ?: invitations|first.employe.nomComplet }} · envoyée {{ m.quand(invitations|first.utilisateur.invitationEnvoyeeLe, maintenant)|split(' ')|first }}{% if invitations|length > 1 %} (+{{ invitations|length - 1 }}){% endif %}{% else %}aucune{% endif %}</span>
			</div></a>
		</div>
	</div>

	<section class="si-em-outils">
		<nav class="si-em-filtres" aria-label="Accès">
			{% for k, l in filtres %}
				<a href="{{ path('app_equipe_employes_index', {filtre: k != 'tous' ? k : null, contrat: contrat ?: null, poste: poste ?: null, q: recherche ?: null}) }}" class="{{ filtre == k ? 'active' }}">{{ l }} · {{ nombres[k] }}</a>
			{% endfor %}
		</nav>
		<form method="get" class="si-em-selects" role="search">
			{% if filtre != 'tous' %}<input type="hidden" name="filtre" value="{{ filtre }}">{% endif %}
			<input type="search" name="q" value="{{ recherche }}" class="form-control form-control-sm" placeholder="Nom, poste, téléphone…" aria-label="Rechercher un employé">
			<select name="poste" class="form-select form-select-sm" aria-label="Poste" onchange="this.form.submit()">
				<option value="">Poste</option>
				{% for p in postes %}<option{{ poste == p ? ' selected' }}>{{ p }}</option>{% endfor %}
			</select>
			<select name="contrat" class="form-select form-select-sm" aria-label="Contrat" onchange="this.form.submit()">
				<option value="">Contrat</option>
				{% for k, l in constant('App\\Entity\\Employes::CONTRATS') %}<option value="{{ k }}"{{ contrat == k ? ' selected' }}>{{ l }}</option>{% endfor %}
			</select>
		</form>
	</section>

	{% if fiches is empty %}
		<p class="si-em-vide">Aucun employé avec ces filtres. <a href="{{ path('app_equipe_employes_nouveau') }}">Ajouter un employé</a></p>
	{% endif %}

	<div class="si-em-cartes">
		{% for f in fiches %}
			{% set e = f.employe %}
			{% set u = f.utilisateur %}
			<article class="si-em-carte{{ f.groupe == 'sans' ? ' si-em-sans' }}">
				<header class="si-em-entete">
					{{ m.avatar(e, '') }}
					<span class="si-em-nom"><b>{{ e.nomComplet }}</b><small>{{ e.fonction ?: '—' }}{{ e.contrat ? ' · ' ~ e.libelleContrat }}</small></span>
					{{ m.statut(f.statut) }}
				</header>
				<dl class="si-em-infos">
					{% if f.groupe == 'sans' %}
						<dt>Pointage</dt><dd>tablette de l'entrée</dd>
						<dt>Bulletins</dt><dd>{{ e.typeRemuneration == 'journalier' ? 'paie journalière en caisse' : (e.modePaiement == 'orange_money' ? 'par Orange Money' : 'imprimé, remis en main propre') }}</dd>
						<dt>Tâches</dt><dd>données par {{ e.responsable ? e.responsable|nom_pointage : 'le responsable' }}</dd>
					{% elseif f.groupe == 'invitation' %}
						<dt>Rôle prévu</dt><dd>{{ u.profil ? u.profil.nom : '—' }}</dd>
						<dt>Invitation</dt><dd>WhatsApp · {{ m.quand(u.invitationEnvoyeeLe, maintenant) }}</dd>
						<dt>Expire</dt><dd>{% if f.statut == 'expire' %}lien expiré{% else %}{% set j = ((u.invitationExpireLe|date('U') - maintenant|date('U')) / 86400)|round(0, 'ceil') %}dans {{ j }} jour{{ j > 1 ? 's' }}{% endif %}</dd>
					{% else %}
						<dt>Rôle</dt><dd>{{ u.profil ? u.profil.nom : (u.admin ? 'Administrateur' : '—') }}</dd>
						<dt>Appareil</dt><dd>{{ f.appareil ? f.appareil.nom|split(' · ')|last ~ ' · enregistré' : 'mot de passe' }}</dd>
						<dt>Dernière connexion</dt><dd>{{ m.quand(u.lastLoginAt, maintenant) }}</dd>
					{% endif %}
				</dl>
				<footer class="si-em-actions">
					<a href="{{ path('app_equipe_employes_dossier', {id: e.id}) }}" class="btn si-btn-discret btn-sm">Dossier</a>
					{% if admin %}
						{% if f.groupe == 'sans' %}
							<a href="{{ path('app_equipe_employes_modifier', {id: e.id, _fragment: 'acces'}) }}" class="btn btn-primary btn-sm">+ Donner un accès</a>
						{% elseif f.groupe == 'invitation' %}
							<form method="post" action="{{ path('app_acces_agir', {id: u.id, action: 'renvoyer'}) }}">
								<input type="hidden" name="_token" value="{{ csrf_token('acces-' ~ u.id) }}">
								<button class="btn si-btn-discret btn-sm w-100">Renvoyer</button>
							</form>
						{% else %}
							<a href="{{ path('app_acces_index', {_fragment: 'u' ~ u.id}) }}" class="btn si-btn-discret btn-sm">Gérer l'accès</a>
						{% endif %}
					{% endif %}
				</footer>
			</article>
		{% endfor %}
	</div>
{% endblock %}
