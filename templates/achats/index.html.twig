{% extends 'achats/_base.html.twig' %}
{% import 'achats/_macros.html.twig' as m %}

{% block title %}Commandes d'achat{% endblock %}

{% block header_actions %}
	<li class="nav-item">
		<a href="{{ path('app_achat_new') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Commande d'achat</a>
	</li>
{% endblock %}

{% block body %}
	<div class="ac-page">

		<nav class="ac-onglets" aria-label="Statut des commandes">
			{% for cle, f in filtres %}
				<a href="{{ path('app_achat_index', {statut: cle}) }}" class="{{ cle == filtre ? 'actif' }}">{{ f.libelle }}{% if f.nombre > 0 and cle != 'toutes' %} · {{ f.nombre }}{% endif %}</a>
			{% endfor %}
		</nav>

		<section class="ac-carte">
			{% if lignes is empty %}
				<p class="ac-muet mb-0">Aucune commande d'achat ici.</p>
			{% else %}
				<div class="ac-defile">
					<table class="ac-table">
						<thead>
							<tr><th>N°</th><th>Fournisseur</th><th>Date</th><th class="num">Montant rendu</th><th>Promis</th><th>Arrivée</th><th>Statut</th><th></th></tr>
						</thead>
						<tbody>
							{% for l in lignes %}
								{% set a = l.achat %}
								<tr>
									<td><a class="ac-lien" href="{{ path(a.estBrouillon ? 'app_achat_edit' : 'app_achat_show', {id: a.id}) }}">{{ a.numero ?? 'Brouillon' }}</a></td>
									<td><a class="ac-nom ac-lien" href="{{ path('app_fournisseur_show', {id: a.fournisseur.id}) }}">{{ m.avatar(a.fournisseur) }}<span>{{ a.fournisseur.nomCourt }}</span></a></td>
									<td class="ac-muet">{{ (a.dateCommande ?? a.dateDemande)|date('d/m/y') }}</td>
									<td class="num"><b>{{ m.f(a.totalRendu) }}</b></td>
									<td class="ac-muet">{{ a.datePromise ? a.datePromise|date('d/m') : '—' }}</td>
									<td class="ac-muet">{{ a.dateReception ? a.dateReception|date('d/m') : (l.prevue ? 'prévue ' ~ l.prevue|date('d/m') : '—') }}</td>
									<td>{{ m.statut(a) }}{% if a.paiementBloque and is_granted('ROLE_TRESORERIE_VOIR') %} <span class="ac-badge retard">paiement bloqué</span>{% endif %}</td>
									<td>{% if a.estEnCours %}<a class="ac-bouton" href="{{ path('app_reception_show', {id: a.id}) }}">Réceptionner</a>{% elseif a.estRecu %}<a class="ac-lien ac-muet" href="{{ path('app_reception_show', {id: a.id}) }}">Réception</a>{% endif %}</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
		</section>
	</div>
{% endblock %}
