{% extends 'espace/_page.html.twig' %}

{% block title %}Mon espace · Succès Imprim{% endblock %}
{% block lien_haut %}<a href="{{ path('app_espace_deconnexion') }}">Se déconnecter</a>{% endblock %}

{% block contenu %}
	{% set nom = (client.prenom ~ ' ' ~ client.nom)|trim %}
	<h1>Bonjour {{ client.typeCompte != 'particulier' and client.raisonSociale ? client.raisonSociale : (client.prenom ?: nom) }}</h1>
	<p class="si-espace-sous-titre">Compte client {{ client.code }} · {{ compte.telephone|slice(3)|split('', 2)|join(' ') }}</p>

	<h2 class="si-espace-titre">Mes commandes</h2>
	{% if commandes is empty %}
		<p class="si-espace-info">Vous n'avez pas encore de commande. Passez nous voir ou écrivez-nous sur WhatsApp.</p>
	{% else %}
		{% set libelles = {vide: 'Enregistrée', preparation: 'En préparation', livraison: 'Prête / en livraison', livree: 'Livrée', annulee: 'Annulée'} %}
		<ul class="si-espace-commandes">
			{% for commande in commandes %}
				{% set statut = commande.statutTravaux %}
				<li>
					<div>
						<strong>{{ commande.numero }}</strong>
						<small>{{ commande.dateCommande ? commande.dateCommande|date('d/m/Y') }}</small>
					</div>
					<span class="si-etat si-etat-{{ statut }}">{{ libelles[statut]|default(statut) }}</span>
					<div class="si-espace-montants">
						<strong>{{ commande.totalTtc|number_format(0, ',', ' ') }} F</strong>
						{% if commande.resteAPayer > 0 %}<small class="si-reste">reste {{ commande.resteAPayer|number_format(0, ',', ' ') }} F</small>{% else %}<small>payée</small>{% endif %}
					</div>
				</li>
			{% endfor %}
		</ul>
	{% endif %}

	<details class="si-espace-reglage">
		<summary>{{ compte.aUnMotDePasse ? 'Changer mon mot de passe' : 'Choisir un mot de passe (facultatif)' }}</summary>
		<form method="post" action="{{ path('app_espace_mot_de_passe') }}">
			<input type="hidden" name="_token" value="{{ csrf_token('espace-mdp') }}">
			<input type="hidden" name="telephone" value="{{ compte.telephone }}" autocomplete="username">
			<label for="nouveau">Nouveau mot de passe (8 caractères ou plus)</label>
			<input type="password" id="nouveau" name="mot_de_passe" minlength="8" autocomplete="new-password" required>
			<label for="confirmation">Confirmer</label>
			<input type="password" id="confirmation" name="confirmation" minlength="8" autocomplete="new-password" required>
			<button type="submit" class="si-espace-bouton">Enregistrer</button>
		</form>
	</details>
{% endblock %}
