{% extends 'espace/app/_app.html.twig' %}

{#
	Page d'un BAT (depuis Fichiers et BAT ou une notification) : la même
	carte que sur la page de la commande (_bat_carte.html.twig), avec le
	lien vers le suivi de la commande.
#}
{% block title %}BAT · {{ b.titre }}{% endblock %}
{% block styles %}<link href="{{ asset('css/espace-suivi.css') }}" rel="stylesheet">{% endblock %}
{% block entete %}<a class="ec-retour" href="{{ path('app_espace_fichiers') }}"><span class="fl">‹</span>BAT · {{ b.titre }}</a>{% endblock %}

{% block contenu %}
	<p class="ec-sous">Commande {{ commande.numero }} · <a href="{{ path('app_espace_commande', {id: commande.publicId}) }}">suivre la commande</a></p>
	{% include 'espace/app/_bat_carte.html.twig' with {b: b, contexte: 'bat'} %}
{% endblock %}

{% block scripts %}<script src="{{ asset('js/espace-bat.js') }}" defer></script>{% endblock %}
