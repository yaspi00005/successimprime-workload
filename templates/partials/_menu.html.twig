{#
	Menu selon le role (maquettes R01 a R03) :
	- volets : tous les modules (Direction), un seul volet ouvert a la fois ;
	- court : les ecrans du quotidien a plat (caisse, livreur...) ;
	- replie : le menu court en icones, pour laisser la place au travail.
	Les pastilles jaunes signalent ce qui attend une decision. « Aller a… »
	(Ctrl K) ouvre n'importe quelle page autorisee sans passer par le menu.
#}
{% set menu = menu_admin(routeCourante) %}
{# Livreur seul : sa tournée et ses livraisons, sans « Aller à… » ni ses statistiques de vente (LivreurSeul). #}
{% set livreurSeul = livreur_seul() %}
{% set utilisateur = app.user %}
{% set employe = utilisateur.employe is defined ? utilisateur.employe : null %}
{% set nomComplet = employe and employe.prenom is not empty ? (employe.prenom ~ ' ' ~ employe.nom)|trim : utilisateur.userIdentifier %}
{% set nomRole = is_granted('ROLE_ADMIN') ? 'Direction' : (utilisateur.profil ? utilisateur.profil.nom : '') %}
<div class="dlabnav si-sidebar si-menu-{{ menu.style }}" data-style-menu="{{ menu.style }}">
	<div class="dlabnav-scroll">

		<a class="si-menu-personne" href="{{ employe ? path('app_mon_espace_index') : path('app_user_change_password') }}" title="{{ nomComplet }}">
			<span class="si-menu-pastille-personne" aria-hidden="true">{{ nomComplet|slice(0, 1)|upper }}</span>
			<span class="nav-text"><b>{{ nomComplet }}</b>{% if nomRole %}<small>{{ nomRole }}</small>{% endif %}</span>
		</a>

		{% if not livreurSeul %}
		<button type="button" class="si-menu-aller" data-aller-a title="Aller à… (Ctrl K)">
			<i class="fas fa-search" aria-hidden="true"></i><span class="nav-text">Aller à…</span><kbd class="nav-text">Ctrl K</kbd>
		</button>
		{% endif %}

		<ul class="si-menu" id="si-menu">
			{% if menu.style == 'volets' %}
				{% for module in menu.entrees %}
					{% set ouvert = module.actif and module.items is not empty %}
					<li class="si-menu-module {{ module.actif ? 'actif' }} {{ ouvert ? 'ouvert' }}" data-module="{{ module.cle }}">
						<a href="{{ path(module.route, module.parametres) }}" class="si-menu-lien" {% if module.items is not empty %}data-volet aria-expanded="{{ ouvert ? 'true' : 'false' }}"{% endif %} title="{{ module.libelle }}">
							<i class="{{ module.icone }}" aria-hidden="true"></i>
							<span class="nav-text">{{ module.libelle }}</span>
							{% if module.pastille > 0 %}<span class="si-menu-compte">{{ module.pastille }}</span>{% endif %}
							{% if module.items is not empty %}<span class="si-menu-fleche nav-text" aria-hidden="true"></span>{% endif %}
						</a>
						{% if module.items is not empty %}
							<ul class="si-menu-ecrans">
								{% for ecran in module.items %}
									<li><a href="{{ path(ecran.route, ecran.parametres) }}" class="{{ ecran.actif ? 'actif' }}" {% if ecran.actif %}aria-current="page"{% endif %}>
										<span>{{ ecran.libelle }}</span>
										{% if ecran.pastille > 0 %}<span class="si-menu-compte petit">{{ ecran.pastille }}</span>{% endif %}
									</a></li>
								{% endfor %}
							</ul>
						{% endif %}
					</li>
				{% endfor %}
			{% else %}
				{% for ecran in menu.entrees %}
					<li class="si-menu-module {{ ecran.actif ? 'actif' }}">
						<a href="{{ path(ecran.route, ecran.parametres) }}" class="si-menu-lien" title="{{ ecran.libelle }}" {% if ecran.actif %}aria-current="page"{% endif %}>
							<i class="{{ ecran.icone }}" aria-hidden="true"></i>
							<span class="nav-text">{{ ecran.libelle }}</span>
							{% if ecran.pastille > 0 %}<span class="si-menu-compte">{{ ecran.pastille }}</span>{% endif %}
						</a>
					</li>
				{% endfor %}
				{% if employe %}
					{% set dansMonEspace = routeCourante starts with 'app_mon_espace_' or routeCourante starts with 'app_pointer_' or routeCourante == 'app_mes_statistiques' %}
					<li class="si-menu-module {{ dansMonEspace ? 'actif ouvert' }}" data-module="mon_espace">
						<a href="{{ path('app_mon_espace_index') }}" class="si-menu-lien" data-volet aria-expanded="{{ dansMonEspace ? 'true' : 'false' }}" title="Mon espace">
							<i class="far fa-star" aria-hidden="true"></i><span class="nav-text">Mon espace</span><span class="si-menu-fleche nav-text" aria-hidden="true"></span>
						</a>
						<ul class="si-menu-ecrans">
							<li><a href="{{ path('app_mon_espace_index') }}" class="{{ routeCourante starts with 'app_mon_espace_' ? 'actif' }}">Mes points, congés et bulletins</a></li>
							<li><a href="{{ path('app_pointer_index') }}" class="{{ routeCourante starts with 'app_pointer_' ? 'actif' }}">Pointer</a></li>
							{% if is_granted('ROLE_STATS_PERSO') and not livreurSeul %}<li><a href="{{ path('app_mes_statistiques') }}" class="{{ routeCourante == 'app_mes_statistiques' ? 'actif' }}">Mes statistiques</a></li>{% endif %}
						</ul>
					</li>
				{% endif %}
			{% endif %}
		</ul>

		<div class="si-menu-bas">
			{% if is_granted('ROLE_ADMIN') %}
				{% set synchro = pastille_synchro() %}
				{% if synchro %}
					<a href="{{ path('app_synchronisation_index') }}" class="si-menu-synchro nav-text {{ synchro.panne ? 'panne' }}">
						<b>● {{ synchro.panne ? 'Synchro en panne' : 'Synchronisé' }}</b> avec {{ synchro.site }}<br>{{ synchro.reussite ? synchro.reussite|temps_ecoule : 'jamais' }}
					</a>
				{% endif %}
			{% endif %}
			<button type="button" class="si-menu-replier" data-replier-menu>
				<span class="si-replier-icone" aria-hidden="true">«</span><span class="nav-text">Replier le menu</span>
			</button>
		</div>
	</div>
</div>
<script>
	// Avant l'affichage : menu replié selon le dernier choix de la personne,
	// sinon selon son rôle (le graphiste commence replié, maquette R03).
	(function () {
		var enveloppe = document.getElementById('main-wrapper');
		if (!enveloppe) {
			return;
		}
		{% if menu.style == 'volets' %}enveloppe.classList.add('si-avec-volets');{% endif %}
		if (window.innerWidth < 1024) {
			return;
		}
		var choix = null;
		try {
			choix = window.localStorage.getItem('si-menu-replie-{{ menu.style }}');
		} catch (e) {}
		if (choix === '1' || (choix === null && {{ menu.style == 'replie' ? 'true' : 'false' }})) {
			enveloppe.classList.add('menu-toggle');
			var hamburger = document.querySelector('.nav-control .hamburger');
			if (hamburger) {
				hamburger.classList.add('is-active');
			}
		}
	})();
</script>

{# « Aller à… » : toutes les pages autorisées, filtrées au clavier. #}
{% if not livreurSeul %}
{% set toutes = menu_admin(routeCourante, 'volets') %}
<div class="si-aller" id="si-aller" hidden>
	<div class="si-aller-boite" role="dialog" aria-modal="true" aria-label="Aller à une page">
		<input type="search" class="form-control" placeholder="Page, ou client, commande, facture à rechercher…" data-aller-champ autocomplete="off" aria-label="Aller à">
		<ul class="si-aller-liste" data-aller-liste>
			{% for module in toutes.entrees %}
				{% for ecran in (module.items is not empty ? module.items : [{libelle: module.libelle, route: module.route, parametres: module.parametres}]) %}
					<li><a href="{{ path(ecran.route, ecran.parametres) }}" data-texte="{{ (module.libelle ~ ' ' ~ ecran.libelle)|lower }}"><small>{{ module.libelle }}</small>{{ ecran.libelle }}</a></li>
				{% endfor %}
			{% endfor %}
			{% if is_granted('ROLE_DEVIS') %}<li><a href="{{ path('app_devis_new') }}" data-texte="nouveau devis"><small>Nouveau</small>Devis</a></li>{% endif %}
			{% if is_granted('ROLE_COMMANDE') %}<li><a href="{{ path('app_commandes_new') }}" data-texte="nouvelle commande"><small>Nouveau</small>Commande</a></li>{% endif %}
			{% if is_granted('ROLE_TRESORERIE_SAISIR') %}<li><a href="{{ path('app_finances_depenses') }}#saisir-depense" data-texte="nouvelle dépense reçu"><small>Nouveau</small>Dépense</a></li>{% endif %}
			{% if is_granted('ROLE_TRESORERIE_TRANSFERER') %}<li><a href="{{ path('app_mouvement_tresorerie_new', {type: 'transfert'}) }}" data-texte="nouveau virement entre comptes verser la caisse à la banque"><small>Nouveau</small>Virement entre comptes</a></li>{% endif %}
			{% if is_granted('ROLE_CLIENT') %}<li><a href="{{ path('app_clients_index', {nouveau: 1}) }}" data-texte="nouveau client"><small>Nouveau</small>Client</a></li>{% endif %}
			{% if employe %}<li><a href="{{ path('app_mon_espace_index') }}" data-texte="mon espace pointage congés bulletins"><small>Moi</small>Mon espace</a></li>{% endif %}
		</ul>
		<a class="si-aller-recherche" href="{{ path('app_recherche') }}" data-aller-recherche>Rechercher « <span></span> » dans les clients, commandes et factures</a>
	</div>
</div>
{% endif %}
