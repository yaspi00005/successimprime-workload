{% extends 'base.html.twig' %}

{% set moisCourts = ['jan', 'fév', 'mars', 'avr', 'mai', 'juin', 'juil', 'août', 'sep', 'oct', 'nov', 'déc'] %}
{% set nomsMois = ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'] %}

{% block title %}{{ autre ? 'Statistiques · ' ~ nom : 'Mes statistiques' }}{% endblock %}

{% block header_actions %}
	<li class="nav-item">
		<form method="get" class="si-choix-periode">
			{% if autre %}<input type="hidden" name="utilisateur" value="{{ agent.id }}">{% endif %}
			<select name="mois" class="form-select form-select-sm" aria-label="Période" onchange="this.form.submit()">
				{% for cle, m in moisPossibles %}
					<option value="{{ cle }}" {{ m == mois ? 'selected' }}>{{ nomsMois[m|date('n') - 1] }} {{ m|date('Y') }}</option>
				{% endfor %}
			</select>
		</form>
	</li>
{% endblock %}

{% macro montant(valeur) %}{{ valeur|number_format(0, ',', ' ') }} F{% endmacro %}
{% macro masque(titre) %}
	<div class="card si-kpi si-kpi-masque"><div class="card-body">
		<span class="si-kpi-libelle">{{ titre }}</span>
		<div class="si-kpi-valeur"><i class="fas fa-lock me-1"></i>Masqué</div>
		<span class="si-tendance">Droit non accordé</span>
	</div></div>
{% endmacro %}
{% import _self as m %}

{% block body %}
	{% if autre %}<p class="text-muted mb-3">Statistiques de <strong>{{ nom }}</strong>, vues par l'administrateur.</p>{% endif %}

	<div class="row si-kpis">
		<div class="col-xl-3 col-6">
			<div class="card si-kpi"><div class="card-body">
				<span class="si-kpi-libelle">{{ autre ? 'Ventes' : 'Mes ventes' }} du mois</span>
				<div class="si-kpi-valeur">{{ m.montant(s.ventes) }}</div>
				{% if s.variationVentes is not null %}
					<span class="si-tendance {{ s.variationVentes >= 0 ? 'si-hausse' : 'si-baisse' }}"><i class="fas fa-caret-{{ s.variationVentes >= 0 ? 'up' : 'down' }}"></i> {{ s.variationVentes > 0 ? '+' }}{{ s.variationVentes }} % vs {{ nomsMois[mois|date_modify('-1 month')|date('n') - 1] }}</span>
				{% endif %}
			</div></div>
		</div>
		<div class="col-xl-3 col-6">
			<div class="card si-kpi"><div class="card-body">
				<span class="si-kpi-libelle">Objectif du mois</span>
				{% if s.objectif %}
					<div class="si-kpi-valeur {{ s.avancementObjectif >= 100 ? 'text-success' }}">{{ s.avancementObjectif }} %</div>
					<span class="si-tendance si-hausse">{{ s.ventes|number_format(0, ',', ' ') }} / {{ s.objectif|number_format(0, ',', ' ') }}</span>
				{% else %}
					<div class="si-kpi-valeur">—</div>
					<span class="si-tendance">Aucun objectif fixé</span>
				{% endif %}
			</div></div>
		</div>
		<div class="col-xl-3 col-6">
			<div class="card si-kpi"><div class="card-body">
				<span class="si-kpi-libelle">{{ autre ? 'Devis' : 'Mes devis' }} envoyés</span>
				<div class="si-kpi-valeur">{{ s.devisEmis }}</div>
				<span class="si-tendance si-hausse">{{ s.tauxTransformation is not null ? 'taux de transformation ' ~ s.tauxTransformation ~ ' %' : 'aucun devis ce mois' }}</span>
			</div></div>
		</div>
		<div class="col-xl-3 col-6">
			<div class="card si-kpi"><div class="card-body">
				<span class="si-kpi-libelle">{{ autre ? 'Encaissements' : 'Mes encaissements' }}</span>
				<div class="si-kpi-valeur">{{ m.montant(s.encaissements) }}</div>
				{% if s.partOrangeMoney is not null %}<span class="si-tendance si-hausse">dont Orange Money {{ s.partOrangeMoney }} %</span>{% endif %}
			</div></div>
		</div>
	</div>

	<div class="row">
		<div class="col-xl-8">
			<div class="card si-bloc">
				<div class="si-bloc-tete"><h4>{{ autre ? 'Ventes' : 'Mes ventes' }} par mois</h4><span class="text-muted small">6 mois</span></div>
				<div class="si-histo" role="img" aria-label="Ventes des 6 derniers mois">
					{% for ligne in s.parMois %}
						<div class="si-histo-col">
							<span class="si-histo-valeur">{{ ligne.montant >= 1000000 ? (ligne.montant / 1000000)|number_format(1, ',', ' ') ~ ' M' : (ligne.montant / 1000)|number_format(0, ',', ' ') ~ ' k' }}</span>
							<span class="si-histo-remplie {{ loop.last ? 'si-histo-courante' }}" style="height: {{ max(2, ligne.montant / s.maxParMois * 100)|round }}%"></span>
							<span class="si-histo-mois">{{ moisCourts[ligne.mois|date('n') - 1] }}</span>
						</div>
					{% endfor %}
				</div>
			</div>
		</div>
		<div class="col-xl-4">
			<div class="card si-bloc">
				<div class="si-bloc-tete"><h4>{{ autre ? 'Indicateurs' : 'Mes indicateurs' }}</h4></div>
				<dl class="si-lignes-chiffres mb-0">
					<div><dt>Commandes traitées</dt><dd>{{ s.commandes }}</dd></div>
					<div><dt>Panier moyen</dt><dd>{{ m.montant(s.panierMoyen) }}</dd></div>
					<div><dt>Devis à relancer</dt><dd class="{{ s.devisARelancer > 0 ? 'text-danger' }}">{{ s.devisARelancer }}</dd></div>
					<div><dt>Remises accordées</dt><dd>{{ s.tauxRemise is not null ? s.tauxRemise|number_format(1, ',', ' ') ~ ' % du CA' : '—' }}</dd></div>
				</dl>
				<small class="text-muted mt-3">L'écart de caisse et la satisfaction des clients arrivent avec la clôture de caisse par agent et les sondages.</small>
			</div>
		</div>
	</div>

	<div class="row si-kpis">
		<div class="col-md-4">
			{% if chiffreAffaires is not null %}
				<div class="card si-kpi"><div class="card-body">
					<span class="si-kpi-libelle">CA global de l'entreprise</span>
					<div class="si-kpi-valeur">{{ (chiffreAffaires / 1000000)|number_format(1, ',', ' ') }} M F <small class="text-muted fs-6">(12 mois)</small></div>
					<span class="si-tendance">Droit accordé</span>
				</div></div>
			{% else %}{{ m.masque('CA global de l\'entreprise') }}{% endif %}
		</div>
		<div class="col-md-4">
			{% if marge is not null %}
				<div class="card si-kpi"><div class="card-body">
					<span class="si-kpi-libelle">Marge brute du mois</span>
					<div class="si-kpi-valeur">{{ m.montant(marge.marge) }}</div>
					<span class="si-tendance">{{ marge.taux is not null ? marge.taux|number_format(0, ',', ' ') ~ ' % du HT · ' }}Droit accordé</span>
				</div></div>
			{% else %}{{ m.masque('Marges et coûts') }}{% endif %}
		</div>
		<div class="col-md-4">
			{% if tresorerie is not null %}
				<div class="card si-kpi"><div class="card-body">
					<span class="si-kpi-libelle">Trésorerie</span>
					<div class="si-kpi-valeur">{{ m.montant(tresorerie) }}</div>
					<span class="si-tendance">Soldes de tous les comptes · Droit accordé</span>
				</div></div>
			{% else %}{{ m.masque('Trésorerie') }}{% endif %}
		</div>
	</div>
{% endblock %}
