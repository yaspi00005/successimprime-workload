{# Fichiers publiés pour le client (copies envoyées à son espace en ligne). Variables : publies, retirer (bool), base (si retirer). #}
{% if publies is empty %}
	<p class="dc-vide-court">Aucun fichier publié pour ce client.</p>
{% else %}
	<ul class="dc-publies">
		{% for p in publies %}
			<li>
				<span class="dc-cat dc-cat-{{ p.categorie }}">{{ p.categorieLibelle }}</span>
				<span class="dc-pub-nom" title="{{ p.nom }}">{{ p.nom }}</span>
				<small>{{ p.publieLe|date('d/m/Y') }}{{ p.commande ? ' · ' ~ p.commande.numero }} · {{ p.taille|taille_octets }}</small>
				{% if retirer|default(false) %}
					<form method="post" action="{{ path('app_dossiers_clients_retirer_publication', {id: p.id}) }}" data-dc-confirmer="Le client ne verra plus ce fichier dans son espace. Le fichier de l'atelier n'est pas touché.">
						<input type="hidden" name="_token" value="{{ csrf_token('dossiers-clients') }}"><input type="hidden" name="base" value="{{ base }}">
						<button class="dc-lien-danger">Retirer</button>
					</form>
				{% endif %}
			</li>
		{% endfor %}
	</ul>
{% endif %}
