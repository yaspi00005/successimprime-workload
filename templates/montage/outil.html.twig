    if(G.dpi){const d=Math.round(G.dpi);if(d>=300)ck.push(['ok',`Résolution ${d} dpi`,'Qualité d\'impression correcte.']);else if(d>=200){bump('warn');ck.push(['warn',`Résolution ${d} dpi`,'Acceptable en petit format, légèrement flou de près. 300 dpi recommandés.'])}else{bump('bad');ck.push(['bad',`Résolution ${d} dpi : trop faible`,'L\'impression sera floue. Demandez un fichier plus grand ou un PDF vectoriel.'])}}
