function drawMarks(page,L){if(!S.marks)return;const H=L.H;const k=PDFLib.cmyk(0,0,0,1);marks(L).forEach(l=>page.drawLine({start:{x:l[0]*PT,y:(H-l[1])*PT},end:{x:l[2]*PT,y:(H-l[3])*PT},thickness:0.25,color:k}))}
