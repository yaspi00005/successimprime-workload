{% extends 'base.html.twig' %}

{% set token = csrf_token(jeton) %}

{% block title %}Paie · {{ b.utilisateur|nom_pointage }}{% endblock %}

{% block header_actions %}
	<li class="nav-item"><a href="{{ path('app_paie_index', {mois: b.mois|date('Y-m')}) }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-arrow-left me-1"></i>Paie de {{ libelleMois }}</a></li>
{% endblock %}

{% block body %}
	<div class="si-py si-py-voir">
		<section class="card si-ac-bloc">
			{% include 'paie/_bulletin.html.twig' with {retirer: b.modifiable} %}
		</section>

		<aside>
			{% if b.modifiable %}
				<section class="card si-ac-bloc">
					<h2>Compléter</h2>
					{% if absences > 0 %}<p class="si-pg-note">Absence{{ absences > 1 ? 's' }} acceptée{{ absences > 1 ? 's' }} ce mois : {{ absences|number_format(1, ',')|replace({',0': ''}) }} j. Ajoutez une retenue si elle n'est pas payée.</p>{% endif %}
					<form method="post" action="{{ path('app_paie_agir', {id: b.id, action: 'ligne'}) }}" class="si-py-form">
						<input type="hidden" name="_token" value="{{ token }}">
						<label>Ligne<select name="type" class="form-select form-select-sm">{% for k, v in types %}<option value="{{ k }}">{{ v }}</option>{% endfor %}</select></label>
						<label>Détail<input name="libelle" maxlength="120" class="form-control form-control-sm" placeholder="Facultatif"></label>
						<label>Montant (F)<input name="montant" inputmode="numeric" class="form-control form-control-sm" required placeholder="10 000"></label>
						<button class="btn btn-primary btn-sm">Ajouter</button>
					</form>
					<p class="si-pg-note">Le sens suit la ligne : une prime ajoute, une retenue enlève. Pour « Autre », tapez « - » devant une retenue.</p>
					<form method="post" action="{{ path('app_paie_agir', {id: b.id, action: 'base'}) }}" class="si-py-form mt-2">
						<input type="hidden" name="_token" value="{{ token }}">
						<label>Salaire de base (F)<input name="salaire" inputmode="numeric" class="form-control form-control-sm" value="{{ b.salaireBase }}"></label>
						<button class="btn btn-light btn-sm si-btn-entete">Corriger</button>
					</form>
					<form method="post" action="{{ path('app_paie_agir', {id: b.id, action: 'valider'}) }}" class="mt-3">
						<input type="hidden" name="_token" value="{{ token }}">
						<button class="btn btn-success w-100">Valider le bulletin</button>
					</form>
				</section>
			{% elseif b.etat == 'valide' %}
				<section class="card si-ac-bloc">
					<h2>Payer</h2>
					<p class="si-pg-note">À verser le {{ versement|date('d/m/Y') }} par {{ {orange_money: 'Orange Money', virement: 'virement', especes: 'espèces'}[reglage('paie', 'mode')] ?? 'Orange Money' }}.</p>
					{% if comptes is not empty %}
						<form method="post" action="{{ path('app_paie_payer', {id: b.id}) }}" class="si-py-form">
							<input type="hidden" name="_token" value="{{ token }}">
							<label>Compte qui paie<select name="compte" class="form-select form-select-sm" required><option value="">—</option>{% for c in comptes %}<option value="{{ c.id }}"{{ reglage('paie', 'mode') == 'orange_money' and 'orange' in c.nom|lower ? ' selected' }}>{{ c.nom }}</option>{% endfor %}</select></label>
							<button class="btn btn-primary btn-sm">Payer {{ b.net|number_format(0, ',', ' ') }} F</button>
						</form>
					{% else %}
						<p class="si-pg-note">Le paiement se fait par une personne qui a le droit « Dépenses et recettes ».</p>
					{% endif %}
					<form method="post" action="{{ path('app_paie_agir', {id: b.id, action: 'rouvrir'}) }}" class="mt-2">
						<input type="hidden" name="_token" value="{{ token }}">
						<button class="btn btn-link btn-sm p-0">Remettre en brouillon pour corriger</button>
					</form>
				</section>
			{% endif %}
		</aside>
	</div>
{% endblock %}
