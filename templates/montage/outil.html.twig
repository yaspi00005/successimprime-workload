{# Outil de montage fourni par Yaya (docs/montage-impression.md), intégré tel quel : bibliothèques servies par l'application, téléchargement normal, réglages et fichier de la ligne préremplis. #}
{% verbatim %}<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Montage d'impression{% endverbatim %}{{ ligne ? ' · ' ~ config.titre }}{% verbatim %}</title>
<style>
/* Layout: atelier bench — réglages à gauche, feuille à l'échelle au centre, faisabilité à droite */
:root{
  --bg:#eef1f6; --panel:#ffffff; --ink:#14213d; --muted:#5b6478; --line:#dfe4ee; --soft:#f4f6fa;
  --blue:#0F4590; --red:#DE1028; --yellow:#FDC82A; --cyan:#2A93D5; --pink:#E8398A;
  --ok:#1a8f4a; --warn:#c46a12; --bad:#c81d34; --okbg:#e5f4ea; --warnbg:#fdf0e1; --badbg:#fde6e9;
  --sheet:#ffffff; --stage:#dde2eb; --cut:#2A93D5; --bleed:rgba(222,16,40,.10);
  --f-display:"Archivo","Arial Narrow",Arial,sans-serif; --f-body:"Figtree",system-ui,-apple-system,"Segoe UI",sans-serif;
}
@media (prefers-color-scheme: dark){:root:not([data-theme="light"]){
  --bg:#0f1420; --panel:#171e2c; --ink:#e7ecf5; --muted:#9aa5bb; --line:#283247; --soft:#1d2536;
  --blue:#5b8fe0; --okbg:#173326; --warnbg:#3a2a15; --badbg:#3c1820; --ok:#4cc27c; --warn:#f0a050; --bad:#ff6b7f;
  --sheet:#fbfbf8; --stage:#0b0f18; --cut:#3aa6ea; color-scheme:dark}}
:root[data-theme="dark"]{
  --bg:#0f1420; --panel:#171e2c; --ink:#e7ecf5; --muted:#9aa5bb; --line:#283247; --soft:#1d2536;
  --blue:#5b8fe0; --okbg:#173326; --warnbg:#3a2a15; --badbg:#3c1820; --ok:#4cc27c; --warn:#f0a050; --bad:#ff6b7f;
  --sheet:#fbfbf8; --stage:#0b0f18; --cut:#3aa6ea; color-scheme:dark}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{background:var(--bg);color:var(--ink);font-family:var(--f-body);font-size:14px;margin:0}
.wrap{padding-inline:16px;padding-block:14px 28px;max-width:1500px;margin:0 auto}
header{display:flex;align-items:center;gap:14px;flex-wrap:wrap;margin-bottom:14px}
header img{height:38px;background:#fff;border-radius:8px;padding:3px 6px}
header h1{font-family:var(--f-display);font-weight:800;font-size:22px;margin:0;letter-spacing:-.2px}
header p{margin:0;color:var(--muted);font-size:13px}
.grid{display:grid;grid-template-columns:310px minmax(0,1fr) 330px;gap:14px;align-items:start}
@media (max-width:1180px){.grid{grid-template-columns:300px minmax(0,1fr)}.right{grid-column:1 / -1;display:grid;grid-template-columns:1fr 1fr;gap:14px}}
@media (max-width:760px){.grid{grid-template-columns:minmax(0,1fr)}.right{grid-template-columns:minmax(0,1fr)}.stagebox{order:-1}}
.card{background:var(--panel);border:1px solid var(--line);border-radius:14px;padding:14px}
.left,.right{display:flex;flex-direction:column;gap:12px;min-width:0}
.right{display:flex}
@media (max-width:1180px){.right{display:grid}}
h2{font-family:var(--f-display);font-size:13px;font-weight:800;text-transform:uppercase;letter-spacing:.7px;margin:0 0 10px;color:var(--muted)}
label{display:block;font-size:12px;font-weight:600;color:var(--muted);margin-bottom:4px}
.row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:8px}
.f{margin-bottom:10px}
input[type=number],select,input[type=text]{width:100%;height:34px;border:1.5px solid var(--line);border-radius:9px;background:var(--soft);color:var(--ink);font:inherit;padding:0 9px;font-variant-numeric:tabular-nums}
input:focus-visible,select:focus-visible,button:focus-visible{outline:2px solid var(--cyan);outline-offset:1px}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg button{flex:1 1 auto;height:32px;border:1.5px solid var(--line);background:var(--soft);color:var(--ink);border-radius:9px;font:600 13px var(--f-body);cursor:pointer;padding:0 10px}
.seg button[aria-pressed="true"]{background:var(--blue);border-color:var(--blue);color:#fff}
.chk{display:flex;align-items:center;gap:8px;font-size:13px;margin:6px 0;color:var(--ink);font-weight:500}
.chk input{width:16px;height:16px;accent-color:var(--blue)}
.file{border:1.5px dashed var(--line);border-radius:12px;padding:10px;display:flex;gap:10px;align-items:center;background:var(--soft)}
.file .th{width:54px;height:54px;border-radius:8px;background:var(--line) center/contain no-repeat;flex:0 0 54px}
.file b{font-size:13px;display:block;word-break:break-all}
.file small{color:var(--muted);font-size:12px;display:block;line-height:1.4}
.btn{height:34px;border-radius:9px;border:1.5px solid var(--line);background:var(--panel);color:var(--ink);font:600 13px var(--f-body);cursor:pointer;padding:0 12px;display:inline-flex;align-items:center;gap:6px}
.btn.pri{background:var(--red);border-color:var(--red);color:#fff}
.btn.blue{background:var(--blue);border-color:var(--blue);color:#fff}
.btn[disabled]{opacity:.5;cursor:not-allowed}
.btns{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.hint{font-size:12px;color:var(--muted);line-height:1.45;margin:6px 0 0}
.stagebox{min-width:0}
.bar{display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-bottom:10px}
.bar .sum{font-family:var(--f-display);font-weight:800;font-size:18px}
.bar .sp{flex:1}
.stage{background:var(--stage);border-radius:12px;padding:14px;display:flex;justify-content:center;align-items:center;min-height:420px}
.stage svg{width:100%;max-height:74vh;height:auto;display:block}
.dims{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:12.5px;color:var(--muted);margin-top:10px;font-variant-numeric:tabular-nums}
.dims b{color:var(--ink)}
.verdict{border-radius:12px;padding:12px 14px;display:flex;gap:12px;align-items:center}
.verdict .ic{width:38px;height:38px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-weight:900;font-size:20px;color:#fff;flex:0 0 38px}
.verdict b{font-family:var(--f-display);font-size:17px;display:block}
.verdict span{font-size:12.5px;color:var(--muted)}
.v-ok{background:var(--okbg)}.v-ok .ic{background:var(--ok)}
.v-warn{background:var(--warnbg)}.v-warn .ic{background:var(--warn)}
.v-bad{background:var(--badbg)}.v-bad .ic{background:var(--bad)}
ul.checks{list-style:none;margin:10px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}
ul.checks li{display:grid;grid-template-columns:20px 1fr;gap:8px;font-size:13px;line-height:1.4}
ul.checks i{font-style:normal;width:20px;height:20px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:900;color:#fff}
.i-ok{background:var(--ok)}.i-warn{background:var(--warn)}.i-bad{background:var(--bad)}.i-info{background:var(--cyan)}
ul.checks small{display:block;color:var(--muted);font-size:12px}
table{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
th{text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.5px;color:var(--muted);font-weight:700;padding:6px 4px;border-bottom:1px solid var(--line)}
td{padding:7px 4px;border-bottom:1px solid var(--line)}
td.n,th.n{text-align:right}
tr.best td{font-weight:700}
tr.best td:first-child::after{content:" ★";color:var(--warn)}
.kv{display:grid;grid-template-columns:1fr auto;gap:6px 10px;font-size:13px;font-variant-numeric:tabular-nums}
.kv span{color:var(--muted)}
.msg{font-size:12.5px;margin-top:8px;color:var(--muted);min-height:1em}
details summary{cursor:pointer;font-weight:700;font-size:13px;color:var(--blue)}
.tag{display:inline-block;font-size:11px;font-weight:700;padding:2px 8px;border-radius:999px;background:var(--soft);color:var(--muted);border:1px solid var(--line)}
@media (prefers-reduced-motion:no-preference){.cellimg{transition:opacity .2s}}
</style>

<div class="wrap">
<header>
  <img src="data:image/png;base64," alt="Succès Imprim">
  <div><h1>Montage d'impression</h1><p>Imposer un fichier sur une feuille A4, A3 ou SRA3, vérifier la faisabilité, exporter le PDF prêt à imprimer.</p></div>
  <nav class="si-retour">{% endverbatim %}
    {% if ligne %}<span class="si-ligne">{{ config.titre }}</span>{% endif %}
    {% if ligne %}<button class="btn" id="siRanger" type="button" disabled title="Exportez d'abord le PDF du montage">Ranger dans la commande</button>{% endif %}
    <a class="btn" href="{{ ligne ? path('app_controle_pre_presse_controler', {id: ligne.id}) : path('app_conception_tableau') }}">Retour {{ ligne ? 'au travail' : 'à l\'atelier' }}</a>
  {% verbatim %}</nav>
  <p class="msg" id="siMsg" role="status"></p>
</header>

<div class="grid">
<!-- ===== Réglages ===== -->
<div class="left">
  <section class="card">
    <h2>1 · Feuille d'impression</h2>
    <div class="f" id="siMachineF" hidden style="margin-bottom:10px"><label for="siMachine">Machine</label><select id="siMachine"></select></div>
    <div class="seg" id="sheetSeg"></div>
    <div class="row f" id="customSheet" hidden style="margin-top:8px">
      <div><label for="sw">Largeur (mm)</label><input id="sw" type="number" min="50" max="1000" step="1" value="210"></div>
      <div><label for="sh">Hauteur (mm)</label><input id="sh" type="number" min="50" max="1500" step="1" value="297"></div>
    </div>
    <div class="f" style="margin-top:10px"><label>Orientation de la feuille</label><div class="seg" id="orientSeg"></div></div>
    <div class="f"><label for="margin">Marge non imprimable de la machine (mm)</label><input id="margin" type="number" min="0" max="20" step="0.5" value="5"></div>
  </section>

  <section class="card">
    <h2>2 · Fichier à monter</h2>
    <div class="file"><div class="th" id="rectoTh"></div><div style="min-width:0"><b id="rectoName">—</b><small id="rectoInfo"></small></div></div>
    <div class="btns">
      <label class="btn blue" for="rectoIn" style="margin:0;color:#fff">Choisir un fichier</label>
      <input id="rectoIn" type="file" accept="application/pdf,image/png,image/jpeg" hidden>
      <button class="btn" id="sampleBtn" type="button">Exemple carte de visite</button>
    </div>
    <p class="hint">PDF (vectoriel conservé), JPG ou PNG. Un PDF avec TrimBox est détecté avec son fond perdu.</p>
    <div class="f" style="margin-top:10px"><label for="fmt">Format fini</label><select id="fmt"></select></div>
    <div class="row f" id="customFmt" hidden>
      <div><label for="tw">Largeur (mm)</label><input id="tw" type="number" min="10" max="1000" step="0.5" value="85"></div>
      <div><label for="th">Hauteur (mm)</label><input id="th" type="number" min="10" max="1000" step="0.5" value="55"></div>
    </div>
    <details style="margin-top:4px"><summary>Verso (recto-verso)</summary>
      <div class="file" style="margin-top:8px"><div class="th" id="versoTh"></div><div style="min-width:0"><b id="versoName">Pas de verso</b><small id="versoInfo">Le PDF aura une seule page</small></div></div>
      <div class="btns">
        <label class="btn" for="versoIn" style="margin:0">Choisir le verso</label>
        <input id="versoIn" type="file" accept="application/pdf,image/png,image/jpeg" hidden>
        <button class="btn" id="sampleVerso" type="button">Exemple</button>
        <button class="btn" id="noVerso" type="button">Retirer</button>
      </div>
      <p class="hint">Grille centrée : chaque verso tombe derrière son recto avec un retournement bord long. Les poses tournées sont pivotées dans l'autre sens au verso.</p>
    </details>
  </section>

  <section class="card">
    <h2>3 · Redimensionner et retoucher</h2>
    <div class="f"><label>Adapter le fichier au format fini</label><div class="seg" id="fitSeg"></div></div>
    <div class="f" id="pctBox" hidden><label for="pct">Échelle (%)</label><input id="pct" type="number" min="5" max="800" step="1" value="100"></div>
    <div class="f"><label>Rotation du fichier</label><div class="seg" id="rotSeg"></div></div>
    <div class="row f">
      <div><label for="dx">Décalage horizontal (mm)</label><input id="dx" type="number" step="0.5" value="0"></div>
      <div><label for="dy">Décalage vertical (mm)</label><input id="dy" type="number" step="0.5" value="0"></div>
    </div>
    <div class="f"><label>Créer le fond perdu manquant</label><div class="seg" id="bgenSeg"></div></div>
    <label class="chk"><input type="checkbox" id="mirror"> Miroir horizontal (transfert, sublimation, DTF)</label>
  </section>

  <section class="card">
    <h2>4 · Pose et coupe</h2>
    <div class="row f">
      <div><label for="bleed">Fond perdu (mm)</label><input id="bleed" type="number" min="0" max="10" step="0.5" value="2"></div>
      <div><label for="target">Poses souhaitées</label><input id="target" type="number" min="0" max="500" step="1" value="10"></div>
    </div>
    <div class="f"><label>Mode de coupe</label><div class="seg" id="cutSeg"></div></div>
    <div class="f" id="gapBox" hidden><label for="gap">Espace entre deux fonds perdus (mm)</label><input id="gap" type="number" min="0" max="30" step="0.5" value="2"></div>
    <label class="chk"><input type="checkbox" id="rotate" checked> Tourner les poses si ça en loge plus</label>
    <label class="chk"><input type="checkbox" id="marks" checked> Traits de coupe dans le PDF</label>
    <label class="chk"><input type="checkbox" id="guides" checked> Lignes de coupe sur l'aperçu</label>
  </section>

  <section class="card">
    <h2>5 · Production</h2>
    <div class="row">
      <div><label for="qty">Quantité à livrer</label><input id="qty" type="number" min="1" step="1" value="500"></div>
      <div><label for="waste">Gâche (%)</label><input id="waste" type="number" min="0" max="50" step="1" value="3"></div>
    </div>
  </section>
</div>

<!-- ===== Aperçu ===== -->
<div class="stagebox card">
  <div class="bar"><span class="sum" id="sum">—</span><span class="tag" id="sumTag"></span><span class="sp"></span><div class="seg" id="viewSeg" style="flex:0 0 auto"></div></div>
  <div class="stage" id="stage"></div>
  <div class="dims" id="dims"></div>
</div>

<!-- ===== Faisabilité ===== -->
<div class="right">
  <section class="card">
    <h2>Faisabilité</h2>
    <div class="verdict" id="verdict"></div>
    <ul class="checks" id="checks"></ul>
  </section>
  <section class="card">
    <h2>Production</h2>
    <div class="kv" id="prod"></div>
  </section>
  <section class="card">
    <h2>Comparer les feuilles</h2>
    <div style="overflow-x:auto"><table id="cmp"></table></div>
    <p class="hint">Mêmes réglages de fond perdu, de marge et de coupe. Vérifiez que la machine accepte le SRA3.</p>
  </section>
  <section class="card">
    <h2>Exporter</h2>
    <div class="btns" style="margin-top:0">
      <button class="btn pri" id="expMontage" type="button">PDF du montage</button>
      <button class="btn" id="expSingle" type="button">Fichier redimensionné seul</button>
    </div>
    <p class="msg" id="expMsg" role="status"></p>
  </section>
</div>
</div>
</div>

{% endverbatim %}<script src="{{ asset('vendor/montage/pdf-lib.min.js') }}"></script>
<script>window.SI_MONTAGE = {{ config|json_encode|raw }}; window.SI_PDFJS = {lib: {{ asset('vendor/montage/pdf.min.js')|json_encode|raw }}, worker: {{ asset('vendor/montage/pdf.worker.min.js')|json_encode|raw }}};</script>{% verbatim %}
<script>
(function(){
const PT=72/25.4;
const SHEETS={A4:[210,297],A3:[297,420],SRA3:[320,450],A5:[148,210]};
const FMTS=[['cv','Carte de visite 85 × 55',85,55],['cv90','Carte de visite 90 × 50',90,50],['pvc','Badge PVC 85,6 × 54',85.6,54],['a7','A7 74 × 105',74,105],['a6','A6 105 × 148',105,148],['a5','A5 148 × 210',148,210],['dl','Flyer DL 99 × 210',99,210],['a4','A4 210 × 297',210,297],['custom','Personnalisé',0,0]];
const S={sheet:'A4',sw:210,sh:297,orient:'auto',margin:5,fmt:'cv',tw:85,th:55,bleed:2,target:10,cut:'common',gap:2,rotate:true,marks:true,guides:true,qty:500,waste:3,fit:'cover',pct:100,frot:0,dx:0,dy:0,bgen:'enlarge',mirror:false,view:'recto'};
const files={recto:null,verso:null};
const $=id=>document.getElementById(id);
const fmtN=(v,d)=>(Math.round(v*Math.pow(10,d||1))/Math.pow(10,d||1)).toLocaleString('fr-FR');
const esc=s=>String(s).replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));

/* ---------- segmented controls ---------- */
function seg(id,key,opts,after){const el=$(id);el.innerHTML='';opts.forEach(o=>{const b=document.createElement('button');b.type='button';b.textContent=o[1];b.setAttribute('aria-pressed',String(S[key]===o[0]));b.onclick=()=>{S[key]=o[0];[...el.children].forEach(c=>c.setAttribute('aria-pressed','false'));b.setAttribute('aria-pressed','true');after&&after();update();};el.appendChild(b);});}
seg('sheetSeg','sheet',[['A4','A4'],['A3','A3'],['SRA3','SRA3'],['custom','Perso']],()=>{$('customSheet').hidden=S.sheet!=='custom'});
seg('orientSeg','orient',[['auto','Auto'],['p','Portrait'],['l','Paysage']]);
seg('cutSeg','cut',[['common','Coupe commune'],['sep','Coupe séparée']],()=>{$('gapBox').hidden=S.cut!=='sep'});
seg('fitSeg','fit',[['cover','Remplir'],['contain','Ajuster'],['stretch','Étirer'],['manual','Échelle %']],()=>{$('pctBox').hidden=S.fit!=='manual'});
seg('rotSeg','frot',[[0,'0°'],[90,'90°'],[180,'180°'],[270,'270°']]);
seg('bgenSeg','bgen',[['none','Non'],['enlarge','Agrandir'],['mirror','Miroir des bords']]);
seg('viewSeg','view',[['recto','Recto'],['verso','Verso']]);
const fsel=$('fmt');FMTS.forEach(f=>{const o=document.createElement('option');o.value=f[0];o.textContent=f[1];fsel.appendChild(o)});
fsel.onchange=()=>{S.fmt=fsel.value;const f=FMTS.find(x=>x[0]===S.fmt);if(S.fmt!=='custom'){S.tw=f[2];S.th=f[3];$('tw').value=S.tw;$('th').value=S.th}$('customFmt').hidden=S.fmt!=='custom';update()};
[['sw','sw'],['sh','sh'],['margin','margin'],['tw','tw'],['th','th'],['bleed','bleed'],['target','target'],['gap','gap'],['qty','qty'],['waste','waste'],['pct','pct'],['dx','dx'],['dy','dy']].forEach(([id,k])=>{$(id).addEventListener('input',()=>{const v=parseFloat($(id).value);if(!isNaN(v)){S[k]=v;update()}})});
[['rotate','rotate'],['marks','marks'],['guides','guides'],['mirror','mirror']].forEach(([id,k])=>{$(id).addEventListener('change',()=>{S[k]=$(id).checked;update()})});
function setSeg(id,key){[...$(id).children].forEach((b,i)=>b.setAttribute('aria-pressed',String(b.textContent && S[key]!==undefined && b.dataset.v===undefined && false)));}

/* ---------- layout engine ---------- */
function sheetDims(name){if(name==='custom')return [S.sw,S.sh];return SHEETS[name]}
// returns best layout for given params
function bestLayout(p){
  const [a,b]=p.sheetWH;const sheetOpts=p.orient==='p'?[[Math.min(a,b),Math.max(a,b)]]:p.orient==='l'?[[Math.max(a,b),Math.min(a,b)]]:[[Math.min(a,b),Math.max(a,b)],[Math.max(a,b),Math.min(a,b)]];
  const e=p.cut==='common'?0:2*p.bleed+p.gap;let best=null;
  for(const [W,H] of sheetOpts){for(const rot of (p.rotate?[false,true]:[false])){
    const cw=rot?p.th:p.tw,ch=rot?p.tw:p.th;const Wp=W-2*p.margin,Hp=H-2*p.margin;
    const cols=Math.max(0,Math.floor((Wp-2*p.bleed+e+1e-9)/(cw+e))),rows=Math.max(0,Math.floor((Hp-2*p.bleed+e+1e-9)/(ch+e)));
    const n=cols*rows;const bw=cols*cw+(cols-1)*e+2*p.bleed,bh=rows*ch+(rows-1)*e+2*p.bleed;
    const slack=Math.min(Wp-bw,Hp-bh);
    const L={W,H,rot,cw,ch,cols,rows,n,e,bw,bh,x0:(W-bw)/2+p.bleed,y0:(H-bh)/2+p.bleed,slack};
    if(!best||n>best.n||(n===best.n&&n>0&&(!L.rot&&best.rot||L.slack>best.slack+0.01&&L.rot===best.rot)))best=L;}}
  return best;
}
function params(over){return Object.assign({sheetWH:sheetDims(S.sheet),orient:S.orient,margin:S.margin,tw:S.tw,th:S.th,bleed:S.bleed,cut:S.cut,gap:S.gap,rotate:S.rotate},over||{})}
function cells(L){const out=[];for(let r=0;r<L.rows;r++)for(let c=0;c<L.cols;c++){const x=L.x0+c*(L.cw+L.e),y=L.y0+r*(L.ch+L.e);
  const common=S.cut==='common';out.push({x,y,w:L.cw,h:L.ch,c,r,
  clip:{x:x-((common&&c>0)?0:S.bleed),y:y-((common&&r>0)?0:S.bleed),x2:x+L.cw+((common&&c<L.cols-1)?0:S.bleed),y2:y+L.ch+((common&&r<L.rows-1)?0:S.bleed)}})}return out}

/* ---------- content geometry (redimensionnement) ---------- */
function geom(F){
  if(!F)return null;const sw=(S.frot===90||S.frot===270);
  let fw=sw?F.hmm:F.wmm,fh=sw?F.wmm:F.hmm,fbx=sw?F.fby:F.fbx,fby=sw?F.fbx:F.fby;
  const tfw=fw*(1-2*fbx),tfh=fh*(1-2*fby);let sx,sy;const notes=[];
  if(S.fit==='cover'){sx=sy=Math.max(S.tw/tfw,S.th/tfh)}else if(S.fit==='contain'){sx=sy=Math.min(S.tw/tfw,S.th/tfh)}else if(S.fit==='stretch'){sx=S.tw/tfw;sy=S.th/tfh}else{sx=sy=S.pct/100}
  let dw=fw*sx,dh=fh*sy;let mirrorExt=0;let enl=1;
  const ebx=()=>(dw-S.tw)/2-Math.abs(S.dx),eby=()=>(dh-S.th)/2-Math.abs(S.dy);
  const missing=S.bleed>0&&(ebx()<S.bleed-0.05||eby()<S.bleed-0.05);
  let gen=S.bgen;if(gen==='mirror'&&F.kind==='pdf'&&missing){gen='enlarge';notes.push('pdfmirror')}
  if(missing&&gen==='enlarge'&&S.fit!=='contain'){const k=Math.max((S.tw+2*S.bleed+2*Math.abs(S.dx))/dw,(S.th+2*S.bleed+2*Math.abs(S.dy))/dh);if(k>1){dw*=k;dh*=k;sx*=k;sy*=k;enl=k}}
