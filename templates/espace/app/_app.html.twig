{#
	Espace client connecté (maquettes 13 à 19) : en-tête, contenu et
	barre d'onglets en bas sur téléphone ; menu à gauche sur ordinateur.
#}
{% set prenom = moi.prenom ?: moi.nom ?: moi.raisonSociale %}
{% set onglets = [
	{cle: 'accueil', route: 'app_espace_accueil', libelle: 'Accueil', icone: 'M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z'},
	{cle: 'commandes', route: 'app_espace_commandes', libelle: 'Commandes', icone: 'M6 2h9l5 5v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1zm8 1.5V8h4.5M8 12h8M8 16h8'},
	{cle: 'fichiers', route: 'app_espace_fichiers', libelle: 'Fichiers', icone: 'M3 6a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z'},
	{cle: 'factures', route: 'app_espace_factures', libelle: 'Factures', icone: 'M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2zM8 8h8M8 12h8M8 16h5'},
	{cle: 'compte', route: 'app_espace_compte', libelle: 'Compte', icone: 'M12 12a4.5 4.5 0 1 0 0-9 4.5 4.5 0 0 0 0 9zm-8 9a8 8 0 0 1 16 0'},
] %}
<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
	<meta name="theme-color" content="#F4F6FA">
	<meta name="robots" content="noindex">
	<title>{% block title %}Mon espace{% endblock %} · Succès Imprim</title>
	<link rel="shortcut icon" type="image/png" href="{{ asset('theme/images/favicon.png') }}">
	<link href="{{ asset('css/espace-app.css') }}" rel="stylesheet">
</head>
<body class="ec">
	<nav class="ec-menu" aria-label="Espace client">
		<a href="{{ path('app_espace_accueil') }}" class="ec-menu-logo"><img src="{{ asset('images/logo-succes-imprim.png') }}" alt="Succès Imprim"></a>
		{% for o in onglets %}
			<a href="{{ path(o.route) }}" class="ec-onglet{{ onglet|default('') == o.cle ? ' actif' }}"{{ onglet|default('') == o.cle ? ' aria-current="page"' }}>
				<svg viewBox="0 0 24 24" aria-hidden="true"><path d="{{ o.icone }}"/></svg><span>{{ o.libelle }}</span>
			</a>
		{% endfor %}
		<a href="{{ path('app_espace_deconnexion') }}" class="ec-menu-sortie">Se déconnecter</a>
	</nav>

	<div class="ec-page">
		<header class="ec-entete">
			{% block entete %}
				<a href="{{ path('app_espace_accueil') }}" class="ec-entete-logo"><img src="{{ asset('images/logo-succes-imprim.png') }}" alt="Succès Imprim"></a>
			{% endblock %}
			<div class="ec-entete-droite">
				<a href="{{ path('app_espace_notifications') }}" class="ec-cloche" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 16V11a6 6 0 1 1 12 0v5l2 2H4zM10 20a2 2 0 0 0 4 0"/></svg></a>
				<a href="{{ path('app_espace_compte') }}" class="ec-avatar" aria-label="Mon compte">{{ prenom|slice(0, 1)|upper }}</a>
			</div>
		</header>

		<main class="ec-contenu">
			{% for message in app.flashes('succes') %}<div class="ec-flash ec-flash-ok" role="status">{{ message }}</div>{% endfor %}
			{% for message in app.flashes('error') %}<div class="ec-flash ec-flash-erreur" role="alert">{{ message }}</div>{% endfor %}
			{% block contenu %}{% endblock %}
		</main>
	</div>
	{% block scripts %}{% endblock %}
</body>
</html>
