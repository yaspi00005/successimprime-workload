{% extends 'base.html.twig' %}

{% block title %}
	Paramètres de paiement
{% endblock %}

{% block body %}
	<div class="page-header">
		<div>
			<h1 class="page-title">
				Paramètres de paiement
			</h1>

			<p class="text-muted mb-0">
				Frais payés par le client en plus du montant quand il paie par Orange Money
				(ou par Wave, si la case est cochée). Ils restent sur le paiement : ni le prix
				de la commande ni la facture ne changent. Les taux partent aussi sur le site en
				ligne, pour le paiement Orange Money de l’espace client.
			</p>
		</div>
	</div>

	{% for message in app.flashes('success') %}
		<div class="alert alert-success">
			<i class="fa fa-check-circle mr-1"></i>
			{{ message }}
		</div>
	{% endfor %}

	{% if not form.vars.valid %}
		<div class="alert alert-danger">
			<strong>Le formulaire contient des erreurs.</strong>
			{{ form_errors(form) }}
		</div>
	{% endif %}

	<div class="row justify-content-center">
		<div class="col-xl-6 col-lg-8">
			<div class="card">
				<div class="card-header">
					<h3 class="card-title">
						Frais mobile money
					</h3>
				</div>

				<div class="card-body">
					{{ form_start(form) }}

					{% for champ in [form.tauxFondsSoutien, form.tauxFraisRetrait] %}
						<div class="form-group">
							{{ form_label(champ) }}
							{{ form_widget(champ) }}
							<small class="form-text text-muted">
								{{ champ.vars.help }}
							</small>
							{{ form_errors(champ) }}
						</div>
					{% endfor %}

					<div class="text-right">
						<button type="submit" class="btn btn-primary">
							<i class="fa fa-check-circle mr-1"></i>
							Enregistrer
						</button>
					</div>

					{{ form_end(form) }}
				</div>
			</div>
		</div>
	</div>
{% endblock %}
