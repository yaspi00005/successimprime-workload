{% extends 'base.html.twig' %}

{% block title %}User index
{% endblock %}

{% block body %}
	<!-- PAGE-HEADER -->
	<div class="side-app">
	<div class="page-header">
		<ol class="breadcrumb">
			<li class="breadcrumb-item">
				<a href="#">Utilisateurs</a>
			</li>
			<li class="breadcrumb-item active" aria-current="page">Liste des Utilisateurs</li>
		</ol>
		<div>
			<button type="button" class="btn btn-primary btn-create-finition" data-bs-toggle="modal" data-bs-target="#finitionCreateModal">
				<i class="fa fa-plus mr-1"></i>
				Ajouter une finition
			</button>

			<button type="button" id="finitionMassPublishButton" class="btn btn-success">
				<i class="fa fa-eye mr-1"></i>
				Publier
			</button>

			<button type="button" id="finitionMassUnpublishButton" class="btn btn-warning">
				<i class="fa fa-eye-slash mr-1"></i>
				Dépublier
			</button>

			<button type="button" id="finitionMassDeleteButton" class="btn btn-danger">
				<i class="fa fa-trash mr-1"></i>
				Supprimer
			</button>


		</div>
	</div>
	</div>
	<!-- PAGE-HEADER END -->

	<!-- ROW OPEN -->
	<div
		class="row row-cards">

		<!-- COL-END -->
		<div class="col-lg-8 col-xl-12">
			<div class="input-group mb-5">
				<input type="text" class="form-control" placeholder="">
				<div class="input-group-append ">
					<button type="button" class="btn btn-primary-light">
						<i class="fa fa-search" aria-hidden="true"></i>
					</button>
				</div>
			</div>
			<div class="card">
				<div class="card-header border-bottom-0 p-4">
					<h2 class="card-title">1 - 30 of 546 users</h2>
					<div class="page-options d-flex float-right">
						<select class="form-control custom-select w-auto">
							<option value="asc">Latest</option>
							<option value="desc">Oldest</option>
						</select>
					</div>
				</div>
				<div class="e-table">
					<div class="table-responsive table-lg br-bl-10 br-br-10">
						<input type="hidden" id="finitionMassActionUrl" value="{{ path('app_finition_mass_action') }}">

						<input type="hidden" id="finitionMassActionToken" value="{{ csrf_token('finition_mass_action') }}">
						<table class="table table-bordered mb-0">

							<thead>
								<tr>
									<th class="text-center">Ordre</th>

									<th class="text-center">
										<div class="custom-control custom-checkbox">
											<input class="custom-control-input" id="finitionCheckAll" type="checkbox">

											<label class="custom-control-label" for="finitionCheckAll"></label>
										</div>
									</th>

									<th>Nom</th>
									<th>Description</th>
									<th>Types d’impression compatibles</th>
									<th class="text-center">Statut</th>
									<th class="text-center">Actions</th>
								</tr>
							</thead>

							<tbody id="finitionSortableBody">

								{% for finition in finitions %}

									<tr id="finition-row-{{ finition.id }}" class="finition-sortable-row" data-id="{{ finition.id }}">

										<td class="text-center align-middle">
											<i class="fa fa-arrows-alt finition-drag-handle" style="cursor: move;" title="Déplacer"></i>
										</td>

										<td class="align-middle text-center">
											<div class="custom-control custom-checkbox">

												<input class="custom-control-input finition-row-check" id="finition-item-{{ finition.id }}" type="checkbox" value="{{ finition.id }}">

												<label class="custom-control-label" for="finition-item-{{ finition.id }}"></label>

											</div>
										</td>

										<td class="align-middle">
											<strong>{{ finition.nom }}</strong>
										</td>

										<td class="align-middle">
											{{ finition.description ?: '-' }}
										</td>

										<td class="align-middle">

											{% for typeImpression in finition.typesImpressions %}

												<span class="badge badge-info mb-1">
													{{ typeImpression.nom }}
												</span>

											{% else %}

												<span class="text-muted">
													Aucun type associé
												</span>

											{% endfor %}

										</td>

										<td class="text-center align-middle">

											{% if finition.publie %}

												<span class="badge badge-success">
													Publié
												</span>

											{% else %}

												<span class="badge badge-danger">
													Non publié
												</span>

											{% endif %}

										</td>

										<td class="text-center align-middle">

											<div class="btn-group align-top">

												<button type="button" class="btn btn-sm btn-primary-light btn-edit-finition" data-bs-toggle="modal" data-bs-target="#finitionEditModal" data-id="{{ finition.id }}" data-get-url="{{ path( 'app_finition_get_ajax', {id: finition.id} ) }}" data-update-url="{{ path( 'app_finition_update_ajax', {id: finition.id} ) }}" title="Modifier">
													<i class="fa fa-edit"></i>
												</button>

												<button type="button" class="btn btn-sm {{ finition.publie
																																																																																																																																															                                ? 'btn-warning-light'
																																																																																																																																															                                : 'btn-success-light'
																																																																																																																																															                            }} btn-toggle-finition" data-url="{{ path( 'app_finition_toggle_publication', {id: finition.id} ) }}" data-token="{{ csrf_token( 'toggle_finition_' ~ finition.id ) }}" data-nom="{{ finition.nom }}" data-publie="{{ finition.publie ? '1' : '0' }}" title="{{ finition.publie ? 'Dépublier' : 'Publier' }}">
													{% if finition.publie %}
														<i class="fa fa-eye-slash"></i>
													{% else %}
														<i class="fa fa-eye"></i>
													{% endif %}
												</button>

												<button type="button" class="btn btn-sm btn-danger-light btn-delete-finition" data-url="{{ path( 'app_finition_delete_ajax', {id: finition.id} ) }}" data-token="{{ csrf_token( 'delete_finition_' ~ finition.id ) }}" data-nom="{{ finition.nom }}" title="Supprimer">
													<i class="fa fa-trash"></i>
												</button>

											</div>

										</td>

									</tr>

								{% else %}

									<tr>
										<td colspan="7" class="text-center">
											Aucune finition trouvée
										</td>
									</tr>

								{% endfor %}

							</tbody>
						</table>
					</div>
				</div>
			</div>

		</div>
		<!-- COL-END -->
		<div class="modal fade" id="finitionCreateModal" tabindex="-1" role="dialog" aria-hidden="true">

			<div class="modal-dialog modal-lg" role="document">
				<div class="modal-content">

					<div class="modal-header">
						<h5 class="modal-title">
							Ajouter une finition
						</h5>

						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>

					<div class="modal-body">

						<input type="hidden" id="finitionCreateUrl" value="{{ path('app_finition_create_ajax') }}">

						<input type="hidden" id="finitionCreateToken" value="{{ csrf_token('create_finition') }}">

						<div class="form-group">
							<label for="finitionCreateNom" class="form-label">
								Nom de la finition
							</label>

							<input type="text" id="finitionCreateNom" class="form-control" placeholder="Exemple : Pelliculage brillant" autocomplete="off">
						</div>

						<div class="form-group">
							<label for="finitionCreateDescription" class="form-label">
								Description
							</label>

							<textarea id="finitionCreateDescription" class="form-control" rows="3" placeholder="Expliquez l’utilisation de cette finition"></textarea>
						</div>

						<div class="form-group">
							<div class="form-label">
								Types d’impression compatibles
							</div>

							<div class="selectgroup selectgroup-pills">

								{% for typeImpression in typesImpressions %}
									<label class="selectgroup-item">
										<input type="checkbox" value="{{ typeImpression.id }}" class="selectgroup-input finition-create-type-impression">

										<span class="selectgroup-button">
											{{ typeImpression.nom }}
										</span>
									</label>
								{% else %}
									<span class="text-muted">
										Aucun type d’impression disponible
									</span>
								{% endfor %}

							</div>
						</div>

						<div class="form-group mb-0">
							<label class="custom-switch">

								<input type="checkbox" id="finitionCreatePublie" class="custom-switch-input" checked>

								<span class="custom-switch-indicator"></span>

								<span class="custom-switch-description">
									Publier cette finition
								</span>

							</label>
						</div>

					</div>

					<div class="modal-footer">

						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
							Annuler
						</button>

						<button type="button" class="btn btn-primary" id="finitionCreateSaveButton">

							<i class="fa fa-save mr-1"></i>
							Enregistrer
						</button>

					</div>

				</div>
			</div>
		</div>
		<div class="modal fade" id="finitionEditModal" tabindex="-1" role="dialog" aria-hidden="true">

			<div class="modal-dialog modal-lg" role="document">
				<div class="modal-content">

					<div class="modal-header">
						<h5 class="modal-title">
							Modifier la finition
						</h5>

						<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
					</div>

					<div class="modal-body">

						<input type="hidden" id="finitionEditUpdateUrl">
						<input type="hidden" id="finitionEditId">

						<div class="form-group">
							<label for="finitionEditNom" class="form-label">
								Nom de la finition
							</label>

							<input type="text" id="finitionEditNom" class="form-control" placeholder="Nom de la finition">
						</div>

						<div class="form-group">
							<label for="finitionEditDescription" class="form-label">
								Description
							</label>

							<textarea id="finitionEditDescription" class="form-control" rows="3"></textarea>
						</div>

						<div class="form-group">
							<div class="form-label">
								Types d’impression compatibles
							</div>

							<div class="selectgroup selectgroup-pills">

								{% for typeImpression in typesImpressions %}
									<label class="selectgroup-item">
										<input type="checkbox" value="{{ typeImpression.id }}" class="selectgroup-input finition-edit-type-impression">

										<span class="selectgroup-button">
											{{ typeImpression.nom }}
										</span>
									</label>
								{% else %}
									<span class="text-muted">
										Aucun type d’impression disponible
									</span>
								{% endfor %}

							</div>
						</div>

						<div class="form-group mb-0">
							<label class="custom-switch">

								<input type="checkbox" id="finitionEditPublie" class="custom-switch-input">

								<span class="custom-switch-indicator"></span>

								<span class="custom-switch-description">
									Publier cette finition
								</span>

							</label>
						</div>

					</div>

					<div class="modal-footer">

						<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
							Annuler
						</button>

						<button type="button" class="btn btn-primary" id="finitionEditSaveButton">

							<i class="fa fa-save mr-1"></i>
							Enregistrer les modifications
						</button>

					</div>

				</div>
			</div>
		</div>
	</div>
	<!-- ROW CLOSED -->
{% endblock %}
{% block javascripts %}
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script src="../assets/js/traitement_parametrage.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

{% endblock %}
