<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
	document.addEventListener('DOMContentLoaded', function () {

console.log('✅ JavaScript Devis chargé');

const form = document.getElementById('devis-form');
const collection = document.getElementById('collection-details');
const addButton = document.getElementById('add-detail');

const addButtonBas = document.getElementById('add-detail-bottom');

if (! form || ! collection || ! addButton) {
console.error('❌ Impossible d’initialiser le devis.', {
form: !! form,
collection: !! collection,
addButton: !! addButton
});

return;
}


/* =========================================================
       URL AJAX
       ========================================================= */

const configurationsProduitUrl = "{{ path(
        'app_produit_configuration_by_produit_ajax',
        { id: 0 }
    ) }}";

const configurationUrl = "{{ path(
        'app_produit_configuration_get_ajax',
        { id: 0 }
    ) }}";

const articleUrl = "{{ path(
        'app_article_commande_ajax',
        { id: 0 }
    ) }}";

const optionsManuellesUrl = "{{ path(
        'app_commande_catalogue_options_manuelles',
        { id: 0 }
    ) }}";


console.log('URL configurations :', configurationsProduitUrl);
console.log('URL configuration :', configurationUrl);
console.log('URL article :', articleUrl);


/* =========================================================
       CACHE
       ========================================================= */

const configurationsParDetail = new WeakMap();


/* =========================================================
       OUTILS
       ========================================================= */

function construireUrl(url, id) {
return url.replace('/0/', '/' + encodeURIComponent(id) + '/');
}


function champDetail(detail, nomChamp) {
return detail.querySelector('[data-detail-field="' + nomChamp + '"],' + '[name$="[' + nomChamp + ']"]');
}


function nombreDepuisChamp(champ, valeurDefaut = 0) {
if (! champ || champ.value === '') {
return valeurDefaut;
}

const valeur = Number(String(champ.value).replace(',', '.'));

return Number.isFinite(valeur) ? valeur : valeurDefaut;
}


/*
 * Les champs largeur/longueur sont saisis en centimetres (voir
 * DevisDetailsType, aligne sur le module commande), mais les calculs
 * de surface/metre lineaire ci-dessous raisonnent en metres (comme
 * le catalogue). On convertit donc systematiquement a la lecture.
 */
function metresDepuisChampCm(champ) {
return Math.max(0, nombreDepuisChamp(champ)) / 100;
}


/*
 * Sens inverse : une dimension du catalogue (en metres) doit etre
 * convertie en centimetres avant d'etre ecrite dans le champ.
 */
function cmDepuisMetres(valeurMetres) {
if (valeurMetres === null || valeurMetres === undefined || valeurMetres === '') {
return '';
}

const nombre = Number(valeurMetres);

return Number.isFinite(nombre) ? nombre * 100 : '';
}


function definirValeurChamp(detail, nomChamp, valeur, declencherEvenement = true) {
const champ = champDetail(detail, nomChamp);

if (! champ) {
console.warn('Champ introuvable :', nomChamp);

return;
}


let valeurFinale = valeur;

if (valeurFinale !== null && typeof valeurFinale === 'object' && valeurFinale.id !== undefined) {
valeurFinale = valeurFinale.id;
}


const nouvelleValeur = valeurFinale === null || valeurFinale === undefined ? '' : String(valeurFinale);


/*
         * Empêche les boucles infinies.
         */
if (String(champ.value) === nouvelleValeur) {
return;
}


champ.value = nouvelleValeur;


/*
         * Mise à jour Select2 sans déclencher
         * les événements métier.
         */
if (champ.tagName === 'SELECT' && typeof window.jQuery !== 'undefined' && typeof window.jQuery.fn.select2 !== 'undefined') {
window.jQuery(champ).val(nouvelleValeur).trigger('change.select2');
}


if (declencherEvenement) {
champ.dispatchEvent(new Event('input', {bubbles: true}));
}
}


function actualiserSelect2(select) {
if (! select || typeof window.jQuery === 'undefined' || typeof window.jQuery.fn.select2 === 'undefined') {
return;
}

window.jQuery(select).trigger('change.select2');
}


function viderSelect(select, placeholder) {
if (! select) {
return;
}

select.innerHTML = '';

const option = document.createElement('option');

option.value = '';
option.textContent = placeholder;

select.appendChild(option);

select.value = '';

actualiserSelect2(select);
}


/* =========================================================
       TYPE DE LIGNE
       ========================================================= */

function valeurTypeLigne(detail) {
const coche = detail.querySelector('[name$="[typeLigne]"]:checked');

if (coche) {
return coche.value;
}

const champ = champDetail(detail, 'typeLigne');

return champ ? champ.value : 'produit';
}


function valeurModeConfiguration(detail) {
/*
 * Alignement sur la commande : une ligne produit fonctionne
 * toujours en mode "manuel" (voir appliquerModeConfiguration()).
 * Le groupe de radios modeConfiguration est desormais cache en
 * permanence, donc jamais coche : lire la valeur statique d'un
 * radio non coche (champDetail(...).value) renvoyait toujours
 * "automatique" (le premier radio de la liste), quel que soit
 * l'etat reel. On retombe directement sur "manuel".
 */
const coche = detail.querySelector('[name$="[modeConfiguration]"]:checked');

if (coche) {
return coche.value;
}

return 'manuel';
}


/* =========================================================
       CALCULS
       ========================================================= */

function ecrireMontant(champ, valeur) {
if (! champ) {
return;
}

champ.value = String(Number.isFinite(valeur) ? Math.round(valeur) : 0);
}


function montantFinitionsAutomatiques(detail) {
const largeur = metresDepuisChampCm(champDetail(detail, 'largeur'));

const longueur = metresDepuisChampCm(champDetail(detail, 'longueur'));

const surface = largeur * longueur;

const quantite = Math.max(1, nombreDepuisChamp(champDetail(detail, 'quantite'), 1));


return Array.from(detail.querySelectorAll('.js-finition-selectionnee:checked')).reduce(function (total, checkbox) {

const prix = Math.max(0, Number(checkbox.dataset.prix || 0));

const mode = String(checkbox.dataset.modeCalcul || 'forfait').toLowerCase();


switch (mode) {
case 'metre_carre':
case 'surface':
case 'm2':

return total + prix * surface * quantite;


case 'metre':

return total + prix * longueur * quantite;


case 'unite':
case 'quantite':
case 'feuille':
case 'exemplaire':
case 'face':
case 'heure':
case 'point':

return total + prix * quantite;


default:

return total + prix;
}
}, 0);
}


function montantFinitionsManuelles(detail) {
return Array.from(detail.querySelectorAll('.js-finition-manuelle')).reduce(function (total, ligne) {

const prix = Math.max(0, nombreDepuisChamp(ligne.querySelector('.js-finition-prix')));

const quantite = Math.max(1, nombreDepuisChamp(ligne.querySelector('.js-finition-quantite'), 1));

const champMode = ligne.querySelector('.js-finition-mode');

const mode = String(champMode ? champMode.value : 'forfait').toLowerCase();


const largeur = metresDepuisChampCm(champDetail(detail, 'largeur'));

const longueur = metresDepuisChampCm(champDetail(detail, 'longueur'));

const surface = largeur * longueur;


switch (mode) {
case 'metre':

return total + prix * longueur * quantite;


case 'metre_carre':

return total + prix * surface * quantite;


case 'unite':
case 'feuille':
case 'exemplaire':
case 'heure':
case 'point':
case 'face':

return total + prix * quantite;


default:

return total + prix;
}
}, 0);
}


function calculerDetail(detail) {
const largeur = metresDepuisChampCm(champDetail(detail, 'largeur'));

const longueur = metresDepuisChampCm(champDetail(detail, 'longueur'));

const surface = largeur * longueur;

const quantite = Math.max(1, nombreDepuisChamp(champDetail(detail, 'quantite'), 1));

const prix = Math.max(0, nombreDepuisChamp(champDetail(detail, 'prixUnitaire')));

const remise = Math.max(0, nombreDepuisChamp(champDetail(detail, 'remise')));

const tva = Math.max(0, nombreDepuisChamp(champDetail(detail, 'tva')));

const champMode = champDetail(detail, 'modeCalcul');

const mode = String(champMode ? champMode.value : 'unite').toLowerCase();


let montant = 0;
let facteur = 0;


switch (mode) {
case 'forfait': facteur = 1; montant = prix * facteur;

break;


case 'metre': facteur = longueur * quantite; montant = prix * facteur;

break;


case 'metre_carre': facteur = surface * quantite; montant = prix * facteur;

break;


case 'face': facteur = Math.max(1, nombreDepuisChamp(champDetail(detail, 'nombreFaces'), 1)) * quantite; montant = prix * facteur;

break;


default: facteur = quantite; montant = prix * facteur;

break;
}


/*
         * Les finitions appartiennent uniquement
         * aux lignes Produit.
         */
if (valeurTypeLigne(detail) === 'produit') {
/*
 * Alignement sur la commande : une ligne produit est toujours en
 * mode "manuel" (voir appliquerModeConfiguration()). Cette
 * fonction ne doit donc compter que les finitions manuelles --
 * valeurModeConfiguration() retombant systematiquement sur
 * "automatique" une fois le groupe de radios cache, l'ancienne
 * condition ignorait le prix des finitions manuelles dans le
 * total affiche.
 */
montant += montantFinitionsManuelles(detail);
}


// La remise est un montant par unité (ex. 500 FCFA par m²), pas un montant fixe sur toute la ligne.
const remiseTotale = Math.min(montant, remise * Math.max(0, facteur));

const totalHt = Math.max(0, montant - remiseTotale);

const totalTtc = totalHt * (1 + tva / 100);


const elementRemiseTotale = detail.querySelector('.js-remise-totale-detail');

if (elementRemiseTotale) {
elementRemiseTotale.textContent = remiseTotale > 0
? ('Remise totale : ' + Math.round(remiseTotale).toLocaleString('fr-FR') + ' FCFA')
: 'Remise totale : —';
}


/*
         * Pas d'événement ici.
         */
definirValeurChamp(detail, 'surface', surface, false);

definirValeurChamp(detail, 'totalHt', Math.round(totalHt), false);

definirValeurChamp(detail, 'totalTtc', Math.round(totalTtc), false);


calculerRecapitulatif();
}


function calculerRecapitulatif() {
let totalHt = 0;
let totalTtc = 0;


collection.querySelectorAll('.detail-devis').forEach(function (wrapper) {

const detail = wrapper.querySelector('.js-devis-detail');

if (! detail) {
return;
}


totalHt += nombreDepuisChamp(champDetail(detail, 'totalHt'));

totalTtc += nombreDepuisChamp(champDetail(detail, 'totalTtc'));
});


const totalHtForm = document.getElementById('{{ form.totalHt.vars.id }}');

const totalTtcForm = document.getElementById('{{ form.totalTtc.vars.id }}');

const remiseForm = document.getElementById('{{ form.remise.vars.id }}');

const montantForm = document.getElementById('{{ form.montantApayer.vars.id }}');


const remise = Math.max(0, nombreDepuisChamp(remiseForm));


ecrireMontant(totalHtForm, totalHt);

ecrireMontant(totalTtcForm, totalTtc);

ecrireMontant(montantForm, Math.max(0, totalTtc - remise));
}


/* =========================================================
       DIMENSIONS
       ========================================================= */

function actualiserDimensions(detail) {
const mode = detail.dataset.modeDimension || '';

const afficher = mode === 'mesure';


['.js-zone-largeur', '.js-zone-longueur', '.js-zone-surface'].forEach(function (selecteur) {

const zone = detail.querySelector(selecteur);

if (zone) {
zone.style.display = afficher ? '' : 'none';
}
});


if (! afficher) {
definirValeurChamp(detail, 'largeur', '', false);

definirValeurChamp(detail, 'longueur', '', false);

definirValeurChamp(detail, 'surface', '', false);
}
}


/* =========================================================
       MODE CONFIGURATION PRODUIT
       ========================================================= */

function appliquerModeConfiguration(detail) {
if (valeurTypeLigne(detail) !== 'produit') {
return;
}


const mode = valeurModeConfiguration(detail);

const automatique = mode === 'automatique';

const manuel = mode === 'manuel';


const zoneConfiguration = detail.querySelector('.js-zone-configuration-automatique');

const zoneChamps = detail.querySelector('.js-zone-champs-configuration');

const zoneFinitionsAuto = detail.querySelector('.js-zone-finitions-automatiques');

const zoneFinitionsManuelles = detail.querySelector('.js-zone-finitions-manuelles');


if (zoneConfiguration) {
zoneConfiguration.style.display = automatique ? '' : 'none';
}


if (zoneChamps) {
zoneChamps.style.display = '';

zoneChamps.classList.toggle('js-champs-auto-verrouilles', automatique);
}


if (zoneFinitionsAuto) {
zoneFinitionsAuto.style.display = automatique ? '' : 'none';
}


if (zoneFinitionsManuelles) {
zoneFinitionsManuelles.style.display = manuel ? '' : 'none';
}


const produit = champDetail(detail, 'produit');

const configuration = champDetail(detail, 'configuration');

const prix = champDetail(detail, 'prixUnitaire');

const modeCalcul = champDetail(detail, 'modeCalcul');


if (produit) {
produit.disabled = false;
produit.required = true;
}


if (configuration) {
configuration.disabled = false;
configuration.required = automatique;
}


if (prix) {
prix.readOnly = automatique;
}


if (modeCalcul) {
modeCalcul.disabled = false;

modeCalcul.style.pointerEvents = automatique ? 'none' : '';

modeCalcul.setAttribute('aria-readonly', automatique ? 'true' : 'false');
}['typeImpression', 'support', 'format'].forEach(function (nomChamp) {

const champ = champDetail(detail, nomChamp);

if (! champ) {
return;
}

champ.disabled = false;
champ.required = false;
});


if (manuel) {
const modeChoisi = modeCalcul ? modeCalcul.value : 'unite';

detail.dataset.modeDimension = ['metre', 'metre_carre'].includes(modeChoisi) ? 'mesure' : '';
}


actualiserDimensions(detail);

calculerDetail(detail);
}


/* =========================================================
       TYPE DE LIGNE
       ========================================================= */

function appliquerTypeLigne(detail) {
const type = valeurTypeLigne(detail);

const estProduit = type === 'produit';

const estArticle = type === 'article';

const estLibre = type === 'libre';


console.log('Type de ligne :', type);


const zoneProduit = detail.querySelector('.js-zone-produit');

const zoneArticle = detail.querySelector('.js-zone-article-stock');

const zoneMode = detail.querySelector('.js-zone-mode-configuration');

const zoneConfiguration = detail.querySelector('.js-zone-champs-configuration');

const zoneFinitions = detail.querySelector('.js-zone-finitions');

const zoneTechnique = detail.querySelector('.js-zone-technique');


if (zoneProduit) {
zoneProduit.style.display = estProduit ? '' : 'none';
}


if (zoneArticle) {
zoneArticle.style.display = estArticle ? '' : 'none';
}


if (zoneMode) {
zoneMode.style.display = 'none';
}


if (zoneConfiguration) {
zoneConfiguration.style.display = estProduit ? '' : 'none';
}


if (zoneFinitions) {
zoneFinitions.style.display = estProduit ? '' : 'none';
}


if (zoneTechnique) {
zoneTechnique.style.display = estProduit ? '' : 'none';
}


const produit = champDetail(detail, 'produit');

const article = champDetail(detail, 'article');

const configuration = champDetail(detail, 'configuration');

const designation = champDetail(detail, 'designation');

const prix = champDetail(detail, 'prixUnitaire');

const modeCalcul = champDetail(detail, 'modeCalcul');


/*
         * modeConfiguration
         */
detail.querySelectorAll('[name$="[modeConfiguration]"]').forEach(function (champ) { /*
                     * Toujours retirer required : .js-zone-mode-configuration
                     * est en permanence masqué (voir zoneMode ci-dessus), donc
                     * un required ici fait planter la validation HTML5 du
                     * navigateur ("not focusable") et bloque l'envoi du devis.
                     *
                     * On ne désactive PAS ces radios ici,
                     * car le serveur possède encore
                     * modeConfiguration dans l'entité.
                     */
champ.required = false;
});


/*
         * Produit
         */
if (produit) {
produit.required = estProduit;

produit.disabled = ! estProduit;
}


/*
         * Article
         */
if (article) {
article.required = estArticle;

article.disabled = ! estArticle;
}


/*
         * Configuration
         */
if (configuration) {
configuration.required = estProduit && valeurModeConfiguration(detail) === 'automatique';

configuration.disabled = ! estProduit;
}


/*
         * =====================================================
         * PRODUIT
         * =====================================================
         */
if (estProduit) {
if (article) {
article.value = '';

actualiserSelect2(article);
}


if (designation) {
designation.readOnly = false;
}


appliquerModeConfiguration(detail);

return;
}


/*
         * =====================================================
         * ARTICLE
         * =====================================================
         */
if (estArticle) {
definirValeurChamp(detail, 'produit', '', false);

definirValeurChamp(detail, 'configuration', '', false);

definirValeurChamp(detail, 'typeImpression', '', false);

definirValeurChamp(detail, 'support', '', false);

definirValeurChamp(detail, 'format', '', false);

definirValeurChamp(detail, 'modeCalcul', 'unite', false);


['typeImpression', 'support', 'format'].forEach(function (nomChamp) {

const champ = champDetail(detail, nomChamp);

if (champ) {
champ.required = false;
champ.disabled = true;
}
});


if (designation) {
designation.readOnly = true;
}


if (prix) {
prix.readOnly = true;
}


if (modeCalcul) { /*
                 * Attention :
                 * doit rester activé pour être envoyé au serveur.
                 */
modeCalcul.disabled = false;
}


detail.dataset.modeDimension = '';

actualiserDimensions(detail);


/*
             * Si article déjà sélectionné.
             */
if (article && article.value) {
chargerArticle(detail);
}


calculerDetail(detail);

return;
}


/*
         * =====================================================
         * LIBRE
         * =====================================================
         */
if (estLibre) {
definirValeurChamp(detail, 'article', '', false);

definirValeurChamp(detail, 'produit', '', false);

definirValeurChamp(detail, 'configuration', '', false);

definirValeurChamp(detail, 'typeImpression', '', false);

definirValeurChamp(detail, 'support', '', false);

definirValeurChamp(detail, 'format', '', false);


['typeImpression', 'support', 'format'].forEach(function (nomChamp) {

const champ = champDetail(detail, nomChamp);

if (champ) {
champ.required = false;
champ.disabled = true;
}
});


if (designation) {
designation.readOnly = false;

designation.required = true;
}


if (prix) {
prix.readOnly = false;
}


if (modeCalcul) {
modeCalcul.disabled = false;
}


detail.dataset.modeDimension = modeCalcul && ['metre', 'metre_carre'].includes(modeCalcul.value) ? 'mesure' : '';


actualiserDimensions(detail);

calculerDetail(detail);
}
}


/* =========================================================
       ARTICLE AJAX
       ========================================================= */

/*
 * Charge le prix de base et le mode de calcul du produit
 * lui-meme (meme endpoint que la commande :
 * app_commande_catalogue_options_manuelles), independamment de
 * toute configuration catalogue.
 */
/*
 * Masque (et desactive) les options d'un <select> qui ne font pas
 * partie de la liste autorisee -- meme fonction que la commande.
 */
function filtrerOptions(select, idsAutorises) {
if (! select) {
return;
}

const autorises = new Set((idsAutorises || []).map(String));

let valeurEncoreValide = false;

Array.from(select.options).forEach(function (option) {
if (! option.value) {
return;
}

const visible = autorises.has(String(option.value));

option.hidden = ! visible;

option.disabled = ! visible;

if (visible && option.value === select.value) {
valeurEncoreValide = true;
}
});

if (! valeurEncoreValide) {
select.value = '';
}

if (window.jQuery && window.jQuery.fn.select2 && window.jQuery(select).hasClass('select2-hidden-accessible')) {
window.jQuery(select).trigger('change.select2');
}
}


async function chargerInfosProduitBase(detail, produitId) {
if (! produitId) {
return;
}

try {

const response = await fetch(construireUrl(optionsManuellesUrl, produitId));

const json = await response.json();

if (! response.ok || ! json.success) {
throw new Error(json.message || 'Impossible de charger le produit.');
}

const infosProduit = json.produit || {};

definirValeurChamp(detail, 'prixUnitaire', infosProduit.prixBase || 0, false);

definirValeurChamp(detail, 'modeCalcul', infosProduit.modeCalcul || 'unite', false);

/*
 * definirValeurChamp() est appele ci-dessus avec declencherEvenement
 * = false, donc le listener 'change' du champ modeCalcul (qui
 * affiche Largeur/Longueur quand le mode est "metre" ou
 * "metre_carre", voir plus bas dans ce fichier) ne se declenche
 * pas tout seul ici. On reproduit directement ce qu'il fait.
 */
detail.dataset.modeDimension = ['metre', 'metre_carre'].includes(infosProduit.modeCalcul || 'unite') ? 'mesure' : '';

actualiserDimensions(detail);

filtrerOptions(champDetail(detail, 'typeImpression'), (json.typesImpression || []).map(function (t) {
return t.id;
}));

filtrerOptions(champDetail(detail, 'support'), (json.supports || []).map(function (s) {
return s.id;
}));

filtrerOptions(champDetail(detail, 'format'), (json.formats || []).map(function (f) {
return f.id;
}));

calculerDetail(detail);

} catch (erreur) {
console.error('Erreur infos produit :', erreur);
}
}


async function chargerArticle(detail) {
if (valeurTypeLigne(detail) !== 'article') {
return;
}


const select = champDetail(detail, 'article');

const information = detail.querySelector('.js-stock-article');


if (! select || ! select.value) {
if (information) {
information.textContent = 'Sélectionnez un article.';
}

return;
}


console.log('Chargement article :', select.value);


if (information) {
information.innerHTML = '<i class="fa fa-spinner fa-spin"></i> Chargement...';
}


try {
const url = construireUrl(articleUrl, select.value);


console.log('URL article appelée :', url);


const reponse = await fetch(url, {
headers: {
Accept: 'application/json'
}
});


const resultat = await reponse.json();


console.log('Article reçu :', resultat);


if (! reponse.ok || ! resultat.success) {
throw new Error(resultat.message || 'Impossible de charger l’article.');
}


const article = resultat.article;


definirValeurChamp(detail, 'designation', article.designation || '', false);


definirValeurChamp(detail, 'prixUnitaire', article.prixVente ?? 0, false);


definirValeurChamp(detail, 'modeCalcul', 'unite', false);


const designation = champDetail(detail, 'designation');

if (designation) {
designation.readOnly = true;
}


if (information) {
information.innerHTML = '<strong>' + (
article.reference || ''
) + '</strong>' + '<br>' + (
article.designation || ''
) + '<br>' + 'Stock disponible : ' + Number(article.stockDisponible || 0).toLocaleString('fr-FR') + ' ' + (
article.unite || ''
) + '<br>' + 'Prix de vente : ' + Number(article.prixVente || 0).toLocaleString('fr-FR') + ' FCFA';
}


calculerDetail(detail);

} catch (erreur) {
console.error('Erreur article :', erreur);


if (information) {
information.innerHTML = '<span class="text-danger">' + erreur.message + '</span>';
}
}
}


