{% extends 'base_simple.html.twig' %}

{% block title %}Connexion · Madial Group{% endblock %}

{% block body %}
	<h4 class="text-center mb-4">Connectez-vous à votre espace</h4>
	{% if error %}
		<div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
	{% endif %}
	{% if app.user %}
		<div class="alert alert-info">
			Connecté en tant que {{ app.user.userIdentifier }}. <a href="{{ path('app_logout') }}">Se déconnecter</a>
		</div>
	{% endif %}
	<form method="post" action="{{ path('app_login') }}">
		<div class="mb-3">
			<label class="mb-1 form-label" for="inputUsername"><strong>Identifiant</strong></label>
			<input type="text" id="inputUsername" name="username" class="form-control" value="{{ last_username }}" autocomplete="username" required autofocus>
		</div>
		<div class="mb-3">
			<label class="mb-1 form-label" for="inputPassword"><strong>Mot de passe</strong></label>
			<input type="password" id="inputPassword" name="password" class="form-control" autocomplete="current-password" required>
		</div>
		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
		<div class="text-center">
			<button type="submit" class="btn btn-primary btn-block w-100">Se connecter</button>
		</div>
	</form>
{% endblock %}
