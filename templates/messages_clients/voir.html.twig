{% extends 'base.html.twig' %}

{# Conversation avec un client (Clients › Messages) : son fil, la réponse de l'atelier, « Classer ». #}
{% block title %}Messages · {{ client.nomComplet }}{% endblock %}

{% block header_actions %}
	<li class="nav-item"><a href="{{ path('app_messages_clients_index') }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-list me-1"></i>Toutes</a></li>
{% endblock %}

{% block body %}
	<div class="si-rc">
		<section class="card si-ac-bloc">
			<h2>Conversation</h2>
			<div class="si-mc-fil">
				{% for m in fil %}
					<div class="si-mc-bulle {{ m.estDeLAtelier ? 'si-mc-atelier' : 'si-mc-client' }}">
						<small>{{ m.estDeLAtelier ? 'Succès Imprim' ~ (m.ecritPar ? ' · ' ~ (m.ecritPar.employe ? m.ecritPar.employe.prenom : m.ecritPar.username)) : (m.auteur ?? client.nomComplet) }} · {{ m.creeLe|date('d/m/Y H:i') }}{% if m.commande %} · commande <a href="{{ path('app_commandes_show', {id: m.commande.id}) }}">{{ m.commande.numero }}</a>{% endif %}</small>
						<p>{{ m.texte|nl2br }}</p>
					</div>
				{% else %}
					<p class="si-ac-vide">Pas encore de message.</p>
				{% endfor %}
			</div>

			{% if enLigne %}
				<p class="si-pg-note">Lecture seule sur le site en ligne : répondez depuis l'ERP de la boutique.</p>
			{% else %}
				<form method="post" action="{{ path('app_messages_clients_repondre', {publicId: client.publicId}) }}" class="si-rc-form">
					<input type="hidden" name="_token" value="{{ csrf_token(jeton) }}">
					<label for="texte">Réponse au client</label>
					<textarea id="texte" name="texte" class="form-control" rows="3" maxlength="{{ max }}" required placeholder="Ex. : Oui, livraison jeudi entre 9 h et 10 h."></textarea>
					<div class="si-rc-choix">
						{% if commandes is not empty %}
							<select name="commande" class="form-select form-select-sm" style="max-width: 260px" aria-label="Commande concernée">
								<option value="">Sans commande</option>
								{% for c in commandes %}<option value="{{ c.id }}"{{ fil is not empty and fil|last.commande and fil|last.commande.id == c.id ? ' selected' }}>{{ c.numero }}</option>{% endfor %}
							</select>
						{% endif %}
						<button class="btn btn-primary btn-sm">Envoyer la réponse</button>
					</div>
					<p class="si-pg-note">Le client lit votre réponse dans son espace et en est prévenu (application, SMS ou e-mail selon ses réglages). Pas de prix ni de montant dans le SMS.</p>
				</form>
				<form method="post" action="{{ path('app_messages_clients_classer', {publicId: client.publicId}) }}" style="margin-top: 10px">
					<input type="hidden" name="_token" value="{{ csrf_token(jeton) }}">
					<button class="btn btn-light btn-sm">Classer sans répondre</button>
				</form>
			{% endif %}
		</section>

		<aside class="card si-ac-bloc si-rc-cote">
			<h2>Client</h2>
			<p><a href="{{ path('app_clients_show', {publicId: client.publicId}) }}"><b>{{ client.nomComplet }}</b></a><br><small>{{ client.code }}{{ client.telephone ? ' · ' ~ client.telephone }}</small></p>
		</aside>
	</div>
{% endblock %}
