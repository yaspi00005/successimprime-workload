# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
 DATABASE_URL=
#DATABASE_URL="postgresql://app:!ChangeMe!@127.0.0.1:5432/app?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
# sync:// : e-mails et SMS partent tout de suite, sans processus de fond
# (aucun « messenger:consume » ne tourne, ni au local ni en ligne). Vide, toute
# commande qui touche à la base ou à l'envoi s'arrête sur « No transport ».
MESSENGER_TRANSPORT_DSN=sync://
###< symfony/messenger ###

###> symfony/mailer ###
# null://null : aucun e-mail ne part tant que le vrai DSN n'est pas dans .env.local.
MAILER_DSN=null://null
###< symfony/mailer ###

###> whatsapp business api ###
# A remplir dans .env.local (jamais ici) une fois le compte Meta Business
# configure : jeton d'acces permanent, ID du numero WhatsApp Business,
# version de l'API Graph utilisee (ex. v21.0).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
# Nom exact du modele de message approuve dans Meta Business Manager
# (en-tete Document + variables de corps : nom client, type de
# document, numero). Voir le message de livraison pour le modele a
# creer/faire approuver.
WHATSAPP_TEMPLATE_DOCUMENT=
###< whatsapp business api ###

###> notifications push ###
# Notifications sur le téléphone (écran verrouillé). Créer les clés avec
# « php bin/console app:push:cles » et les mettre dans .env.local
# (jamais ici). Sans clés, aucune notification ne part sur les téléphones.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@successimprim.ml

# Sauvegardes (docs/sauvegardes.md). Vide = var/sauvegardes du projet.
SAUVEGARDE_DIR=
# Second disque ou NAS où chaque sauvegarde est recopiée (ex. D:\Sauvegardes ou /mnt/nas/si). Vide = pas de copie.
SAUVEGARDE_COPIE_DIR=
# Chemin de mysqldump si la recherche automatique ne le trouve pas. Vide = recherche automatique.
SAUVEGARDE_MYSQLDUMP=
# Clé de la copie chiffrée hors site (app:sauvegarde --nouvelle-cle-hors-site), ERP local seulement, dans .env.local
SAUVEGARDE_CLE_HORS_SITE=
###< notifications push ###

###> orange sms api ###
# A remplir dans .env.local (jamais ici) avec les identifiants du
# contrat Orange SMS API (https://developer.orange.com). Le jeton
# n'est plus stocke ici : il est demande automatiquement et mis en
# cache par OrangeSmsService.
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
# Format attendu : tel:+22300000000
ORANGE_SMS_SENDER_ADDRESS=
ORANGE_SMS_SENDER_NAME=''
###< orange sms api ###

###> orange money web payment ###
# Paiement Orange Money depuis l'espace client (docs/espace-client.md).
# Les cles se mettent seulement dans .env.local du serveur en ligne, jamais
# ici ni dans le depot. Essai : l'adresse dev ci-dessous et la devise OUV ;
# production au Mali : https://api.orange.com/orange-money-webpay/ml/v1 et XOF.
ORANGE_MONEY_API=https://api.orange.com/orange-money-webpay/dev/v1
ORANGE_MONEY_DEVISE=OUV
ORANGE_MONEY_CLIENT_ID=
ORANGE_MONEY_CLIENT_SECRET=
ORANGE_MONEY_MERCHANT_KEY=
###< orange money web payment ###

###> images IA de la demande de conception (docs/demande-conception.md) ###
# Fournisseur : openai (par défaut, actif dès que la clé est posée) ou demo
# (affiche de démonstration, développement seulement, refusée en production).
# La clé se met seulement dans .env.local du serveur en ligne, jamais ici ni
# dans le dépôt. Sans clé, la génération par IA est « bientôt disponible ».
IA_IMAGES_FOURNISSEUR=openai
IA_IMAGES_CLE=
IA_IMAGES_MODELE=gpt-image-1
# API compatible OpenAI : adresse de base (https seulement).
IA_IMAGES_URL=https://api.openai.com/v1
###< images IA ###

###> module communications (campagnes + rappels de paiement) ###
# Adresse d'expedition des emails de campagne/rappel de paiement.
# A configurer dans .env.local une fois MAILER_DSN renseigne.
MAILER_FROM_ADDRESS=
# Nom exact du modele WhatsApp approuve par Meta pour les rappels de
# paiement (categorie "Utility"). Variables attendues dans le corps,
# dans l'ordre : nom du client, numero de commande, reste a payer.
WHATSAPP_TEMPLATE_RAPPEL_PAIEMENT=
# Nom exact du modele WhatsApp approuve par Meta pour les campagnes
# (categorie "Marketing"). WhatsApp exige un modele pre-approuve pour
# tout message a l'initiative de l'entreprise : le contenu saisi dans
# le "Modele de message" (ecran Communications) sert alors seulement
# d'aide-memoire, ce n'est pas le texte reellement envoye. Variable
# attendue dans le corps : nom du client.
WHATSAPP_TEMPLATE_CAMPAGNE=
###< module communications (campagnes + rappels de paiement) ###

###> administration en ligne ###
# 1 sur le serveur en ligne (admin.succesimprim.com) : appareil
# autorisé + code par SMS + session fermée après 15 min sans activité
# (maquettes 38 et CX03). 0 sur le serveur local de l'atelier.
APP_EN_LIGNE=0
###< administration en ligne ###

###> synchronisation local <-> en ligne (docs/synchronisation.md) ###
# Adresse du site, sur l'ERP local seulement (ex. https://succesimprim.com).
SYNC_URL=
# Clé partagée, la MÊME des deux côtés, 32 caractères au moins.
# Jamais ici : dans .env.local de chaque machine (php bin/console app:synchro --nouvelle-cle).
SYNC_CLE=
###< synchronisation ###

###> assistant du site et de l'espace client (docs/assistant-client.md) ###
# Clé de l'API Claude : sur le serveur en ligne seulement, dans .env.local,
# jamais ici. Vide : l'assistant est caché.
ANTHROPIC_API_KEY=
# Modèle imposé par le serveur ; vide : celui de la tuile Réglages ›
# Assistant du site (Claude Opus 5.5 par défaut).
ASSISTANT_MODELE=
# 1 : réponses de démonstration, sans appel à l'API ni clé. Ne joue
# qu'en développement (APP_ENV=dev) : ignoré en production.
ASSISTANT_DEMO=0
###< assistant du site et de l'espace client ###
