			<script>
				(function () {
'use strict';

function initialiserMenuMDG() {
const racine = document.getElementById('parentVerticalTab');

if (! racine || racine.dataset.mdgInitialise === '1') {
return;
}

racine.dataset.mdgInitialise = '1';

const indexActif = {{ indexMenuActif|json_encode|raw }};
const onglets = racine.querySelectorAll(':scope > .first-sidemenu > .resp-tabs-list > li');
const panneaux = racine.querySelectorAll('.resp-tabs-container.hor_1 > div');

function afficherMenu(index) {
onglets.forEach(function (onglet, position) {
const actif = position === index;

onglet.classList.toggle('resp-tab-active', actif);
onglet.classList.toggle('active', actif);
onglet.setAttribute('aria-selected', actif ? 'true' : 'false');
});

panneaux.forEach(function (panneau, position) {
const actif = position === index;

panneau.classList.toggle('resp-tab-content-active', actif);
panneau.style.display = actif ? 'block' : 'none';
});
}

window.setTimeout(function () {
afficherMenu(indexActif);
}, 0);

onglets.forEach(function (onglet, index) {
onglet.addEventListener('click', function () {
afficherMenu(index);
});
});

const recherche = document.getElementById('menuSearch');

if (recherche) {
recherche.addEventListener('input', function () {
const terme = this.value.trim().toLowerCase();
const liens = racine.querySelectorAll('.second-sidemenu .slide-item');

liens.forEach(function (lien) {
lien.style.display = ! terme || lien.textContent.toLowerCase().includes(terme) ? '' : 'none';
});
});
}
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', initialiserMenuMDG, {once: true});
} else {
initialiserMenuMDG();
}
})();
			</script>

			{% set notifications = {
				success: app.flashes('success'),
				error: app.flashes('error'),
				danger: app.flashes('danger'),
				warning: app.flashes('warning'),
				info: app.flashes('info')
			} %}

			<script>
				(function () {
'use strict';

const notifications = {{ notifications|json_encode|raw }};
const configurations = {
success: {
icon: 'success',
title: 'Opération réussie'
},
error: {
icon: 'error',
title: 'Erreur'
},
danger: {
icon: 'error',
title: 'Erreur'
},
warning: {
icon: 'warning',
title: 'Attention'
},
info: {
icon: 'info',
title: 'Information'
}
};

function afficherNotifications() {
Object.keys(notifications).forEach(function (type) {
notifications[type].forEach(function (message) {
const configuration = configurations[type] || configurations.info;

if (typeof window.Swal === 'undefined') {
window.alert(message);
return;
}

window.Swal.fire({
icon: configuration.icon,
title: configuration.title,
text: message,
confirmButtonText: 'OK',
timer: type === 'success' ? 3500 : undefined,
timerProgressBar: type === 'success'
});
});
});
}

if (document.readyState === 'loading') {
document.addEventListener('DOMContentLoaded', afficherNotifications, {once: true});
} else {
afficherNotifications();
}
})();
			</script>

