{% extends 'espace/app/_app.html.twig' %}

{#
	« Mes devis » (docs/devis.md) : chaque devis mène à sa page (DT01),
	où il se lit, s'accepte, se refuse ou se fait modifier. Le prix pour
	qui voit les montants (coque.montants).
#}

{% block title %}Mes devis{% endblock %}
{% block entete %}<a class="ec-retour" href="{{ path('app_espace_commandes') }}"><span class="fl">‹</span>Mes devis</a>{% endblock %}

{% block contenu %}
	<nav class="ec-filtres">
		{% for k, l in {tous: 'Tous', a_accepter: 'À accepter', acceptes: 'Acceptés'} %}
			<a href="{{ path('app_espace_devis', {filtre: k}) }}" class="{{ filtre == k ? 'actif' }}">{{ l }}</a>
		{% endfor %}
	</nav>
	{% set etats = {envoye: ['À accepter', 'ambre'], vu: ['À accepter', 'ambre'], accepte: ['Accepté', 'vert'], converti: ['Accepté', 'vert'], refuse: ['Refusé', 'gris'], expire: ['Expiré', 'gris']} %}
	{% for d in liste %}
		{% set lignes = d.devisDetails|filter(l => true) %}
		{% set etat = etats[d.statut]|default(['', 'gris']) %}
		<a class="ec-carte" href="{{ path('app_espace_devis_detail', {id: d.id}) }}" style="display:block;color:inherit">
			<div class="ec-ligne"><span class="ec-petit">{{ d.numero }}{{ d.version > 1 ? ' · v' ~ d.version }}{{ d.envoyeLe ? ' · ' ~ d.envoyeLe|date('d/m/Y') : (d.dateDevis ? ' · ' ~ d.dateDevis|date('d/m/Y')) }}</span><span class="ec-pastille {{ etat[1] }}">{{ etat[0] }}</span></div>
			<div style="font-weight:800;margin:.3rem 0">{{ d.objet ?: '' }}{% if not d.objet %}{% for l in lignes|slice(0, 2) %}{{ l|ligne_client('Travail') }}{{ not loop.last ? ', ' }}{% endfor %}{% if lignes|length > 2 %} + {{ lignes|length - 2 }}{% endif %}{% endif %}</div>
			<div class="ec-ligne">
				{% if coque.montants %}<span class="ec-montant" style="font-size:1.15rem">{{ d.totalTtc|number_format(0, ',', ' ') }} F</span>{% else %}<span class="ec-petit">Prix vu par votre valideur</span>{% endif %}
				{% if d.estEnAttente and d.dateValidite %}<span class="ec-petit">valable jusqu'au {{ d.dateValidite|date('d/m') }}</span>{% elseif d.commande %}<span class="ec-petit">commande {{ d.commande.numero }}</span>{% endif %}
			</div>
			{% if d.estEnAttente %}<div style="text-align:right;margin-top:.4rem"><span class="ec-lien">{{ (peutValider ?? true) ? 'Voir et répondre ›' : 'Voir le devis ›' }}</span></div>{% endif %}
		</a>
	{% else %}
		<div class="ec-carte ec-vide">Aucun devis ici.</div>
	{% endfor %}
{% endblock %}
