		<rect x="3" y="6" width="18" height="12" rx="2"/><circle cx="8.5" cy="11" r="1.8"/><path d="M13 10h5M13 13.5h4M6 15.5h5"/>
	{% elseif famille == 'signaletique' %}
		<path d="M12 2v20M8 21h8"/><rect x="5" y="4" width="14" height="5" rx="1"/><rect x="5" y="11" width="14" height="5" rx="1"/>
	{% else %}
		<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="9.5" r="1.8"/><path d="m21 16-5-5-9 9"/>
	{% endif %}
</svg>
