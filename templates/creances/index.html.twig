{% extends 'base.html.twig' %}

{% block title %}Factures et créances{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_factures_index') }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-file-invoice me-1"></i>Toutes les factures</a>
	</li>
	{% if filtre != 'payees' and lignes is not empty %}
		<li class="nav-item">
			<button type="submit" form="form-relances" class="btn btn-primary btn-sm si-btn-entete" data-si-selection disabled><i class="fab fa-whatsapp me-1"></i>Relancer<span class="si-masque-mobile"> la sélection</span> (<span data-si-compte>0</span>)</button>
		</li>
	{% endif %}
{% endblock %}

{% block body %}
	{% set max = max(balance|merge([1])) %}
	<div class="si-creances">
		<section class="card si-creances-balance">
			<h2>Balance âgée</h2>
			<div class="si-creances-barres" role="img" aria-label="{% for cle, libelle in constant('App\\Service\\Creances::TRANCHES') %}{{ libelle }} : {{ balance[cle]|number_format(0, ',', ' ') }} F. {% endfor %}">
				{% for cle, libelle in constant('App\\Service\\Creances::TRANCHES') %}
					<div class="si-creances-barre si-tranche-{{ cle }}">
						<span class="si-creances-valeur">{{ balance[cle]|number_format(0, ',', ' ') }}</span>
						<span class="si-creances-colonne" style="height: {{ balance[cle] > 0 ? max(4, (balance[cle] / max * 100)|round) : 0 }}%"></span>
						<span class="si-creances-tranche">{{ libelle }}</span>
					</div>
				{% endfor %}
			</div>
			<div class="si-creances-total">
				<span>Total créances</span>
				<strong>{{ total|number_format(0, ',', ' ') }} F</strong>
			</div>
			<p class="si-creances-note"><i class="fas fa-exclamation-circle si-creances-plafond"></i> client au-dessus de son plafond de crédit.</p>
			{% if nb_echues > 0 %}
				<p class="si-creances-note">{{ nb_echues }} créance{{ nb_echues > 1 ? 's' }} échue{{ nb_echues > 1 ? 's' }}. Les tranches comptent les jours après l’échéance.</p>
			{% endif %}
		</section>

		<section class="card si-creances-liste">
			<div class="si-creances-outils">
				<nav class="si-creances-filtres" aria-label="Filtrer">
					{% for cle, libelle in constant('App\\Service\\Creances::FILTRES') %}
						<a href="{{ path('app_creances_index', {filtre: cle, q: recherche ?: null}) }}" class="{{ filtre == cle ? 'active' }}" {{ filtre == cle ? 'aria-current="page"' }}>{{ libelle }}</a>
					{% endfor %}
				</nav>
				<form method="get" action="{{ path('app_creances_index') }}" class="si-creances-recherche" role="search">
					<input type="hidden" name="filtre" value="{{ filtre }}">
					<input type="search" name="q" value="{{ recherche }}" class="form-control form-control-sm" placeholder="Client ou n° de facture" aria-label="Rechercher une créance">
				</form>
			</div>

			{% if lignes is empty %}
				<p class="si-creances-vide">{{ recherche ? 'Aucune créance ne correspond à « ' ~ recherche ~ ' ».' : (filtre == 'payees' ? 'Aucune commande soldée pour l’instant.' : 'Aucune créance : tous les clients sont à jour.') }}</p>
			{% else %}
				<form method="post" action="{{ path('app_creances_relancer') }}" id="form-relances">
					<input type="hidden" name="_token" value="{{ csrf_token('relancer-creances') }}">
					<div class="table-responsive">
						<table class="table si-creances-table si-creances-cartes">
							<thead>
								<tr>
									{% if filtre != 'payees' %}<th class="si-creances-case"><input type="checkbox" class="form-check-input" id="tout-cocher" aria-label="Tout cocher"></th>{% endif %}
									<th>Facture</th>
									<th>Client</th>
									<th>Échéance</th>
									<th class="text-end si-masque-mobile">Montant</th>
									<th class="text-end">Reste</th>
									<th>Statut</th>
									<th class="si-masque-mobile">Relance</th>
									{% if is_granted('ROLE_PAIEMENT_ENCAISSER') and filtre != 'payees' %}<th class="si-masque-mobile"><span class="visually-hidden">Actions</span></th>{% endif %}
								</tr>
							</thead>
							<tbody>
								{% for l in lignes %}
									<tr>
										{% if filtre != 'payees' %}
											<td class="si-creances-case"><input type="checkbox" class="form-check-input" name="commandes[]" value="{{ l.commande.id }}" aria-label="Relancer {{ l.client }} pour {{ l.document }}" {{ l.telephone ? '' : 'title="Pas de téléphone"' }}></td>
										{% endif %}
										<td class="text-nowrap">
											<a href="{{ l.facture ? path('app_factures_show', {id: l.facture.id}) : path('app_commandes_show', {id: l.commande.id}) }}">{{ l.document }}</a>
											{% if not l.facture %}<small class="d-block text-muted">sans facture</small>{% endif %}
										</td>
										<td>
											{{ l.client ?: '—' }}
											{% if l.plafond_depasse %}<i class="fas fa-exclamation-circle si-creances-plafond" title="Encours au-dessus du plafond de crédit" aria-label="Plafond de crédit dépassé"></i>{% endif %}
										</td>
										<td class="text-nowrap">{{ l.echeance ? l.echeance|date('d/m/y') : '—' }}</td>
										<td class="text-end text-nowrap si-masque-mobile">{{ l.montant|number_format(0, ',', ' ') }}</td>
										<td class="text-end text-nowrap fw-bold">{{ l.reste|number_format(0, ',', ' ') }}</td>
										<td>
											<span class="si-statut-creance si-statut-{{ l.statut.cle }}">{{ l.statut.libelle }}</span>
										</td>
										<td class="si-masque-mobile">
											{% if l.relance %}
												{{ l.relance.canal }} <small class="text-muted">{{ l.relance.date|date('d/m') }}</small>
											{% else %}—{% endif %}
										</td>
										{% if is_granted('ROLE_PAIEMENT_ENCAISSER') and filtre != 'payees' %}
											<td class="text-end si-masque-mobile">
												{% if l.commande.clients %}<a href="{{ path('app_caisse_index', {client: l.commande.clients.id, commande: l.commande.id}) }}" class="btn btn-light btn-sm" title="Encaisser" aria-label="Encaisser {{ l.document }}"><i class="fas fa-cash-register"></i></a>{% endif %}
											</td>
										{% endif %}
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</form>
			{% endif %}
		</section>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		(function () {
			var form = document.getElementById('form-relances');
			var tout = document.getElementById('tout-cocher');
			if (!form || !tout) { return; }
			var cases = form.querySelectorAll('input[name="commandes[]"]');
			var maj = function () {
				var n = form.querySelectorAll('input[name="commandes[]"]:checked').length;
				document.querySelectorAll('[data-si-compte]').forEach(function (e) { e.textContent = n; });
				document.querySelectorAll('[data-si-selection]').forEach(function (b) { b.disabled = n === 0; });
				tout.checked = n === cases.length;
				tout.indeterminate = n > 0 && n < cases.length;
			};
			cases.forEach(function (c) { c.addEventListener('change', maj); });
			tout.addEventListener('change', function () { cases.forEach(function (c) { c.checked = tout.checked; }); maj(); });
			maj();
		})();
	</script>
{% endblock %}
