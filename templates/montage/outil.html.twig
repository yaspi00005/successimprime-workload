  if(!L.n){bump('bad');ck.push(['bad','Le format fini ne tient pas dans la zone imprimable',`Format ${fmtN(S.tw)} × ${fmtN(S.th)} mm + fond perdu ${fmtN(S.bleed)} mm, zone imprimable ${fmtN(L.W-2*S.margin,0)} × ${fmtN(L.H-2*S.margin,0)} mm.`]);return {level,ck}}
  ck.push(['ok',`${L.n} poses par feuille · ${L.cols} × ${L.rows}${L.rot?' · poses tournées':''}`,`Feuille ${L.W>L.H?'paysage':'portrait'}, rendement papier ${fmtN(100*L.n*S.tw*S.th/(L.W*L.H),0)} %.`]);
  if(S.target>0&&L.n<S.target){bump('warn');ck.push(['warn',`Objectif de ${S.target} poses non atteint`,suggest().join(' ')||'Aucun réglage simple ne permet d\'y arriver.'])}
  else if(S.target>0)ck.push(['ok',`Objectif de ${S.target} poses atteint`,'']);
  const mx=Math.min(L.x0-S.bleed,L.y0-S.bleed);ck.push(['ok','Tout est dans la zone imprimable',`Il reste ${fmtN(L.x0-S.bleed-S.margin)} mm sur les côtés et ${fmtN(L.y0-S.bleed-S.margin)} mm en haut et en bas.`]);
  const mk=marks(L);if(S.marks){const r=mk.room||{};const small=Math.min(r.top,r.bottom,r.left,r.right);if(small<2){bump('warn');ck.push(['warn','Peu de place pour les traits de coupe',`Traits raccourcis à ${fmtN(Math.max(small,0))} mm sur un bord : coupez en vous aidant des repères des autres bords.`])}else ck.push(['ok','Traits de coupe en place',`Longueur ${fmtN(Math.min(5,small))} mm, à 1,5 mm du fond perdu.`])}
  if(S.cut==='common')ck.push(['info','Coupe commune','Un seul coup de massicot entre deux poses. Évitez les cadres ou filets près du bord : ils seraient rognés de façon inégale.']);
  if(!files.recto){ck.push(['info','Aucun fichier chargé','Le calcul de pose fonctionne déjà ; chargez un fichier pour vérifier le contenu.']);return {level,ck}}
  if(G){
    if(G.contain){bump('warn');ck.push(['warn','Bandes blanches','En mode « Ajuster », le fichier ne remplit pas tout le format. Utilisez « Remplir » ou « Étirer » si le fond doit aller jusqu\'au bord.'])}
    if(G.aspectDiff>0.02){bump('warn');ck.push(['warn',`Fichier déformé de ${fmtN(G.aspectDiff*100,0)} %`,'Les proportions du fichier ne sont pas celles du format fini. À éviter sur un logo ou une photo.'])}
