{% extends 'base.html.twig' %}

{#
	Ventes › Produits et services (maquette PR01, docs/produits.md) : prix de
	base, coût de revient, marge, délai, machine et visibilité en ligne.
	Le coût et la marge ne sont dans la page qu'avec le droit « Marges et
	coûts de revient » (avec_couts) : sans lui, ils ne sont pas calculés.
#}

{% import 'produits/_macros.html.twig' as pd %}

{% block title %}Produits et services{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/produits.css') }}" rel="stylesheet">
{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile"><a href="{{ path('app_produits_export') }}" class="btn btn-light btn-sm si-btn-entete" title="Exporter la grille (CSV)"><i class="fas fa-download me-1"></i>Exporter</a></li>
	{% if modifiable %}
		<li class="nav-item"><a href="{{ path('app_produits_nouveau') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Nouveau produit</a></li>
	{% endif %}
{% endblock %}

{% block body %}
	{{ pd.onglets('catalogue') }}

	<div class="si-pd-kpis">
		<div class="si-pd-kpi">
			<span>Produits actifs</span>
			<strong>{{ indicateurs.actifs }}</strong>
			<small>dont {{ indicateurs.enLigne }} visible{{ indicateurs.enLigne > 1 ? 's' }} en ligne</small>
		</div>
		{% if avec_couts %}
			<div class="si-pd-kpi">
				<span>Marge moyenne</span>
				<strong class="{{ indicateurs.marge is not null and indicateurs.marge >= garde_fous.cible ? 'bon' : 'alerte' }}">{{ indicateurs.marge is null ? '—' : indicateurs.marge ~ ' %' }}</strong>
				<small>{{ indicateurs.ponderee ? 'pondérée par les ventes du mois' : 'moyenne simple (aucune vente ce mois)' }}</small>
			</div>
		{% endif %}
		<div class="si-pd-kpi">
			<span>Plus vendu ce mois</span>
			{% if indicateurs.meilleur %}
				{% set m = indicateurs.meilleur %}
				<strong title="{{ m.produit.nom }}">{{ m.produit.nomCommercial ?: m.produit.nom }}</strong>
				<small>{{ m.ventes.quantite|number_format(m.mode == 'metre_carre' ? 0 : 0, ',', ' ') }} {{ m.unite }}{{ m.mode != 'metre_carre' and m.ventes.quantite > 1 ? 's' }}{% if voir_ca %} · {{ pd.f(m.ventes.ca) }}{% endif %} · {{ m.ventes.clients }} client{{ m.ventes.clients > 1 ? 's' }}</small>
			{% else %}
				<strong>—</strong><small>aucune vente ce mois</small>
			{% endif %}
		</div>
		{% if avec_couts %}
			<div class="si-pd-kpi">
				<span>Marge sous {{ garde_fous.cible }} %</span>
				<strong class="{{ indicateurs.aRevoir > 0 ? 'alerte' : 'bon' }}">{{ indicateurs.aRevoir }} produit{{ indicateurs.aRevoir > 1 ? 's' }}</strong>
				<small>{{ indicateurs.aRevoir > 0 ? 'à revoir' : 'rien à revoir' }}</small>
			</div>
		{% else %}
			<div class="si-pd-kpi">
				<span>Masqués en ligne</span>
				<strong>{{ masques|length }}</strong>
				<small>toujours vendus au comptoir</small>
			</div>
		{% endif %}
	</div>

	<div class="si-pd-filtres">
		<nav class="si-pd-puces" aria-label="Familles">
			<a href="{{ path('app_produits_index', {q: recherche ?: null}) }}" class="si-pd-puce{{ famille is null ? ' actif' }}">Tous · {{ total }}</a>
			{% for f in familles %}
				<a href="{{ path('app_produits_index', {famille: f.id, q: recherche ?: null}) }}" class="si-pd-puce{{ famille == f.id ? ' actif' }}">{{ f.nom|replace({' (démo)': ''}) }} · {{ f.nombre }}</a>
			{% endfor %}
		</nav>
		<form method="get" class="si-pd-recherche" role="search">
			{% if famille %}<input type="hidden" name="famille" value="{{ famille }}">{% endif %}
			<i class="fas fa-search" aria-hidden="true"></i>
			<input type="search" name="q" value="{{ recherche }}" placeholder="Rechercher un produit" aria-label="Rechercher un produit">
		</form>
	</div>

	<div class="si-pd-carte">
		{% if lignes is empty %}
			<p class="text-muted mb-0">Aucun produit{{ recherche ? ' pour « ' ~ recherche ~ ' »' }}.</p>
		{% else %}
			<div class="si-pd-tableau table-responsive">
				<table class="si-pd-table">
					<thead>
						<tr>
							<th>Produit</th>
							<th>Catégorie</th>
							<th>Unité</th>
							<th class="si-pd-num">Prix de base</th>
							{% if avec_couts %}
								<th class="si-pd-num">Coût de revient</th>
								<th>Marge</th>
							{% endif %}
							<th class="si-pd-num">Délai</th>
							<th>Machine</th>
							<th class="text-center">En ligne</th>
						</tr>
					</thead>
					<tbody>
						{% for l in lignes %}
							{% set p = l.produit %}
							<tr{% if not p.actif %} class="si-pd-gris"{% endif %}>
								<td>
									<a href="{{ path('app_produits_fiche', {id: p.id}) }}" class="si-pd-nom">{{ pd.pastille(p) }}<span>{{ p.nom }}{% if p.nomCommercial %}<small>{{ p.nomCommercial }}</small>{% endif %}{% if not p.actif %}<small>hors vente</small>{% endif %}</span></a>
								</td>
								<td>{{ p.categorieProduit ? p.categorieProduit.nom|replace({' (démo)': ''}) : '—' }}</td>
								<td>{{ l.unite }}</td>
								<td class="si-pd-num"><b>{{ pd.f(l.prix) }}</b>{% if l.configurations > 1 %}<small class="d-block si-pd-gris">dès · {{ l.configurations }} config.</small>{% endif %}</td>
								{% if avec_couts %}
									<td class="si-pd-num si-pd-gris">{{ pd.f(l.cout) }}{% if l.coutSource == 'saisi' %}<small class="d-block">saisi</small>{% endif %}</td>
									<td>{{ pd.marge(l.marge, l.niveau) }}</td>
								{% endif %}
								<td class="si-pd-num">{{ l.delai ? l.delai ~ ' h' : '—' }}</td>
								<td>{{ l.machine ?: '—' }}</td>
								<td class="text-center">
									{% if modifiable %}
										<form method="post" action="{{ path('app_produits_en_ligne', {id: p.id}) }}" class="d-inline">
											<input type="hidden" name="_token" value="{{ csrf_token('produit-en-ligne-' ~ p.id) }}">
											<input type="hidden" name="retour" value="{{ app.request.requestUri }}">
											<button type="submit" class="si-pd-bascule{{ l.enLigne ? ' oui' }}" title="{{ l.enLigne ? 'Visible en ligne : cliquer pour masquer' : 'Masqué en ligne : cliquer pour montrer' }}" aria-label="{{ p.nom }} : {{ l.enLigne ? 'visible' : 'masqué' }} en ligne"></button>
										</form>
									{% else %}
										<span class="si-pd-bascule{{ l.enLigne ? ' oui' }}" role="img" aria-label="{{ l.enLigne ? 'Visible' : 'Masqué' }} en ligne"></span>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>

			<div class="si-pd-cartes">
				{% for l in lignes %}
					{% set p = l.produit %}
					<div class="si-pd-ligne">
						{{ pd.pastille(p) }}
						<a href="{{ path('app_produits_fiche', {id: p.id}) }}" class="si-pd-nom"><span>{{ p.nom }}{% if p.nomCommercial %}<small>{{ p.nomCommercial }}</small>{% endif %}</span></a>
						<span class="si-pd-bascule{{ l.enLigne ? ' oui' }}" role="img" aria-label="{{ l.enLigne ? 'Visible' : 'Masqué' }} en ligne"></span>
						<div class="si-pd-ligne-infos">
							<span><b>{{ pd.f(l.prix) }}</b> / {{ l.unite }}</span>
							{% if avec_couts %}<span>coût {{ pd.f(l.cout) }}</span><span>{{ pd.marge(l.marge, l.niveau) }}</span>{% endif %}
							<span>{{ l.delai ? l.delai ~ ' h' : 'délai —' }}</span>
							{% if l.machine %}<span>{{ l.machine }}</span>{% endif %}
						</div>
					</div>
				{% endfor %}
			</div>
		{% endif %}

		{% for l in masques %}
			<p class="si-pd-note"><b>{{ l.produit.nom }}</b> masqué en ligne{{ l.produit.motifHorsLigne ? ' : ' ~ l.produit.motifHorsLigne }}{{ l.produit.motifHorsLigne ? '' : ' ; toujours vendu au comptoir' }}.</p>
		{% endfor %}
	</div>

	<p class="si-pd-note">Le prix de base est celui de la configuration la moins chère. Le coût de revient se calcule avec les matières du stock (coût moyen), l'encre et le temps de la machine de chaque produit ; il n'est jamais montré en ligne.{% if not avec_couts %} Le coût et la marge demandent le droit « Marges et coûts de revient ».{% endif %}</p>
	<p class="d-md-none"><a href="{{ path('app_produits_export') }}" class="btn btn-light btn-sm"><i class="fas fa-download me-1"></i>Exporter la grille</a> <a href="{{ path('app_produits_options_index') }}" class="btn btn-light btn-sm">Options partagées</a></p>
{% endblock %}
