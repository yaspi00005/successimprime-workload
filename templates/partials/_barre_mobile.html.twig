{#
	Barre d'onglets en bas d'ecran sur telephone (maquette 41) : les
	sections principales, et « Plus » qui ouvre le menu complet.
#}
{% set sectionActive = section_admin(routeCourante) %}
<nav class="si-barre-mobile" aria-label="Navigation principale">
	{% for section, element in {
		accueil: { libelle: 'Résumé', icone: 'fas fa-home' },
		ventes: { libelle: 'Ventes', icone: 'fas fa-handshake' },
		finances: { libelle: 'Caisse', icone: 'fas fa-wallet' },
		clients: { libelle: 'Clients', icone: 'fas fa-users' }
	} %}
		{% set entree = null %}
		{% for onglet in onglets_section_admin(section) %}
			{% if entree is null and (onglet.role is null or is_granted(onglet.role)) %}{% set entree = onglet %}{% endif %}
		{% endfor %}
		{% if entree %}
			<a href="{{ path(entree.route, entree.parametres|default({})) }}" class="{{ sectionActive == section ? 'actif' }}">
				<i class="{{ element.icone }}"></i><span>{{ element.libelle }}</span>
			</a>
		{% endif %}
	{% endfor %}
	<button type="button" data-ouvrir-menu><i class="fas fa-bars"></i><span>Plus</span></button>
</nav>
