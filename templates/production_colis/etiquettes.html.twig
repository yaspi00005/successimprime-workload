{% extends 'fabrication/_base.html.twig' %}

{#
	PD05 Étiquettes à coller (maquette du 20/10/2026, docs/production-colis.md) :
	travaux terminés sans étiquette regroupés par commande, combien de colis,
	où coller, aperçu des étiquettes 100 × 60 mm puis impression (nouvel
	onglet ; cet onglet passe au contrôle final de la commande). Aucun montant.
#}

{% block title %}Étiquettes à coller{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/fabrication-colis.css') }}" rel="stylesheet">
	<link href="{{ asset('css/etiquette-colis.css') }}" rel="stylesheet">
{% endblock %}

{% block fab_actif %}etiquettes{% endblock %}

{% block fab_contenu %}
	{% set n = choisi ? choisi.n : 0 %}
	{% set imprimable = choisi and peutAgir and choisi.ordres is not empty %}
	<header class="si-fab-entete">
		<div>
			<p class="si-fab-ariane">Atelier › Production › Étiquettes</p>
			<h1 class="si-fab-titre">Étiquettes à coller sur les produits</h1>
		</div>
		<div class="si-fab-actions">
			<span class="si-fab-pastille si-colis-imprimante"><i class="fas fa-print" aria-hidden="true"></i>Imprimante : étiquettes 100 × 60 mm</span>
			<a class="si-fab-bouton" href="{{ path('app_atelier_operateur_scanner') }}"><i class="fas fa-qrcode" aria-hidden="true"></i>Scanner les étiquettes</a>
			{% if imprimable %}
				<button type="submit" form="si-colis-imprimer" class="si-fab-bouton principal"><i class="fas fa-print" aria-hidden="true"></i>Imprimer {{ n }} étiquette{{ n > 1 ? 's' }}</button>
			{% endif %}
		</div>
	</header>

	<div class="si-colis-grille">
		<div class="si-colis-gauche">
			<section class="si-fab-carte">
				<h2>Travaux terminés · sans étiquette</h2>
				{% if cartes is empty %}
					<p class="si-fab-muet mb-0">Aucun travail terminé sans étiquette. Un travail terminé dans Ma file arrive ici.</p>
				{% else %}
					<ul class="si-colis-liste">
						{% for c in cartes %}
							{% set actif = choisi and choisi.commande.id == c.commande.id %}
							<li>
								<a href="{{ path('app_atelier_production_etiquettes', {commande: c.commande.id}) }}" class="{{ actif ? 'actif' }}"{% if actif %} aria-current="true"{% endif %}>
									<span class="si-colis-coche" aria-hidden="true">{% if actif %}<i class="fas fa-check"></i>{% endif %}</span>
									<span class="si-colis-texte">
										<b>{{ c.commande.numero }} · {{ c.client.nom }}</b>
										<small>{{ c.resume }}{% if c.enProduction %} · {{ c.enProduction }} travail encore en production{% endif %}{% if c.remplacees %} · {{ c.remplacees }} étiquette{{ c.remplacees > 1 ? 's' }} à remplacer{% endif %}</small>
									</span>
									<span class="si-colis-nb">{{ c.colis }} {{ c.cartons ? 'carton' : 'colis' }}{{ c.cartons and c.colis > 1 ? 's' }}</span>
								</a>
							</li>
						{% endfor %}
					</ul>
				{% endif %}
			</section>

			{% if choisi and choisi.ordres is not empty %}
				<section class="si-fab-carte">
					<h2>Combien de colis ?</h2>
					<div class="si-colis-compteur">
						{% if n > 1 %}
							<a class="si-colis-pas" href="{{ path('app_atelier_production_etiquettes', {commande: choisi.commande.id, colis: n - 1}) }}" aria-label="Un colis de moins">−</a>
						{% else %}
							<span class="si-colis-pas inactif" aria-hidden="true">−</span>
						{% endif %}
						<output aria-live="polite" aria-label="Nombre de colis">{{ n }}</output>
						{% if n < choisi.max %}
							<a class="si-colis-pas" href="{{ path('app_atelier_production_etiquettes', {commande: choisi.commande.id, colis: n + 1}) }}" aria-label="Un colis de plus">+</a>
						{% else %}
							<span class="si-colis-pas inactif" aria-hidden="true">+</span>
						{% endif %}
						<p>1 étiquette par colis, numérotées 1/{{ n }}{% if n > 1 %}{{ n > 2 ? ' à ' : ' et ' }}{{ n }}/{{ n }}{% endif %}.{% if choisi.suggestion != n %} Conseillé : {{ choisi.suggestion }}.{% endif %}</p>
					</div>
				</section>
			{% endif %}

			<section class="si-fab-carte">
				<h2>Où coller</h2>
				{% set emballages = choisi ? choisi.colis|map(p => p.emballage) : [] %}
				<ul class="si-colis-ou">
					{% for cle, o in ouColler %}
						{% if cle != 'autre' or cle in emballages %}
							<li class="{{ cle in emballages ? 'actif' }}"><b>{{ o.libelle }}</b> : {{ o.conseil }}</li>
						{% endif %}
					{% endfor %}
				</ul>
			</section>
		</div>

		<section class="si-colis-apercu" aria-label="Aperçu des étiquettes">
			<p class="si-colis-apercu-titre">Aperçu · étiquette thermique 100 × 60 mm</p>
			{% if choisi is null %}
				<p class="si-colis-apercu-vide">Choisissez une commande à gauche.</p>
			{% else %}
				<p class="si-colis-apercu-cmd">
					<b>{{ choisi.commande.numero }} · {{ choisi.client.nom }}</b>{{ choisi.client.societe ? ' · ' ~ choisi.client.societe }}
					<span>{{ choisi.livraison.retrait ? 'Retrait à l\'imprimerie' : 'Livraison ' ~ (choisi.livraison.jourCourt ?? 'à planifier') ~ (choisi.livraison.zone ? ' · ' ~ choisi.livraison.zone) }}</span>
				</p>
				{% if choisi.enProduction %}
					<p class="si-colis-alerte">{{ choisi.enProduction }} travail de cette commande est encore en production : il aura ses étiquettes quand il sera terminé (une nouvelle série remplacera celle-ci).</p>
				{% endif %}
				{% if choisi.ordres is empty %}
					<p class="si-colis-apercu-vide">Rien à étiqueter pour {{ choisi.commande.numero }} : aucun travail terminé en attente.</p>
				{% else %}
					<div class="si-colis-planche">
						{% for e in choisi.apercus %}
							{% include 'production_colis/_etiquette.html.twig' with {e: e} only %}
						{% endfor %}
					</div>
				{% endif %}

				{% if choisi.actifs is not empty %}
					<div class="si-colis-deja">
						<p><b>Déjà imprimées :</b>
							{% for c in choisi.actifs %}{{ c.code }}{{ c.scanneLe ? ' (scanné ' ~ c.scanneLe|date('H:i') ~ ')' }}{{ not loop.last ? ', ' }}{% endfor %}.
						</p>
						{% if peutAgir %}
							<form method="post" action="{{ path('app_atelier_production_etiquettes_reimprimer', {id: choisi.commande.id}) }}" target="_blank">
								<input type="hidden" name="_token" value="{{ csrf_token('production-colis') }}">
								<button class="si-fab-bouton"><i class="fas fa-redo" aria-hidden="true"></i>Réimprimer les mêmes</button>
							</form>
						{% endif %}
						<a class="si-fab-bouton" href="{{ path('app_atelier_production_controle_commande', {id: choisi.commande.id}) }}">Contrôle final</a>
					</div>
				{% endif %}

				{% if imprimable %}
					<form id="si-colis-imprimer" method="post" action="{{ path('app_atelier_production_etiquettes_imprimer', {id: choisi.commande.id}) }}" target="_blank" data-si-colis-suite="{{ path('app_atelier_production_controle_commande', {id: choisi.commande.id}) }}"{% if choisi.actifs is not empty %} data-confirmer="Remplacer les {{ choisi.actifs|length }} étiquette{{ choisi.actifs|length > 1 ? 's' }} déjà imprimée{{ choisi.actifs|length > 1 ? 's' }} ?" data-confirmer-detail="Les anciennes ne seront plus acceptées au scan : collez les nouvelles." data-confirmer-bouton="Imprimer {{ n }} étiquette{{ n > 1 ? 's' }}"{% endif %}>
						<input type="hidden" name="_token" value="{{ csrf_token('production-colis') }}">
						<input type="hidden" name="colis" value="{{ n }}">
						<button class="si-fab-bouton principal si-colis-imprimer-bas"><i class="fas fa-print" aria-hidden="true"></i>Imprimer {{ n }} étiquette{{ n > 1 ? 's' }}</button>
					</form>
				{% elseif choisi.ordres is not empty and not peutAgir %}
					<p class="si-colis-apercu-vide">Imprimer demande le droit « Statuts de production ».</p>
				{% endif %}
			{% endif %}
		</section>
	</div>

	<script>
		(function () {
			// Après l'envoi (impression dans un nouvel onglet), cet onglet passe au contrôle final de la commande.
			var form = document.querySelector('[data-si-colis-suite]');
			if (!form) { return; }
			form.addEventListener('submit', function () {
				var suite = form.getAttribute('data-si-colis-suite');
				setTimeout(function () { window.location.href = suite; }, 600);
			});
		})();
	</script>
{% endblock %}
