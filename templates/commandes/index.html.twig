{% extends 'base.html.twig' %}

{#
	Commandes : liste avec étape, paiement, échéance et responsable (maquette
	GC01) et tableau par étape (GC02), sur la même adresse. Données :
	SuiviCommercial. La part payée et le reste à encaisser ne sont montrés
	qu'avec le droit de voir les paiements.
#}

{% set voirPaiements = is_granted('ROLE_PAIEMENT_VOIR') %}
{% set rechercheActive =
	filtres.q or filtres.client or filtres.statut or filtres.etat or filtres.paiement
	or filtres.date_debut or filtres.date_fin or filtres.montant_min or filtres.montant_max
	or filtres.affichage == 'toutes' or filtres.tri != 'recent'
%}
{% set jours = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'] %}

{% macro lien(filtres, changements) %}{{ path('app_commandes_index', filtres|merge(changements)) }}{% endmacro %}
{% import _self as m %}

{% block title %}Commandes{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/commandes-suivi.css') }}" rel="stylesheet">
{% endblock %}

{% block body %}
	<div class="si-cs-tete">
		<div>
			<small>Devis et commandes</small>
			<h1>{{ vue == 'tableau' ? 'Tableau des commandes · par étape' : 'Commandes' }}</h1>
		</div>
		<div class="si-cs-actions">
			{% if is_granted('ROLE_DEVIS') %}
				<a href="{{ path('app_devis_index') }}" class="btn si-cs-btn-blanc">Devis</a>
			{% endif %}
			<a href="{{ path('app_commandes_export', filtres) }}" class="btn si-cs-btn-blanc"><i class="fas fa-download me-1"></i>Exporter</a>
			<a href="{{ path('app_commandes_new') }}" class="btn btn-danger"><i class="fas fa-plus me-1"></i>Commande</a>
		</div>
	</div>

	{% if vue == 'liste' %}
		{# ---------- Cartes : toujours sur les commandes actives ---------- #}
		<div class="si-cs-cartes">
			<a class="si-cs-carte{{ not filtres.etape and not filtres.pour ? ' actif' }}" href="{{ m.lien(filtres, {etape: '', pour: ''}) }}">
				<span>En cours</span>
				<strong>{{ cartes.enCours }}</strong>
				<small>commande{{ cartes.enCours > 1 ? 's' }} ouverte{{ cartes.enCours > 1 ? 's' }}</small>
			</a>
			<a class="si-cs-carte{{ filtres.pour == 'aujourdhui' ? ' actif' }}" href="{{ m.lien(filtres, {pour: filtres.pour == 'aujourdhui' ? '' : 'aujourdhui', etape: ''}) }}">
				<span>À livrer aujourd'hui</span>
				<strong>{{ cartes.aujourdhui }}</strong>
				<small>{{ cartes.aujourdhuiEnLivraison ? 'dont ' ~ cartes.aujourdhuiEnLivraison ~ ' en livraison' : (cartes.aujourdhui ? 'à préparer' : 'rien de prévu') }}</small>
			</a>
			<a class="si-cs-carte{{ filtres.etape == 'retard' ? ' actif' }}" href="{{ m.lien(filtres, {etape: filtres.etape == 'retard' ? '' : 'retard', pour: ''}) }}">
				<span>En retard</span>
				<strong class="{{ cartes.retard ? 'si-cs-rouge' }}">{{ cartes.retard }}</strong>
				<small>{% if cartes.retard %}{{ [cartes.retardBat ? cartes.retardBat ~ ' avant impression' : null, cartes.retardProduction ? cartes.retardProduction ~ ' en production ou livraison' : null]|filter(v => v)|join(' · ') }}{% else %}aucune échéance dépassée{% endif %}</small>
			</a>
			<a class="si-cs-carte{{ filtres.etape == 'acompte' ? ' actif' }}" href="{{ m.lien(filtres, {etape: filtres.etape == 'acompte' ? '' : 'acompte', pour: ''}) }}">
				<span>Acomptes attendus</span>
				<strong class="{{ cartes.acomptes ? 'si-cs-orange' }}">{{ cartes.acomptes }}</strong>
				<small>{{ cartes.acomptes ? 'production bloquée' : 'aucun' }}</small>
			</a>
			{% if voirPaiements %}
				<div class="si-cs-carte si-cs-carte-large">
					<span>Reste à encaisser</span>
					<strong>{{ cartes.reste|number_format(0, ',', ' ') }} F</strong>
					<small>commandes en cours et livrées non soldées</small>
				</div>
			{% endif %}
		</div>
	{% endif %}

	{# ---------- Étapes, bascule Liste / Tableau, recherche ---------- #}
	<div class="si-cs-barre">
		{% if vue == 'liste' %}
			<nav class="si-cs-puces" aria-label="Filtrer par étape">
				<a href="{{ m.lien(filtres, {etape: ''}) }}" class="si-cs-puce{{ not filtres.etape ? ' actif' }}">Toutes · {{ compteurs.toutes }}</a>
				{% for cle in ['a_confirmer', 'acompte', 'fichier', 'impression', 'prete', 'livraison', 'livree'] %}
					{% if compteurs[cle] > 0 or filtres.etape == cle or cle in ['acompte', 'fichier', 'impression', 'prete', 'livraison'] %}
						<a href="{{ m.lien(filtres, {etape: filtres.etape == cle ? '' : cle}) }}" class="si-cs-puce{{ filtres.etape == cle ? ' actif' }}">{{ etapes[cle].pluriel }} · {{ compteurs[cle] }}</a>
					{% endif %}
				{% endfor %}
				<a href="{{ m.lien(filtres, {etape: filtres.etape == 'retard' ? '' : 'retard'}) }}" class="si-cs-puce si-cs-puce-rouge{{ filtres.etape == 'retard' ? ' actif' }}">En retard · {{ compteurs.retard }}</a>
			</nav>
		{% else %}
			<form method="get" action="{{ path('app_commandes_index') }}" class="d-flex flex-wrap gap-2 align-items-center">
				{% for cle, valeur in filtres|filter((v, k) => k != 'pour') %}<input type="hidden" name="{{ cle }}" value="{{ valeur }}">{% endfor %}
				<label class="visually-hidden" for="filtre-pour">Échéance</label>
				<select id="filtre-pour" name="pour" class="form-select form-select-sm" onchange="this.form.submit()">
					<option value="">Filtre : toutes les échéances</option>
					{% for cle, libelle in choixPour %}
						<option value="{{ cle }}" {{ filtres.pour == cle ? 'selected' }}>Filtre : {{ libelle|lower }}</option>
					{% endfor %}
				</select>
				<noscript><button type="submit" class="btn btn-sm si-cs-btn-blanc">OK</button></noscript>
			</form>
		{% endif %}
		<div class="si-cs-bascule">
			<a href="{{ path('app_commandes_index', {vue: 'liste'}) }}" class="{{ vue == 'liste' ? 'actif' }}"><i class="fas fa-list"></i>Liste</a>
			<a href="{{ path('app_commandes_index', {vue: 'tableau'}) }}" class="{{ vue == 'tableau' ? 'actif' }}"><i class="fas fa-columns"></i>Tableau</a>
			<button type="button" data-bs-toggle="collapse" data-bs-target="#recherche-commandes" aria-expanded="{{ rechercheActive ? 'true' : 'false' }}" aria-controls="recherche-commandes">
				<i class="fas fa-filter"></i>Recherche{% if rechercheActive %} <span class="si-cs-pastille-filtre">active</span>{% endif %}
			</button>
		</div>
	</div>

	{# ---------- Recherche avancée (celle d'avant, repliée) ---------- #}
	<div class="collapse{{ rechercheActive ? ' show' }}" id="recherche-commandes">
		<form method="get" action="{{ path('app_commandes_index') }}" class="card si-cs-recherche">
			<input type="hidden" name="etape" value="{{ filtres.etape }}">
			<input type="hidden" name="pour" value="{{ filtres.pour }}">
			<div class="card-body">
				<div>
					<label class="form-label" for="r-q">Recherche</label>
					<input type="search" id="r-q" name="q" class="form-control form-control-sm" value="{{ filtres.q }}" placeholder="N° de commande, client, téléphone…">
				</div>
				<div>
					<label class="form-label" for="r-client">Client</label>
					<select id="r-client" name="client" class="form-select form-select-sm custom-select">
						<option value="">Tous les clients</option>
						{% for client in clients %}
							<option value="{{ client.id }}" {{ filtres.client == client.id ? 'selected' }}>{{ client.telephone|default('Sans téléphone') }} — {{ (client.prenom|default('') ~ ' ' ~ client.nom|default(''))|trim }}{% if client.raisonSociale %} — {{ client.raisonSociale }}{% endif %}</option>
						{% endfor %}
					</select>
				</div>
				<div>
					<label class="form-label" for="r-etat">État des travaux</label>
					<select id="r-etat" name="etat" class="form-select form-select-sm">
						<option value="">Tous les états</option>
						<option value="preparation" {{ filtres.etat == 'preparation' ? 'selected' }}>En préparation</option>
						<option value="livraison" {{ filtres.etat == 'livraison' ? 'selected' }}>En livraison</option>
						<option value="livree" {{ filtres.etat == 'livree' ? 'selected' }}>Livrée</option>
					</select>
				</div>
				<div>
					<label class="form-label" for="r-paiement">Situation financière</label>
					<select id="r-paiement" name="paiement" class="form-select form-select-sm">
						<option value="">Toutes</option>
						<option value="impayee" {{ filtres.paiement == 'impayee' ? 'selected' }}>Non payée</option>
						<option value="partielle" {{ filtres.paiement == 'partielle' ? 'selected' }}>Paiement partiel</option>
						<option value="payee" {{ filtres.paiement == 'payee' ? 'selected' }}>Entièrement payée</option>
					</select>
				</div>
				<div>
					<label class="form-label" for="r-du">Commandées du</label>
					<input type="date" id="r-du" name="date_debut" class="form-control form-control-sm" value="{{ filtres.date_debut }}">
				</div>
				<div>
					<label class="form-label" for="r-au">au</label>
					<input type="date" id="r-au" name="date_fin" class="form-control form-control-sm" value="{{ filtres.date_fin }}">
				</div>
				<div>
					<label class="form-label" for="r-min">Montant min.</label>
					<input type="number" min="0" id="r-min" name="montant_min" class="form-control form-control-sm" value="{{ filtres.montant_min }}" placeholder="0">
				</div>
				<div>
					<label class="form-label" for="r-max">Montant max.</label>
					<input type="number" min="0" id="r-max" name="montant_max" class="form-control form-control-sm" value="{{ filtres.montant_max }}" placeholder="Illimité">
				</div>
				<div>
					<label class="form-label" for="r-affichage">Afficher</label>
					<select id="r-affichage" name="affichage" class="form-select form-select-sm">
						<option value="actives" {{ filtres.affichage == 'actives' ? 'selected' }}>Commandes actives</option>
						<option value="toutes" {{ filtres.affichage == 'toutes' ? 'selected' }}>Toutes les commandes</option>
					</select>
				</div>
				<div>
					<label class="form-label" for="r-tri">Trier par</label>
					<select id="r-tri" name="tri" class="form-select form-select-sm">
						<option value="recent" {{ filtres.tri == 'recent' ? 'selected' }}>Plus récentes</option>
						<option value="ancien" {{ filtres.tri == 'ancien' ? 'selected' }}>Plus anciennes</option>
						<option value="montant_desc" {{ filtres.tri == 'montant_desc' ? 'selected' }}>Montant décroissant</option>
						{% if voirPaiements %}<option value="reste_desc" {{ filtres.tri == 'reste_desc' ? 'selected' }}>Reste à payer décroissant</option>{% endif %}
					</select>
				</div>
				<div class="si-cs-boutons">
					<button type="submit" class="btn btn-primary btn-sm flex-grow-1"><i class="fas fa-search me-1"></i>Rechercher</button>
					<a href="{{ path('app_commandes_index', {reset: 1}) }}" class="btn btn-light btn-sm">Réinitialiser</a>
				</div>
			</div>
		</form>
	</div>

	{% if vue == 'liste' %}
		{# ---------- Liste (GC01) ---------- #}
		<div class="si-cs-liste">
			<div class="table-responsive">
				<table class="table si-cs-table">
					<thead>
						<tr>
							<th scope="col">N°</th>
							<th scope="col">Client</th>
							<th scope="col">Produit</th>
							<th scope="col" class="text-end">Montant</th>
							{% if voirPaiements %}<th scope="col" data-filtre-type="nombre">Payé</th>{% endif %}
							<th scope="col">Étape</th>
							<th scope="col" data-filtre-type="date">Pour le</th>
							<th scope="col">Responsable</th>
							<th scope="col" data-sans-filtre><span class="visually-hidden">Actions</span></th>
						</tr>
					</thead>
					<tbody>
						{% for l in lignes %}
							{% set commande = l.commande %}
							<tr class="{{ l.enRetard ? 'si-cs-retard' }}" data-lien="{{ path('app_commandes_show', {id: commande.id}) }}">
								<td class="si-cs-c-num"><a href="{{ path('app_commandes_show', {id: commande.id}) }}" class="si-cs-num">{{ commande.numero }}</a></td>
								<td class="si-cs-c-client" data-filtre-valeur="{{ l.client.nom }}">
									<span class="si-cs-client"><span class="si-cs-pastille si-cs-teinte-{{ l.client.teinte }}" aria-hidden="true">{{ l.client.initiales }}</span><span>{{ l.client.nom }}</span></span>
								</td>
								<td class="si-cs-c-produit" data-filtre-valeur="{{ l.produit }}"><div class="si-cs-produit" title="{{ l.produit }}">{{ l.produit }}{% if l.autres %} <small>+{{ l.autres }}</small>{% endif %}</div></td>
								<td class="si-cs-c-montant si-cs-montant">{{ l.total|number_format(0, ',', ' ') }} F</td>
								{% if voirPaiements %}
									<td class="si-cs-c-paye" data-filtre-valeur="{{ l.partPayee }}">
										<span class="si-cs-paye" title="Payé {{ l.paye|number_format(0, ',', ' ') }} F · reste {{ l.reste|number_format(0, ',', ' ') }} F">
											<span class="si-cs-paye-piste"><span class="{{ l.partPayee >= 100 ? 'complet' }}" style="width: {{ l.partPayee }}%"></span></span>
											<small>{{ l.partPayee }} %</small>
										</span>
									</td>
								{% endif %}
								<td class="si-cs-c-etape" data-filtre-valeur="{{ l.libelle }}"><span class="si-cs-etape si-cs-etape-{{ l.couleur }}" {% if l.etat %}title="{{ l.etat }}"{% endif %}>{{ l.libelle }}</span></td>
								<td class="si-cs-c-pour{{ l.pourLe ? '' : ' sans-date' }}" data-filtre-valeur="{{ l.pourLe ? l.pourLe|date('d/m/Y') : '' }}">
									{% if l.pourLe %}<span class="si-cs-date{{ l.enRetard ? ' retard' }}" title="{{ jours[l.pourLe|date('w')] }} {{ l.pourLe|date('d/m/Y') }}{{ l.retrait ? ' · retrait' : ' · livraison' }}">{{ l.pourLe|date('d/m') }}</span>{% else %}<span class="si-cs-vide">—</span>{% endif %}
								</td>
								<td class="si-cs-c-resp" data-filtre-valeur="{{ l.responsable ? l.responsable.nom : '' }}">
									{% if l.responsable %}
										<span class="si-cs-personne" title="{{ l.responsable.complet }}"><span class="si-cs-disque si-initiales-{{ l.responsable.teinte }}" aria-hidden="true">{{ l.responsable.initiales }}</span>{{ l.responsable.nom }}</span>
									{% else %}<span class="si-cs-vide">—</span>{% endif %}
								</td>
								<td class="si-cs-c-actions text-end">
									{% if l.ouverte and not l.verrouillee %}
										<a href="{{ path('app_commandes_edit', {id: commande.id}) }}" class="si-cs-modifier" title="Modifier {{ commande.numero }}" aria-label="Modifier {{ commande.numero }}"><i class="fas fa-pen"></i></a>
									{% endif %}
								</td>
							</tr>
						{% else %}
							<tr>
								<td colspan="{{ voirPaiements ? 9 : 8 }}">
									<div class="si-cs-aucune">
										<i class="fas fa-inbox" aria-hidden="true"></i>
										<strong class="d-block text-body">Aucune commande trouvée</strong>
										Changez d'étape ou de recherche.
										<div class="mt-2"><a href="{{ path('app_commandes_index', {reset: 1}) }}" class="btn btn-sm si-cs-btn-blanc">Revoir les commandes actives</a></div>
									</div>
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		</div>
	{% else %}
		{# ---------- Tableau par étape (GC02) ---------- #}
		<div class="si-cs-tableau">
			{% for cle, colonne in colonnes %}
				<section class="si-cs-colonne" aria-labelledby="colonne-{{ cle }}">
					<header>
						<span id="colonne-{{ cle }}" class="si-cs-etape si-cs-etape-{{ colonne.couleur }}">{{ colonne.libelle }}</span>
						<b>{{ colonne.cartes|length }}</b>
						{% if cle in ['acompte', 'fichier'] %}<a href="{{ path('app_commandes_new') }}" title="Nouvelle commande" aria-label="Nouvelle commande">+</a>{% endif %}
					</header>
					<div class="si-cs-cartes-etape">
						{% for l in colonne.cartes %}
							{% set commande = l.commande %}
							<a href="{{ path('app_commandes_show', {id: commande.id}) }}" class="si-cs-fiche{{ l.enRetard ? ' retard' }}">
								<span class="si-cs-fiche-tete">
									<b>{{ commande.numero }}</b>
									{% if l.pourLe %}<small class="{{ l.enRetard ? 'retard' }}"><i class="far fa-calendar me-1" aria-hidden="true"></i>{{ l.pourLe|date('d/m') }}</small>{% endif %}
								</span>
								<span class="si-cs-client"><span class="si-cs-pastille si-cs-teinte-{{ l.client.teinte }}" aria-hidden="true">{{ l.client.initiales }}</span><span>{{ l.client.nom }}</span></span>
								<span class="si-cs-fiche-produit">{{ l.produit }}{% if l.autres %} · +{{ l.autres }}{% endif %}</span>
								{% if l.etat %}<span class="si-cs-fiche-etat{{ l.alerte or (l.enRetard and cle == 'fichier') ? ' alerte' }}">{{ l.etat }}</span>{% endif %}
								<span class="si-cs-fiche-pied">
									<b>{{ l.total|number_format(0, ',', ' ') }} F</b>
									{% if l.responsable %}<span class="si-cs-disque si-initiales-{{ l.responsable.teinte }}" title="{{ l.responsable.complet }}">{{ l.responsable.initiales }}</span>{% endif %}
								</span>
							</a>
						{% else %}
							<p class="si-cs-colonne-vide">Aucune commande</p>
						{% endfor %}
					</div>
				</section>
			{% endfor %}
		</div>
	{% endif %}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script>
		document.addEventListener('DOMContentLoaded', function () {
			// Toute la ligne ouvre la commande (sauf ses liens et boutons).
			document.querySelectorAll('.si-cs-table tr[data-lien]').forEach(function (ligne) {
				ligne.addEventListener('click', function (e) {
					if (e.target.closest('a, button, input, label') || window.getSelection().toString()) {
						return;
					}
					window.location.href = ligne.dataset.lien;
				});
			});
			if (window.jQuery && window.jQuery.fn.select2) {
				window.jQuery('#r-client').select2({width: '100%'});
			}
		});
	</script>
{% endblock %}
