{% extends 'base.html.twig' %}

{% set nom = client.nomComplet %}
{% set initiales = nom|split(' ')|filter(m => m)|slice(0, 2)|map(m => m|first|upper)|join('') %}

{% block title %}{{ nom }}{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_clients_modifier', {publicId: client.publicId}) }}" class="btn btn-light btn-sm si-btn-entete">Modifier</a>
	</li>
	{% if whatsapp %}
		<li class="nav-item">
			<a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noopener" class="btn btn-success btn-sm si-btn-entete"><i class="fab fa-whatsapp me-1"></i>WhatsApp</a>
		</li>
	{% endif %}
	{% if is_granted('ROLE_DEVIS') %}
		<li class="nav-item">
			<a href="{{ path('app_devis_new', {client: client.id}) }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Devis</a>
		</li>
	{% endif %}
{% endblock %}

{% block body %}
	{# « Envoyer l'accès à l'espace client » : caché en « Voir » (et refusé par LectureSeuleSubscriber). #}
	{% set accesEspacePossible = acces_espace.possible and not module_en_lecture(app.request.attributes.get('_route')) %}
	{% if invitation and accesEspacePossible %}
		<div class="si-cf-doublon si-fh-invitation">
			<b><i class="fab fa-whatsapp me-1"></i>Espace client</b>
			<span>Envoyez au client son accès sur WhatsApp : son identifiant, un code valable 48 h et le lien de la première connexion.</span>
			<form method="post" action="{{ path('app_clients_acces_espace', {publicId: client.publicId}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('acces-espace-' ~ client.id) }}">
				<button type="submit" class="btn btn-success btn-sm">Envoyer l'accès</button>
			</form>
		</div>
	{% endif %}
	{% include 'clients/_proposition_client.html.twig' %}
	<div class="si-fiche">
		<aside class="card si-fiche-identite">
			<div class="si-fiche-avatar" aria-hidden="true" style="background: {{ ['#0F4590', '#E8590C', '#0E7C66', '#15A34A', '#6B7280', '#DB2777', '#2563EB', '#7C2D12', '#DC2626'][client.id % 9] }}">{{ initiales ?: '?' }}</div>
			<h2>{{ nom }}</h2>
			<p class="si-fiche-badges">
				<span class="si-badge si-badge-bleu">{{ client.typeCompteLabel }}</span>
				<span class="si-badge {{ {actif: 'si-badge-vert', relance: 'si-badge-orange', inactif: '', nouveau: 'si-badge-bleu', bloque: 'si-badge-rouge'}[statut] }}">{{ constant('App\\Service\\Clients\\ListeClients::STATUTS')[statut] }}</span>
				{% if client.createdAt %}<span class="si-badge">Client depuis {{ client.createdAt|date('Y') }}</span>{% endif %}
			</p>
			<div class="si-fh-rapide si-seul-mobile">
				{% if client.telephone %}<a href="tel:+223{{ client.telephone|slice(-8) }}" class="btn btn-light btn-sm"><i class="fas fa-phone me-1"></i>Appeler</a>{% endif %}
				{% if whatsapp %}<a href="https://wa.me/{{ whatsapp }}" target="_blank" rel="noopener" class="btn btn-light btn-sm"><i class="fab fa-whatsapp me-1"></i>WhatsApp</a>{% endif %}
				{% if is_granted('ROLE_DEVIS') %}<a href="{{ path('app_devis_new', {client: client.id}) }}" class="btn btn-light btn-sm"><i class="far fa-file-alt me-1"></i>Devis</a>{% endif %}
			</div>
			<details class="si-fh-plus" open>
			<summary>Coordonnées, conditions et notes</summary>
			<dl>
				<dt>Contacts</dt>
				{% for k in contacts %}
					<dd><b>{{ k.nom }}</b>{{ k.fonction ? ' · ' ~ k.fonction }}{% if k.role != 'principal' %} · {{ k.roleLabel|lower }}{% endif %}
						{% if k.telephone %}<small class="d-block"><a href="tel:+223{{ k.telephone }}">+223 {{ k.telephoneAffiche }}</a>{{ k.whatsapp ? ' · WhatsApp' }}</small>{% endif %}
					</dd>
				{% else %}
					<dd>{% if client.telephone %}<a href="tel:{{ client.telephone }}">{{ client.telephone }}</a>{% if client.telephone2 %} · <a href="tel:{{ client.telephone2 }}">{{ client.telephone2 }}</a>{% endif %}{% else %}—{% endif %}</dd>
				{% endfor %}
				{% if client.email %}<dt>E-mail</dt><dd><a href="mailto:{{ client.email }}">{{ client.email }}</a></dd>{% endif %}
				{% set adresse = [client.quartier, client.commune, client.adresse, client.ville]|filter(v => v)|join(', ') %}
				{% if adresse or client.repere %}
					<dt>Adresse</dt>
					<dd>
						{{ adresse }}{% if client.repere %}{{ adresse ? ' · ' }}repère : {{ client.repere }}{% endif %}
						{% if client.latitude and client.longitude %}<a href="https://www.google.com/maps?q={{ client.latitude }},{{ client.longitude }}" target="_blank" rel="noopener" class="d-block">Voir sur la carte</a>{% endif %}
					</dd>
				{% endif %}
				{% if client.nif or client.rccm %}
					<dt>Identifiants</dt>
					<dd>{{ [client.nif ? 'NIF ' ~ client.nif, client.rccm ? 'RCCM ' ~ client.rccm]|filter(v => v)|join(' · ') }}</dd>
				{% endif %}
				{% set conditions = [client.delaiPaiementLabel, client.remiseHabituelle ? 'remise ' ~ client.remiseHabituelle|number_format(client.remiseHabituelle == client.remiseHabituelle|round ? 0 : 1, ',') ~ ' %', client.sansAcompte ? 'dispensé d\'acompte' : (client.acompte ? 'acompte ' ~ client.acompte ~ ' %'), client.moyenPrefereLabel, client.typeClient == 'B2B' ? 'grille Revendeur (B2B)']|filter(v => v) %}
				{% if conditions is not empty or voir_paiements %}
					<dt>Conditions</dt>
					{% if conditions is not empty %}<dd>{{ conditions|join(' · ') }}</dd>{% endif %}
					{% if voir_paiements %}
						<dd>
							Plafond {{ client.plafondCredit ? client.plafondCredit|number_format(0, ',', ' ') ~ ' F' : 'aucun' }} · utilisé {{ kpi.solde_du|number_format(0, ',', ' ') }} F
							{% if client.plafondCredit %}
								{% set part = min(100, (kpi.solde_du * 100 / client.plafondCredit)|round) %}
								<span class="si-fh-jauge" role="img" aria-label="{{ part }} % du plafond utilisé"><span style="width: {{ part }}%" class="{{ part >= 90 ? 'si-fh-plein' : (part >= 60 ? 'si-fh-moitie') }}"></span></span>
								{% if kpi.solde_du > client.plafondCredit %}<small class="d-block text-danger fw-semibold">Plafond dépassé</small>{% endif %}
							{% endif %}
						</dd>
					{% endif %}
				{% endif %}
				{% if client.suiviPar %}<dt>Suivi par</dt><dd>{{ client.suiviPar|nom_pointage }}</dd>{% endif %}
			</dl>
			{% if client.observation %}
				<p class="si-fiche-note"><strong>Note :</strong> {{ client.observation }}</p>
			{% endif %}
			{% if client.etiquettes is not empty %}
				<p class="si-fh-etiquettes">{% for e in client.etiquettes %}<span>{{ e }}</span>{% endfor %}</p>
			{% endif %}
			<div class="si-fh-liens">
				<a href="{{ path('app_clients_journal', {publicId: client.publicId}) }}" class="btn btn-light btn-sm"><i class="fas fa-history me-1"></i>Journal des modifications</a>
				<a href="{{ path('app_clients_detail', {publicId: client.publicId}) }}" class="btn btn-light btn-sm">Fiche détaillée</a>
				<a href="{{ path('app_clients_modifier', {publicId: client.publicId}) }}" class="btn btn-outline-primary btn-sm">Modifier</a>
				{# Supprimer le client : la Direction seulement, 30 jours dans la corbeille (Yaya, 18/10/2026). #}
				{% if is_granted('ROLE_ADMIN') and suppression_impossible %}
					<p class="si-fh-suppression-impossible"><i class="fas fa-info-circle me-1"></i>{{ suppression_impossible }}</p>
				{% elseif is_granted('ROLE_ADMIN') %}
					<form method="post" action="{{ path('app_clients_delete', {id: client.id}) }}" class="si-fh-supprimer" {{ confirmer_suppression('le client ' ~ nom, {detail: 'Ses commandes, devis et factures restent ; la fiche ne s\'affiche plus dans les listes.'}) }}>
						<input type="hidden" name="_token" value="{{ csrf_token('supprimer-client-' ~ client.id) }}">
						<button type="submit" class="btn btn-outline-danger btn-sm"><i class="far fa-trash-alt me-1"></i>Supprimer</button>
					</form>
				{% endif %}
			</div>
			</details>
			{% set dernierAcces = acces_espace.dernier %}
			{% if accesEspacePossible or dernierAcces %}
				<div class="si-fh-espace">
					<h3>Espace client</h3>
					{% if dernierAcces %}
						<p>
							Dernier accès envoyé le {{ dernierAcces.creeLe|date('d/m/Y à H:i') }}{{ dernierAcces.creePar ? ' par ' ~ dernierAcces.creePar|nom_pointage }},
							{{ dernierAcces.expireLe < acces_espace.maintenant ? 'expiré le' : 'valable jusqu\'au' }} {{ dernierAcces.expireLe|date('d/m/Y à H:i') }}.
						</p>
					{% else %}
						<p>Le client se connecte avec son numéro. Envoyez-lui un code d'accès sur WhatsApp pour sa première connexion, ou s'il a oublié son mot de passe.</p>
					{% endif %}
					{% if accesEspacePossible %}
						<form method="post" action="{{ path('app_clients_acces_espace', {publicId: client.publicId}) }}">
							<input type="hidden" name="_token" value="{{ csrf_token('acces-espace-' ~ client.id) }}">
							<button type="submit" class="btn btn-outline-success btn-sm"><i class="fab fa-whatsapp me-1"></i>Envoyer l'accès à l'espace client</button>
						</form>
					{% elseif acces_espace.empechement and dernierAcces %}
						<p class="mb-0">{{ acces_espace.empechement }}</p>
					{% endif %}
				</div>
			{% elseif acces_espace.empechement == constant('App\\Service\\EspaceClient\\AccesEspace::SANS_NUMERO') %}
				<div class="si-fh-espace">
					<h3>Espace client</h3>
					<p class="mb-0">{{ acces_espace.empechement }}</p>
				</div>
			{% endif %}
			{% include 'clients/_espace_suspension.html.twig' %}
		</aside>

		<div class="si-fiche-principal">
			<div class="si-fiche-kpis">
				{% if voir_ca %}
					<article class="card">
						<h3>CA 12 mois</h3>
						<strong>{{ kpi.ca|number_format(0, ',', ' ') }} F</strong>
						{% if kpi.evolution is not null %}<span class="{{ kpi.evolution >= 0 ? 'si-t-ok' : 'si-t-alerte' }}">{{ kpi.evolution >= 0 ? '▲ +' : '▼ ' }}{{ kpi.evolution }} %</span>{% endif %}
					</article>
				{% endif %}
				<article class="card">
					<h3>Commandes</h3>
					<strong>{{ kpi.commandes }}</strong>
					{% if kpi.commandes > 0 %}<span class="si-t-ok">moyenne {{ kpi.panier_moyen|number_format(0, ',', ' ') }} F</span>{% endif %}
				</article>
				{% if voir_paiements %}
					<article class="card">
						<h3>Solde dû</h3>
						<strong>{{ kpi.solde_du|number_format(0, ',', ' ') }} F</strong>
						{% if kpi.echues > 0 %}<a href="{{ path('app_creances_index', {q: nom}) }}" class="si-t-alerte">{{ kpi.echues }} échéance{{ kpi.echues > 1 ? 's' }} dépassée{{ kpi.echues > 1 ? 's' }}</a>{% elseif kpi.solde_du == 0 %}<span class="si-t-ok">à jour</span>{% endif %}
					</article>
				{% endif %}
				<article class="card">
					<h3>Dernière commande</h3>
					<strong>{{ kpi.derniere_jours is null ? '—' : (kpi.derniere_jours == 0 ? 'Aujourd’hui' : 'Il y a ' ~ kpi.derniere_jours ~ ' j') }}</strong>
					<span class="si-t-neutre">{{ kpi.devis_ouverts }} devis en cours</span>
				</article>
			</div>

			<section class="card si-fh-histo" id="historique">
				<h2 class="si-fh-titre">Historique d'activité</h2>
				<nav class="si-cl-types si-fh-filtres" aria-label="Filtrer l'historique">
					<button type="button" class="active" data-filtre="">Tout</button>
					{% for k, l in constant('App\\Service\\FicheClient360::CATEGORIES') %}
						{% if k != 'paiements' or voir_paiements %}<button type="button" data-filtre="{{ k }}">{{ l }}</button>{% endif %}
					{% endfor %}
				</nav>
				<form method="post" action="{{ path('app_clients_note', {publicId: client.publicId}) }}" class="si-fh-note">
					<input type="hidden" name="_token" value="{{ csrf_token('note-client') }}">
					<i class="fas fa-pen" aria-hidden="true"></i>
					<input name="texte" class="form-control form-control-sm" maxlength="2000" placeholder="Ajouter une note ou un compte rendu d'appel…" aria-label="Note" required>
					<select name="type" class="form-select form-select-sm" aria-label="Type de note">
						{% for k, l in constant('App\\Entity\\NoteClient::TYPES') %}<option value="{{ k }}">{{ k == 'appel' ? 'Appel' : l }}</option>{% endfor %}
					</select>
					<label class="si-fh-rappel" title="Rappel"><i class="far fa-clock"></i><input type="date" name="rappel" min="{{ 'now'|date('Y-m-d') }}" aria-label="Date de rappel"></label>
					<button type="submit" class="btn btn-primary btn-sm">Ajouter</button>
				</form>
				<ul class="si-fh-liste">
					{% for e in historique %}
						<li data-categorie="{{ e.categorie }}"{{ loop.index > 15 ? ' data-plus hidden' }}>
							<time datetime="{{ e.date|date('c') }}"><b>{{ e.date|date('d/m') }}</b>{% if e.date|date('H:i') != '00:00' %}<small>{{ e.date|date('H:i') }}</small>{% endif %}{% if e.date|date('Y') != 'now'|date('Y') %}<small>{{ e.date|date('Y') }}</small>{% endif %}</time>
							<span class="si-fh-icone si-fh-{{ e.categorie }}"><i class="fas {{ e.icone }}"></i></span>
							<div>
								{% if e.lien %}<a href="{{ path(e.lien.route, e.lien.parametres) }}">{{ e.titre }}</a>{% else %}<strong>{{ e.titre }}</strong>{% endif %}
								{% if e.detail %}<small>{{ e.detail }}</small>{% endif %}
							</div>
							<span class="si-fiche-montant">{{ e.montant is not null ? e.montant|number_format(0, ',', ' ') ~ ' F' }}</span>
						</li>
					{% else %}
						<li class="si-fiche-vide">Rien encore avec ce client.</li>
					{% endfor %}
				</ul>
				<p class="si-fh-vide" hidden>Rien dans cette catégorie.</p>
				{% if historique|length > 15 %}
					<button type="button" class="btn btn-link btn-sm si-fh-tout" data-voir-tout>Voir les {{ historique|length }} événements depuis {{ (historique|last).date|date('m/Y') }}</button>
				{% endif %}
			</section>

			<section class="card si-fiche-onglets">
				<div class="si-fiche-tabs" role="tablist" aria-label="Fiche client">
					{% set voir_fidelite = is_granted('ROLE_COMMANDE') and not client.isB2B %}
					{# « Compte » : argent laissé par le client (monnaie, dépôts), avec « Paiements » ou « Encaissements » (compte non nul). #}
					{% for cle, libelle in {commandes: 'Commandes', devis: 'Devis', factures: 'Factures'}|merge(compte ? {compte: 'Compte'} : {})|merge({fichiers: 'Fichiers et logos'})|merge(voir_fidelite ? {fidelite: 'Fidélité'} : {}) %}
						<button type="button" role="tab" id="tab-{{ cle }}" aria-controls="panneau-{{ cle }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" {{ loop.first ? '' : 'tabindex="-1"' }}>{{ libelle }}</button>
					{% endfor %}
				</div>

				<div role="tabpanel" id="panneau-commandes" aria-labelledby="tab-commandes">
					{% if commandes is empty and soldes_ouverture|default([]) is empty %}<p class="si-fiche-vide">Aucune commande.</p>{% else %}
						<div class="table-responsive"><table class="table si-fiche-table">
							<thead><tr><th>Commande</th><th>Date</th><th>Travaux</th><th class="text-end">Montant</th>{% if voir_paiements %}<th class="text-end">Payé</th>{% endif %}</tr></thead>
							<tbody>
								{% for c in soldes_ouverture|default([]) %}
									<tr>
										<td><a href="{{ path('app_commandes_show', {id: c.id}) }}">Solde d'ouverture</a></td>
										<td class="text-nowrap">{{ c.dateCommande ? c.dateCommande|date('d/m/Y') }}</td>
										<td><span class="si-badge">Repris à l'import</span></td>
										<td class="text-end text-nowrap">{{ c.totalTtc|number_format(0, ',', ' ') }}</td>
										{% if voir_paiements %}<td class="text-end text-nowrap">{{ c.totalPaye|number_format(0, ',', ' ') }}</td>{% endif %}
									</tr>
								{% endfor %}
								{% for c in commandes %}
									<tr>
										<td><a href="{{ path('app_commandes_show', {id: c.id}) }}">{{ c.numero }}</a>{% if c.demandeePar %}<br><small class="text-muted">par {{ c.demandeePar }}</small>{% endif %}</td>
										<td class="text-nowrap">{{ c.dateCommande ? c.dateCommande|date('d/m/Y') }}</td>
										<td>{{ constant('App\\Service\\FicheClient360::STATUTS_TRAVAUX')[c.statutTravaux]|default(c.statutTravaux) }}</td>
										<td class="text-end text-nowrap">{{ c.totalTtc|number_format(0, ',', ' ') }}</td>
										{% if voir_paiements %}<td class="text-end text-nowrap">{{ c.totalPaye|number_format(0, ',', ' ') }}</td>{% endif %}
									</tr>
								{% endfor %}
							</tbody>
						</table></div>
					{% endif %}
				</div>

				<div role="tabpanel" id="panneau-devis" aria-labelledby="tab-devis" hidden>
					{% if devis is empty %}<p class="si-fiche-vide">Aucun devis.</p>{% else %}
						<div class="table-responsive"><table class="table si-fiche-table">
							<thead><tr><th>Devis</th><th>Date</th><th>Statut</th><th class="text-end">Montant</th></tr></thead>
							<tbody>
								{% for d in devis %}
									<tr>
										<td><a href="{{ path('app_devis_show', {id: d.id}) }}">{{ d.numero ?: '#' ~ d.id }}</a>{% if d.interlocuteur %}<br><small class="text-muted">pour {{ d.interlocuteur }}</small>{% endif %}</td>
										<td class="text-nowrap">{{ d.dateDevis ? d.dateDevis|date('d/m/Y') }}</td>
										<td>{{ constant('App\\Service\\FicheClient360::STATUTS_DEVIS')[d.statut]|default(d.statut) }}</td>
										<td class="text-end text-nowrap">{{ d.totalTtc|number_format(0, ',', ' ') }}</td>
									</tr>
								{% endfor %}
							</tbody>
						</table></div>
					{% endif %}
				</div>

				<div role="tabpanel" id="panneau-factures" aria-labelledby="tab-factures" hidden>
					{% if factures is empty %}<p class="si-fiche-vide">Aucune facture ni proforma.</p>{% else %}
						<div class="table-responsive"><table class="table si-fiche-table">
							<thead><tr><th>Document</th><th>Date</th><th>Type</th><th class="text-end">Montant</th>{% if voir_paiements %}<th class="text-end">Reste</th>{% endif %}</tr></thead>
							<tbody>
								{% for f in factures %}
									<tr>
										<td>{% if is_granted('ROLE_FACTURE') %}<a href="{{ path('app_factures_show', {id: f.id}) }}">{{ f.numero ?: '#' ~ f.id }}</a>{% else %}{{ f.numero ?: '#' ~ f.id }}{% endif %}{% if f.estAnnulee %} <span class="si-badge si-badge-rouge">Annulée</span>{% endif %}</td>
										<td class="text-nowrap">{{ f.dateFacture ? f.dateFacture|date('d/m/Y') }}</td>
										<td>{{ f.typeDocumentLabel }}</td>
										<td class="text-end text-nowrap">{{ f.totalTtc|number_format(0, ',', ' ') }}</td>
										{% if voir_paiements %}<td class="text-end text-nowrap">{{ f.estProforma ? '—' : f.resteAPayer|number_format(0, ',', ' ') }}</td>{% endif %}
									</tr>
								{% endfor %}
							</tbody>
						</table></div>
					{% endif %}
				</div>

				{% if compte %}
					<div role="tabpanel" id="panneau-compte" aria-labelledby="tab-compte" hidden>
						{% include 'clients/_compte.html.twig' %}
					</div>
				{% endif %}

				<div role="tabpanel" id="panneau-fichiers" aria-labelledby="tab-fichiers" hidden>
					{% if fichiers is empty %}<p class="si-fiche-vide">Aucun fichier reçu pour ce client.</p>{% else %}
						<ul class="si-fiche-histo">
							{% for f in fichiers %}
								<li>
									<span class="si-fiche-icone"><i class="fas {{ f.fichierSource ? 'fa-pen-ruler' : 'fa-file-image' }}"></i></span>
									<div>
										<a href="{{ path('app_fichier_visualiser', {id: f.id}) }}" target="_blank" rel="noopener">{{ f.nomOriginal ?: 'Fichier ' ~ f.id }}</a>
										<small>{{ f.termineLe|date('d/m/Y') }} · {{ f.commandeDetail.commande.numero }}{% if f.fichierSource %} · version corrigée{% endif %}</small>
									</div>
									<span class="si-fiche-montant">{{ f.taille ? (f.taille / 1048576)|number_format(1, ',', ' ') ~ ' Mo' : '' }}</span>
								</li>
							{% endfor %}
						</ul>
					{% endif %}
				</div>

				{% if voir_fidelite %}
					<div role="tabpanel" id="panneau-fidelite" aria-labelledby="tab-fidelite" hidden>
						{% include 'fidelite/_fiche_client.html.twig' %}
					</div>
				{% endif %}
			</section>
			{% if compte %}{% include 'clients/_compte_modales.html.twig' %}{% endif %}
		</div>
	</div>
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	{% if compte %}<link href="{{ asset('css/compte-client.css') }}" rel="stylesheet">{% endif %}
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	{% if compte %}<script src="{{ asset('js/compte-client.js') }}" defer></script>{% endif %}
	<script>
		if (window.matchMedia('(max-width: 767.98px)').matches) { document.querySelectorAll('.si-fh-plus').forEach(function (d) { d.open = false; }); }
		(function () {
			var liste = document.querySelector('.si-fh-liste');
			if (!liste) { return; }
			var tout = document.querySelector('[data-voir-tout]');
			var filtre = '';
			var appliquer = function () {
				var n = 0;
				Array.prototype.forEach.call(liste.querySelectorAll('li[data-categorie]'), function (li) {
					var ok = !filtre || li.dataset.categorie === filtre;
					if (ok) { n++; }
					li.hidden = !ok || (n > 15 && !liste.classList.contains('si-fh-ouverte'));
				});
				document.querySelector('.si-fh-vide').hidden = n > 0 || !filtre;
				if (tout) { tout.hidden = n <= 15 || liste.classList.contains('si-fh-ouverte'); }
			};
			document.querySelectorAll('.si-fh-filtres [data-filtre]').forEach(function (b) {
				b.addEventListener('click', function () {
					document.querySelectorAll('.si-fh-filtres [data-filtre]').forEach(function (x) { x.classList.toggle('active', x === b); });
					filtre = b.dataset.filtre;
					appliquer();
				});
			});
			if (tout) { tout.addEventListener('click', function () { liste.classList.add('si-fh-ouverte'); appliquer(); }); }
		})();
		(function () {
			var onglets = Array.prototype.slice.call(document.querySelectorAll('.si-fiche-tabs [role="tab"]'));
			var choisir = function (onglet) {
				onglets.forEach(function (o) {
					var actif = o === onglet;
					o.setAttribute('aria-selected', actif ? 'true' : 'false');
					o.tabIndex = actif ? 0 : -1;
					document.getElementById(o.getAttribute('aria-controls')).hidden = !actif;
				});
			};
			onglets.forEach(function (o, i) {
				o.addEventListener('click', function () { choisir(o); });
				o.addEventListener('keydown', function (e) {
					if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') { return; }
					var suivant = onglets[(i + (e.key === 'ArrowRight' ? 1 : onglets.length - 1)) % onglets.length];
					choisir(suivant); suivant.focus();
				});
			});
			var demande = location.hash ? document.getElementById('tab-' + location.hash.slice(1)) : null;
			if (demande && onglets.indexOf(demande) >= 0) { choisir(demande); }
		})();
	</script>
{% endblock %}
