{% extends 'espace/app/_app.html.twig' %}

{#
	Devis dans l'espace client (maquettes DT01, bureau, et DT04, téléphone ;
	docs/devis.md) : lignes, version, validité, total, acompte et délai ;
	« Suivi du devis » ; ce qui a changé depuis la version d'avant ; le
	dernier message de la conversation ; accepter (la commande est créée,
	puis l'acompte Orange Money pour qui paie), demander une modification,
	refuser. Montants pour qui les voit (coque.montants) ; réponse pour qui
	valide (peutValider). Jamais de coût ni de marge.
#}
{% set enAttente = devis.estEnAttente and not expire %}
{% set montants = espace_coque().montants %}
{% set statuts = {envoye: ['Envoyé', ''], vu: ['Envoyé', ''], accepte: ['Accepté', 'vert'], converti: ['Accepté', 'vert'], refuse: ['Refusé', 'rouge'], expire: ['Expiré', 'gris']} %}
{% set statut = expire ? statuts.expire : statuts[devis.statut]|default(['', '']) %}
{% set acompte = devis.montantAcompte %}

{% block title %}Devis {{ devis.numero }}{% endblock %}
{% block page_classe %} ec-page-large{% endblock %}
{% block styles %}
	<link href="{{ asset('css/espace-suivi.css') }}" rel="stylesheet">
	<link href="{{ asset('css/espace-devis.css') }}" rel="stylesheet">
{% endblock %}
{% block entete %}
	<a class="ec-retour" href="{{ path('app_espace_devis') }}"><span class="fl">‹</span><span>Devis {{ devis.numero }}</span></a>
	<div class="cs-entete-actions ec-bureau">
		{% if montants %}<a class="cs-bouton-entete" href="{{ path('app_espace_devis_pdf', {id: devis.id}) }}" target="_blank">↓ PDF</a>{% endif %}
		<a class="cs-bouton-entete" href="{{ conversation_url_client(devis) }}">Message</a>
	</div>
{% endblock %}

{% block contenu %}
	{% import 'espace/app/_agent.html.twig' as ag %}
	{% if devis.attendUneModification and devis.estEnAttente %}
		<div class="ec-note">Votre demande de modification du {{ devis.demandeModificationLe|date('d/m') }} est reçue : nous préparons une nouvelle version et vous prévenons.</div>
	{% elseif expire %}
		<div class="ec-note">Ce devis a expiré le {{ devis.dateValidite|date_modify('+1 day')|date('d/m') }}. Demandez-nous une nouvelle version : le prix peut avoir changé.</div>
	{% elseif devis.statut == 'refuse' %}
		<div class="ec-note">Devis refusé{{ devis.motifRefus ? ' : ' ~ devis.motifRefus }}. Merci de nous avoir répondu.</div>
	{% endif %}

	<div class="dv-grille">
		<div class="dv-gauche">
			<section class="ec-carte dv-devis" aria-label="Le devis">
				<div class="dv-tete">
					<div class="dv-tete-titre">
						<h2>{{ devis.objet ?: (actuelle ? actuelle.resume : 'Votre devis') }}</h2>
						<span class="ec-pastille {{ statut[1] }}">{{ statut[0] }}</span>
						<span class="dv-version">v{{ devis.version }}{{ devis.envoyeLe ? ' · ' ~ devis.envoyeLe|date('d/m') }}</span>
						{% if agent %}<span class="dv-agent">{{ ag.disque(agent) }}{{ agent.nom }}</span>{% endif %}
					</div>
					{% if devis.dateValidite and devis.estEnAttente %}<span class="dv-validite{{ expire ? ' passe' }}">Valable jusqu'au {{ devis.dateValidite|date('d/m') }}</span>{% endif %}
				</div>

				<table class="dv-lignes">
					<thead><tr><th>Désignation</th><th class="n">Qté</th>{% if montants %}<th class="n">Prix unitaire</th><th class="n">Total</th>{% endif %}</tr></thead>
					<tbody>
						{% for l in devis.devisDetails %}
							{% set q = l.quantite|default(1) %}
							<tr>
								<td>
									<b>{{ l|ligne_client('Travail') }}</b>
									{% set options = [l.support ? l.support|texte_client : null, l.finitions|map(f => f.nomFinition)|filter(n => n)|join(', ') ?: null]|filter(o => o) %}
									{% if options is not empty %}<small>{{ options|join(' · ') }}</small>{% endif %}
								</td>
								<td class="n dv-q">{{ q|number_format(q == q|round ? 0 : 2, ',', ' ') }}</td>
								{% if montants %}
									<td class="n dv-pu">{% if l.totalTtc == 0 %}<span class="dv-offert">offert</span>{% else %}{{ (q > 0 ? l.totalTtc / q : 0)|number_format(0, ',', ' ') }} F{% endif %}</td>
									<td class="n dv-total-ligne">{% if l.totalTtc == 0 %}<span class="dv-offert">offert</span>{% else %}{{ l.totalTtc|number_format(0, ',', ' ') }} F{% endif %}</td>
								{% endif %}
							</tr>
						{% endfor %}
					</tbody>
				</table>

				<dl class="dv-totaux">
					{% if montants %}
						{% if devis.remise > 0 %}<div><dt>Remise</dt><dd>−{{ devis.remise|number_format(0, ',', ' ') }} F</dd></div>{% endif %}
						<div class="dv-total"><dt>Total</dt><dd>{{ devis.totalTtc|number_format(0, ',', ' ') }} F</dd></div>
						{% if acompte > 0 %}<div><dt>Acompte à l'acceptation · {{ devis.acomptePourcentage }} %</dt><dd>{{ acompte|number_format(0, ',', ' ') }} F</dd></div>{% endif %}
					{% else %}
						<div><dt>Prix</dt><dd><small>vu par la personne qui valide pour votre entreprise</small></dd></div>
					{% endif %}
					{% if devis.delaiRealisation %}<div><dt>Délai</dt><dd>{{ devis.delaiRealisation }}</dd></div>{% endif %}
					{% if devis.conditionSolde %}<div><dt>Solde</dt><dd>{{ devis.conditionSolde }}</dd></div>{% endif %}
					{% if devis.conditionFichier %}<div><dt>Fichier</dt><dd>{{ devis.conditionFichier }}</dd></div>{% endif %}
					{% if devis.conditionGarantie %}<div><dt>Garantie</dt><dd>{{ devis.conditionGarantie }}</dd></div>{% endif %}
				</dl>
				{# Téléphone (DT04) : le total en grand, l'acompte et le délai dessous. #}
				<div class="dv-total-mobile ec-telephone">
					{% if montants %}<div class="dv-total-mobile-ligne"><span>Total</span><strong>{{ devis.totalTtc|number_format(0, ',', ' ') }} F</strong></div>{% endif %}
					<small>{{ [montants and acompte > 0 ? 'acompte ' ~ acompte|number_format(0, ',', ' ') ~ ' F' : null, devis.delaiRealisation ? 'délai ' ~ devis.delaiRealisation : null]|filter(x => x)|join(' · ') }}</small>
				</div>
			</section>

			{% if precedente and actuelle %}
				<section class="ec-carte dv-changes" aria-labelledby="changes-titre">
					<h2 id="changes-titre">Ce qui a changé depuis la version {{ precedente.numero }}</h2>
					<div class="dv-versions">
						<div class="dv-v"><b>v{{ precedente.numero }} · {{ precedente.le|date('d/m') }}</b><small>{{ precedente.resume }}{{ montants ? ' · ' ~ precedente.total|number_format(0, ',', ' ') ~ ' F' }}</small></div>
						<div class="dv-v actuelle"><b>v{{ actuelle.numero }} · {{ actuelle.le|date('d/m') }}</b><small>{{ actuelle.resume }}{{ montants ? ' · ' ~ actuelle.total|number_format(0, ',', ' ') ~ ' F' }}</small></div>
					</div>
					{% if changements is not empty %}
						<ul class="dv-changements">{% for c in changements %}<li class="{{ c.sorte }}">{{ c.texte }}</li>{% endfor %}</ul>
					{% endif %}
				</section>
			{% endif %}

			{# Conversation du devis (docs/messagerie-clients.md) : montants masqués pour qui ne les voit pas. #}
			{% set conv = conversation_resume(devis, not montants) %}
			{% set dernierMessage = conv ? conv.dernier : null %}
			{% if dernierMessage %}
				<a class="ec-carte dv-message-mobile ec-telephone" href="{{ conversation_url_client(devis) }}">
					{% if dernierMessage.deLAtelier %}{{ ag.disque({photo: dernierMessage.photo, initiales: dernierMessage.initiales, teinte: null}) }}{% endif %}
					<p>{{ dernierMessage.texte }}</p>
				</a>
			{% endif %}

			{# Réponse du client : accepter, demander une modification, refuser. #}
			{% if enAttente %}
				{% if peutValider %}
					<div class="dv-actions">
						<form method="post" action="{{ path('app_espace_devis_accepter', {id: devis.id}) }}" class="dv-accepter" data-confirmer="Accepter le devis {{ devis.numero }}{{ montants ? ' (' ~ devis.totalTtc|number_format(0, ',', ' ') ~ ' F)' }} ? La commande est créée avec ce prix." data-confirmer-bouton="Accepter">
							<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
							<button type="submit" class="ec-bouton orange">
								{%- if peutPayer and acompte > 0 and montants -%}
									<span class="ec-bureau">✓ Accepter et payer l'acompte · {{ acompte|number_format(0, ',', ' ') }} F</span><span class="ec-telephone">Accepter · payer {{ acompte|number_format(0, ',', ' ') }} F</span>
								{%- else -%}
									✓ Accepter le devis
								{%- endif -%}
							</button>
						</form>
						<details class="dv-repondre">
							<summary class="ec-bouton clair"><span class="ec-bureau">Demander une modification</span><span class="ec-telephone">Modifier</span></summary>
							<form method="post" action="{{ path('app_espace_devis_modification', {id: devis.id}) }}" class="dv-form">
								<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
								<label for="dv-texte">Que faut-il changer ?</label>
								<textarea id="dv-texte" name="texte" class="ec-champ" maxlength="1200" required minlength="3" placeholder="Ex. : 4 kakémonos au lieu de 3, livraison avant samedi…"></textarea>
								<button type="submit" class="ec-bouton bleu">Envoyer la demande</button>
							</form>
						</details>
						<details class="dv-repondre">
							<summary class="ec-bouton clair dv-refuser">Refuser</summary>
							<form method="post" action="{{ path('app_espace_devis_refuser', {id: devis.id}) }}" class="dv-form">
								<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
								<label for="dv-motif">Pourquoi ? (cela nous aide)</label>
								<select id="dv-motif" name="motif" class="ec-champ">
									{% for cle, libelle in motifs %}<option value="{{ cle }}">{{ libelle }}</option>{% endfor %}
								</select>
								<input type="text" name="precision" class="ec-champ" maxlength="200" placeholder="Précision (facultatif)">
								<button type="submit" class="ec-bouton clair">Refuser le devis</button>
							</form>
						</details>
					</div>
					{% if acompte > 0 and not peutPayer %}<p class="ec-petit dv-note-acompte">Après l'acceptation, l'acompte est payé par la personne qui paie pour votre entreprise.</p>{% endif %}
				{% else %}
					<div class="ec-note">Ce devis est accepté par une personne qui valide pour votre entreprise. Vous pouvez demander une modification par <a class="ec-lien" href="{{ conversation_url_client(devis) }}">message</a>.</div>
				{% endif %}
			{% elseif devis.commande %}
				<div class="ec-boutons"><a class="ec-bouton bleu" href="{{ path('app_espace_commande', {id: devis.commande.publicId}) }}">Voir la commande {{ devis.commande.numero }}</a></div>
			{% elseif expire and peutValider %}
				<form method="post" action="{{ path('app_espace_devis_modification', {id: devis.id}) }}" class="ec-carte dv-form">
					<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
					<label for="dv-texte">Demander une nouvelle version</label>
					<textarea id="dv-texte" name="texte" class="ec-champ" maxlength="1200" required minlength="3">Merci de m'envoyer une nouvelle version de ce devis.</textarea>
					<button type="submit" class="ec-bouton bleu">Envoyer la demande</button>
				</form>
			{% endif %}
		</div>

		<aside class="dv-droite">
			<section class="ec-carte" aria-labelledby="suivi-titre">
				<h2 id="suivi-titre">Suivi du devis</h2>
				<ol class="cs-frise">
					{% for e in etapes %}
						<li class="{{ e.etat == 'avenir' or e.etat == 'annulee' ? 'a_venir' : e.etat }}" style="--i: {{ loop.index0 }}"{% if e.etat == 'action' %} aria-current="step"{% endif %}>
							<b>{{ e.libelle }}</b>{% if e.detail %}<small>{{ e.detail }}</small>{% endif %}
						</li>
					{% endfor %}
				</ol>
			</section>

			<section class="ec-carte dv-dernier ec-bureau" aria-labelledby="message-titre">
				<h2 id="message-titre">Dernier message</h2>
				{% if dernierMessage %}
					<div class="dv-bulle">
						{% if dernierMessage.deLAtelier %}{{ ag.disque({photo: dernierMessage.photo, initiales: dernierMessage.initiales, teinte: null}) }}{% else %}<span class="ec-avatar">{{ coque.initiales }}</span>{% endif %}
						<div><small class="ec-petit">{{ dernierMessage.deLAtelier ? dernierMessage.auteur : 'Vous' }} · {{ dernierMessage.le|date('d/m H:i') }}{{ conv.delaiTexte ? ' · ' ~ conv.delaiTexte }}</small>
						<p>{{ dernierMessage.texte }}</p></div>
					</div>
				{% else %}
					<p class="ec-petit">Une question sur ce devis ? Écrivez-nous, nous répondons dans la journée.</p>
				{% endif %}
				{% if not coque.lecture|default(false) %}<a class="ec-lien" href="{{ conversation_url_client(devis) }}">Ouvrir la conversation du devis →</a>{% endif %}
			</section>

			{% if enAttente %}
				<p class="ec-carte dv-info ec-petit">En acceptant, la commande est créée avec ce prix. La production commence après l'acompte et la validation du BAT.</p>
			{% endif %}
		</aside>
	</div>
{% endblock %}
