{#
	Mon compte en un coup d'œil (maquettes EC01 et EC05), pour qui paie :
	solde dû et part échue, plafond de crédit (entreprise), commandes de
	l'année, Mon solde (argent laissé à l'imprimerie), points fidélité (hors
	grille revendeur).
#}
{% if apercu %}
	{% set fi = droits.fidelite ? fidelite_espace(client) : null %}
	<section class="ec-carte ec-bloc">
		<h2 class="ec-bureau">Mon compte en un coup d'œil</h2>
		<div class="ec-tuiles">
			<a class="ec-tuile" href="{{ path('app_espace_factures') }}">
				<small>Solde dû</small>
				<b class="{{ apercu.solde > 0 ? 'rouge' : 'vert' }}">{{ apercu.solde|number_format(0, ',', ' ') }} F</b>
				{% if apercu.echu > 0 %}<small>dont {{ apercu.echu|number_format(0, ',', ' ') }} F échus</small>{% elseif apercu.enValidation > 0 %}<small>{{ apercu.enValidation|number_format(0, ',', ' ') }} F en validation</small>{% endif %}
			</a>
			{% if apercu.plafond %}
				<div class="ec-tuile ec-bureau">
					<small>Plafond de crédit</small>
					<b>{{ apercu.plafond|number_format(0, ',', ' ') }} F</b>
					{% if apercu.utilise > 100 %}
						<small class="rouge">dépassé de {{ (apercu.solde - apercu.plafond)|number_format(0, ',', ' ') }} F</small>
					{% else %}
						<small>utilisé à {{ apercu.utilise }} %</small>
					{% endif %}
				</div>
			{% endif %}
			{# Mon solde (docs/espace-client.md) : l'argent laissé à l'imprimerie, monnaie gardée et dépôts. #}
			<a class="ec-tuile" href="{{ path('app_espace_solde') }}">
				<small>Mon solde</small>
				<b class="{{ apercu.avoir > 0 ? 'vert' }}">{{ apercu.avoir|number_format(0, ',', ' ') }} F</b>
				<small class="ec-bureau">monnaie gardée, dépôts</small>
			</a>
			<a class="ec-tuile ec-bureau" href="{{ path('app_espace_commandes') }}">
				<small>Commandes {{ apercu.annee }}</small>
				<b>{{ apercu.commandesAnnee }}</b>
				<small>{{ apercu.montantAnnee|number_format(0, ',', ' ') }} F</small>
			</a>
			{% if fi and not fi.exclu %}
				<a class="ec-tuile" href="{{ path('app_espace_fidelite') }}">
					<small><span class="ec-bureau">Points fidélité</span><span class="ec-telephone">Points</span></small>
					<b class="bleu">{{ fi.disponible|number_format(0, ',', ' ') }}</b>
					<small class="ec-bureau">soit {{ fi.disponibleF|number_format(0, ',', ' ') }} F</small>
				</a>
			{% endif %}
		</div>
	</section>
{% endif %}
