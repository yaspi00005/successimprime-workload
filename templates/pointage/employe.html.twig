{% extends 'base.html.twig' %}

{% set statuts = constant('App\\Service\\Pointage\\CalculPointage::STATUTS') %}
{% set token = csrf_token(jeton) %}

{% block title %}Pointage · {{ nom }}{% endblock %}

{% block header_actions %}
	<li class="nav-item"><a href="{{ path('app_pointage_employe', {id: utilisateur.id, mois: mois|date_modify('-1 month')|date('Y-m')}) }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-caret-left"></i><span class="si-masque-mobile ms-1">Mois précédent</span></a></li>
	<li class="nav-item"><a href="{{ path('app_pointage_feuille', {id: utilisateur.id, mois: mois|date('Y-m')}) }}" target="_blank" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-download me-1"></i>Feuille de présence</a></li>
	{% if detail %}
		<li class="nav-item"><button type="button" class="btn btn-light btn-sm si-btn-entete" data-si-ouvrir="si-pg-correction">Corriger un pointage</button></li>
	{% endif %}
{% endblock %}

{% block body %}
	<div class="si-pg si-pg-fiche">
		<section class="card si-pg-journal">
			<h2>Journal · {{ mois|date_fr('MMMM y') }}</h2>
			<table class="table">
				<thead><tr><th>Jour</th><th>Arrivée</th><th>Départ</th><th>Heures faites / dues</th><th>Points</th><th>Photos</th></tr></thead>
				<tbody>
					{% for j in fiche.jours %}
						{% if j.presences is empty %}
							<tr class="si-pg-ligne-vide">
								<td>{{ j.jour|date_fr('EEE d')|capitalize }}</td>
								<td colspan="5">{{ j.jour|date('Y-m-d') < 'now'|date('Y-m-d') ? 'Absent' : '—' }}</td>
							</tr>
						{% endif %}
						{% for c in j.presences %}
							{% set p = c.pointage %}
							{% set k = c.calcul %}
							<tr class="si-pg-avec-raison {{ detail and detail.pointage.id == p.id ? 'si-pg-choisi' }}" data-si-pointage="{{ p.id }}">
								<td><a href="{{ path('app_pointage_employe', {id: utilisateur.id, mois: mois|date('Y-m'), pointage: p.id}) }}">{{ j.jour|date_fr('EEE d')|capitalize }}</a></td>
								<td class="{{ k.retard > 0 ? 'si-p-alerte' }}">{{ p.arriveeLe|date('H:i') }}{% if k.avance|default(0) > 0 %} <small class="si-pg-avant" title="Arrivé avant l'heure de début : le temps compte à partir de {{ k.debutPrevu|heure_pointage }}">avant {{ k.debutPrevu|heure_pointage }}</small>{% endif %}</td>
								<td>{{ p.departLe ? p.departLe|date(p.departLe|date('Y-m-d') != p.arriveeLe|date('Y-m-d') ? 'd/m H:i' : 'H:i') : '—' }}</td>
								<td>{% if not p.departLe %}{{ statuts[k.statut] }}{% elseif k.dues is not null %}{{ k.faites|duree_pointage }} / {{ k.dues > 0 ? k.dues|duree_pointage : 'repos' }}{% else %}{{ k.presence|duree_pointage }}{% endif %}</td>
								<td class="{{ k.total < 0 ? 'si-p-alerte' : (k.total > 0 ? 'si-p-ok') }}"><b>{{ k.total > 0 ? '+' }}{{ k.total }}</b>{% if k.bonusEnAttente %} <i class="fas fa-hourglass-half si-pg-attente" title="{{ k.bonusEnAttente }}"></i>{% endif %}</td>
								<td class="si-pg-photos">
									{% include 'pointage/_photo.html.twig' with {pointage: p, photo: p.photoArrivee, sens: 'arrivee'} %}
									{% include 'pointage/_photo.html.twig' with {pointage: p, photo: p.photoDepart, sens: 'depart'} %}
								</td>
							</tr>
							<tr class="si-pg-raison {{ detail and detail.pointage.id == p.id ? 'si-pg-choisi' }}">
								<td colspan="6">{{ k.raison }}{% if k.bareme == 'ancien' %} <small class="si-mp-ancien">ancien barème</small>{% endif %}</td>
							</tr>
						{% endfor %}
					{% else %}
						<tr><td colspan="6" class="si-pg-absent">Pas encore de pointage ce mois-ci.</td></tr>
					{% endfor %}
				</tbody>
			</table>
			<p class="si-pg-totaux">
				Présent <b>{{ fiche.presents }} / {{ fiche.ouvres }} j</b>
				· Retards <b>{{ fiche.retards }}</b>
				{% if fiche.avance > 0 %}· Arrivé avant l'heure <b>{{ fiche.avance }} fois</b>{% endif %}
				{% if fiche.nouveau > 0 %}· Heures faites <b>{{ fiche.faites|duree_pointage }}</b> sur <b>{{ fiche.dues|duree_pointage }}</b>{% endif %}
				· Présence (pause déduite) <b>{{ fiche.minutes|duree_pointage }}</b>
				· Points du mois <b>{{ fiche.points > 0 ? '+' }}{{ fiche.points }}</b>{% if fiche.aValider > 0 %} ({{ fiche.aValider }} à valider){% endif %}
				· Ponctualité <b>{{ fiche.note is null ? '—' : fiche.note ~ ' / 100' }}</b>
			</p>
			<p class="si-pg-note">Horaire : <b>{{ fiche.horaire.libelle }}</b>{% if fiche.horaire.libre %} (ni retard ni départ anticipé){% else %}, {{ fiche.horaire.debut|heure_pointage }} – {{ fiche.horaire.fin|heure_pointage }} ({{ fiche.horaire.dues|duree_pointage }} dues par jour){% endif %}{% if utilisateur.employe and not fiche.horaire.propre %} · <a href="{{ path('app_equipe_employes_modifier', {id: utilisateur.employe.id}) }}">changer sur sa fiche</a>{% endif %}.</p>
		</section>

		<section class="card si-pg-detail">
			{% if detail %}
				{% set p = detail.pointage %}
				{% set c = detail.calcul %}
				<h2>Pointage du {{ p.arriveeLe|date_fr('EEEE d/MM') }}</h2>
				<div class="si-pg-grandes">
					<figure>
						{% if p.photoArrivee %}<img src="{{ path('app_pointer_voir_photo', {id: p.id, sens: 'arrivee'}) }}" alt="Photo arrivée">{% else %}<span class="si-pg-sans"><i class="fas fa-user"></i></span>{% endif %}
						<figcaption>Arrivée<strong>{{ p.arriveeLe|date('H:i:s') }}</strong></figcaption>
					</figure>
					<figure>
						{% if p.photoDepart %}<img src="{{ path('app_pointer_voir_photo', {id: p.id, sens: 'depart'}) }}" alt="Photo départ">{% else %}<span class="si-pg-sans"><i class="fas fa-user"></i></span>{% endif %}
						<figcaption>Départ<strong>{{ p.departLe ? p.departLe|date('H:i:s') : '—' }}</strong></figcaption>
					</figure>
				</div>
				<dl class="si-pg-infos">
					<div><dt>Point</dt><dd>{{ p.pointArrivee ? p.pointArrivee.code ~ ' ' ~ p.pointArrivee.nom : 'saisi par la RH' }}</dd></div>
					<div><dt>Téléphone</dt><dd>{{ p.appareilArrivee ? p.appareilArrivee.nom ~ (p.appareilArrivee.etat == 'autorise' ? ' · enregistré ✓' : ' · non validé') : '—' }}</dd></div>
					<div><dt>Position</dt><dd>{% if p.positionArrivee %}{{ p.positionArrivee.distance is not null ? 'à ' ~ p.positionArrivee.distance ~ ' m du point' : 'notée (point sans coordonnées)' }}{% else %}non transmise{% endif %}</dd></div>
					<div><dt>Heure</dt><dd>horloge du serveur (non modifiable)</dd></div>
					<div><dt>Statut</dt><dd><span class="si-pg-statut si-pg-{{ c.statut }}">{{ statuts[c.statut] }}</span>{% if c.retard > 0 %} · retard {{ c.retard|duree_pointage }}{% endif %}{% if c.avance|default(0) > 0 %} · arrivé {{ c.avance|duree_pointage }} avant {{ c.debutPrevu|heure_pointage }}{% endif %}{% if c.sup > 0 %} · {{ c.sup|duree_pointage }} après la fin{% endif %}</dd></div>
					{% if c.dues is not null %}
						<div><dt>Horaire du jour</dt><dd>{{ c.debutPrevu is null ? c.horaire : c.horaire|split(' – ')|map(x => x|heure_pointage)|join(' – ') }}</dd></div>
						<div><dt>Heures faites / dues</dt><dd>{{ c.faites is null ? '—' : c.faites|duree_pointage }} / {{ c.dues > 0 ? c.dues|duree_pointage : 'jour de repos' }}</dd></div>
					{% endif %}
				</dl>

				<h3>Points de la journée{% if c.bareme == 'ancien' %} <small class="si-mp-ancien">ancien barème</small>{% endif %}</h3>
				<p class="si-pg-pourquoi">{{ c.raison }}</p>
				<ul class="si-pg-points">
					{% for l in c.points %}<li><span>{{ l.libelle }}</span><b class="{{ l.points < 0 ? 'si-p-alerte' : 'si-p-ok' }}">{{ l.points > 0 ? '+' }}{{ l.points }}</b></li>{% endfor %}
				</ul>
				{% if p.motifAjustement %}<p class="si-pg-motif">Ajustement : {{ p.motifAjustement }}</p>{% endif %}
				{% if c.bonusEnAttente %}
					<form method="post" action="{{ path('app_pointage_valider_heures', {id: p.id}) }}" class="si-pg-valider">
						<input type="hidden" name="_token" value="{{ token }}">
						<span>{{ c.bonusEnAttente }}</span>
						<button type="submit" class="btn btn-success btn-sm">Valider les heures sup.</button>
					</form>
				{% endif %}
				{% if p.corrige %}<p class="si-pg-motif">Corrigé : {{ p.motifCorrection }}</p>{% endif %}
				<p class="si-pg-note">Toute correction manuelle exige un motif et reste visible dans l'historique.</p>
				<button type="button" class="btn btn-light btn-sm si-btn-entete" data-si-ouvrir="si-pg-ajustement">Ajuster les points</button>

				<dialog class="si-dialogue" id="si-pg-correction">
					<form method="post" action="{{ path('app_pointage_corriger', {id: p.id}) }}">
						<header><h2>Corriger le pointage</h2><button type="button" class="btn-close" data-si-fermer aria-label="Fermer"></button></header>
						<input type="hidden" name="_token" value="{{ token }}">
						<div class="si-dialogue-grille">
							<label>Arrivée<input type="datetime-local" name="arrivee" class="form-control" value="{{ p.arriveeLe|date('Y-m-d\\TH:i') }}" required></label>
							<label>Départ<input type="datetime-local" name="depart" class="form-control" value="{{ p.departLe ? p.departLe|date('Y-m-d\\TH:i') }}"></label>
							<label class="si-plein">Motif (obligatoire, vu par l'employé)<input type="text" name="motif" class="form-control" maxlength="255" required placeholder="Ex. téléphone en panne, départ confirmé par le chef d'atelier"></label>
						</div>
						<footer><button type="button" class="btn btn-light" data-si-fermer>Annuler</button><button type="submit" class="btn btn-primary">Corriger</button></footer>
					</form>
				</dialog>
				<dialog class="si-dialogue" id="si-pg-ajustement">
					<form method="post" action="{{ path('app_pointage_ajuster', {id: p.id}) }}">
						<header><h2>Ajuster les points</h2><button type="button" class="btn-close" data-si-fermer aria-label="Fermer"></button></header>
						<input type="hidden" name="_token" value="{{ token }}">
						<p class="si-dialogue-meta">Remplace l'ajustement actuel ({{ p.ajustementPoints }}). Ex. +10 pour compter une journée justifiée, −5 pour retirer une heure en plus. Un départ oublié se corrige plutôt avec « Corriger un pointage ».</p>
						<div class="si-dialogue-grille">
							<label>Points<input type="number" name="points" class="form-control" min="-500" max="500" value="{{ p.ajustementPoints }}" required></label>
							<label class="si-plein">Motif (vu par l'employé)<input type="text" name="motif" class="form-control" maxlength="255" required value="{{ p.motifAjustement }}"></label>
						</div>
						<footer><button type="button" class="btn btn-light" data-si-fermer>Annuler</button><button type="submit" class="btn btn-primary">Enregistrer</button></footer>
					</form>
				</dialog>
			{% else %}
				<p class="si-pg-absent">Aucun pointage à détailler ce mois-ci.</p>
			{% endif %}
		</section>
	</div>
	{% include 'pointage/_calcul_points.html.twig' with {regles: regles, horaires: horaires, horaire: fiche.horaire, debut: fiche.debutNouveau, pour_moi: false} %}
	<script>
		document.addEventListener('click', function (e) {
			var ouvrir = e.target.closest('[data-si-ouvrir]');
			if (ouvrir) { document.getElementById(ouvrir.dataset.siOuvrir).showModal(); }
			var fermer = e.target.closest('[data-si-fermer]');
			if (fermer) { fermer.closest('dialog').close(); }
		});
	</script>
{% endblock %}
