{% block javascripts %}

	{{ parent() }}

	<script>

		document.addEventListener('DOMContentLoaded', function () { /*
                 * ===================================================
                 * ÉLÉMENTS
                 * ===================================================
                 */

const form = document.getElementById('facture-form');

const typeInput = document.getElementById('{{ form.typeDocument.vars.id }}');

const surfacturationInput = document.getElementById('{{ form.surfacturation.vars.id }}');

const tauxInput = document.getElementById('{{ form.tauxSurfacturation.vars.id }}');

const montantInput = document.getElementById('{{ form.montantSurfacturation.vars.id }}');

const majorationFields = document.getElementById('majoration-fields');

const majorationCard = document.getElementById('majoration-card');

const typeMessage = document.getElementById('document-type-message');

const previewBase = document.getElementById('preview-base');

const previewMajoration = document.getElementById('preview-majoration');

const previewTotal = document.getElementById('preview-total');

const previewType = document.getElementById('preview-type');

const previewComptabilisation = document.getElementById('preview-comptabilisation');

const submitButton = document.getElementById('btn-enregistrer-facture');


/*
                 * Montant réel de la commande.
                 */
const totalCommande = {{ commandeTotalTtc|default(0)|json_encode|raw }};


/*
                 * ===================================================
                 * FORMATEUR FCFA
                 * ===================================================
                 */

function formatMoney(montant) {
const valeur = Number(montant) || 0;

return new Intl.NumberFormat('fr-FR', {maximumFractionDigits: 0}).format(valeur) + ' FCFA';
}


/*
                 * ===================================================
                 * TYPE DOCUMENT
                 * ===================================================
                 */

function updateDocumentType() {
if (! typeInput) {
return;
}

const type = typeInput.value;

const factureOfficielle = type === 'facture';


if (factureOfficielle) {

previewType.textContent = 'Facture officielle';

previewComptabilisation.textContent = 'Oui';

previewComptabilisation.className = 'text-success';


typeMessage.textContent = 'La facture officielle sera ' + 'comptabilisée et conservera ' + 'les montants réels de la commande.';


/*
                         * Une facture officielle
                         * ne peut pas être majorée.
                         */
surfacturationInput.checked = false;

surfacturationInput.disabled = true;

majorationFields.style.display = 'none';

tauxInput.value = '';

montantInput.value = '';

tauxInput.disabled = true;

montantInput.disabled = true;

majorationCard.classList.add('majoration-disabled');

} else {

previewType.textContent = 'Pro forma / Simulation';

previewComptabilisation.textContent = 'Non';

previewComptabilisation.className = 'text-warning';


typeMessage.textContent = 'La pro forma est un document ' + 'commercial non comptabilisé. ' + 'Une majoration peut être appliquée.';


surfacturationInput.disabled = false;

majorationCard.classList.remove('majoration-disabled');


updateMajorationVisibility();
} calculatePreview();
}


/*
                 * ===================================================
                 * AFFICHAGE MAJORATION
                 * ===================================================
                 */

function updateMajorationVisibility() {
if (! surfacturationInput || ! majorationFields) {
return;
}


const active = surfacturationInput.checked && ! surfacturationInput.disabled;


majorationFields.style.display = active ? 'block' : 'none';


tauxInput.disabled = ! active;

montantInput.disabled = ! active;


if (! active) {

tauxInput.value = '';

montantInput.value = '';
}


calculatePreview();
}


/*
                 * ===================================================
                 * CALCUL APERÇU
                 * ===================================================
                 */

function calculatePreview() {
let majoration = 0;


const majorationActive = surfacturationInput && surfacturationInput.checked && ! surfacturationInput.disabled;


if (majorationActive) {

const taux = parseFloat(tauxInput.value || '0');

const montant = parseInt(montantInput.value || '0', 10);


if (taux > 0) {

majoration = Math.round(totalCommande * taux / 100);

} else if (montant > 0) {

majoration = montant;
}
}


const totalFinal = totalCommande + majoration;


previewBase.textContent = formatMoney(totalCommande);

previewMajoration.textContent = formatMoney(majoration);

previewTotal.textContent = formatMoney(totalFinal);
}


/*
                 * ===================================================
                 * EMPÊCHER TAUX + MONTANT EN MÊME TEMPS
                 * ===================================================
                 */

tauxInput.addEventListener('input', function () {

const taux = parseFloat(this.value || '0');

if (taux > 0) {
montantInput.value = '';
}

calculatePreview();

});


montantInput.addEventListener('input', function () {

const montant = parseInt(this.value || '0', 10);

if (montant > 0) {
tauxInput.value = '';
}

calculatePreview();

});


/*
                 * ===================================================
                 * EVENTS
                 * ===================================================
                 */

typeInput.addEventListener('change', updateDocumentType);


surfacturationInput.addEventListener('change', updateMajorationVisibility);


/*
                 * ===================================================
                 * CONFIRMATION
                 * ===================================================
                 */

if (form) {

form.addEventListener('submit', function (event) {

const type = typeInput.value;

const estFacture = type === 'facture';


const taux = parseFloat(tauxInput.value || '0');

const montant = parseInt(montantInput.value || '0', 10);


/*
                             * Double sécurité.
                             */
if (surfacturationInput.checked && taux > 0 && montant > 0) {

event.preventDefault();

if (typeof Swal !== 'undefined') {

Swal.fire({
icon: 'error',
title: 'Majoration incorrecte',
text: 'Choisissez soit ' + 'un pourcentage, ' + 'soit un montant fixe.'
});

}

return;
}


/*
                             * Confirmation SweetAlert.
                             */
if (typeof Swal !== 'undefined' && ! form.dataset.confirmed) {

event.preventDefault();


const titre = estFacture ? 'Créer la facture officielle ?' : 'Créer la pro forma ?';


const texte = estFacture ? 'La facture sera comptabilisée ' + 'avec les montants réels ' + 'de la commande.' : 'La pro forma sera enregistrée ' + 'sans impact comptable.';


Swal.fire({
icon: 'question',
title: titre,
text: texte,
showCancelButton: true,
confirmButtonText: 'Oui, enregistrer',
cancelButtonText: 'Annuler'
}).then(function (result) {

if (result.isConfirmed) {

form.dataset.confirmed = '1';

submitButton.disabled = true;

submitButton.innerHTML = '<i class="fa ' + 'fa-spinner ' + 'fa-spin mr-1"></i>' + ' Enregistrement...';

/*
                                             * requestSubmit()
                                             * conserve le comportement
                                             * normal du formulaire.
                                             */
form.requestSubmit();
}

});

}

});
}


/*
                 * ===================================================
                 * FACTURATION À UN TIERS
                 * ===================================================
                 */

const facturerAUnTiersInput = document.getElementById('{{ form.facturerAUnTiers.vars.id }}');

const zoneFacturerAUnTiers = document.querySelector('.js-zone-facturer-a-un-tiers');

function actualiserFacturerAUnTiers() {
if (! facturerAUnTiersInput || ! zoneFacturerAUnTiers) {
return;
}

zoneFacturerAUnTiers.style.display = facturerAUnTiersInput.checked ? '' : 'none';
}

if (facturerAUnTiersInput) {
facturerAUnTiersInput.addEventListener('change', actualiserFacturerAUnTiers);

actualiserFacturerAUnTiers();
}


/*
                 * ===================================================
                 * INITIALISATION
                 * ===================================================
                 */

updateDocumentType();

});
	</script>

{% endblock %}
