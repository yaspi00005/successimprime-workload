{% extends 'base.html.twig' %}

{#
	Exceptions B2B (docs/promotions.md) : un agent demande d'appliquer une
	promotion à une ligne d'un revendeur au prix B2B. La ligne reste au prix
	B2B tant qu'un responsable n'a pas accepté.
#}

{% block title %}Exceptions B2B{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/promotions.css') }}" rel="stylesheet">
{% endblock %}

{% block header_actions %}
	<li class="nav-item"><a href="{{ path('app_promotions_index') }}" class="btn btn-light btn-sm si-btn-entete">Promotions</a></li>
{% endblock %}

{% macro document(d) %}
	{%- set l = d.ligne -%}
	{%- if d.ligneCommande %}<a href="{{ path('app_commandes_show', {id: l.commande.id}) }}">{{ d.document }}</a>
	{%- elseif d.ligneDevis %}<a href="{{ path('app_devis_show', {id: l.devis.id}) }}">{{ d.document }}</a>
	{%- else %}—{% endif -%}
{% endmacro %}
{% import _self as m %}

{% block body %}
	{% if en_ligne %}
		<p class="si-pg-note"><i class="fas fa-info-circle me-1"></i>Site en ligne : les exceptions se décident sur l'ERP de l'imprimerie.</p>
	{% endif %}

	<div class="card si-bloc">
		<div class="si-bloc-tete"><h4>À décider</h4><span class="si-bloc-note">{{ attente|length }} demande{{ attente|length > 1 ? 's' }}</span></div>
		<p class="si-pg-note">Accepter : la ligne prend la promotion à la place du prix B2B (jamais les deux), et l'agent est prévenu. Refuser : la ligne reste au prix B2B ; le motif est obligatoire. Tout est gardé au journal d'activité.</p>
		{% if attente is empty %}
			<p class="si-ac-vide">Aucune demande en attente.</p>
		{% else %}
			<div class="table-responsive">
				<table class="table si-table si-pr-table mb-0">
					<thead><tr><th>Demande</th><th>Revendeur</th><th>Ligne</th><th>Promotion</th><th class="text-end">Par unité</th><th>Décision</th></tr></thead>
					<tbody>
						{% for d in attente %}
							<tr>
								<td class="text-nowrap">{{ d.demandeLe|date('d/m/Y H:i') }}<small class="d-block text-muted">{{ d.demandePar ? d.demandePar.userIdentifier : '—' }}</small></td>
								<td><a href="{{ path('app_clients_show', {publicId: d.client.publicId}) }}">{{ d.client.nomComplet }}</a><small class="d-block"><span class="si-pastille si-pastille-gris">Prix B2B</span></small></td>
								<td>{{ m.document(d) }}<small class="d-block text-muted">{{ d.ligne ? d.ligne.designation }}{{ d.ligne ? ' · ' ~ d.ligne.quantite ~ ' ex.' }}</small></td>
								<td><b>{{ d.promotion.nom }}</b><small class="d-block text-muted">{{ d.promotion.libelleAvantage }} · jusqu'au {{ d.promotion.fin|date('d/m/Y') }}</small></td>
								<td class="text-end text-nowrap">
									<span class="d-block">prix B2B : −{{ d.remiseB2b|number_format(0, ',', ' ') }} F</span>
									<span class="d-block si-pr-avantage">promotion : −{{ (d.remiseB2b + d.remiseUnitaire)|number_format(0, ',', ' ') }} F</span>
								</td>
								<td>
									{% if not en_ligne %}
										<form method="post" action="{{ path('app_promotions_exception_decider', {id: d.id}) }}" class="si-pr-decision">
											<input type="hidden" name="_token" value="{{ csrf_token('exception-promotion') }}">
											<input type="text" name="reponse" maxlength="255" class="form-control form-control-sm" placeholder="Motif (obligatoire pour refuser)" aria-label="Motif">
											<div class="d-flex gap-1">
												<button name="decision" value="accepter" class="btn btn-sm btn-success">Accepter</button>
												<button name="decision" value="refuser" class="btn btn-sm btn-outline-secondary">Refuser</button>
											</div>
										</form>
									{% endif %}
								</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</div>

	<div class="card si-bloc">
		<div class="si-bloc-tete"><h4>Dernières décisions</h4></div>
		{% if traitees is empty %}
			<p class="si-ac-vide">Rien encore.</p>
		{% else %}
			<div class="table-responsive">
				<table class="table si-table si-pr-table mb-0">
					<thead><tr><th>Décision</th><th>Revendeur</th><th>Ligne</th><th>Promotion</th><th>Motif ou note</th></tr></thead>
					<tbody>
						{% for d in traitees %}
							<tr>
								<td class="text-nowrap"><span class="si-pastille {{ d.estAcceptee ? 'si-pastille-vert' : 'si-pastille-rouge' }}">{{ d.statutLabel }}</span><small class="d-block text-muted">{{ d.decideLe ? d.decideLe|date('d/m/Y H:i') }} · {{ d.decidePar ? d.decidePar.userIdentifier : '—' }}</small></td>
								<td>{{ d.client.nomComplet }}</td>
								<td>{{ m.document(d) }}<small class="d-block text-muted">{{ d.ligne ? d.ligne.designation }}</small></td>
								<td>{{ d.promotion.nom }}</td>
								<td><small>{{ d.reponse ?? '—' }}</small></td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
			</div>
		{% endif %}
	</div>
{% endblock %}
