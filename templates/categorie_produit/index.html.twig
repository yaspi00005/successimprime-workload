{% extends 'base.html.twig' %}

{% block title %}
	Catégories de produits
{% endblock %}

{% block body %}

	<!-- PAGE-HEADER -->
	<div class="side-app">
		<div class="page-header">

			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="#">Paramétrage</a>
				</li>

				<li class="breadcrumb-item active" aria-current="page">
					Catégories de produits
				</li>
			</ol>

			<div>

				<button type="button" class="btn btn-primary btn-create-categorie-produit" data-bs-toggle="modal" data-bs-target="#categorieProduitCreateModal">
					<i class="fa fa-plus mr-1"></i>
					Ajouter une catégorie
				</button>

				<button type="button" id="categorieProduitMassPublishButton" class="btn btn-success">
					<i class="fa fa-eye mr-1"></i>
					Publier
				</button>

				<button type="button" id="categorieProduitMassUnpublishButton" class="btn btn-warning">
					<i class="fa fa-eye-slash mr-1"></i>
					Dépublier
				</button>

				<button type="button" id="categorieProduitMassDeleteButton" class="btn btn-danger">
					<i class="fa fa-trash mr-1"></i>
					Supprimer
				</button>

			</div>

		</div>
		<!-- PAGE-HEADER END -->

		<!-- ROW OPEN -->
		<div class="row row-cards">

			<div class="col-lg-8 col-xl-12">

				<div class="input-group mb-5">

					<input type="text" id="categorieProduitSearchInput" class="form-control" placeholder="Rechercher une catégorie...">

					<div class="input-group-append">

						<button type="button" class="btn btn-primary-light" id="categorieProduitSearchButton">
							<i class="fa fa-search" aria-hidden="true"></i>
						</button>

					</div>

				</div>

				<div class="card">

					<div class="card-header border-bottom-0 p-4">

						<h2 class="card-title">
							Liste des catégories de produits
						</h2>

						<div class="page-options d-flex float-right">

							<select id="categorieProduitSortSelect" class="form-control custom-select w-auto">
								<option value="ordre">
									Ordre d’affichage
								</option>

								<option value="asc">
									Nom croissant
								</option>

								<option value="desc">
									Nom décroissant
								</option>
							</select>

						</div>

					</div>

					<div class="e-table">

						<div class="table-responsive table-lg br-bl-10 br-br-10">

							{# ===================================================== #}
							{# URL ET JETONS AJAX                                     #}
							{# ===================================================== #}

							<input type="hidden" id="categorieProduitCreateUrl" value="{{ path('app_categorie_produit_create_ajax') }}"> <input type="hidden" id="categorieProduitCreateToken" value="{{ csrf_token('create_categorie_produit') }}">

							<input type="hidden" id="categorieProduitMassActionUrl" value="{{ path('app_categorie_produit_mass_action') }}">

							<input type="hidden" id="categorieProduitMassActionToken" value="{{ csrf_token('categorie_produit_mass_action') }}">

							<input type="hidden" id="categorieProduitReorderUrl" value="{{ path('app_categorie_produit_reorder') }}">

							<input type="hidden" id="categorieProduitReorderToken" value="{{ csrf_token('categorie_produit_reorder') }}">

							<table class="table table-bordered mb-0">

								<thead>

									<tr>

										<th class="text-center">
											Ordre
										</th>

										<th class="text-center">

											<div class="custom-control custom-checkbox">

												<input class="custom-control-input" id="categorieProduitCheckAll" type="checkbox">

												<label class="custom-control-label" for="categorieProduitCheckAll"></label>

											</div>

										</th>

										<th>
											Nom
										</th>

										<th>
											Description
										</th>

										<th class="text-center">
											Produits
										</th>

										<th class="text-center">
											Statut
										</th>

										<th class="text-center">
											Actions
										</th>

									</tr>

								</thead>

								<tbody id="categorieProduitSortableBody">

									{% for categorieProduit in categoriesProduits %}

										<tr
											id="categorie-produit-row-{{ categorieProduit.id }}" class="categorie-produit-sortable-row" data-id="{{ categorieProduit.id }}">

											{# Déplacement #}
											<td class="text-center align-middle">

												<i class="fa fa-arrows-alt categorie-produit-drag-handle" style="cursor: move;" title="Déplacer"></i>

											</td>

											{# Sélection #}
											<td class="align-middle text-center">

												<div class="custom-control custom-checkbox">

													<input class="custom-control-input categorie-produit-row-check" id="categorie-produit-item-{{ categorieProduit.id }}" type="checkbox" value="{{ categorieProduit.id }}">

													<label class="custom-control-label" for="categorie-produit-item-{{ categorieProduit.id }}"></label>

												</div>

											</td>

											{# Nom #}
											<td class="align-middle">

												<strong>
													{{ categorieProduit.nom }}
												</strong>

											</td>

											{# Description #}
											<td class="align-middle">

												{{ categorieProduit.description ?: '-' }}

											</td>

											{# Nombre de produits #}
											<td class="text-center align-middle">

												<span class="badge badge-info">
													{{ categorieProduit.produits|length }}
												</span>

											</td>

											{# Statut #}
											<td class="text-center align-middle">

												{% if categorieProduit.publie %}

													<span class="badge badge-success">
														Publié
													</span>

												{% else %}

													<span class="badge badge-danger">
														Non publié
													</span>

												{% endif %}

											</td>

											{# Actions #}
											<td class="text-center align-middle">

												<div class="btn-group align-top">

													<button type="button" class="btn btn-sm btn-primary-light btn-edit-categorie-produit" data-bs-toggle="modal" data-bs-target="#categorieProduitEditModal" data-id="{{ categorieProduit.id }}" data-get-url="{{ path( 'app_categorie_produit_get_ajax', {id: categorieProduit.id} ) }}" data-update-url="{{ path( 'app_categorie_produit_update_ajax', {id: categorieProduit.id} ) }}" data-update-token="{{ csrf_token( 'update_categorie_produit_' ~ categorieProduit.id ) }}" title="Modifier">
														<i class="fa fa-edit"></i>
													</button>

													<button type="button" class="btn btn-sm {{
																																																																				categorieProduit.publie
																																																																					? 'btn-warning-light'
																																																																					: 'btn-success-light'
																																																																			}} btn-toggle-categorie-produit" data-url="{{ path( 'app_categorie_produit_toggle_publication', {id: categorieProduit.id} ) }}" data-token="{{ csrf_token( 'toggle_categorie_produit_' ~ categorieProduit.id ) }}" data-nom="{{ categorieProduit.nom }}" data-publie="{{ categorieProduit.publie ? '1' : '0' }}" title="{{ categorieProduit.publie ? 'Dépublier' : 'Publier' }}">

														{% if categorieProduit.publie %}

															<i class="fa fa-eye-slash"></i>

														{% else %}

															<i class="fa fa-eye"></i>

														{% endif %}

													</button>

													<button type="button" class="btn btn-sm btn-danger-light btn-delete-categorie-produit" data-url="{{ path( 'app_categorie_produit_delete_ajax', {id: categorieProduit.id} ) }}" data-token="{{ csrf_token( 'delete_categorie_produit_' ~ categorieProduit.id ) }}" data-nom="{{ categorieProduit.nom }}" data-produits-count="{{ categorieProduit.produits|length }}" title="Supprimer">
														<i class="fa fa-trash"></i>
													</button>

												</div>

											</td>

										</tr>

									{% else %}

										<tr>

											<td colspan="7" class="text-center text-muted">

												Aucune catégorie de produit trouvée

											</td>

										</tr>

									{% endfor %}

								</tbody>

							</table>

						</div>

					</div>

				</div>

			</div>

			{# ========================================================= #}
			{# MODAL D’AJOUT                                             #}
			{# ========================================================= #}

				<div class="modal fade" id="categorieProduitCreateModal" tabindex="-1" role="dialog" aria-hidden="true"> <div class="modal-dialog modal-lg" role="document">

					<div class="modal-content">

						<div class="modal-header">

							<h5 class="modal-title">
								Ajouter une catégorie de produit
							</h5>

							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>

						</div>

						<div class="modal-body">

							<div class="form-group">

								<label for="categorieProduitCreateNom" class="form-label">
									Nom de la catégorie
								</label>

								<input type="text" id="categorieProduitCreateNom" class="form-control" placeholder="Exemple : Communication visuelle" maxlength="255" autocomplete="off">

							</div>

							<div class="form-group">

								<label for="categorieProduitCreateDescription" class="form-label">
									Description
								</label>

								<textarea id="categorieProduitCreateDescription" class="form-control" rows="4" maxlength="500" placeholder="Décrivez les produits appartenant à cette catégorie."></textarea>

								<small class="form-text text-muted">
									Maximum 500 caractères.
								</small>

							</div>

							<div class="form-group mb-0">

								<label class="custom-switch">

									<input type="checkbox" id="categorieProduitCreatePublie" class="custom-switch-input" checked>

									<span class="custom-switch-indicator"></span>

									<span class="custom-switch-description">
										Publier cette catégorie
									</span>

								</label>

							</div>

						</div>

						<div class="modal-footer">

							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
								Annuler
							</button>

							<button type="button" class="btn btn-primary" id="categorieProduitCreateSaveButton">
								<i class="fa fa-save mr-1"></i>
								Enregistrer
							</button>

						</div>

					</div>

				</div>

			</div>

			{# ========================================================= #}
			{# MODAL DE MODIFICATION                                     #}
			{# ========================================================= #}

				<div class="modal fade" id="categorieProduitEditModal" tabindex="-1" role="dialog" aria-hidden="true"> <div class="modal-dialog modal-lg" role="document">

					<div class="modal-content">

						<div class="modal-header">

							<h5 class="modal-title">
								Modifier la catégorie de produit
							</h5>

							<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>

						</div>

						<div class="modal-body">

							<input type="hidden" id="categorieProduitEditUpdateUrl">

							<input type="hidden" id="categorieProduitEditToken">

							<div class="form-group">

								<label for="categorieProduitEditNom" class="form-label">
									Nom de la catégorie
								</label>

								<input type="text" id="categorieProduitEditNom" class="form-control" placeholder="Nom de la catégorie" maxlength="255" autocomplete="off">

							</div>

							<div class="form-group">

								<label for="categorieProduitEditDescription" class="form-label">
									Description
								</label>

								<textarea id="categorieProduitEditDescription" class="form-control" rows="4" maxlength="500"></textarea>

								<small class="form-text text-muted">
									Maximum 500 caractères.
								</small>

							</div>

							<div class="form-group mb-0">

								<label class="custom-switch">

									<input type="checkbox" id="categorieProduitEditPublie" class="custom-switch-input">

									<span class="custom-switch-indicator"></span>

									<span class="custom-switch-description">
										Publier cette catégorie
									</span>

								</label>

							</div>

						</div>

						<div class="modal-footer">

							<button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
								Annuler
							</button>

							<button type="button" class="btn btn-primary" id="categorieProduitEditSaveButton">
								<i class="fa fa-save mr-1"></i>
								Enregistrer les modifications
							</button>

						</div>

					</div>

				</div>

			</div>

		</div>
	</div>
	<!-- ROW CLOSED -->

{% endblock %}

{% block javascripts %}

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

	<script src="{{ asset('assets/js/traitement_categorie_produit.js') }}?v=2026080901"></script>

{% endblock %}
