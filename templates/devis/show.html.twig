{% extends 'base.html.twig' %}

{#
	Fiche d'un devis (maquette DT03, docs/devis.md) : lignes et totaux,
	versions avec la demande du client, suivi des envois et des
	ouvertures, carte du client, rentabilité (droit « Marges et coûts »)
	et responsable. Actions : nouvelle version, relance WhatsApp,
	transformation en commande.
#}

{% block title %}Devis {{ devis.numero ?: '#' ~ devis.id }}{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<link href="{{ asset('css/devis.css') }}" rel="stylesheet">
	<link href="{{ asset('css/promotions.css') }}" rel="stylesheet">
{% endblock %}

{% set jeton = csrf_token('devis-' ~ devis.id) %}
{% set enAttente = devis.estEnAttente %}
{% set peutNouvelleVersion = devis.statut in ['envoye', 'vu', 'refuse', 'expire'] %}

{% block header_actions %}
	{% if devis.statut == 'brouillon' %}
		<li class="nav-item si-masque-mobile"><a href="{{ path('app_devis_pdf', {id: devis.id}) }}" target="_blank" class="btn btn-light btn-sm si-btn-entete">Aperçu PDF</a></li>
		<li class="nav-item si-masque-mobile"><a href="{{ path('app_devis_edit', {id: devis.id}) }}" class="btn btn-light btn-sm si-btn-entete">Modifier</a></li>
		<li class="nav-item si-masque-mobile">
			<form method="post" action="{{ path('app_devis_envoyer', {id: devis.id}) }}" class="d-inline">
				<input type="hidden" name="_token" value="{{ jeton }}">
				<button type="submit" class="btn btn-danger btn-sm">Envoyer au client</button>
			</form>
		</li>
	{% else %}
		{% if peutNouvelleVersion %}
			<li class="nav-item si-masque-mobile">
				<form method="post" action="{{ path('app_devis_nouvelle_version', {id: devis.id}) }}" class="d-inline">
					<input type="hidden" name="_token" value="{{ jeton }}">
					<button type="submit" class="btn btn-light btn-sm si-btn-entete">Nouvelle version</button>
				</form>
			</li>
		{% endif %}
		{% if enAttente %}
			<li class="nav-item si-masque-mobile">
				<form method="post" action="{{ path('app_devis_relancer', {id: devis.id}) }}" class="d-inline" {{ whatsAppAuto ? '' : 'target="_blank"' }}>
					<input type="hidden" name="_token" value="{{ jeton }}">
					<button type="submit" class="btn btn-light btn-sm si-btn-entete"><i class="fab fa-whatsapp me-1"></i>Relancer sur WhatsApp</button>
				</form>
			</li>
		{% endif %}
		{% if (enAttente or devis.statut == 'accepte') and devis.commande is null %}
			<li class="nav-item si-masque-mobile">
				<form method="post" action="{{ path('app_devis_convertir_commande', {id: devis.id}) }}" class="d-inline" data-confirmer="{{ enAttente ? 'Le client a accepté ? Le devis devient la commande, sans ressaisie.' : 'Créer la commande à partir de ce devis ?' }}">
					<input type="hidden" name="_token" value="{{ csrf_token('convertir-devis-' ~ devis.id) }}">
					<button type="submit" class="btn btn-danger btn-sm">Convertir en commande</button>
				</form>
			</li>
		{% elseif devis.commande %}
			<li class="nav-item si-masque-mobile"><a href="{{ path('app_commandes_show', {id: devis.commande.id}) }}" class="btn btn-danger btn-sm">Voir la commande</a></li>
		{% endif %}
	{% endif %}
{% endblock %}

{% macro initiales(nom) %}{% set mots = nom|trim|split(' ')|filter(m => m is not empty) %}{{ (mots|first|default('?')|first ~ (mots|length > 1 ? mots[1]|first : ''))|upper }}{% endmacro %}

{% block body %}
	{% set client = devis.clients %}
	{% set nomClient = client ? (client.raisonSociale ?: client.nomComplet) : 'Client inconnu' %}
	{% set cleStatut = devis.statut == 'converti' ? 'accepte' : devis.statut %}

	<div class="si-dv si-dv-fiche">
		<div class="si-dv-fiche-tete">
			<a href="{{ path('app_devis_index') }}" class="si-dv-retour" aria-label="Retour à la liste"><i class="fas fa-chevron-left"></i></a>
			<h1>{{ devis.numero ?: '#' ~ devis.id }}{% if devis.objet %} · {{ devis.objet }}{% endif %}</h1>
			<span class="si-dv-statut si-dv-st-{{ cleStatut }}">{{ devis.statutLibelle }}</span>
			<span class="si-dv-fiche-sous">
				{%- if devis.version > 1 %}version {{ devis.version }}{% endif -%}
				{%- if devis.version > 1 and devis.dateValidite and (enAttente or devis.statut == 'expire') %} · {% endif -%}
				{%- if devis.dateValidite and enAttente %}expire le {{ devis.dateValidite|date('d/m') }}{% elseif devis.statut == 'expire' and devis.dateValidite %}expiré le {{ devis.dateValidite|date_modify('+1 day')|date('d/m') }}{% endif -%}
			</span>
		</div>

		{# Actions sur téléphone (l'en-tête les cache). #}
		<div class="si-dv-actions-mobile d-md-none">
			{% if devis.statut == 'brouillon' %}
				<a href="{{ path('app_devis_edit', {id: devis.id}) }}" class="btn btn-light">Modifier</a>
				<form method="post" action="{{ path('app_devis_envoyer', {id: devis.id}) }}"><input type="hidden" name="_token" value="{{ jeton }}"><button type="submit" class="btn btn-danger w-100">Envoyer au client</button></form>
			{% else %}
				{% if enAttente %}
					<form method="post" action="{{ path('app_devis_relancer', {id: devis.id}) }}" {{ whatsAppAuto ? '' : 'target="_blank"' }}><input type="hidden" name="_token" value="{{ jeton }}"><button type="submit" class="btn btn-light w-100"><i class="fab fa-whatsapp me-1"></i>Relancer</button></form>
				{% endif %}
				{% if peutNouvelleVersion %}
					<form method="post" action="{{ path('app_devis_nouvelle_version', {id: devis.id}) }}"><input type="hidden" name="_token" value="{{ jeton }}"><button type="submit" class="btn btn-light w-100">Nouvelle version</button></form>
				{% endif %}
				{% if (enAttente or devis.statut == 'accepte') and devis.commande is null %}
					<form method="post" action="{{ path('app_devis_convertir_commande', {id: devis.id}) }}" data-confirmer="Le devis devient la commande, sans ressaisie."><input type="hidden" name="_token" value="{{ csrf_token('convertir-devis-' ~ devis.id) }}"><button type="submit" class="btn btn-danger w-100">Convertir en commande</button></form>
				{% elseif devis.commande %}
					<a href="{{ path('app_commandes_show', {id: devis.commande.id}) }}" class="btn btn-danger">Voir la commande</a>
				{% endif %}
			{% endif %}
		</div>

		{% if lienWhatsApp %}
			<div class="alert alert-success si-dv-bandeau d-flex flex-wrap align-items-center gap-2">
				<span>Message WhatsApp prêt pour {{ nomClient }} (lien du devis, sans montant).</span>
				<a href="{{ lienWhatsApp }}" target="_blank" rel="noopener" class="btn btn-success btn-sm ms-auto"><i class="fab fa-whatsapp me-1"></i>Ouvrir WhatsApp</a>
			</div>
		{% endif %}
		{% if devis.attendUneModification and enAttente %}
			<div class="alert alert-warning si-dv-bandeau">
				<strong>{{ devis.reponduPar ?: 'Le client' }} demande une modification</strong> le {{ devis.demandeModificationLe|date('d/m à H:i') }} : « {{ devis.demandeModification }} »
				{% if peutNouvelleVersion %}Préparez la version {{ devis.version + 1 }} avec « Nouvelle version ».{% endif %}
			</div>
		{% endif %}
		{% if relanceDue and not whatsAppAuto %}
			<div class="alert alert-info si-dv-bandeau">Envoyé il y a {{ maintenant.diff(devis.envoyeLe).days }} jours sans réponse : c'est le moment de relancer (« Relancer sur WhatsApp », message déjà écrit).</div>
		{% endif %}

		<div class="si-dv-fiche-grille">
			<div class="si-dv-fiche-gauche">
				<section class="card si-dv-carte si-dv-lignes">
					<table class="table si-dv-table-lignes" data-sans-filtres>
						<thead><tr><th>Désignation</th><th class="text-end">Qté</th><th class="text-end">Prix unitaire</th><th class="text-end">Total</th></tr></thead>
						<tbody>
							{% for detail in devis.devisDetails %}
								{% set quantite = detail.quantite|default(1) %}
								<tr>
									<td data-label="Désignation">
										<strong>{{ detail|ligne_interne('Ligne sans désignation') }}</strong>
										{% if pieces_m2_ligne(detail) %}<small class="d-block text-muted">{{ pieces_m2_ligne(detail) }}</small>{% endif %}
										{{ include('promotions/_ligne.html.twig', {detail: detail, possibles: promotionsB2b[detail.id] ?? [], type: 'devis', peutDemander: is_granted('ROLE_DEVIS')}) }}
									</td>
									<td class="text-end" data-label="Qté">{{ quantite|number_format(quantite == quantite|round ? 0 : 2, ',', ' ') }}</td>
									<td class="text-end" data-label="Prix unitaire">{{ (quantite > 0 ? detail.totalTtc / quantite : 0)|number_format(0, ',', ' ') }} F</td>
									<td class="text-end si-dv-montant" data-label="Total">{{ detail.totalTtc|default(0)|number_format(0, ',', ' ') }} F</td>
								</tr>
							{% else %}
								<tr><td colspan="4" class="text-muted">Aucune ligne. <a href="{{ path('app_devis_edit', {id: devis.id}) }}">Ajouter des lignes</a></td></tr>
							{% endfor %}
						</tbody>
					</table>
					<div class="si-dv-totaux">
						<dl>
							{% if devis.fraisLivraison > 0 %}<dt>Livraison</dt><dd>{{ devis.fraisLivraison|number_format(0, ',', ' ') }} F</dd>{% endif %}
							{% if devis.remise > 0 %}<dt>Remise</dt><dd>− {{ devis.remise|number_format(0, ',', ' ') }} F</dd>{% endif %}
							{% if devis.tva > 0 %}<dt>TVA</dt><dd>{{ devis.tva|number_format(0, ',', ' ') }} F</dd>{% endif %}
							<dt class="si-dv-total-ligne">Total</dt><dd class="si-dv-total-ligne">{{ devis.totalTtc|number_format(0, ',', ' ') }} F</dd>
							{% if devis.acomptePourcentage > 0 %}<dt>Acompte demandé</dt><dd>{{ devis.acomptePourcentage }} % · {{ devis.montantAcompte|number_format(0, ',', ' ') }} F</dd>{% endif %}
							{% if devis.delaiRealisation %}<dt>Délai</dt><dd>{{ devis.delaiRealisation }}</dd>{% endif %}
						</dl>
					</div>
					{% if devis.conditionSolde or devis.conditionFichier or devis.conditionGarantie %}
						<p class="si-dv-conditions-texte">
							{% if devis.conditionSolde %}<span>Solde : <b>{{ devis.conditionSolde }}</b></span>{% endif %}
							{% if devis.conditionFichier %}<span>Fichier : <b>{{ devis.conditionFichier }}</b></span>{% endif %}
							{% if devis.conditionGarantie %}<span>Garantie : <b>{{ devis.conditionGarantie }}</b></span>{% endif %}
						</p>
					{% endif %}
				</section>

				<div class="si-dv-fiche-bas">
					<section class="card si-dv-carte si-dv-versions" id="nouvelle-version">
						<h2>Versions</h2>
						{% if versions is empty %}
							<p class="si-dv-petit">{{ devis.statut == 'brouillon' ? 'Pas encore envoyé : la version ' ~ devis.version ~ ' est notée à l\'envoi.' : 'Envoyé avant le suivi des versions.' }}</p>
						{% else %}
							<ul>
								{% if devis.statut == 'brouillon' %}
									<li><span class="si-dv-v">v{{ devis.version }}</span><div><b>en préparation</b><small>{{ devis.totalTtc|number_format(0, ',', ' ') }} F pour l'instant</small></div><span class="si-dv-statut si-dv-st-brouillon">Brouillon</span></li>
								{% endif %}
								{% for v in versions %}
									<li>
										<span class="si-dv-v">v{{ v.numero }} · {{ v.le|date('d/m') }}</span>
										<div>
											<b>{{ v.total|number_format(0, ',', ' ') }} F</b>
											{% if v.changements %}<small>{{ v.changements }}</small>{% endif %}
											{% if v.demandeClient %}<small>client : « {{ v.demandeClient }} »</small>{% endif %}
											{% if not v.changements and not v.demandeClient %}<small>{{ v.resume }}</small>{% endif %}
										</div>
										{% if v.actuelle %}<span class="si-dv-actuelle">Actuelle</span>{% endif %}
									</li>
								{% endfor %}
							</ul>
						{% endif %}
						{% if peutNouvelleVersion %}
							<form method="post" action="{{ path('app_devis_nouvelle_version', {id: devis.id}) }}" class="mt-2">
								<input type="hidden" name="_token" value="{{ jeton }}">
								<button type="submit" class="btn btn-link btn-sm p-0">+ Préparer la version {{ devis.version + 1 }}</button>
							</form>
						{% endif %}
					</section>

					<section class="card si-dv-carte si-dv-suivi-fiche">
						<h2>Suivi</h2>
						{% if evenements is empty %}
							<p class="si-dv-petit">Rien encore : le suivi commence à l'envoi.</p>
						{% else %}
							<ul>
								{% for e in evenements %}
									<li class="{{ e.futur ? 'est-futur' }}">
										<time>{{ e.le ? (e.le|date('H:i') == '00:00' ? e.le|date('d/m') : e.le|date('d/m H:i')) : '' }}</time>
										<span>{{ e.texte }}</span>
									</li>
								{% endfor %}
							</ul>
						{% endif %}
						{% if enAttente or devis.statut == 'expire' %}
							<details class="si-plus-options mt-2">
								<summary>Le client a refusé (téléphone, comptoir)</summary>
								<form method="post" action="{{ path('app_devis_refuser', {id: devis.id}) }}" class="mt-2">
									<input type="hidden" name="_token" value="{{ jeton }}">
									<select name="motif" class="form-select form-select-sm mb-2" aria-label="Motif du refus">
										{% for cle, libelle in motifs %}<option value="{{ cle }}">{{ libelle }}</option>{% endfor %}
									</select>
									<input type="text" name="precision" maxlength="200" class="form-control form-control-sm mb-2" placeholder="Précision (facultatif)">
									<button type="submit" class="btn btn-sm btn-outline-danger">Noter le refus</button>
								</form>
							</details>
						{% endif %}
					</section>
				</div>
			</div>

			<aside class="si-dv-fiche-droite">
				<section class="card si-dv-carte si-dv-client-carte">
					<div class="si-dv-client-tete">
						<span class="si-dv-avatar si-dv-avatar-grand si-dv-a{{ (client ? client.id : 0) % 6 }}">{{ _self.initiales(nomClient) }}</span>
						<div>
							{% if client %}<a href="{{ path('app_clients_show', {publicId: client.publicId}) }}"><b>{{ nomClient }}</b></a>{% else %}<b>{{ nomClient }}</b>{% endif %}
							<small>{{ nombreDevisClient }} devis · {{ nombreAcceptesClient }} accepté{{ nombreAcceptesClient > 1 ? 's' }}</small>
						</div>
					</div>
					{% if devis.interlocuteur %}<p class="si-dv-contact"><i class="fas fa-user me-2"></i>{{ devis.interlocuteur }}</p>{% endif %}
					{% if client and client.telephone %}<p class="si-dv-contact"><i class="fas fa-phone me-2"></i>{{ client.telephone }}</p>{% endif %}
					{% if nombreImpayees > 0 %}
						<p class="si-dv-alerte">
							{% if is_granted('ROLE_PAIEMENT_VOIR') %}<b>Solde impayé {{ impaye|number_format(0, ',', ' ') }} F.</b>{% else %}<b>{{ nombreImpayees }} commande{{ nombreImpayees > 1 ? 's' }} pas encore payée{{ nombreImpayees > 1 ? 's' }}.</b>{% endif %}
							Demander l'acompte avant de lancer.
						</p>
					{% endif %}
				</section>

				{% if rentabilite %}
					<section class="card si-dv-carte si-dv-rentabilite">
						<h4>Rentabilité <span class="si-dv-interne">Interne</span></h4>
						<dl>
							<dt>Coût estimé</dt><dd>{{ rentabilite.cout > 0 ? rentabilite.cout|number_format(0, ',', ' ') ~ ' F' : '—' }}</dd>
							<dt>Marge</dt><dd>{{ rentabilite.marge|number_format(0, ',', ' ') }} F</dd>
							<dt>Taux de marge</dt><dd class="{{ rentabilite.alerte ? 'si-p-alerte' : 'si-p-ok' }}">{{ rentabilite.taux is null ? '—' : rentabilite.taux|number_format(0, ',', ' ') ~ ' %' }}</dd>
						</dl>
						{% if rentabilite.alerte %}<p class="si-dv-alerte">Marge sous {{ seuilMarge|number_format(0) }} %.</p>{% endif %}
						{% if rentabilite.incomplet %}<p class="si-dv-petit">Coût incomplet : {{ rentabilite.manquants|join(', ') }}.</p>{% endif %}
						<p class="si-dv-petit">Jamais visible par le client.</p>
					</section>
				{% endif %}

				<section class="card si-dv-carte si-dv-responsable">
					<h4>Responsable</h4>
					{% set agent = devis.agents %}
					{% if agent %}
						{% set nomAgent = agent.employe ? agent.employe.nomComplet : agent.username %}
						<div class="si-dv-client-tete">
							<span class="si-dv-avatar si-dv-avatar-grand si-dv-a{{ agent.id % 6 }}">{{ _self.initiales(nomAgent) }}</span>
							<div><b>{{ nomAgent }}</b>{% if agent.employe and agent.employe.fonction %}<small class="si-dv-fonction">{{ agent.employe.fonction }}</small>{% endif %}</div>
						</div>
					{% else %}
						<p class="si-dv-petit">Non renseigné.</p>
					{% endif %}
				</section>

				{{ include('demandes_site/_encart_devis.html.twig') }}

				<section class="card si-dv-carte si-dv-liens">
					<a href="{{ path('app_devis_pdf', {id: devis.id}) }}" target="_blank"><i class="far fa-file-pdf me-2"></i>PDF du devis</a>
					{% if devis.statut not in ['brouillon', 'annule'] and devis.tokenAuthenticite %}
						<a href="{{ path('app_devis_lien', {token: devis.tokenAuthenticite}) }}" target="_blank" rel="noopener"><i class="fas fa-link me-2"></i>Lien envoyé au client</a>
					{% endif %}
					{% if devis.statut == 'brouillon' or peutNouvelleVersion %}
						<a href="{{ path('app_devis_edit', {id: devis.id}) }}"><i class="fas fa-pen me-2"></i>{{ devis.statut == 'brouillon' ? 'Modifier le brouillon' : 'Modifier (version ' ~ (devis.version + 1) ~ ')' }}</a>
					{% endif %}
					{% if is_granted('ROLE_ADMIN') %}
						<form method="post" action="{{ path('app_devis_delete', {id: devis.id}) }}" data-confirmer="Supprimer le devis {{ devis.numero }} ?" data-confirmer-danger>
							<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ devis.id) }}">
							<button type="submit"><i class="fas fa-trash-alt me-2"></i>Supprimer</button>
						</form>
					{% endif %}
				</section>
			</aside>
		</div>
	</div>
{% endblock %}
