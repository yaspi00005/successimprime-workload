  const ang=cellAngle(L,side);const m=S.mirror?-1:1;const dxv=side==='verso'?-S.dx:S.dx;
  for(const c of cells(L)){
    const cx=(c.x+c.w/2)*PT,cy=(H-(c.y+c.h/2))*PT;const cl=c.clip;
