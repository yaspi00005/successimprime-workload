<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{% for page in pages %}
	<url>
		<loc>{{ page.url }}</loc>
		{% if page.modifieLe %}<lastmod>{{ page.modifieLe|date('Y-m-d') }}</lastmod>{% endif %}
		<priority>{{ page.priorite }}</priority>
	</url>
{% endfor %}
</urlset>
