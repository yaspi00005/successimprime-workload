{#
	Illustration d'une réalisation ou d'un conseil sans photo, aux couleurs
	de sa famille (grand, textile, petit, signaletique). Variables : famille,
	id (unique dans la page, pour le dégradé).
#}
{% set fonds = {
	grand: ['#123F86', '#2C8AD6'],
	textile: ['#FAD6E6', '#E8398A'],
	petit: ['#1D1D1B', '#45443F'],
	signaletique: ['#EEF2F8', '#CED9EA'],
	evenement: ['#FDC82A', '#E95B35'],
} %}
{% set f = fonds[famille] ?? fonds.grand %}
<svg viewBox="0 0 400 300" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
	<defs><linearGradient id="sc-fond-{{ id }}" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="{{ f[0] }}"/><stop offset="1" stop-color="{{ f[1] }}"/></linearGradient></defs>
	<rect width="400" height="300" fill="url(#sc-fond-{{ id }})"/>
	{% if famille == 'textile' %}
		<path d="M163 78 125 98l-17 38 30 13 8-12v94h108v-94l8 12 30-13-17-38-38-20c-6 18-21 28-37 28s-31-10-37-28Z" fill="#fff"/>
		<rect x="170" y="150" width="60" height="12" rx="4" fill="#0F4590" opacity=".85"/>
	{% elseif famille == 'petit' %}
		<g transform="rotate(-6 200 150)"><rect x="118" y="98" width="164" height="104" rx="8" fill="#fff"/><rect x="136" y="118" width="58" height="10" rx="3" fill="#DE1028"/><rect x="136" y="138" width="92" height="7" rx="3" fill="#C9CED8"/><rect x="136" y="152" width="74" height="7" rx="3" fill="#C9CED8"/></g>
	{% elseif famille == 'signaletique' %}
		<rect x="178" y="52" width="44" height="190" rx="3" fill="#fff"/><rect x="178" y="128" width="44" height="114" fill="#0F4590"/><rect x="166" y="242" width="68" height="10" rx="5" fill="#1D1D1B" opacity=".75"/>
	{% elseif famille == 'evenement' %}
		<rect x="50" y="102" width="300" height="78" rx="6" fill="#fff"/><rect x="72" y="126" width="150" height="30" rx="4" fill="#DE1028"/>
	{% else %}
		<rect x="62" y="96" width="276" height="108" rx="6" fill="rgba(255,255,255,.18)" stroke="#fff" stroke-width="8"/>
	{% endif %}
</svg>
