{% extends 'security/_page_connexion.html.twig' %}

{% block title %}Session verrouillée · Succès Imprim{% endblock %}

{# Écran de verrouillage : même page que la connexion (CX02), mot de passe seul. #}
{% block carte %}
	{% set nom = user.employe ? (user.employe.prenom ~ ' ' ~ user.employe.nom)|trim : user.username %}
	<div class="si-connexion-personne">
		{# Pas de photo ici : la page s'ouvre sans être connecté et les photos du personnel ne sortent qu'après connexion (docs/securite.md). #}
		<span>{{ nom|slice(0, 1)|upper }}</span>
		<div>
			<h1>Bonjour {{ user.employe ? user.employe.prenom : user.username }}</h1>
			<p class="si-connexion-sous-titre">{{ user.username }}</p>
		</div>
	</div>
	{% if en_ligne|default(false) %}{% include 'security/_appareil.html.twig' %}{% endif %}

	{% if error %}
		<div class="si-connexion-erreur" role="alert">{{ error }}</div>
	{% endif %}

	<form method="post" action="{{ path('app_login') }}" autocomplete="off">
		<input type="hidden" name="_token" value="{{ csrf_token('lockscreen_' ~ user.id) }}">
		<input type="hidden" name="username" value="{{ user.username }}">
		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
		<input type="hidden" name="_target_path" value="/">

		<label for="inputPassword">Mot de passe</label>
		<div class="si-connexion-mdp">
			<input type="password" id="inputPassword" name="password" autocomplete="current-password" required autofocus>
			<button type="button" class="js-afficher" data-cible="inputPassword" aria-pressed="false">Afficher</button>
		</div>

		<button type="submit" class="si-connexion-bouton">Déverrouiller</button>
	</form>

	<p class="si-connexion-lien">Ce n'est pas vous ? <a href="{{ path('app_switch_user_login') }}">Changer d'utilisateur</a></p>
{% endblock %}
