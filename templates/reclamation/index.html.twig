{% extends 'base.html.twig' %}

{% block title %}
	Réclamations
{% endblock %}

{% block body %}

	{% include "alert.html.twig" %}
	<div class="side-app">
		<div class="page-header">

			<ol class="breadcrumb">
				<li class="breadcrumb-item active">
					Réclamations
				</li>
			</ol>

			<div>
				<a href="{{ path('app_reclamation_new') }}" class="btn btn-primary">
					<i class="fa fa-plus mr-1"></i>
					Demander un remboursement
				</a>
			</div>

		</div>

		<div class="card">

			<div class="card-header">
				<h3 class="card-title">
					{{ (estAdmin or peutPayer) ? 'Toutes les réclamations' : 'Mes réclamations' }}
				</h3>
			</div>

			<div class="card-body">

				<div class="table-responsive">

					<table class="table table-bordered mb-0">

						<thead>
							<tr>
								<th>Référence</th>
								{% if estAdmin or peutPayer %}
									<th>Agent</th>
								{% endif %}
								<th>Motif</th>
								<th class="text-right">Montant</th>
								<th class="text-center">Justificatif</th>
								<th class="text-center">Statut</th>
								<th>Date</th>
								<th class="text-center">Actions</th>
							</tr>
						</thead>

						<tbody>

							{% for reclamation in reclamations %}

								<tr>
									<td>
										<strong>{{ reclamation.reference }}</strong>
									</td>

									{% if estAdmin or peutPayer %}
										<td>
											{{ reclamation.agent.employe.prenom|default('') }}
											{{ reclamation.agent.employe.nom|default(reclamation.agent.username) }}
										</td>
									{% endif %}

									<td>
										{{ reclamation.motif|length > 80 ? (reclamation.motif|slice(0, 80) ~ '…') : reclamation.motif }}
									</td>

									<td class="text-right text-nowrap">
										{{ reclamation.montant|number_format(0, ',', ' ') }}
										F CFA
									</td>

									<td class="text-center">
										{% if reclamation.justificatif %}
											<a href="{{ asset('uploads/reclamations/' ~ reclamation.justificatif) }}" target="_blank" title="Voir le justificatif">
												<i class="fa fa-file-o"></i>
											</a>
										{% else %}
											<span class="text-muted">—</span>
										{% endif %}
									</td>

									<td class="text-center">
										{% if reclamation.isPayee %}
											<span class="badge badge-success">{{ reclamation.statutLabel }}</span>
										{% elseif reclamation.isValidee %}
											<span class="badge badge-info">{{ reclamation.statutLabel }}</span>
										{% elseif reclamation.isRefusee %}
											<span class="badge badge-danger">{{ reclamation.statutLabel }}</span>
										{% else %}
											<span class="badge badge-warning">{{ reclamation.statutLabel }}</span>
										{% endif %}
									</td>

									<td class="text-nowrap">
										{{ reclamation.dateCreation|date('d/m/Y') }}
									</td>

									<td class="text-center text-nowrap">

										<a href="{{ path('app_reclamation_show', {id: reclamation.id}) }}" class="btn btn-sm btn-primary-light" title="Voir">
											<i class="fa fa-eye"></i>
										</a>

										{% if peutPayer and reclamation.isValidee %}
											<a href="{{ path('app_reclamation_payer', {id: reclamation.id}) }}" class="btn btn-sm btn-success-light" title="Payer">
												<i class="fa fa-money"></i>
											</a>
										{% endif %}

									</td>
								</tr>

							{% else %}

								<tr>
									<td colspan="{{ (estAdmin or peutPayer) ? 8 : 7 }}" class="text-center text-muted">
										Aucune réclamation trouvée.
									</td>
								</tr>

							{% endfor %}

						</tbody>

					</table>

				</div>

			</div>

		</div>
	</div>
{% endblock %}
