{% extends 'espace/app/_app.html.twig' %}

{% set c = carte.commande %}
{% block title %}Commande {{ c.numero }}{% endblock %}
{% block styles %}<link href="{{ asset('css/avis.css') }}" rel="stylesheet">{% endblock %}
{% block scripts %}
	<script>
	(function () {
		// Commande prête : quelques confettis autour de l'étape, une seule fois par appareil, jamais si l'on réduit les animations.
		var frise = document.querySelector('.ec-frise[data-fete]');
		var etape = frise && frise.querySelector('[data-etape-prete]');
		if (!etape || !window.matchMedia || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
		var cle = 'ec-fete-' + frise.getAttribute('data-fete');
		try { if (localStorage.getItem(cle)) return; localStorage.setItem(cle, '1'); } catch (e) { return; }
		var zone = document.createElement('span');
		zone.className = 'ec-fete';
		zone.setAttribute('aria-hidden', 'true');
		var couleurs = ['#0F4590', '#DE1028', '#F5B800', '#E6007E', '#1F9D55'];
		for (var i = 0; i < 18; i++) {
			var b = document.createElement('i');
			var angle = (i / 18) * Math.PI * 2 + Math.random() * 0.3;
			var r = 38 + Math.random() * 34;
			b.style.cssText = '--x:' + Math.round(Math.cos(angle) * r) + 'px;--y:' + Math.round(Math.sin(angle) * r - 12) + 'px;--r:' + Math.round(Math.random() * 360) + 'deg;background:' + couleurs[i % couleurs.length] + ';animation-delay:' + (0.9 + Math.random() * 0.15).toFixed(2) + 's';
			zone.appendChild(b);
		}
		etape.classList.add('ec-frise-fete');
		etape.appendChild(zone);
		setTimeout(function () { zone.remove(); }, 2600);
	}());
	</script>
{% endblock %}
{% block entete %}<a class="ec-retour" href="{{ path('app_espace_commandes') }}"><span class="fl">‹</span>Commande n° {{ c.numero }}</a>{% endblock %}

{% block contenu %}
	{# Compte « Lecture · suivi » : le suivi seulement, sans montant ni action. #}
	{% set lecture = app.user.estLectureSeule() %}
	{% if carte.refuseeEntreprise %}
		<div class="ec-note">Demande refusée par {{ c.valideePar ?? 'votre entreprise' }}{% if c.motifRefusEntreprise %} : « {{ c.motifRefusEntreprise }} »{% endif %}. Elle ne part pas à l'atelier.</div>
	{% elseif carte.aValiderEntreprise %}
		<div class="ec-note">Demandée par {{ c.demandeePar ?? 'une personne de votre entreprise' }}. Elle part à l'atelier dès qu'une personne qui valide pour l'entreprise l'accepte.</div>
		{% if peutValider %}
			<div class="ec-carte">
				<h2>Valider cette demande ?</h2>
				<form method="post" action="{{ path('app_espace_commande_valider', {id: c.publicId}) }}">
					<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
					<button type="submit" class="ec-bouton">Valider et envoyer à l'atelier</button>
				</form>
				<details style="margin-top:.6rem">
					<summary class="ec-lien" style="cursor:pointer">Refuser</summary>
					<form method="post" action="{{ path('app_espace_commande_refuser', {id: c.publicId}) }}" style="margin-top:.5rem;display:grid;gap:.5rem">
						<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
						<label class="ec-petit" for="motif">Motif, lu par {{ c.demandeePar ?? 'la personne qui l\'a demandée' }} (facultatif)</label>
						<textarea class="ec-champ" id="motif" name="motif" maxlength="255" style="min-height:4rem"></textarea>
						<button type="submit" class="ec-bouton clair">Refuser la demande</button>
					</form>
				</details>
			</div>
		{% endif %}
	{% elseif carte.aConfirmer %}
		<div class="ec-note">Commande reçue. L'atelier vérifie le prix et votre fichier, puis la confirme : vous êtes prévenu à ce moment-là.</div>
	{% endif %}
	<div class="ec-carte">
		{% for l in lignes %}
			<div{% if not loop.first %} style="margin-top:.7rem;padding-top:.7rem;border-top:1px solid var(--trait)"{% endif %}>
				<b style="font-size:1.1rem">{{ l|espace_titre_ligne }}</b>
				{% set options = [l.support ? l.support.nom : null, l.finitions|map(f => f.nomFinition)|filter(n => n)|join(', ') ?: null]|filter(o => o) %}
				{% if options is not empty %}<div class="ec-petit">{{ options|join(' · ') }}</div>{% endif %}
				{% if l.demandeClient %}<div class="ec-petit">Votre demande : « {{ l.demandeClient }} »</div>{% endif %}
				{% set mesFichiers = l.fichiers|filter(f => f.actif and f.origine == 'client') %}
				{% if mesFichiers is not empty %}<div class="ec-petit">Fichier{{ mesFichiers|length > 1 ? 's' }} : {{ mesFichiers|map(f => f.nomOriginal)|join(', ') }}</div>{% endif %}
			</div>
		{% endfor %}
		<div style="display:flex;gap:.5rem;flex-wrap:wrap;margin-top:.8rem">
			{% if not carte.terminee and c.dateLivraison %}<span class="ec-pastille ambre">{{ c.estALivrer ? 'Livraison' : 'Prête' }} le {{ c.dateLivraison|date('d/m') }}</span>{% endif %}
			<span class="ec-pastille">{{ c.estALivrer ? 'Livraison' : 'Retrait boutique' }}</span>
		</div>
		{% if c.estALivrer and c.adresseLivraison %}<div class="ec-petit" style="margin-top:.4rem">Livrer : {{ c.adresseLivraison|nl2br }}</div>{% endif %}
	</div>

	{% for ctl in bats %}
		<a class="ec-alerte" href="{{ path('app_espace_bat', {id: ctl.id}) }}"><div><b>BAT à valider</b><small>{{ ctl.commandeDetail|espace_titre_ligne }}</small></div><span class="ec-bouton-blanc">Voir</span></a>
	{% endfor %}

	{# Une demande pas encore validée (ou refusée) par l'entreprise n'est pas à l'atelier : pas de frise. #}
	{% if not carte.aValiderEntreprise and not carte.refuseeEntreprise %}
	<div class="ec-carte">
		{# Prête et pas encore remise : une petite fête, une fois par appareil (docs/atelier-3d.md, animations). #}
		{% set prete = carte.etapes|filter(e => e.cle == 'prete' and e.etat == 'faite')|length > 0 and carte.etapes|filter(e => e.cle == 'livree' and e.etat == 'faite')|length == 0 %}
		<ol class="ec-frise"{% if prete %} data-fete="{{ c.numero }}"{% endif %}>
			{% for e in carte.etapes %}
				<li class="{{ e.etat }}" style="--i: {{ loop.index0 }}"{% if e.cle == 'prete' %} data-etape-prete{% endif %}>
					<b>{{ e.libelle }}</b>
					<small>{% if e.etat == 'faite' and e.date %}{{ e.date|date_fr('EEE') }} {{ e.date|date('d/m H:i') }}{% elseif e.etat == 'en_cours' %}{{ e.detail ?? 'en cours' }}{% else %}{{ e.detail }}{% endif %}</small>
					{% if e.cle == 'livree' and livraison and livraison.enRouteLe and not livraison.livreLe %}<small> · livreur parti à {{ livraison.enRouteLe|date('H:i') }}{{ livraison.creneau ? ', créneau ' ~ livraison.creneau }}</small>{% endif %}
				</li>
			{% endfor %}
		</ol>
	</div>
	{% endif %}

	{# Commande livrée : son avis (docs/sondages.md). #}
	{% set avis = avis_commande(c) %}
	{% if avis.reponse %}
		<div class="ec-carte av-merci">
			<span class="av-merci-icone" aria-hidden="true">★</span>
			<div><b>Merci pour votre avis</b><div class="ec-petit">Donné le {{ avis.reponse.creeLe|date('d/m/Y') }}{{ avis.reponse.auteur ? ' par ' ~ avis.reponse.auteur }}{% if avis.reponse.noteGlobale %} · {% for i in 1..5 %}<span style="color:{{ i <= avis.reponse.noteGlobale ? '#F5A800' : '#D8DEE8' }}">★</span>{% endfor %}{% endif %}</div></div>
		</div>
	{% elseif avis.possible and not lecture %}
		<a class="ec-carte av-merci" href="{{ path('app_espace_avis_commande', {id: c.publicId}) }}" style="color:inherit">
			<span class="av-merci-icone" aria-hidden="true">★</span>
			<div style="flex:1"><b>Votre avis sur cette commande ?</b><div class="ec-petit">Une minute : notez le travail, le délai et l'accueil.</div></div>
			<span class="ec-bouton-petit">Noter</span>
		</a>
	{% endif %}

	{% if not lecture %}
	<div class="ec-carte">
		{# Montants : CompteClient::montantsVisibles ; un demandeur voit la commande, son valideur en voit le prix. #}
		{% if coque.montants %}
			<div class="ec-ligne"><span>Total{{ carte.aConfirmer ? ' indicatif' }}</span><b>{{ c.totalTtc|number_format(0, ',', ' ') }} F</b></div>
		{% else %}
			<div class="ec-ligne"><span>Prix</span><span class="ec-petit">confirmé par votre valideur</span></div>
		{% endif %}
		{% if peutPayer and not carte.refuseeEntreprise %}<div class="ec-ligne" style="margin-top:.3rem"><span>Reste à payer</span><b class="{{ c.resteAPayer > 0 ? 'ec-montant' }}">{{ c.resteAPayer|number_format(0, ',', ' ') }} F</b></div>{% endif %}
		{% if c.bonCommande %}<div class="ec-ligne" style="margin-top:.3rem"><span class="ec-petit">Bon de commande</span><span>{{ c.bonCommande }}</span></div>{% endif %}
		{% if peutPayer and c|espace_en_validation > 0 %}<div class="ec-ligne" style="margin-top:.3rem"><span class="ec-petit">Payé par Orange Money, en validation</span><span>{{ (c|espace_en_validation)|number_format(0, ',', ' ') }} F</span></div>{% endif %}
		{# Frais Orange Money payés en plus (fonds de soutien, retrait) : sur le paiement, hors commande. Pour qui paie seulement. #}
		{% if peutPayer %}
			{% for p in c|espace_paiements_om %}
				<div class="ec-ligne" style="margin-top:.3rem;align-items:flex-start">
					<span class="ec-petit">
						Payé avec Orange Money le {{ p.date|date('d/m') }}{{ p.statut == 'en_attente' ? ' · en validation' }}<br>
						<span class="ec-nowrap">{{ p.montant|number_format(0, ',', ' ') }} F</span> pour la commande{% if p.montantFondsSoutien > 0 %} + fonds de soutien <span class="ec-nowrap">{{ p.montantFondsSoutien|number_format(0, ',', ' ') }} F</span>{% endif %}{% if p.montantFraisRetrait > 0 %} + frais de retrait <span class="ec-nowrap">{{ p.montantFraisRetrait|number_format(0, ',', ' ') }} F</span>{% endif %}
					</span>
					<span class="ec-nowrap">{{ p.montantTotalEncaisse|number_format(0, ',', ' ') }} F</span>
				</div>
			{% endfor %}
		{% endif %}
		{% if c|espace_a_payer > 0 and not carte.aConfirmer and peutPayer %}<div class="ec-boutons"><a class="ec-bouton orange" href="{{ path('app_espace_payer', {id: c.publicId}) }}">Payer avec Orange Money</a></div>{% endif %}
	</div>
	{% endif %}

	{% if whatsapp or (c.isStatut and not lecture) %}
		<div class="ec-boutons" id="recommander">
			{% if whatsapp %}<a class="ec-bouton clair" href="{{ whatsapp }}" target="_blank" rel="noopener">Contacter l'atelier sur WhatsApp</a>{% endif %}
			{% if c.isStatut and not lecture %}<a class="ec-lien" href="{{ path('app_espace_reclamation_nouvelle', {commande: c.publicId}) }}" style="display:block;text-align:center;margin-top:.7rem">Un problème avec cette commande ?</a>{% endif %}
		</div>
	{% endif %}
{% endblock %}
