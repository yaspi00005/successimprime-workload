{% extends 'achats/_base.html.twig' %}
{% import 'achats/_macros.html.twig' as m %}

{% block title %}Fournisseurs{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_fournisseur_export') }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-download me-1"></i>Exporter</a>
	</li>
	<li class="nav-item">
		<a href="{{ path('app_fournisseur_new') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Fournisseur</a>
	</li>
{% endblock %}

{% block body %}
	{% set voir_du = is_granted('ROLE_TRESORERIE_VOIR') %}
	<div class="ac-page">

		<section class="ac-kpis" aria-label="Indicateurs des achats">
			<a class="ac-kpi" href="{{ path('app_achat_index', {statut: 'toutes'}) }}">
				<span>Achats en {{ (aujourdhui|mois_francais|split(' ')|first)|lower }}</span>
				<b>{{ m.f(kpis.mois.montant) }}</b>
				<small>{{ kpis.mois.nombre }} commande{{ kpis.mois.nombre > 1 ? 's' }}</small>
			</a>
			{% if voir_du %}
				<a class="ac-kpi" href="{{ path('app_finances_fournisseurs') }}">
					<span>Dû aux fournisseurs</span>
					<b class="ac-bleu">{{ m.f(kpis.du) }}</b>
					<small>{{ kpis.echeance ? 'prochaine échéance ' ~ kpis.echeance|date('d/m') : 'aucune facture à payer' }}</small>
				</a>
			{% endif %}
			<a class="ac-kpi" href="{{ path('app_achat_index') }}">
				<span>En route</span>
				{% set n = kpis.en_route|length %}
				<b class="{{ n > 0 ? 'ac-orange' }}">{{ n }} commande{{ n > 1 ? 's' }}</b>
				{% if n > 0 %}
					{% set premiere = kpis.en_route|first %}
					<small>{{ premiere.achat.fournisseur.nomCourt }}{{ premiere.prevue ? ' · arrivée ' ~ premiere.prevue|date('d/m') }}</small>
				{% else %}
					<small>rien en attente</small>
				{% endif %}
			</a>
			<a class="ac-kpi" href="{{ path('app_reappro_index') }}">
				<span>À commander bientôt</span>
				<b class="{{ kpis.bientot > 0 ? 'ac-rouge' : 'ac-vert' }}">{{ kpis.bientot }} article{{ kpis.bientot > 1 ? 's' }}</b>
				<small>alertes de réapprovisionnement</small>
			</a>
		</section>

		<section class="ac-carte" aria-label="Fournisseurs">
			{% if lignes is empty %}
				<p class="mb-0">Aucun fournisseur. <a href="{{ path('app_fournisseur_new') }}">Ajouter le premier</a>.</p>
			{% else %}
				<div class="ac-defile">
					<table class="ac-table ac-liste">
						<thead>
							<tr>
								<th>Fournisseur</th>
								<th>Fournit</th>
								<th>Origine</th>
								<th>Délai moyen</th>
								<th>À l'heure</th>
								<th class="num">Achats {{ aujourdhui|date('Y') }}</th>
								{% if voir_du %}<th class="num">Dû</th>{% endif %}
								<th>Prochaine commande</th>
							</tr>
						</thead>
						<tbody>
							{% for l in lignes %}
								{% set f = l.fournisseur %}
								<tr class="{{ not f.actif ? 'ac-inactif' }}">
									<td class="ac-pleine">
										<a class="ac-nom ac-lien" href="{{ path('app_fournisseur_show', {id: f.id}) }}">{{ m.avatar(f) }}<span>{{ f.nomCourt }}{% if not f.actif %} <small class="ac-muet">(inactif)</small>{% endif %}</span></a>
									</td>
									<td class="ac-pleine" data-libelle="Fournit">{{ f.fournit ?? '—' }}</td>
									<td data-libelle="Origine"><span class="ac-muet">{{ f.origine ?? '—' }}</span></td>
									<td data-libelle="Délai moyen" title="{{ f.delaiPromisJours is not null ? 'promis ' ~ f.delaiPromisJours ~ ' j' }}"><b>{{ m.jours(l.stats.delaiReel) }}</b></td>
									<td data-libelle="À l'heure">{{ m.ponctualite(l.stats.aLHeure) }}</td>
									<td class="num" data-libelle="Achats {{ aujourdhui|date('Y') }}">{{ l.stats.achatsAnnee > 0 ? m.f(l.stats.achatsAnnee) : '—' }}</td>
									{% if voir_du %}<td class="num" data-libelle="Dû">{% if l.du %}<b class="ac-bleu">{{ m.f(l.du.du) }}</b>{% else %}<span class="ac-muet">—</span>{% endif %}</td>{% endif %}
									<td class="ac-pleine" data-libelle="Prochaine commande">
										{% if l.prochaine %}
											<a class="ac-prochaine {{ l.prochaine.urgence }}" href="{{ path('app_achat_new', {article: l.prochaine.article.id}) }}" title="{{ l.prochaine.joursRestants is not null ? l.prochaine.joursRestants ~ ' j de stock · délai ' ~ l.prochaine.delai ~ ' + ' ~ l.prochaine.marge ~ ' j' }}">{{ l.prochaine.article.designation|split(' · ')|first }} · {{ l.prochaine.urgence == 'sous_minimum' ? 'sous le minimum' : (l.prochaine.urgence == 'maintenant' ? 'maintenant' : (l.prochaine.urgence == 'bientot' ? 'avant le ' : 'le ') ~ l.prochaine.date|date('d/m')) }}</a>
										{% else %}
											<span class="ac-muet">—</span>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>
			{% endif %}
			<p class="ac-note">« À l'heure » : part des livraisons arrivées à la date promise sur 12 mois. « Délai moyen » : de la commande à l'arrivée, mesuré. « Prochaine commande » vient de la consommation des 12 dernières semaines, du délai du fournisseur et d'une marge de {{ marge }} jours (Réglages, tuile « Achats et fournisseurs »).</p>
		</section>
	</div>
{% endblock %}
