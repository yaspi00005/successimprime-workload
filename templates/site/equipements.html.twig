{#
	Nos équipements (maquette 05), page « equipements » de Réglages › Site
	vitrine : une carte par machine (« ### », étiquette en italique), puis
	la bande des finitions (ligne de pastilles « A · B · C »).
#}
{% extends 'site/_site.html.twig' %}

{# Sans page de devis ni de contact, la demande part sur WhatsApp (« devis » est déjà pris par le gabarit). #}
{% set lien_devis = site_lien('app_site_devis') ?? site_lien('app_site_contact') ?? site_whatsapp('Bonjour Succès Imprim, je voudrais un devis.') %}
{% set devis_externe = lien_devis and lien_devis starts with 'https://' %}
{% set photo = site_image(page.image) %}
{% set image_partage = photo %}

{% block title %}{{ page.titre|site_titre }}{% endblock %}
{% block description %}{{ (page.description ?? page.accroche ?? 'Les machines de l\'atelier Succès Imprim à Bamako : grand format jusqu\'à 3,20 m, textile, petit format et finitions.')|site_description }}{% endblock %}

{% block entete %}
	{{ site_styles('css/site-contenu.css') }}
{% endblock %}

{% block contenu %}
	{{ include('site/_bandeau.html.twig', {titre: page.titre, accroche: page.accroche, ariane: definition.libelle}) }}

	<section class="sc-section">
		<div class="si-cadre">
			{% if contenu.intro or photo %}
				<div class="sc-intro{{ photo ? ' sc-intro-photo' }}">
					{% if contenu.intro %}<div class="sc-prose">{{ site_blocs(contenu.intro) }}</div>{% endif %}
					{% if photo %}<img src="{{ asset(photo.chemin) }}" width="{{ photo.largeur }}" height="{{ photo.hauteur }}" alt="{{ page.image.texteAlternatif ?? 'L\'atelier Succès Imprim' }}" class="sc-photo">{% endif %}
				</div>
			{% endif %}

			{% for s in contenu.sections %}
				{% set pastilles = s.blocs|filter(b => b.type == 'pastilles') %}
				{% if s.cartes is not empty %}
					{% set niveau = s.titre ? 'h3' : 'h2' %}
					<section class="sc-bloc-section"{% if s.titre %} aria-labelledby="{{ s.ancre }}"{% endif %}>
						{% if s.titre %}<h2 id="{{ s.ancre }}" class="sc-titre-section">{{ s.html|raw }}</h2>{% endif %}
						{% if s.blocs %}<div class="sc-prose">{{ site_blocs(s.blocs) }}</div>{% endif %}
						<div class="sc-machines">
							{% for c in s.cartes %}
								<article class="sc-machine sc-teinte-{{ loop.index0 % 4 }}" id="{{ c.ancre }}">
									<div class="sc-machine-illu">{{ include('site/_machine.svg.twig') }}</div>
									<div class="sc-machine-corps">
										{% if c.etiquette %}<span class="sc-etiquette">{{ c.etiquette }}</span>{% endif %}
										<{{ niveau }} class="sc-carte-titre">{{ c.html|raw }}</{{ niveau }}>
										{% if c.blocs %}<div class="sc-prose">{{ site_blocs(c.blocs) }}</div>{% endif %}
									</div>
								</article>
							{% endfor %}
						</div>
					</section>
				{% elseif pastilles is not empty %}
					<section class="sc-bande"{% if s.titre %} aria-labelledby="{{ s.ancre }}"{% endif %}>
						{% if s.titre %}<h2 id="{{ s.ancre }}">{{ s.html|raw }}</h2>{% endif %}
						<div class="sc-bande-texte sc-prose">{{ site_blocs(s.blocs) }}</div>
						{% if lien_devis %}<a href="{{ lien_devis }}" class="si-bouton si-bouton-rouge si-bouton-grand"{% if devis_externe %} target="_blank" rel="noopener"{% endif %}>Demander un devis</a>{% endif %}
					</section>
				{% else %}
					{{ include('site/_section.html.twig', {s: s}) }}
				{% endif %}
			{% endfor %}
		</div>
	</section>
{% endblock %}
