{# Mise en page de la saisie : section « Saisie d'une commande » de public/css/admin.css. #}
<style>
	#commande-form .select2-container {
		width: 100% !important;
	}

	#commande-form .select2-container .select2-selection--single {
		min-height: 2.6rem;
		border-radius: 0.6rem;
		border-color: #D5DCE8;
		display: flex;
		align-items: center;
	}
</style>


<script>

	function initialiserFormulaireCommande() {

console.log('[DEBUG] initialiserFormulaireCommande() : execution du script');

const form = document.getElementById('commande-form');

const collection = document.getElementById('collection-details');

const addButton = document.getElementById('add-detail');

const addButtonBas = document.getElementById('add-detail-bottom');

if (! form || ! collection) {
return;
}


const commandeVerrouillee = form.dataset.circuitVerrouille === '1';


/*
         * ====================================================
         * CLIENT B2B / B2C
         * ====================================================
         */

const clientSelect = form.querySelector('.js-client-commande');

const profilClient = form.querySelector('.js-profil-client');

const profilClientAide = form.querySelector('.js-profil-client-aide');

console.log('[DEBUG] clientSelect trouve ?', !! clientSelect, clientSelect);
console.log('[DEBUG] profilClient trouve ?', !! profilClient);
console.log('[DEBUG] profilClientAide trouve ?', !! profilClientAide);
console.log('[DEBUG] commandeVerrouillee =', commandeVerrouillee);


function typeClientActuel() {

if (! clientSelect || ! clientSelect.value) {
return 'B2C';
}

const option = clientSelect.options[clientSelect.selectedIndex];

if (! option) {
return 'B2C';
}

const type = String(option.dataset.typeClient || 'B2C').trim().toUpperCase();

return type === 'B2B' ? 'B2B' : 'B2C';
}


function clientEstB2B() {
return typeClientActuel() === 'B2B';
}


function afficherProfilClient() {

console.log('[DEBUG] afficherProfilClient() appelee, clientSelect.value =', clientSelect ? clientSelect.value : '(pas de clientSelect)');

if (! profilClient || ! profilClientAide) {
console.log('[DEBUG] afficherProfilClient() : profilClient/profilClientAide introuvable, arret');
return;
}

if (! clientSelect || ! clientSelect.value) {
console.log('[DEBUG] afficherProfilClient() : clientSelect vide, affichage placeholder');
profilClient.textContent = 'Sélectionnez un client';
profilClientAide.textContent = 'Le tarif B2B ou B2C sera appliqué automatiquement.';
return;
}

if (clientEstB2B()) {
profilClient.textContent = 'Client B2B';
profilClientAide.textContent = 'Le tarif professionnel B2B est appliqué automatiquement lorsqu’il existe pour le produit.';
} else {
profilClient.textContent = 'Client B2C';
profilClientAide.textContent = 'Le prix public est appliqué, sans remise B2B.';
}
}


async function appliquerNouveauProfilClient() {

console.log('[DEBUG] appliquerNouveauProfilClient() DECLENCHE (changement client detecte)');

afficherProfilClient();

const details = collection.querySelectorAll('.detail-commande');

for (const detail of details) {

if (valeurTypeLigne(detail) !== 'produit') {
continue;
}

const mode = valeurModeConfiguration(detail);

if (mode === 'automatique') {
const configuration = champDetail(detail, 'configuration');

if (configuration && configuration.value) {
await chargerConfiguration(detail);
}
} else {
const produit = champDetail(detail, 'produit');

if (produit && produit.value) {
await chargerOptionsManuelles(detail);
}
}
}

calculerCommande();
}


/*
         * ====================================================
         * URLS
         * ====================================================
         */

const configurationsProduitUrl = "{{ path(
                'app_commande_catalogue_produit',
                {'id': 0}
            ) }}";

const configurationUrl = "{{ path(
                'app_commande_catalogue_configuration',
                {'id': 0}
            ) }}";

const optionsManuellesUrl = "{{ path(
                'app_commande_catalogue_options_manuelles',
                {'id': 0}
            ) }}";

const articleCommandeUrl = "{{ path(
                'app_article_commande_ajax',
                {'id': 0}
            ) }}";

const uploadCsrf = form.dataset.uploadCsrf;

const uploadInitialiserUrl = form.dataset.uploadInitialiserUrl;

const uploadMorceauUrlModele = form.dataset.uploadMorceauUrl;

const uploadStatutUrlModele = form.dataset.uploadStatutUrl;

const uploadSupprimerUrlModele = form.dataset.uploadSupprimerUrl;


/*
         * ====================================================
         * HELPERS
         * ====================================================
         */

function construireUrl(modele, id) { /*
 * "/0/" ne fonctionne que si l'id 0 est suivi d'un autre segment
 * (ex. /produit/0/options-manuelles). Quand 0 est le DERNIER
 * segment de l'URL (ex. /produit/0, /configuration/0), il n'y a
 * pas de "/" apres : le remplacement echouait silencieusement et
 * l'URL gardait l'id 0, jamais trouve cote serveur
 * (EntityValueResolver : "Produits introuvable").
 */
return modele.replace(/\/0(\/|$)/, '/' + encodeURIComponent(id) + '$1');
}


/*
         * ====================================================
         * ENVOI DES FICHIERS (morceaux)
         *
         * Le formulaire porte deja les URLs et le jeton CSRF
         * necessaires (data-upload-*) et le backend (chunked upload,
         * FichierUploadController) fonctionne integralement, mais
         * rien ne les utilisait cote client : choisir un fichier ne
         * declenchait jamais son envoi, et le champ cache
         * jetonsFichiers restait vide. Sans jeton, rattacherFichiers()
         * cote serveur n'a rien a rattacher : le formulaire partait
         * sans les fichiers.
         * ====================================================
         */

const TAILLE_MORCEAU_UPLOAD = 5 * 1024 * 1024;

function construireUrlMorceauUpload(jeton, index) {
return uploadMorceauUrlModele.replace('__JETON__', jeton).replace('__INDEX__', String(index));
}

function construireUrlSuppressionFichier(jeton) {
return uploadSupprimerUrlModele.replace('__JETON__', jeton);
}

function echapperHtml(texte) {
const zone = document.createElement('div');
zone.textContent = texte;
return zone.innerHTML;
}

/*
 * Au-dela de cette taille, on n'essaie plus de generer d'apercu
 * miniature pour une image : meme via createObjectURL(), le
 * navigateur doit decoder toute l'image (largeur/hauteur reelles)
 * pour en afficher ne serait-ce qu'une vignette 40x40, ce qui peut
 * geler la page un instant sur une tres grosse photo/scan.
 */
const LIMITE_APERCU_IMAGE = 8 * 1024 * 1024;

function creerLigneUpload(fichier) {
const ligne = document.createElement('div');

ligne.className = 'd-flex align-items-center border rounded p-2 mb-2 js-upload-ligne';

const estImage = fichier.type
&& fichier.type.indexOf('image/') === 0
&& fichier.size <= LIMITE_APERCU_IMAGE;

const apercu = document.createElement(estImage ? 'img' : 'i');

if (estImage) {
apercu.className = 'mr-2 rounded js-upload-apercu';
apercu.style.width = '40px';
apercu.style.height = '40px';
apercu.style.objectFit = 'cover';

/*
 * URL.createObjectURL() plutot que FileReader.readAsDataURL() :
 * ce dernier lit et encode tout le fichier en base64 en memoire
 * avant meme le debut de l'envoi, ce qui bloque/fait planter le
 * navigateur sur les fichiers lourds (grosses photos, scans...).
 * createObjectURL() ne fait qu'une reference legere geree par le
 * navigateur, sans lire le contenu.
 */
apercu.src = URL.createObjectURL(fichier);
} else {
apercu.className = 'fa fa-file-o mr-2 js-upload-icone';
apercu.style.fontSize = '24px';
}

const infos = document.createElement('div');
infos.className = 'flex-grow-1';

infos.innerHTML = '<div class="small font-weight-bold">' + echapperHtml(fichier.name) + '</div>' + '<div class="progress" style="height:4px;"><div class="progress-bar js-upload-barre" style="width:0%"></div></div>' + '<div class="small text-muted js-upload-statut">En attente...</div>';

const boutonSupprimer = document.createElement('button');
boutonSupprimer.type = 'button';
boutonSupprimer.className = 'btn btn-sm btn-link text-danger js-upload-supprimer';
boutonSupprimer.title = 'Supprimer ce fichier';
boutonSupprimer.innerHTML = '<i class="fa fa-trash"></i>';

ligne.appendChild(apercu);
ligne.appendChild(infos);
ligne.appendChild(boutonSupprimer);

return ligne;
}

function ajouterJetonFichier(detail, jeton) {
const champ = detail.querySelector('.js-jetons-fichiers');

if (! champ) {
return;
}

const valeurs = champ.value ? champ.value.split(',').map(function (v) {
return v.trim();
}).filter(Boolean) : [];

if (valeurs.indexOf(jeton) === -1) {
valeurs.push(jeton);
}

champ.value = valeurs.join(',');
}

function retirerJetonFichier(detail, jeton) {
const champ = detail.querySelector('.js-jetons-fichiers');

if (! champ) {
return;
}

const valeurs = champ.value
? champ.value.split(',').map(function (v) { return v.trim(); }).filter(Boolean)
: [];

champ.value = valeurs.filter(function (v) { return v !== jeton; }).join(',');
}

async function supprimerFichierTeleverse(detail, ligne) {
const jeton = ligne.dataset.jeton || '';

const statutTexte = ligne.querySelector('.js-upload-statut');

/*
 * Pas encore de jeton (upload pas encore initialise cote serveur) :
 * rien a supprimer la-bas, on retire juste la ligne localement.
 */
if (! jeton) {
ligne.remove();

return;
}

// Fenêtre de confirmation de l'application (public/js/confirmation.js) : le fichier n'est rattaché à rien encore, il part pour de bon.
if (! (await window.SiConfirmation.demander({message: 'Supprimer ce fichier ?', detail: 'Il vient d’être envoyé et n’est encore dans aucune commande : il est effacé pour de bon.', bouton: 'Supprimer', danger: true}))) {
return;
}

if (statutTexte) {
statutTexte.textContent = 'Suppression...';
}

try {

const reponse = await fetch(construireUrlSuppressionFichier(jeton), {
method: 'POST',
headers: {
'X-CSRF-TOKEN': uploadCsrf
}
});

if (! reponse.ok) {
const donnees = await reponse.json().catch(function () { return {}; });

throw new Error(donnees.message || 'Impossible de supprimer ce fichier.');
}

retirerJetonFichier(detail, jeton);

ligne.remove();

} catch (erreur) {

console.error(erreur);

if (statutTexte) {
statutTexte.textContent = 'Échec : ' + erreur.message;
}
}
}

async function televerserFichier(detail, fichier, ligneUpload) {
const barre = ligneUpload.querySelector('.js-upload-barre');

const statutTexte = ligneUpload.querySelector('.js-upload-statut');

try {

const nombreMorceaux = Math.max(1, Math.ceil(fichier.size / TAILLE_MORCEAU_UPLOAD));

const reponseInit = await fetch(uploadInitialiserUrl, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
'X-CSRF-TOKEN': uploadCsrf,
Accept: 'application/json'
},
body: JSON.stringify(
{
nom: fichier.name,
typeMime: fichier.type || 'application/octet-stream',
taille: fichier.size,
nombreMorceaux: nombreMorceaux
}
)
});

const donneesInit = await reponseInit.json();

if (! reponseInit.ok || ! donneesInit.jeton) {
throw new Error(donneesInit.message || "Impossible d'initialiser l'envoi.");
}

const jeton = donneesInit.jeton;

/*
 * Rendu disponible sur la ligne pour le bouton de suppression :
 * on peut annuler un envoi meme avant qu'il soit termine.
 */
ligneUpload.dataset.jeton = jeton;

for (let index = 0; index < nombreMorceaux; index++) {

const debut = index * TAILLE_MORCEAU_UPLOAD;

const fin = Math.min(fichier.size, debut + TAILLE_MORCEAU_UPLOAD);

const donneesFormulaire = new FormData();

donneesFormulaire.append('morceau', fichier.slice(debut, fin), fichier.name);

const reponseMorceau = await fetch(construireUrlMorceauUpload(jeton, index), {
method: 'POST',
headers: {
'X-CSRF-TOKEN': uploadCsrf
},
body: donneesFormulaire
});

const donneesMorceau = await reponseMorceau.json();

if (! reponseMorceau.ok) {
throw new Error(donneesMorceau.message || "L'envoi du fichier a été interrompu.");
}

const progression = typeof donneesMorceau.progression === 'number' ? donneesMorceau.progression : Math.round(((index + 1) / nombreMorceaux) * 100);

if (barre) {
barre.style.width = progression + '%';
}

if (statutTexte) {
statutTexte.textContent = progression + ' %';
}
}

ajouterJetonFichier(detail, jeton);

if (statutTexte) {
statutTexte.textContent = 'Envoyé';
}

ligneUpload.classList.add('text-success');

} catch (erreur) {

console.error(erreur);

if (statutTexte) {
statutTexte.textContent = 'Échec : ' + erreur.message;
}

ligneUpload.classList.add('text-danger');
}
}

function initialiserUploadFichiers(detail) {
const champFichier = detail.querySelector('.js-fichiers-client');

const zoneListe = detail.querySelector('.js-liste-uploads');

if (! champFichier || ! zoneListe || ! uploadInitialiserUrl) {
return;
}

champFichier.addEventListener('change', async function () {

const fichiers = Array.from(champFichier.files || []);

/*
 * Reinitialise le champ natif : sans cela, choisir a nouveau
 * exactement le meme fichier ne redeclenche pas "change".
 */
champFichier.value = '';

/*
 * Envoi des fichiers un par un (et non tous en parallele) :
 * avec plusieurs fichiers lourds selectionnes d'un coup, lancer
 * tous les envois en meme temps multiplie la charge memoire/
 * reseau au meme instant et peut faire planter/geler la page.
 */
for (const fichier of fichiers) {

const ligne = creerLigneUpload(fichier);

zoneListe.appendChild(ligne);

const boutonSupprimer = ligne.querySelector('.js-upload-supprimer');

if (boutonSupprimer) {
boutonSupprimer.addEventListener('click', function () {
supprimerFichierTeleverse(detail, ligne);
});
}

await televerserFichier(detail, fichier, ligne);
}
});
}


function champDetail(detail, nom) {
return detail.querySelector('[data-detail-field="' + nom + '"],' + '[name$="[' + nom + ']"]');
}


function nombreDepuisChamp(champ, valeurDefaut = 0) {
if (! champ || champ.value === '') {
return valeurDefaut;
}

const valeur = Number(String(champ.value).replace(',', '.'));

return Number.isFinite(valeur) ? valeur : valeurDefaut;
}


/*
 * Les champs largeur/longueur sont saisis en centimetres (voir
 * CommandesDetailsType), mais les calculs de surface/metre lineaire
 * ci-dessous raisonnent en metres (comme le catalogue). On convertit
 * donc systematiquement a la lecture du champ.
 */
function metresDepuisChampCm(champ) {
return Math.max(0, nombreDepuisChamp(champ)) / 100;
}


function formaterNombre(valeur, decimals = 3) {
return Number(valeur || 0).toLocaleString('fr-FR', {maximumFractionDigits: decimals});
}


function formaterMontant(valeur) {
return Math.round(Number(valeur || 0)).toLocaleString('fr-FR');
}


function definirValeur(detail, champNom, valeur) {
const champ = champDetail(detail, champNom);

if (! champ) {
return;
}

if (valeur && typeof valeur === 'object' && valeur.id !== undefined) {
valeur = valeur.id;
}

const nouvelleValeur = valeur === null || valeur === undefined ? '' : String(valeur);

/*
 * Garde anti-recursion : certains champs (ex. "surface") portent
 * la classe js-calcul-detail et redeclenchent calculerDetail() sur
 * l'evenement "input". Sans ce garde-fou, calculerDetail() ->
 * definirValeur() -> input -> calculerDetail() -> ... boucle
 * indefiniment (RangeError: Maximum call stack size exceeded).
 * Si la valeur ne change pas reellement, on ne redispatche rien.
 */
if (champ.value === nouvelleValeur) {
return;
}

champ.value = nouvelleValeur;

if (champ.tagName === 'SELECT' && window.jQuery && window.jQuery.fn.select2) {
window.jQuery(champ).val(champ.value).trigger('change.select2');
}

champ.dispatchEvent(new Event('input', {bubbles: true}));
}


function valeurTypeLigne(detail) {
const radio = detail.querySelector('[name$="[typeLigne]"]:checked');

if (radio) {
return radio.value;
}

const champ = champDetail(detail, 'typeLigne');

return champ ? champ.value : 'produit';
}


function valeurModeConfiguration(detail) {
const radio = detail.querySelector('[name$="[modeConfiguration]"]:checked');

if (radio) {
return radio.value;
}

const champ = champDetail(detail, 'modeConfiguration');

return champ ? champ.value : 'automatique';
}


function afficher(detail, selecteur, visible) {
const zone = detail.querySelector(selecteur);

if (zone) {
zone.style.display = visible ? '' : 'none';
}
}


/*
 * Reduit un conteneur (finitions, caracteristiques techniques...) a
 * ses "seuil" premiers enfants directs et ajoute un bouton pour
 * afficher/masquer le reste. Rappelable plusieurs fois sur le meme
 * conteneur (ex: apres reconstruction dynamique de la liste des
 * finitions) : l'ancien bouton est retire avant d'en recreer un,
 * ce qui remet la liste repliee a chaque nouvel appel.
 */
function limiterListeCourte(conteneur, seuil) {
if (! conteneur) {
return;
}

const ancienBouton = conteneur.nextElementSibling;

if (ancienBouton && ancienBouton.classList.contains('js-voir-plus-toggle')) {
ancienBouton.remove();
}

const enfants = Array.from(conteneur.children);

if (enfants.length <= seuil) {
return;
}

enfants.slice(seuil).forEach(function (el) {
el.classList.add('d-none');
});

const nbCaches = enfants.length - seuil;

const bouton = document.createElement('button');
bouton.type = 'button';
bouton.className = 'btn btn-link btn-sm p-0 mt-2 js-voir-plus-toggle';
bouton.textContent = 'Afficher ' + nbCaches + ' de plus';

bouton.addEventListener('click', function () {
const estReduit = enfants[seuil].classList.contains('d-none');

enfants.slice(seuil).forEach(function (el) {
el.classList.toggle('d-none', ! estReduit);
});

bouton.textContent = estReduit ? 'Réduire' : ('Afficher ' + nbCaches + ' de plus');
});

conteneur.insertAdjacentElement('afterend', bouton);
}


/*
 * Verrouille un champ dont la valeur provient du catalogue (prix,
 * mode de calcul) : l'utilisateur ne doit pas pouvoir le modifier
 * manuellement tant qu'il vient du produit/de la configuration.
 * "readOnly" ne fonctionne pas sur un <select> : on utilise
 * pointer-events pour bloquer l'interaction tout en laissant la
 * valeur soumise avec le formulaire.
 */
function verrouillerChampCatalogue(champ, verrouille) {
if (! champ) {
return;
}

if (champ.tagName === 'SELECT') {
champ.style.pointerEvents = verrouille ? 'none' : '';
champ.tabIndex = verrouille ? -1 : 0;
} else {
champ.readOnly = verrouille;
}
}


/*
         * ====================================================
         * SELECT2
         * ====================================================
         */

function initialiserSelect2(scope) {
if (!window.jQuery || !window.jQuery.fn.select2) {
return;
}

window.jQuery(scope).find('select.js-select-search').each(function () {

const select = window.jQuery(this);

if (select.hasClass('select2-hidden-accessible')) {
return;
}

select.select2({
width: '100%',

allowClear: true,

placeholder: select.data('placeholder') || 'Rechercher...',

/*
 * filtrerOptions() marque les options incompatibles avec
 * option.disabled = true (type d'impression / support / format
 * non lies au produit choisi en mode manuel). Select2 construit
 * sa propre liste deroulante et ignore par defaut les attributs
 * "hidden"/"disabled" du <select> natif : sans ce matcher, les
 * options desactivees restaient visibles et selectionnables dans
 * le menu Select2, alors qu'elles ne l'etaient plus dans le
 * <select> natif.
 */
matcher: function (params, data) {
if (data.element && data.element.disabled) {
return null;
}

// Sans accents, majuscules ni pluriel : « autocollants » trouve « Vinyle adhésif (Autocollant) » (docs/noms-commerciaux.md).
const sansAccents = function (t) {
return String(t || '').normalize('NFD').replace(/[\u0300-\u036f]/g, '').toUpperCase().replace(/([A-Z]{3})[SX](?=[^A-Z0-9]|$)/g, '$1');
};

const terme = sansAccents((params.term || '').trim());

if (terme === '') {
return data;
}

const texte = sansAccents(data.text);

return texte.indexOf(terme) > -1 ? data : null;
}
});

});
}


/*
 * Un select transforme par Select2 notifie une selection en appelant
 * $(element).trigger('change'), qui ne passe QUE par le systeme
 * d'evenements interne de jQuery : un ecouteur natif
 * addEventListener('change', ...) ne le recoit jamais. Cette fonction
 * attache le gestionnaire via jQuery quand il est disponible (cas de
 * tous les champs .js-select-search de ce formulaire : produit,
 * article, configuration, client), et retombe sur addEventListener
 * sinon.
 */
function attacherChangement(champ, gestionnaire) {
if (! champ) {
return;
}

if (window.jQuery) {
window.jQuery(champ).on('change', gestionnaire);
} else {
champ.addEventListener('change', gestionnaire);
}
}


/*
         * ====================================================
         * CALCUL
         * ====================================================
         */

function montantFinitions(detail) {
if (valeurTypeLigne(detail) !== 'produit') {
return 0;
}

const automatiques = Array.from(detail.querySelectorAll('.js-finition-selectionnee:checked')).reduce(function (total, checkbox) {
return total + Number(checkbox.dataset.prix || 0);
}, 0);

/*
 * Finitions manuelles : simple apercu cote client (forfait =
 * prix fixe, sinon prix x quantite). Le montant definitif de
 * chaque ligne est recalcule cote serveur a l'enregistrement.
 */
const manuelles = Array.from(detail.querySelectorAll('.js-finition-manuelle')).reduce(function (total, ligne) {
const prix = Number(ligne.querySelector('.js-finition-prix') ?. value || 0);
const quantite = Math.max(1, Number(ligne.querySelector('.js-finition-quantite') ?. value || 1));
const mode = ligne.querySelector('.js-finition-mode') ?. value || 'forfait';

return total + (mode === 'forfait' ? prix : prix * quantite);
}, 0);

return automatiques + manuelles;
}


function calculerDetail(detail) {
const quantite = Math.max(1, nombreDepuisChamp(champDetail(detail, 'quantite'), 1));

const largeur = metresDepuisChampCm(champDetail(detail, 'largeur'));

const longueur = metresDepuisChampCm(champDetail(detail, 'longueur'));

const surface = largeur * longueur;

const prix = Math.max(0, nombreDepuisChamp(champDetail(detail, 'prixUnitaire')));

const remise = Math.max(0, nombreDepuisChamp(champDetail(detail, 'remise')));

const tva = Math.max(0, nombreDepuisChamp(champDetail(detail, 'tva')));

const mode = String(champDetail(detail, 'modeCalcul') ?. value || 'unite');

// Pièces au m² (public/js/pieces-m2.js) : surface facturée selon les pièces qui tiennent sur 1 m², ou null.
const surfacePieces = window.SiPiecesM2 ? window.SiPiecesM2.ligne(detail, {mode: mode, typeLigne: valeurTypeLigne(detail), largeur: largeur, longueur: longueur, quantite: quantite}) : null;

let montant = 0;
let facteur = 0;

switch (mode) {

case 'forfait': facteur = 1; montant = prix * facteur;

break;


case 'metre': facteur = longueur * quantite; montant = prix * facteur;

break;


case 'metre_carre': facteur = surfacePieces !== null ? surfacePieces : surface * quantite; montant = prix * facteur;

break;


default: facteur = quantite; montant = prix * facteur;

break;
}


montant += montantFinitions(detail);


// Promotion de la ligne (docs/promotions.md) : remise par unité donnée par le serveur, ajoutée à la remise saisie.
const remisePromotion = window.SiPromotions ? window.SiPromotions.remise(detail) : 0;

// La remise est un montant par unité (ex. 500 FCFA par m²), pas un montant fixe sur toute la ligne.
const remiseTotale = Math.min(montant, (remise + remisePromotion) * Math.max(0, facteur));

const ht = Math.max(0, montant - remiseTotale);

const ttc = ht * (1 + tva / 100);


const elementRemiseTotale = detail.querySelector('.js-remise-totale-detail');

if (elementRemiseTotale) {
elementRemiseTotale.textContent = remiseTotale > 0
? ('Remise totale : ' + formaterMontant(remiseTotale) + ' FCFA')
: 'Remise totale : —';
}


definirValeur(detail, 'surface', surface);

definirValeur(detail, 'totalHt', Math.round(ht));

definirValeur(detail, 'totalTtc', Math.round(ttc));

if (window.SiPromotions) {
window.SiPromotions.calculee(detail, montant, facteur);
}


calculerCommande();
}


function calculerCommande() {

let ht = 0;
let ttc = 0;

collection.querySelectorAll('.detail-commande').forEach(function (detail) {
ht += nombreDepuisChamp(champDetail(detail, 'totalHt'));

ttc += nombreDepuisChamp(champDetail(detail, 'totalTtc'));
});

// Frais de livraison choisis (rien en retrait boutique), sans TVA. Le serveur refait ces totaux.
const modeLivraison = form.querySelector('.js-mode-livraison input:checked');
const fraisLivraison = form.querySelector('.js-frais-livraison input:checked');
if (fraisLivraison && modeLivraison && modeLivraison.value === 'livraison') {
ht += Number(fraisLivraison.value) || 0;
ttc += Number(fraisLivraison.value) || 0;
}


const totalHt = document.getElementById('{{ form.totalHt.vars.id }}');

const totalTtc = document.getElementById('{{ form.totalTtc.vars.id }}');

const remise = document.getElementById('{{ form.remise.vars.id }}');

const payer = document.getElementById('{{ form.montantApayer.vars.id }}');


// Remise globale déduite du sous-total HT, TVA au prorata (TotauxDocument) : le total TTC est ce que le client doit.
const remiseRetenue = Math.min(Math.max(0, nombreDepuisChamp(remise)), Math.max(0, ht));
const tvaNette = ht > 0 ? Math.round(Math.max(0, ttc - ht) * (ht - remiseRetenue) / ht) : 0;
const net = Math.max(0, Math.round(ht - remiseRetenue + tvaNette));

if (totalHt) {
totalHt.value = Math.round(ht);
}

if (totalTtc) {
totalTtc.value = net;
}

if (payer) {

payer.value = net;
}
}


/*
         * ====================================================
         * CIRCUIT
         * ====================================================
         */

function appliquerCircuit(detail) {
const prepresse = detail.querySelector('.js-prepresse-necessaire');

const production = detail.querySelector('.js-production-necessaire');

const message = detail.querySelector('.js-message-circuit-texte');

if (! prepresse || ! production || ! message) {
return;
}


if (! prepresse.checked && ! production.checked) {
message.textContent = 'Livraison directe.';

return;
}


if (! prepresse.checked && production.checked) {
message.textContent = 'Production directe puis livraison.';

return;
}


if (prepresse.checked && production.checked) {
message.textContent = 'Prépresse, production puis livraison.';

return;
}


message.textContent = 'Prépresse puis livraison.';
}


/*
         * ====================================================
         * TYPE DE LIGNE
         * ====================================================
         */

function appliquerTypeLigne(detail, viaChangementUtilisateur) {
const type = valeurTypeLigne(detail);

const produit = type === 'produit';

const article = type === 'article';

const libre = type === 'libre';
const designation = champDetail(detail, 'designation');
if (produit) {

if (designation) {
designation.readOnly = false;
}

// reste de ton code...
}
if (article) {

if (designation) {
designation.readOnly = true;
}
}
if (libre) {

if (designation) {
designation.readOnly = false;

/*
 * On ne vide la designation que lors d'un vrai changement de
 * type par l'utilisateur (pas au chargement initial d'une ligne
 * existante en saisie libre, sinon la designation deja
 * enregistree disparait a chaque ouverture du formulaire de
 * modification).
 */
if (viaChangementUtilisateur) {
designation.value = '';
}
}

definirValeur(detail, 'article', '');
}

afficher(detail, '.js-zone-produit', produit);

afficher(detail, '.js-zone-champs-configuration', produit);

afficher(detail, '.js-zone-article-stock', article);

afficher(detail, '.js-zone-finitions', produit);

afficher(detail, '.js-zone-technique', produit);

afficher(detail, '.js-zone-fichiers', produit);


const articleChamp = champDetail(detail, 'article');

const produitChamp = champDetail(detail, 'produit');

const configuration = champDetail(detail, 'configuration');


if (articleChamp) {
articleChamp.required = article;
}

if (produitChamp) {
produitChamp.required = produit;
}

if (configuration) {
configuration.required = produit && valeurModeConfiguration(detail) === 'automatique';
}

detail.querySelectorAll('[name$="[modeConfiguration]"]').forEach(function (radio) {
radio.required = produit;
});


if (produit) {

if (articleChamp) {
articleChamp.required = false;
}

definirValeur(detail, 'article', '');

const prepresse = detail.querySelector('.js-prepresse-necessaire');

const production = detail.querySelector('.js-production-necessaire');

if (prepresse) {
prepresse.style.pointerEvents = '';

/*
 * Prepresse/production sont cochees par defaut sur une ligne
 * produit, sauf en saisie libre ou choix d'article. On ne force
 * cette valeur que lors d'un vrai changement de type par
 * l'utilisateur (pas au chargement initial d'une ligne existante,
 * pour ne pas ecraser une case decochee manuellement et deja
 * enregistree).
 */
if (viaChangementUtilisateur) {
prepresse.checked = true;
}
}

if (production) {
production.style.pointerEvents = '';

if (viaChangementUtilisateur) {
production.checked = true;
}
}

appliquerModeConfiguration(detail, viaChangementUtilisateur);

appliquerCircuit(detail);

calculerDetail(detail);

return;
}


/*
             * ARTICLE / LIBRE
             */

/*
 * Hors mode "produit", le prix et le mode de calcul ne viennent plus
 * du catalogue : on les redeverrouille (une ligne peut passer de
 * "produit" a "libre" sans recharger la page).
 */
verrouillerChampCatalogue(champDetail(detail, 'prixUnitaire'), false);

verrouillerChampCatalogue(champDetail(detail, 'modeCalcul'), false);

definirValeur(detail, 'produit', '');

definirValeur(detail, 'configuration', '');

definirValeur(detail, 'typeImpression', '');

definirValeur(detail, 'support', '');

definirValeur(detail, 'format', '');


afficher(detail, '.js-zone-largeur', false);

afficher(detail, '.js-zone-longueur', false);

afficher(detail, '.js-zone-surface', false);

afficher(detail, '.js-zone-nombre-faces', false);


