<!DOCTYPE html>

<html lang="fr">

	<head>

		<meta charset="UTF-8">

		<meta name="viewport" content="width=device-width, initial-scale=1.0">

		<title>
			Modifier mon mot de passe
		</title>


		{# ============================================================
				       CSS AROX
				       ============================================================ #}

		<link href="{{ asset('assets/css/dashboard.css') }}" rel="stylesheet">


		<link href="{{ asset('assets/css/color-themes.css') }}" rel="stylesheet">


		<link href="{{ asset('assets/plugins/single-page/css/main.css') }}" rel="stylesheet" type="text/css">


		<link href="{{ asset('assets/css/icons.css') }}" rel="stylesheet">


		<style>

			/*
         * ============================================================
         * PAGE
         * ============================================================
         */

			html,
			body {

				width: 100%;
				min-height: 100%;

				margin: 0;
				padding: 0;

			}


			body {

				min-height: 100vh;

				background: #0b3278;

				overflow-x: hidden;

			}


			/*
         * ============================================================
         * CONTENEUR PRINCIPAL
         * ============================================================
         */

			.password-page {

				min-height: 100vh;

				display: flex;

				align-items: center;

				justify-content: center;

				padding: 40px 15px;

			}


			.password-wrapper {

				width: 100%;

				max-width: 420px;

			}


			/*
         * ============================================================
         * LOGO
         * ============================================================
         */

			.password-logo {

				text-align: center;

				margin-bottom: 25px;

			}


			.password-logo img {

				max-width: 180px;

				max-height: 75px;

				object-fit: contain;

			}


			/*
         * ============================================================
         * CARTE
         * ============================================================
         */

			.password-card {

				background: rgba(5, 28, 78, 0.74);

				border: 1px solid rgba(255, 255, 255, 0.14);

				border-radius: 3px;

				padding: 32px 30px;

				box-shadow: 0 8px 25px rgba(0, 0, 0, 0.12);

			}


			/*
         * ============================================================
         * TITRE
         * ============================================================
         */

			.password-title {

				color: #ffffff;

				text-align: center;

				font-size: 19px;

				font-weight: 400;

				margin-bottom: 8px;

			}


			.password-subtitle {

				color: rgba(255, 255, 255, 0.55);

				text-align: center;

				font-size: 13px;

				margin-bottom: 28px;

			}


			/*
         * ============================================================
         * UTILISATEUR
         * ============================================================
         */

			.user-info {

				text-align: center;

				margin-bottom: 25px;

			}


			.user-avatar {

				width: 66px;
				height: 66px;

				border-radius: 50%;

				object-fit: cover;

				border: 2px solid rgba(255, 255, 255, 0.25);

			}


			.user-avatar-letter {

				width: 66px;
				height: 66px;

				margin: 0 auto;

				border-radius: 50%;

				background: rgba(255, 255, 255, 0.15);

				color: #ffffff;

				display: flex;

				align-items: center;

				justify-content: center;

				font-size: 25px;

				font-weight: 600;

				border: 2px solid rgba(255, 255, 255, 0.22);

			}


			.user-name {

				color: #ffffff;

				margin-top: 10px;

				font-size: 15px;

			}


			.user-username {

				color: rgba(255, 255, 255, 0.5);

				font-size: 12px;

				margin-top: 2px;

			}


			/*
         * ============================================================
         * CHAMP
         * ============================================================
         */

			.password-field {

				position: relative;

				margin-bottom: 18px;

			}


			.password-field input {

				width: 100%;

				height: 48px;

				border: 1px solid rgba(255, 255, 255, 0.25);

				border-radius: 3px;

				background: rgba(255, 255, 255, 0.25);

				color: #ffffff;

				outline: none;

				padding: 0 50px 0 48px;

				font-size: 14px;

				box-sizing: border-box;

			}


			.password-field input::placeholder {

				color: rgba(255, 255, 255, 0.55);

			}


			.password-field input:focus {

				border-color: rgba(255, 255, 255, 0.55);

				background: rgba(255, 255, 255, 0.29);

			}


			/*
         * ============================================================
         * ICÔNE GAUCHE
         * ============================================================
         */

			.password-field .field-icon {

				position: absolute;

				left: 18px;

				top: 50%;

				transform: translateY(-50%);

				color: rgba(255, 255, 255, 0.9);

				font-size: 15px;

			}


			/*
         * ============================================================
         * AFFICHAGE PASSWORD
         * ============================================================
         */

			.password-toggle {

				position: absolute;

				right: 15px;

				top: 50%;

				transform: translateY(-50%);

				border: 0;

				background: transparent;

				padding: 5px;

				color: rgba(255, 255, 255, 0.65);

				cursor: pointer;

				outline: none;

			}


			.password-toggle:hover {

				color: #ffffff;

			}


			/*
         * ============================================================
         * BOUTON
         * ============================================================
         */

			.btn-change-password {

				width: 100%;

				border: 0;

				border-radius: 3px;

				padding: 12px 15px;

				margin-top: 5px;

				background: linear-gradient(90deg, #9238f2, #a738ef);

				color: #ffffff;

				font-size: 13px;

				font-weight: 600;

				cursor: pointer;

				transition: 0.2s ease;

			}


			.btn-change-password:hover {

				opacity: .92;

			}


			/*
         * ============================================================
         * RÈGLES PASSWORD
         * ============================================================
         */

			.password-rules {

				background: rgba(255, 255, 255, 0.05);

				border: 1px solid rgba(255, 255, 255, 0.1);

				padding: 12px 15px;

				margin-bottom: 18px;

				border-radius: 3px;

			}


			.password-rules-title {

				color: rgba(255, 255, 255, 0.8);

				font-size: 12px;

				margin-bottom: 7px;

			}


			.password-rule {

				color: rgba(255, 255, 255, 0.45);

				font-size: 11px;

				margin: 3px 0;

			}


			.password-rule.valid {

				color: #40d49c;

			}


			.password-rule.invalid {

				color: #ff667d;

			}


			/*
         * ============================================================
         * FLASH
         * ============================================================
         */

			.flash-message {

				padding: 10px 12px;

				margin-bottom: 18px;

				border-radius: 3px;

				font-size: 12px;

			}


			.flash-error {

				color: #ffffff;

				background: rgba(220, 53, 69, 0.45);

				border: 1px solid rgba(255, 255, 255, 0.12);

			}


			.flash-success {

				color: #ffffff;

				background: rgba(40, 167, 69, 0.45);

				border: 1px solid rgba(255, 255, 255, 0.12);

			}


			/*
         * ============================================================
         * BAS
         * ============================================================
         */

			.password-footer {

				text-align: center;

				color: rgba(255, 255, 255, 0.45);

				font-size: 12px;

				margin-top: 15px;

			}


			.password-footer a {

				color: rgba(255, 255, 255, 0.7);

			}


			.password-footer a:hover {

				color: #ffffff;

			}


			/*
         * ============================================================
         * RESPONSIVE
         * ============================================================
         */

			@media(max-width: 576px) {

				.password-wrapper {

					max-width: 100%;

				}


				.password-card {

					padding: 27px 20px;

				}


				.password-logo img {

					max-width: 155px;

				}

			}

		</style>

	</head>


	<body>


		<div class="password-page">


			<div
				class="password-wrapper">


				{# ==========================================================
								           LOGO
								           ========================================================== #}

				<div
					class="password-logo">

					{#
										               REMPLACE SEULEMENT LE FICHIER LOGO ICI.
										
										               Exemple :
										               public/assets/images/brand/logo-success-imprim.png
										            #}

					<img src="{{ asset( 'assets/images/brand/logo0.png' ) }}" alt="Success Imprim">

				</div>


				{# ==========================================================
								           CARTE
								           ========================================================== #}

				<form method="post" action="{{ path( 'app_user_change_password' ) }}" class="password-card" autocomplete="off">


					<h1 class="password-title">

						Modifier le mot de passe

					</h1>


					<div class="password-subtitle">

						Définissez votre nouveau mot de passe
												                pour continuer.

					</div>


					{# ======================================================
										               UTILISATEUR
										               ====================================================== #}

					<div class="user-info">


						{% if
                    user.employe
                    and user.employe.photos
                %}

							<img src="{{ asset( 'uploads/employes/' ~ user.employe.photos ) }}" class="user-avatar" alt="{{ user.username }}">

						{% else %}

							<div class="user-avatar-letter">

								{{
                            user.username
                                |slice(0, 1)
                                |upper
                        }}

							</div>

						{% endif %}


						<div class="user-name">

							{% if user.employe %}

								{{ user.employe.prenom }}
								{{ user.employe.nom }}

							{% else %}

								{{ user.username }}

							{% endif %}

						</div>


						<div class="user-username">

							{{ user.username }}

						</div>

					</div>


					{# ======================================================
										               MESSAGES
										               ====================================================== #}

					{% for message in app.flashes('error') %}

						<div class="
																                        flash-message
																                        flash-error
																                    ">

							<i class="fa fa-exclamation-circle"></i>

							{{ message }}

						</div>

					{% endfor %}


					{% for message in app.flashes('success') %}

						<div class="
																                        flash-message
																                        flash-success
																                    ">

							<i class="fa fa-check-circle"></i>

							{{ message }}

						</div>

					{% endfor %}


					{# ======================================================
										               CSRF
										               ====================================================== #}

					<input
					type="hidden" name="_token" value="{{ csrf_token( 'change_password_' ~ user.id ) }}">


					{# ======================================================
										               MOT DE PASSE ACTUEL
										               ====================================================== #}

					<div class="password-field">

						<span class="field-icon">

							<i class="fa fa-lock"></i>

						</span>


						<input type="password" name="current_password" id="currentPassword" placeholder="Mot de passe actuel" autocomplete="current-password" required>


						<button type="button" class="password-toggle" data-target="currentPassword">

							<i class="fa fa-eye"></i>

						</button>

					</div>


					{# ======================================================
										               NOUVEAU MOT DE PASSE
										               ====================================================== #}

					<div class="password-field">

						<span class="field-icon">

							<i class="fa fa-key"></i>

						</span>


						<input type="password" name="new_password" id="newPassword" placeholder="Nouveau mot de passe" autocomplete="new-password" required>


						<button type="button" class="password-toggle" data-target="newPassword">

							<i class="fa fa-eye"></i>

						</button>

					</div>


					{# ======================================================
										               CONFIRMATION
										               ====================================================== #}

					<div class="password-field">

						<span class="field-icon">

							<i class="fa fa-check"></i>

						</span>


						<input type="password" name="confirm_password" id="confirmPassword" placeholder="Confirmer le mot de passe" autocomplete="new-password" required>


						<button type="button" class="password-toggle" data-target="confirmPassword">

							<i class="fa fa-eye"></i>

						</button>

					</div>


					{# ======================================================
										               RÈGLES
										               ====================================================== #}

					<div class="password-rules">

						<div class="password-rules-title">

							Le mot de passe doit contenir :

						</div>


						<div class="password-rule" id="ruleLength">
							• Au moins 8 caractères
						</div>


						<div class="password-rule" id="ruleUpper">
							• Une lettre majuscule
						</div>


						<div class="password-rule" id="ruleLower">
							• Une lettre minuscule
						</div>


						<div class="password-rule" id="ruleNumber">
							• Un chiffre
						</div>


						<div class="password-rule" id="ruleSpecial">
							• Un caractère spécial
						</div>


						<div class="password-rule" id="ruleConfirm">
							• Confirmation identique
						</div>

					</div>


					{# ======================================================
										               SUBMIT
										               ====================================================== #}

					<button type="submit" class="btn-change-password">

						Modifier mon mot de passe

					</button>


					{# ======================================================
										               LOGOUT
										               ====================================================== #}

					<div class="password-footer">

						Vous souhaitez quitter ?

						<a href="{{ path('app_logout') }}">

							Se déconnecter

						</a>

					</div>

				</form>

			</div>

		</div>


		{# ================================================================
				   JS
				   ================================================================ #}

		<script src="{{ asset( 'assets/js/vendors/jquery-3.2.1.min.js' ) }}"></script>


		<script>

			document.addEventListener('DOMContentLoaded', function () { /*
             * ========================================================
             * AFFICHER / MASQUER
             * ========================================================
             */

document.querySelectorAll('.password-toggle').forEach(function (button) {

button.addEventListener('click', function () {

const input = document.getElementById(this.dataset.target);


if (! input) {
return;
}


const icon = this.querySelector('i');


if (input.type === 'password') {

input.type = 'text';


icon.classList.remove('fa-eye');


icon.classList.add('fa-eye-slash');

} else {

input.type = 'password';


icon.classList.remove('fa-eye-slash');


icon.classList.add('fa-eye');

}

});

});


/*
             * ========================================================
             * RÈGLES PASSWORD
             * ========================================================
             */

const newPassword = document.getElementById('newPassword');


const confirmPassword = document.getElementById('confirmPassword');


const updateRule = function (id, valid, touched) {

const element = document.getElementById(id);


if (! element) {
return;
}


element.classList.remove('valid', 'invalid');


if (! touched) {
return;
}


element.classList.add(valid ? 'valid' : 'invalid');

};


const validatePassword = function () {

const password = newPassword.value;


const confirmation = confirmPassword.value;


const touched = password.length > 0;


updateRule('ruleLength', password.length >= 8, touched);


updateRule('ruleUpper', /[A-Z]/.test(password), touched);


updateRule('ruleLower', /[a-z]/.test(password), touched);


updateRule('ruleNumber', /[0-9]/.test(password), touched);


updateRule('ruleSpecial', /[^A-Za-z0-9]/.test(password), touched);


updateRule('ruleConfirm', password !== '' && confirmation !== '' && password === confirmation, confirmation.length > 0);

};


newPassword.addEventListener('input', validatePassword);


confirmPassword.addEventListener('input', validatePassword);

});
		</script>


	</body>

</html>
