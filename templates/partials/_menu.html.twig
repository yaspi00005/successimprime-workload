{#
	Menu de l'admin en 6 entrees simples, comme sur les maquettes 20 a 41 :
	Accueil, Ventes, Atelier, Finances, Clients, Reglages. Chaque entree
	ouvre le premier ecran autorise de sa section ; les autres ecrans de la
	section sont des onglets en haut de page (partials/_onglets_section).
#}
{% set sectionActive = section_admin(routeCourante) %}
{% set icones = { accueil: 'fas fa-home', ventes: 'fas fa-handshake', atelier: 'fas fa-industry', finances: 'fas fa-wallet', clients: 'fas fa-users', reglages: 'fas fa-cog' } %}
<div class="dlabnav si-sidebar">
	<div class="dlabnav-scroll">

		{# ---------- « + Nouveau » toujours visible ---------- #}
		<div class="si-nouveau dropdown">
			<button type="button" class="btn si-btn-nouveau w-100 dropdown-toggle" data-bs-toggle="dropdown" data-bs-display="static" aria-expanded="false">
				<i class="fas fa-plus"></i><span class="nav-text ms-2">Nouveau</span>
			</button>
			<ul class="dropdown-menu w-100">
				{% if peutVoirDevis %}<li><a class="dropdown-item" href="{{ path('app_devis_new') }}"><i class="fas fa-file-signature me-2"></i>Devis</a></li>{% endif %}
				{% if peutVoirCommandes %}<li><a class="dropdown-item" href="{{ path('app_commandes_new') }}"><i class="fas fa-shopping-cart me-2"></i>Commande</a></li>{% endif %}
				{% if peutSaisirTresorerie %}<li><a class="dropdown-item" href="{{ path('app_mouvement_tresorerie_new') }}"><i class="fas fa-receipt me-2"></i>Dépense</a></li>{% endif %}
				{% if peutVoirClients %}<li><a class="dropdown-item" href="{{ path('app_clients_index', {nouveau: 1}) }}"><i class="fas fa-user-plus me-2"></i>Client</a></li>{% endif %}
			</ul>
		</div>

		<ul class="metismenu" id="menu">
			{% for section, libelle in { accueil: 'Accueil', ventes: 'Ventes', atelier: 'Atelier', finances: 'Finances', clients: 'Clients', reglages: 'Réglages' } %}
				{% set entree = null %}
				{% for onglet in onglets_section_admin(section) %}
					{% if entree is null and (onglet.role is null or is_granted(onglet.role)) %}{% set entree = onglet %}{% endif %}
				{% endfor %}
				{% if entree %}
					<li class="{{ sectionActive == section ? 'mm-active' }}">
						<a href="{{ path(entree.route, entree.parametres|default({})) }}" class="{{ sectionActive == section ? 'mm-active' }}" aria-expanded="false">
							<i class="{{ icones[section] }}"></i><span class="nav-text">{{ libelle }}</span>
						</a>
					</li>
				{% endif %}
			{% endfor %}
		</ul>
	</div>
</div>
