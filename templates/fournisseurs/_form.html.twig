{# Fiche fournisseur à remplir (maquette SU02) : identité, contact, conditions. #}
{{ form_start(form) }}
	<section class="ac-carte">
		<h2>Identité</h2>
		<div class="row g-3">
			<div class="col-md-6">{{ form_row(form.nom) }}</div>
			<div class="col-md-6">{{ form_row(form.fournit) }}</div>
			<div class="col-md-3 col-6">{{ form_row(form.ville) }}</div>
			<div class="col-md-3 col-6">{{ form_row(form.pays) }}</div>
			<div class="col-md-6">{{ form_row(form.couleur) }}</div>
		</div>
	</section>

	<section class="ac-carte">
		<h2>Contact</h2>
		<div class="row g-3">
			<div class="col-md-6">{{ form_row(form.contactNom) }}</div>
			<div class="col-md-6">{{ form_row(form.contactTelephone) }}</div>
			<div class="col-md-6">{{ form_row(form.telephone, {label: 'Téléphone fixe (8 chiffres)'}) }}</div>
			<div class="col-md-6">{{ form_row(form.email) }}</div>
			<div class="col-12">{{ form_row(form.adresse) }}</div>
		</div>
	</section>

	<section class="ac-carte">
		<h2>Conditions</h2>
		<div class="row g-3">
			<div class="col-md-8">{{ form_row(form.conditionsPaiement) }}</div>
			<div class="col-md-4">{{ form_row(form.acomptePourcentage) }}</div>
			<div class="col-md-8">{{ form_row(form.transport) }}</div>
			<div class="col-md-4">{{ form_row(form.delaiPromisJours) }}</div>
			<div class="col-12">
				<div class="form-check form-switch">
					{{ form_widget(form.actif, {attr: {class: 'form-check-input'}}) }}
					<label class="form-check-label" for="{{ form.actif.vars.id }}">Fournisseur actif</label>
				</div>
			</div>
		</div>
		{{ form_errors(form) }}
	</section>

	<div class="ac-actions-pied">
		<a href="{{ fournisseur is defined and fournisseur.id ? path('app_fournisseur_show', {id: fournisseur.id}) : path('app_fournisseur_index') }}" class="btn btn-light">Retour</a>
		<button type="submit" class="btn btn-danger">Enregistrer</button>
	</div>
{{ form_end(form) }}
