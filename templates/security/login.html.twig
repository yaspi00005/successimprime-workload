{% extends 'security/_page_connexion.html.twig' %}

{% block carte %}
	{% if en_ligne|default(false) %}
		<h1>Administration en ligne</h1>
		<p class="si-connexion-sous-titre">{{ app.request.host }}</p>
		{% include 'security/_appareil.html.twig' %}
	{% else %}
		<h1>Bonjour 👋</h1>
		<p class="si-connexion-sous-titre">Connectez-vous pour ouvrir votre session de travail.</p>
	{% endif %}

	{% if error %}
		<div class="si-connexion-erreur" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
	{% endif %}

	<form method="post" action="{{ path('app_login') }}">
		<label for="inputUsername">Identifiant</label>
		<input type="text" id="inputUsername" name="username" value="{{ last_username }}" autocomplete="username" autocapitalize="none" spellcheck="false" required autofocus>

		<label for="inputPassword">Mot de passe</label>
		<div class="si-connexion-mdp">
			<input type="password" id="inputPassword" name="password" autocomplete="current-password" required>
			<button type="button" class="js-afficher" data-cible="inputPassword" aria-pressed="false">Afficher</button>
		</div>

		<a href="{{ path('app_acces_pin') }}" class="si-connexion-pin">Se connecter avec mon code PIN</a>

		<details class="si-connexion-oubli">
			<summary>Mot de passe oublié ?</summary>
			<p>Demandez à un administrateur : Réglages › Utilisateurs, fiche de la personne, « Réinitialiser le mot de passe ».</p>
		</details>

		<input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
		<button type="submit" class="si-connexion-bouton">{{ en_ligne|default(false) ? 'Continuer' : 'Se connecter' }}</button>
	</form>
{% endblock %}
