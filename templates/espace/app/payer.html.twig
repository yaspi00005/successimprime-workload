{% extends 'espace/app/_app.html.twig' %}

{% block title %}Paiement{% endblock %}
{% block entete %}<a class="ec-retour" href="{{ path('app_espace_factures') }}"><span class="fl">‹</span>Paiement</a>{% endblock %}

{% block contenu %}
	<div class="ec-carte" style="text-align:center">
		<span class="ec-petit">{{ commande.estSoldeOuverture ? 'Réf. ' ~ commande.numero : 'Commande ' ~ commande.numero }} · {{ titre }}</span>
		{% if aPayer > 0 or enValidation <= 0 %}
			<div class="ec-gros">{{ aPayer|number_format(0, ',', ' ') }} FCFA</div>
			<span class="ec-petit">Succès Imprim · MDG SARL</span>
		{% else %}
			<div class="ec-gros" style="color:var(--vert)">{{ enValidation|number_format(0, ',', ' ') }} FCFA</div>
			<span class="ec-petit">Payés par Orange Money · en validation à la caisse</span>
		{% endif %}
	</div>

	{% if enValidation > 0 %}
		<div class="ec-note">{{ aPayer > 0 ? enValidation|number_format(0, ',', ' ') ~ ' FCFA déjà payés par Orange Money attendent' : 'Votre paiement Orange Money est bien reçu. Il attend' }} la validation de la caisse, puis votre reçu arrive dans l'espace.</div>
	{% endif %}

	{% if aPayer <= 0 %}
		{% if enValidation <= 0 %}<div class="ec-flash ec-flash-ok">Cette commande est réglée, merci.</div>{% endif %}
	{% else %}
		<div class="ec-moyen choisi">
			<span class="om">OM</span>
			<div><b>Orange Money Mali</b><div class="ec-petit">+223 {{ compte.telephone|slice(3)|split('', 2)|join(' ') }}</div></div>
		</div>
		{% if omActif %}
			<div class="ec-note">Vous passez sur la page sécurisée d'Orange Money pour confirmer avec votre code secret, puis vous revenez ici. Le lien de paiement vaut 10 minutes.</div>
			<form method="post" action="{{ path('app_espace_payer_orange_money', {id: commande.publicId}) }}">
				<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
				<button class="ec-bouton orange" type="submit">Payer {{ aPayer|number_format(0, ',', ' ') }} FCFA</button>
			</form>
			{% if marchand %}<div class="ec-note">Vous pouvez aussi payer au numéro marchand <b>{{ marchand }}</b> en indiquant la commande <b>{{ commande.numero }}</b>.</div>{% endif %}
		{% else %}
			<div class="ec-note">
				Le paiement Orange Money depuis l'espace arrive très bientôt.
				{% if marchand %}En attendant, payez au numéro marchand <b>{{ marchand }}</b> en indiquant la commande <b>{{ commande.numero }}</b> : le paiement est validé par la caisse et votre reçu arrive sur WhatsApp.{% else %}En attendant, payez en boutique ou demandez le numéro marchand sur WhatsApp.{% endif %}
			</div>
			<button class="ec-bouton orange" disabled>Payer {{ aPayer|number_format(0, ',', ' ') }} FCFA</button>
		{% endif %}
		{% if whatsapp %}<div class="ec-boutons"><a class="ec-bouton clair" href="{{ whatsapp }}" target="_blank" rel="noopener">Écrire à la caisse sur WhatsApp</a></div>{% endif %}
	{% endif %}
{% endblock %}
