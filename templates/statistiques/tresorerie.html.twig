{% extends 'base.html.twig' %}

{% block title %}
	Statistiques de trésorerie
{% endblock %}

{% block body %}

<div class="side-app">

	<div class="page-header">

		<div>

			<ol class="breadcrumb">

				<li class="breadcrumb-item">
					<a href="{{ path('app_statistiques_globales_index') }}">Statistiques</a>
				</li>

				<li class="breadcrumb-item active">
					Trésorerie
				</li>

			</ol>

		</div>

	</div>


	{# ==========================================================
	   ÉVOLUTION ENCAISSEMENTS / DÉCAISSEMENTS
	   ========================================================== #}

	<div class="card">

		<div class="card-header d-flex align-items-center justify-content-between flex-wrap">

			<h3 class="card-title mb-0">
				Évolution encaissements / décaissements
			</h3>

			<div class="btn-group">
				{% for cle, libelle in { jour: 'Jour', semaine: 'Semaine', mois: 'Mois', annee: 'Année' } %}
					<a href="{{ path('app_statistiques_tresorerie_index', {granularite: cle, date_debut: filtres.date_debut, date_fin: filtres.date_fin}) }}" class="btn btn-sm {{ granulariteEvolution == cle ? 'btn-primary' : 'btn-primary-light' }}">
						{{ libelle }}
					</a>
				{% endfor %}
			</div>

		</div>

		<div class="card-body">
			<canvas id="graphiqueEvolutionTresorerie" height="240"></canvas>
		</div>

	</div>


	{# ==========================================================
	   INTERVALLE PERSONNALISÉ
	   ========================================================== #}

	<div class="card">

		<div class="card-body">

			<form method="get" class="row align-items-end">

				<input type="hidden" name="granularite" value="{{ granulariteEvolution }}">

				<div class="col-md-4 mb-2">
					<label class="form-label">Du</label>
					<input type="date" name="date_debut" value="{{ filtres.date_debut }}" class="form-control">
				</div>

				<div class="col-md-4 mb-2">
					<label class="form-label">Au</label>
					<input type="date" name="date_fin" value="{{ filtres.date_fin }}" class="form-control">
				</div>

				<div class="col-md-4 mb-2">
					<button type="submit" class="btn btn-primary btn-block">
						<i class="fa fa-filter mr-1"></i>
						Appliquer l'intervalle
					</button>
				</div>

			</form>

		</div>

	</div>


	{# ==========================================================
	   TOTAUX SUR L'INTERVALLE
	   ========================================================== #}

	<div class="row">

		<div class="col-lg-4 mb-3">
			<div class="card mb-0 h-100">
				<div class="card-body text-center">
					<small class="text-muted d-block">Total encaissé</small>
					<div class="h2 text-success mb-0">{{ totalEncaisse|number_format(0, ',', ' ') }}</div>
					<small class="text-muted">FCFA</small>
				</div>
			</div>
		</div>

		<div class="col-lg-4 mb-3">
			<div class="card mb-0 h-100">
				<div class="card-body text-center">
					<small class="text-muted d-block">Total décaissé (charges)</small>
					<div class="h2 text-danger mb-0">{{ totalDecaisse|number_format(0, ',', ' ') }}</div>
					<small class="text-muted">FCFA</small>
				</div>
			</div>
		</div>

		<div class="col-lg-4 mb-3">
			<div class="card mb-0 h-100">
				<div class="card-body text-center">
					<small class="text-muted d-block">Solde net</small>
					<div class="h2 mb-0 {{ (totalEncaisse - totalDecaisse) >= 0 ? 'text-success' : 'text-danger' }}">
						{{ (totalEncaisse - totalDecaisse)|number_format(0, ',', ' ') }}
					</div>
					<small class="text-muted">FCFA</small>
				</div>
			</div>
		</div>

	</div>


	{# ==========================================================
	   CHARGES PAR CATÉGORIE
	   ========================================================== #}

	<div class="row">

		<div class="col-lg-6 mb-3">

			<div class="card mb-0 h-100">

				<div class="card-header">
					<h3 class="card-title">
						Charges par catégorie (intervalle sélectionné)
					</h3>
				</div>

				<div class="card-body">
					<canvas id="graphiqueChargesCategorie" height="260"></canvas>
				</div>

			</div>

		</div>

		<div class="col-lg-6 mb-3">

			<div class="card mb-0 h-100">

				<div class="card-header">
					<h3 class="card-title">
						Détail des charges
					</h3>
				</div>

				<div class="table-responsive">
					<table class="table table-bordered table-hover mb-0">
						<thead>
							<tr>
								<th>Catégorie</th>
								<th class="text-right">Mouvements</th>
								<th class="text-right">Montant (FCFA)</th>
							</tr>
						</thead>
						<tbody>
							{% for ligne in chargesParCategorie %}
								<tr>
									<td>{{ ligne.categorie }}</td>
									<td class="text-right">{{ ligne.nombre }}</td>
									<td class="text-right">{{ ligne.montant|number_format(0, ',', ' ') }}</td>
								</tr>
							{% else %}
								<tr>
									<td colspan="3" class="text-center text-muted py-4">
										Aucune charge sur cet intervalle.
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				</div>

			</div>

		</div>

	</div>

</div>


<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<script>
	(function () {
		var evolution = {{ evolution|json_encode|raw }};
		var charges = {{ chargesParCategorie|json_encode|raw }};

		var canevasEvolution = document.getElementById('graphiqueEvolutionTresorerie');

		if (canevasEvolution && typeof Chart !== 'undefined') {
			new Chart(canevasEvolution, {
				type: 'bar',
				data: {
					labels: evolution.labels,
					datasets: [
						{ label: 'Encaissements', data: evolution.encaissements, backgroundColor: '#5eba00' },
						{ label: 'Décaissements', data: evolution.decaissements, backgroundColor: '#cd201f' }
					]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false,
					scales: { y: { beginAtZero: true } }
				}
			});
		}

		var canevasCharges = document.getElementById('graphiqueChargesCategorie');

		if (canevasCharges && typeof Chart !== 'undefined') {
			var palette = ['#467fcf', '#5eba00', '#f1c40f', '#cd201f', '#6f42c1', '#17a2b8', '#fd7e14', '#20c997', '#e83e8c', '#6c757d'];

			new Chart(canevasCharges, {
				type: 'doughnut',
				data: {
					labels: charges.map(function (ligne) { return ligne.categorie; }),
					datasets: [{
						data: charges.map(function (ligne) { return ligne.montant; }),
						backgroundColor: charges.map(function (_, index) { return palette[index % palette.length]; })
					}]
				},
				options: {
					responsive: true,
					maintainAspectRatio: false
				}
			});
		}
	})();
</script>

{% endblock %}
