			</div>
		</div>
		<div class="si-saisie-boutons">
			{% if estNouvelle %}
				<a href="{{ path('app_commandes_index') }}" class="btn btn-light btn-sm si-btn-entete">Annuler</a>
			{% else %}
				<a href="{{ path('app_commandes_show', {id: commande.id}) }}" class="btn btn-light btn-sm si-btn-entete">Annuler</a>
			{% endif %}
			{% if not dejaConfirmee %}
				<button type="submit" name="action_saisie" value="brouillon" class="btn btn-light btn-sm si-btn-entete js-action-saisie">Enregistrer en brouillon</button>
				<button type="submit" name="action_saisie" value="confirmer" class="btn btn-danger btn-sm si-btn-entete js-action-saisie">Confirmer la commande</button>
			{% else %}
				<button type="submit" name="action_saisie" value="confirmer" class="btn btn-danger btn-sm si-btn-entete js-action-saisie">Enregistrer les modifications</button>
			{% endif %}
		</div>
	</div>

	{% if not form.vars.valid %}
		{# Toutes les erreurs, celles des lignes comprises : le volet de la ligne concernée peut être fermé. #}
		<div class="alert alert-danger">
			<ul class="mb-0 ps-3">
				{% for erreur in form.vars.errors.form.getErrors(true) %}
					<li>{{ erreur.message }}</li>
				{% endfor %}
			</ul>
		</div>
	{% endif %}

	{% if commandeVerrouillee %}
		<div class="alert alert-warning"><i class="fas fa-lock me-2"></i><strong>Commande engagée dans son circuit.</strong> Les lignes ne peuvent plus être modifiées.</div>
	{% endif %}

	<div class="si-saisie-grille">
		<div class="si-saisie-gauche">

			{# ---------- Client ---------- #}
			<div class="card si-bloc si-saisie-client js-zone-client">
