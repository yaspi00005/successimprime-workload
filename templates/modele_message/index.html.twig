{% extends 'base.html.twig' %}

{% block title %}
	Modèles de message
{% endblock %}

{% block body %}

	{% include "alert.html.twig" %}

	<div class="side-app">

		<div class="page-header">

			<div>

				<h1 class="page-title">
					Modèles de message
				</h1>

				<ol class="breadcrumb">
					<li class="breadcrumb-item">
						Communications
					</li>
					<li class="breadcrumb-item active">
						Modèles de message
					</li>
				</ol>

			</div>

			<div class="ml-auto">

				<a href="{{ path('app_modele_message_new') }}" class="btn btn-primary-light">
					<i class="fa fa-plus mr-1"></i>
					Nouveau modèle
				</a>

			</div>

		</div>

		<div class="row row-cards">

			<div class="col-lg-12">

				<div class="card">

					<div class="card-header">
						<div>
							<h3 class="card-title mb-1">
								Modèles
							</h3>
							<small class="text-muted">
								{{ modeles|length }} modèle(s)
							</small>
						</div>
					</div>

					<div class="table-responsive">

						<table class="table table-bordered table-hover mb-0">

							<thead>
								<tr>
									<th>Nom</th>
									<th>Canal</th>
									<th>Aperçu du contenu</th>
									<th class="text-center">Statut</th>
									<th class="text-center">Actions</th>
								</tr>
							</thead>

							<tbody>

								{% for modele in modeles %}

									<tr>

										<td class="align-middle">
											<strong>{{ modele.nom }}</strong>
										</td>

										<td class="align-middle">
											<span class="badge badge-secondary">{{ modele.canalLabel }}</span>
										</td>

										<td class="align-middle">
											<span class="text-muted">{{ modele.contenu|length > 80 ? modele.contenu|slice(0, 80) ~ '…' : modele.contenu }}</span>
										</td>

										<td class="align-middle text-center">
											{% if modele.actif %}
												<span class="badge badge-success">Actif</span>
											{% else %}
												<span class="badge badge-light">Inactif</span>
											{% endif %}
										</td>

										<td class="align-middle text-center nowrap">
											<div class="btn-group">

												<a href="{{ path('app_modele_message_edit', {id: modele.id}) }}" class="btn btn-sm btn-warning-light" title="Modifier">
													<i class="fa fa-pencil"></i>
												</a>

												<form method="post" action="{{ path('app_modele_message_delete', {id: modele.id}) }}" class="d-inline js-confirm-form" data-message="Supprimer définitivement ce modèle de message ?">
													<input type="hidden" name="_token" value="{{ csrf_token('delete' ~ modele.id) }}">
													<button type="submit" class="btn btn-sm btn-danger-light" title="Supprimer">
														<i class="fa fa-trash"></i>
													</button>
												</form>

											</div>
										</td>

									</tr>

								{% else %}

									<tr>
										<td colspan="5" class="text-center text-muted py-5">
											Aucun modèle de message enregistré.
										</td>
									</tr>

								{% endfor %}

							</tbody>

						</table>

					</div>

				</div>

			</div>

		</div>

	</div>

{% endblock %}
