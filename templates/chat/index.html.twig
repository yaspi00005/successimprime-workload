{% extends 'base.html.twig' %}

{% block title %}
	Messagerie
{% endblock %}

{% block body %}
	<div class="side-app">
		{% include "alert.html.twig" %}

		<div class="page-header">

			<ol class="breadcrumb">
				<li class="breadcrumb-item active">
					Messagerie
				</li>
			</ol>

			<div>
				<a href="{{ path('app_chat_nouvelle') }}" class="btn btn-primary">
					<i class="fa fa-plus mr-1"></i>
					Nouvelle conversation
				</a>
			</div>

		</div>

		<div class="card">

			<div class="card-header">
				<h3 class="card-title">Mes conversations</h3>
			</div>

			<div class="list-group list-group-flush">

				{% for conversation in conversations %}

					{% set participant = conversation.getParticipantPour(utilisateur) %}
					{% set nonLu = participant and participant.aDesMessagesNonLus %}
					{% set dernierMessage = conversation.dernierMessage %}

					<a href="{{ path('app_chat_show', {id: conversation.id}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-start {{ nonLu ? 'font-weight-bold' : '' }}">

						<div>
							<div>{{ conversation.getLibellePour(utilisateur) }}</div>

							{% if dernierMessage %}
								<div class="small text-muted">
									{% if dernierMessage.contenu is empty and dernierMessage.aUnePieceJointe %}
										<i class="fa fa-paperclip mr-1"></i>
										{{ dernierMessage.pieceJointeEstUneImage ? 'Image' : 'Fichier' }}
									{% else %}
										{{ dernierMessage.contenu|length > 90 ? (dernierMessage.contenu|slice(0, 90) ~ '…') : dernierMessage.contenu }}
									{% endif %}
								</div>
							{% endif %}
						</div>

						<div class="text-right text-nowrap ml-2">
							{% if dernierMessage %}
								<div class="small text-muted">{{ dernierMessage.dateEnvoi|date('d/m/Y H:i') }}</div>
							{% endif %}

							{% if nonLu %}
								<span class="badge badge-danger">Nouveau</span>
							{% endif %}
						</div>

					</a>

				{% else %}

					<div class="text-center text-muted p-4">
						Aucune conversation pour le moment.
						<a href="{{ path('app_chat_nouvelle') }}">Démarrer une conversation</a>.
					</div>

				{% endfor %}

			</div>

		</div>
	</div>
{% endblock %}
