{% extends 'base.html.twig' %}

{% block title %}Gestion des devis
{% endblock %}

{% block stylesheets %}
	{{ parent() }}
	<style>
		.devis-filter-card {
			position: sticky;
			top: 85px;
		}
		.devis-stat {
			border: 0;
			border-left: 4px solid #1643a3;
		}
		.devis-reference {
			font-weight: 700;
			color: #1643a3;
		}
		.devis-client {
			max-width: 230px;
			white-space: normal;
		}
		.devis-actions .btn {
			margin: 2px;
		}
		.filter-indicator {
			display: inline-flex;
			align-items: center;
			gap: 6px;
			padding: 5px 10px;
			border-radius: 20px;
			background: #eef3ff;
			color: #1643a3;
			font-size: 12px;
			font-weight: 600;
		}
		.empty-state {
			padding: 55px 20px;
			text-align: center;
		}
		.empty-state i {
			font-size: 48px;
			color: #cbd3df;
		}
		@media(max-width: 1199px) {
			.devis-filter-card {
				position: static;
			}
		}
	</style>
{% endblock %}

{% block body %}
	{% set rechercheActive =
        app.request.query.get('q')
        or app.request.query.get('client')
        or app.request.query.get('statut')
		or app.request.query.get('paiement')
        or app.request.query.get('date_debut')
        or app.request.query.get('date_fin')
        or app.request.query.get('montant_min')
        or app.request.query.get('montant_max')
        or app.request.query.get('affichage') == 'toutes'
    %}

	<div class="side-app">
		<div class="page-header">
			<ol class="breadcrumb">
				<li class="breadcrumb-item">
					<a href="{{ path('app_devis_index') }}">Devis</a>
				</li>
				<li class="breadcrumb-item active" aria-current="page">Liste</li>
			</ol>

			<a href="{{ path('app_devis_new') }}" class="btn btn-primary">
				<i class="fa fa-plus mr-1"></i>
				Nouveau devis
			</a>
		</div>

		<div class="row">
			<div class="col-sm-6 col-xl-3">
				<div class="card devis-stat">
					<div class="card-body">
						<div class="text-muted">Résultats affichés</div>
						<div class="h2 mb-0">{{ devis|length }}</div>
					</div>
				</div>
			</div>
			<div class="col-sm-6 col-xl-3">
				<div class="card devis-stat border-warning">
					<div class="card-body">
						<div class="text-muted">Total TTC des devis</div>
						<div class="h2 mb-0">
							{{ totalTtcDevis|default(0)|number_format(0, ',', ' ') }}
							F CFA
						</div>
					</div>
				</div>
			</div>
			<div class="col-sm-6 col-xl-3">
				<div class="card devis-stat border-success">
					<div class="card-body">
						<div class="text-muted">Montant à payer</div>
						<div class="h2 mb-0">
							{{ totalMontantAPayer|default(0)|number_format(0, ',', ' ') }}
							F CFA
						</div>
					</div>
				</div>
			</div>
			<div class="col-sm-6 col-xl-3">
				<div class="card devis-stat border-info">
					<div class="card-body">
						<div class="text-muted">Mode d’affichage</div>
						<div class="mt-2">
							{% if rechercheActive %}
								<span class="filter-indicator">
									<i class="fa fa-filter"></i>
									Recherche personnalisée
								</span>
							{% else %}
								<span class="filter-indicator">
									<i class="fa fa-bolt"></i>
									Devis actifs
								</span>
							{% endif %}
						</div>
					</div>
				</div>
			</div>
		</div>

		<div class="row row-cards">
			<div class="col-xl-3">
				<div class="card devis-filter-card">
					<div class="card-header">
						<div class="card-title">
							<i class="fa fa-filter mr-2"></i>Recherche avancée
						</div>
					</div>

					<form method="get" action="{{ path('app_devis_index') }}">
						<div class="card-body">
							<div class="form-group">
								<label class="form-label">Recherche générale</label>
								<input type="search" name="q" class="form-control" value="{{ app.request.query.get('q') }}" placeholder="N° devis, client, téléphone…">
							</div>

							<div class="form-group">
								<label class="form-label">Client</label>
								<select name="client" class="form-control custom-select">
									<option value="">Tous les clients</option>
									{% for client in clients|default([]) %}
										<option value="{{ client.id }}" {{ app.request.query.get('client') == client.id ? 'selected' : '' }}>
											{{ client }}
										</option>
									{% endfor %}
								</select>
							</div>

							<div class="form-group">
								<label class="form-label">Statut du devis</label>
								<select name="statut" class="form-control custom-select">
									<option value="">Tous les statuts</option>
									{% set statutsDevis = {
										'brouillon': 'Brouillon',
										'envoye': 'Envoyé',
										'accepte': 'Accepté',
										'refuse': 'Refusé',
										'expire': 'Expiré',
										'converti': 'Converti en commande',
										'annule': 'Annulé'
									} %}
									{% for valeur, libelle in statutsDevis %}
										<option value="{{ valeur }}" {{ app.request.query.get('statut') == valeur ? 'selected' : '' }}>
											{{ libelle }}
										</option>
									{% endfor %}
								</select>
							</div>

							<div class="form-group">
								<label class="form-label">Situation financière</label>
								<select name="paiement" class="form-control custom-select">
									<option value="">Toutes</option>
									<option value="impayee" {{ app.request.query.get('paiement') == 'impayee' ? 'selected' : '' }}>
										Non payée
									</option>
									<option value="partielle" {{ app.request.query.get('paiement') == 'partielle' ? 'selected' : '' }}>
										Paiement partiel
									</option>
									<option value="payee" {{ app.request.query.get('paiement') == 'payee' ? 'selected' : '' }}>
										Entièrement payée
									</option>
								</select>
							</div>

							<div class="row">
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Du</label>
										<input type="date" name="date_debut" class="form-control" value="{{ app.request.query.get('date_debut') }}">
									</div>
								</div>
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Au</label>
										<input type="date" name="date_fin" class="form-control" value="{{ app.request.query.get('date_fin') }}">
									</div>
								</div>
							</div>

							<div class="row">
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Montant min.</label>
										<input type="number" min="0" name="montant_min" class="form-control" value="{{ app.request.query.get('montant_min') }}" placeholder="0">
									</div>
								</div>
								<div class="col-6">
									<div class="form-group">
										<label class="form-label">Montant max.</label>
										<input type="number" min="0" name="montant_max" class="form-control" value="{{ app.request.query.get('montant_max') }}" placeholder="Illimité">
									</div>
								</div>
							</div>

							<div class="form-group">
								<label class="form-label">Afficher</label>
								<select name="affichage" class="form-control custom-select">
									<option value="actives" {{ app.request.query.get('affichage', 'actives') == 'actives' ? 'selected' : '' }}>
										Devis actifs
									</option>
									<option value="toutes" {{ app.request.query.get('affichage') == 'toutes' ? 'selected' : '' }}>
										Tous les devis
									</option>
								</select>
							</div>

							<div class="form-group">
								<label class="form-label">Trier par</label>
								<select name="tri" class="form-control custom-select">
									<option value="recent" {{ app.request.query.get('tri') == 'recent' ? 'selected' : '' }}>Plus récentes</option>
									<option value="ancien" {{ app.request.query.get('tri') == 'ancien' ? 'selected' : '' }}>Plus anciennes</option>
									<option value="montant_desc" {{ app.request.query.get('tri') == 'montant_desc' ? 'selected' : '' }}>Montant décroissant</option>
									<option value="reste_desc" {{ app.request.query.get('tri') == 'reste_desc' ? 'selected' : '' }}>Reste à payer décroissant</option>
								</select>
							</div>

							<button type="submit" class="btn btn-primary btn-block">
								<i class="fa fa-search mr-1"></i>
								Rechercher
							</button>

							<a href="{{ path('app_devis_index') }}" class="btn btn-light btn-block">
								<i class="fa fa-refresh mr-1"></i>
								Réinitialiser
							</a>
						</div>
					</form>
				</div>
			</div>

			<div class="col-xl-9">
				<div class="card">
					<div class="card-header d-flex justify-content-between align-items-center">
						<div>
							<div class="card-title mb-1">Liste des devis</div>
							<small class="text-muted">
								{% if rechercheActive %}
									Résultats correspondant à vos critères.
								{% else %}
									Affichage automatique : paiements en attente et travaux en cours.
								{% endif %}
							</small>
						</div>
					</div>

					<div class="table-responsive">
						<table class="table card-table table-vcenter text-nowrap">
							<thead>
								<tr>
									<th scope="col">Devis</th>
									<th scope="col">Client</th>
									<th scope="col">Date / statut</th>
									<th scope="col">Paiement</th>
									<th scope="col" class="text-right">Total TTC</th>
									<th scope="col" class="text-right">Remise</th>
									<th scope="col" class="text-right">Montant à payer</th>
									<th scope="col" class="text-center">Actions</th>
								</tr>
							</thead>
							<tbody>
								{% for devis in devis %}
									{% set total = devis.totalTtc|default(0) %}
									{% set statutPaiement = devis.statutPaiement|default('impayee') %}

									<tr>
										{# 1. Devis #}
										<td>
											<a href="{{ path('app_devis_show', { id: devis.id }) }}" class="devis-reference">
												{{ devis.numero|default('DEV-' ~ ('%05d'|format(devis.id))) }}
											</a>

											<div class="small text-muted">
												#{{ devis.id }}
											</div>
										</td>

										{# 2. Client #}
										<td class="devis-client">
											<strong>
												{{ devis.clients }}
											</strong>
										</td>

										{# 3. Date et statut métier du devis #}
										<td>
											<div>{{ devis.dateDevis ? devis.dateDevis|date('d/m/Y H:i') : '—' }}</div>
											{% set libelleStatut = statutsDevis[devis.statut]|default(devis.statut|capitalize) %}


											<div class="small text-muted mt-1">
												{{ devis.devisDetails|length }}
												ligne{{ devis.devisDetails|length > 1 ? 's' : '' }}
											</div>
										</td>

										{# 4. Statut du paiement #}
										<td>
											<span class="badge badge-{{ devis.statut == 'accepte' ? 'success' : (devis.statut in ['refuse', 'annule', 'expire'] ? 'danger' : (devis.statut == 'converti' ? 'info' : 'secondary')) }} mt-1">
												{{ libelleStatut }}
											</span>
										</td>

										{# 5. Total TTC #}
										<td class="text-right">
											<strong>
												{{ total|number_format(0, ',', ' ') }}
												FCFA
											</strong>
										</td>

										{# 6. Remise globale #}
										<td class="text-right">
											<strong>
												{{ devis.remise|default(0)|number_format(0, ',', ' ') }}
												FCFA
											</strong>
										</td>

										{# 7. Montant final à payer #}
										<td class="text-right">
											<strong class="text-primary">
												{{ devis.montantApayer|default(0)|number_format(0, ',', ' ') }}
												FCFA
											</strong>
										</td>

										{# 8. Actions #}
										<td class="text-center devis-actions">
											<a href="{{ path('app_devis_show', { id: devis.id }) }}" class="btn btn-info-light btn-sm" title="Afficher">
												<i class="fa fa-eye"></i>
											</a>

											<a href="{{ path('app_devis_edit', { id: devis.id }) }}" class="btn btn-primary-light btn-sm" title="Modifier">
												<i class="fa fa-pencil"></i>
											</a>
										</td>
									</tr>
								{% else %}
									<tr>
										<td colspan="8">
											<div class="empty-state">
												<i class="fa fa-inbox"></i>

												<h4 class="mt-3">
													Aucun devis trouvé
												</h4>

												<p class="text-muted">
													Modifiez les filtres ou réinitialisez la recherche.
												</p>

												<a href="{{ path('app_devis_index') }}" class="btn btn-primary-light">
													Afficher les devis actifs
												</a>
											</div>
										</td>
									</tr>
								{% endfor %}
							</tbody>
						</table>
					</div>
				</div>

				{% if pagination is defined and pagination.pageCount > 1 %}
					<nav class="d-flex justify-content-end">
						<ul class="pagination">
							{% for page in 1..pagination.pageCount %}
								<li class="page-item {{ page == pagination.currentPage ? 'active' : '' }}">
									<a class="page-link" href="{{ path('app_devis_index', app.request.query.all|merge({page: page})) }}">
										{{ page }}
									</a>
								</li>
							{% endfor %}
						</ul>
					</nav>
				{% endif %}
			</div>
		</div>
	</div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
	<script>
		document.addEventListener('DOMContentLoaded', function () {
document.querySelectorAll('[data-confirm]').forEach(function (button) {
button.addEventListener('click', function (event) {
event.preventDefault();
const url = button.getAttribute('href');

Swal.fire({
icon: 'warning',
title: 'Confirmer cette action ?',
text: button.dataset.confirm,
showCancelButton: true,
confirmButtonText: 'Oui, continuer',
cancelButtonText: 'Annuler'
}).then(function (result) {
if (result.isConfirmed) {
window.location.href = url;
}
});
});
});
});
	</script>
{% endblock %}
