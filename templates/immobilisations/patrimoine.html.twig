{% extends 'immobilisations/_base.html.twig' %}
{% import 'finances/_macros.html.twig' as m %}

{% block title %}Immobilisations › Patrimoine{% endblock %}
{% block page_title %}Patrimoine de l'entreprise{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_immobilisations_inventaire') }}" class="btn btn-light btn-sm si-btn-entete">Inventaire annuel</a>
	</li>
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_immobilisations_registre_pdf') }}" class="btn btn-light btn-sm si-btn-entete" target="_blank" rel="noopener"><i class="fas fa-download me-1"></i>Registre PDF</a>
	</li>
	<li class="nav-item">
		<a href="{{ path('app_immobilisations_nouveau') }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Bien</a>
	</li>
{% endblock %}

{% block body %}
	{% set s = synthese %}
	<div class="si-fin si-imm">
		<section class="si-fin-kpis" aria-label="Patrimoine en chiffres">
			<article class="card si-fin-kpi">
				<h2>Biens enregistrés</h2>
				<strong>{{ s.biens }}</strong>
				<span class="si-fin-vert">{{ s.nombreCategories }} catégorie{{ s.nombreCategories > 1 ? 's' }}</span>
			</article>
			<article class="card si-fin-kpi">
				<h2>Valeur d'achat totale</h2>
				<strong>{{ m.f(s.achat) }}</strong>
				<span class="si-fin-vert">{{ s.incorporelles is empty ? 'biens corporels' : 'hors logiciel' }}</span>
			</article>
			<article class="card si-fin-kpi">
				<h2>Valeur nette actuelle</h2>
				<strong>{{ m.f(s.nette) }}</strong>
				<span class="si-fin-vert">{{ s.pourcentNette is not null ? s.pourcentNette ~ ' %' : '—' }}</span>
			</article>
			<article class="card si-fin-kpi">
				<h2>Biens à contrôler</h2>
				<strong>{{ s.aControler|length }}</strong>
				<a href="{{ path('app_immobilisations_inventaire') }}" class="{{ s.aControler is empty ? 'si-fin-vert' : 'si-fin-rouge' }}">{{ s.aControler is empty ? 'inventaire à jour' : 'inventaire > ' ~ s.inventaireMois ~ ' mois' }}</a>
			</article>
		</section>

		{% if s.biens == 0 %}
			<section class="card">
				<h2>Aucun bien au registre</h2>
				<p class="si-fin-note mt-0">Ajoutez les machines depuis <a href="{{ path('app_immobilisations_machines') }}">Machines et amortissement</a>, puis les ordinateurs, chaises, motos, climatiseurs… avec le bouton « + Bien ».</p>
			</section>
		{% else %}
			<section class="si-imm-categories" aria-label="Par catégorie">
				{% for c in s.corporelles %}
					<a class="card si-imm-categorie" href="{{ path('app_immobilisations_registre', {categorie: c.cle}) }}">
						<div class="si-imm-categorie-tete">
							<span class="si-imm-pastille" style="color: {{ c.couleur }}; background: {{ c.couleur }}1a" aria-hidden="true"><i class="fas {{ c.icone }}"></i></span>
							<strong>{{ c.unites }}</strong>
						</div>
						<h3>{{ c.libelle }}</h3>
						<p>Achat {{ c.achat|number_format(0, ',', ' ') }} F</p>
						<p>Valeur nette <b>{{ c.nette|number_format(0, ',', ' ') }} F</b></p>
					</a>
				{% endfor %}
			</section>

			<div class="si-fin-deux" style="grid-template-columns: minmax(0, 1.9fr) minmax(0, 1fr);">
				<section class="card" aria-labelledby="titre-nette">
					<h2 id="titre-nette">Valeur nette par catégorie</h2>
					<dl class="si-imm-barres">
						{% for c in s.corporelles|sort((a, b) => b.nette <=> a.nette) %}
							<dt title="{{ c.libelle }}">{{ c.libelle }}</dt>
							<dd><span class="si-fin-jauge"><span style="width: {{ (c.nette * 100 / s.maxNette)|round(1) }}%; background: {{ c.couleur }}"></span></span></dd>
							<dd class="si-imm-montant">{{ c.nette|number_format(0, ',', ' ') }}</dd>
						{% endfor %}
					</dl>
				</section>
				<section class="card" aria-labelledby="titre-lieux">
					<h2 id="titre-lieux">Par emplacement</h2>
					<table class="table si-fin-table">
						<thead>
							<tr><th scope="col">Lieu</th><th scope="col" class="text-end">Biens</th><th scope="col" class="text-end">Valeur nette</th></tr>
						</thead>
						<tbody>
							{% for l in s.lieux %}
								<tr><td>{{ l.lieu }}</td><td class="text-end">{{ l.biens }}</td><td class="text-end si-fin-f">{{ l.nette|number_format(0, ',', ' ') }}</td></tr>
							{% endfor %}
						</tbody>
					</table>
					{% for l in s.incorporelles %}
						<p class="si-fin-note">{{ l.bien.designation }} suivi à part comme immobilisation incorporelle ({{ l.bien.code }}, valeur nette {{ l.calcul.valeurNette|number_format(0, ',', ' ') }} F).</p>
					{% endfor %}
				</section>
			</div>
		{% endif %}
	</div>
{% endblock %}
