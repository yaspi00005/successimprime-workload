}

production.style.pointerEvents = 'none';
}


definirValeur(detail, 'modeCalcul', 'unite');


if (article && articleChamp && articleChamp.value) {
chargerArticle(detail);
}


if (libre) {

definirValeur(detail, 'article', '');

if (articleChamp) {
articleChamp.required = false;
}
}


appliquerCircuit(detail);

calculerDetail(detail);
}


/*
         * ====================================================
         * MODE PRODUIT
         * ====================================================
         */

function appliquerModeConfiguration(detail, viaChangementUtilisateur) {
if (valeurTypeLigne(detail) !== 'produit') {
return;
}

const mode = valeurModeConfiguration(detail);

const auto = mode === 'automatique';

afficher(detail, '.js-zone-configuration-automatique', auto);

afficher(detail, '.js-zone-finitions-automatiques', auto);

afficher(detail, '.js-zone-finitions-manuelles', ! auto);

const configuration = champDetail(detail, 'configuration');

if (configuration) {
configuration.required = auto;
}

/*
 * Prix et mode de calcul viennent toujours du catalogue en mode
 * "produit" (automatique ou manuel) : ils ne sont modifiables que
 * pour une ligne en saisie libre.
 */
verrouillerChampCatalogue(champDetail(detail, 'prixUnitaire'), true);

verrouillerChampCatalogue(champDetail(detail, 'modeCalcul'), true);

const produitChamp = champDetail(detail, 'produit');

if (produitChamp && produitChamp.value) {
if (auto) {
chargerConfigurationsProduit(detail);
} else {
chargerOptionsManuelles(detail, ! viaChangementUtilisateur);
}
}
}


