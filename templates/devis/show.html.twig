{% block javascripts %}

	{{ parent() }}

	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>

		document.addEventListener('DOMContentLoaded', function () {

document.querySelectorAll('.js-envoyer-whatsapp').forEach(function (bouton) {

bouton.addEventListener('click', function () {

const numero = bouton.dataset.numero || 'ce document';

Swal.fire({
icon: 'question',
title: 'Envoyer ' + numero + ' par WhatsApp ?',
text: 'Le PDF sera envoyé au numéro WhatsApp enregistré pour ce client.',
showCancelButton: true,
confirmButtonText: 'Envoyer',
cancelButtonText: 'Annuler'
}).then(function (resultat) {

if (! resultat.isConfirmed) {
return;
}

bouton.disabled = true;

fetch(bouton.dataset.url, {
method: 'POST',
headers: {
'Content-Type': 'application/json',
Accept: 'application/json',
'X-Requested-With': 'XMLHttpRequest'
},
body: JSON.stringify(
{_token: bouton.dataset.token}
)
}).then(function (reponse) {
return reponse.json();
}).then(function (donnees) {
Swal.fire({
icon: donnees.success ? 'success' : 'error',
title: donnees.success ? 'Envoyé' : 'Erreur',
text: donnees.message
});
}).catch(function () {
Swal.fire({icon: 'error', title: 'Erreur', text: "La requête n'a pas pu aboutir."});
}). finally(function () {
bouton.disabled = false;
});
});
});
});
});
	</script>

{% endblock %}
