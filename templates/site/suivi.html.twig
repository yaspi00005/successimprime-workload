{#
	Suivre ma commande (maquette 10) : numéro de commande et téléphone, sans
	compte. Seulement les étapes : ni montant, ni nom, ni fichier (ils sont
	dans l'espace client). Page jamais indexée.
#}
{% extends 'site/_site.html.twig' %}

{% set menu_actif = 'app_site_suivi' %}

{% block title %}Suivre ma commande · Succès Imprim{% endblock %}
{% block description %}Suivez votre commande Succès Imprim avec son numéro et votre téléphone, sans créer de compte : BAT, impression, finition, prête, livrée.{% endblock %}

{% block entete %}
	<meta name="robots" content="noindex, nofollow">
	<link rel="stylesheet" href="{{ asset('css/site-formulaires.css') }}">
{% endblock %}

{% block contenu %}
	{{ include('site/_bandeau.html.twig', {titre: 'Suivre ma commande', accroche: 'Entrez le numéro reçu par SMS ou WhatsApp, sans créer de compte.'}) }}

	<section class="si-section si-suivi-page">
		<div class="si-cadre">
			<form method="post" action="{{ path('app_site_suivi') }}" class="si-suivi-recherche" novalidate>
				<input type="hidden" name="_token" value="{{ csrf_token('site-suivi') }}">
				<div class="si-champ si-suivi-numero">
					<label for="suivi-numero">Numéro de commande</label>
					<input type="text" id="suivi-numero" name="numero" value="{{ numero }}" placeholder="Ex. 0142" autocomplete="off" autocapitalize="characters" spellcheck="false" maxlength="50" required>
				</div>
				<div class="si-champ si-suivi-telephone">
					<label for="suivi-telephone">Téléphone de la commande</label>
					<div class="si-tel">
						<span aria-hidden="true">+223</span>
						<input type="tel" id="suivi-telephone" name="telephone" value="{{ telephone }}" placeholder="7X XX XX XX" inputmode="tel" autocomplete="tel-national" maxlength="20" required>
					</div>
				</div>
				<button type="submit" class="si-bouton si-bouton-rouge si-bouton-grand">Suivre</button>
			</form>

			{% if erreur %}
				<div class="si-alerte" role="alert">
					<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm1 15h-2v-2h2Zm0-4h-2V7h2Z"/></svg>
					<div>
						<strong>{{ erreur }}</strong>
						<p>Vérifiez le numéro sur votre reçu ou dans le message de confirmation, et le téléphone donné à la commande.{% if site_whatsapp() %} Besoin d'aide ? <a href="{{ site_whatsapp('Bonjour Succès Imprim, je ne retrouve pas ma commande ' ~ numero ~ '.') }}" target="_blank" rel="noopener">Écrivez-nous sur WhatsApp</a>.{% endif %}</p>
					</div>
				</div>
			{% endif %}

			{% if carte %}
				{% set commande = carte.commande %}
				<article class="si-suivi-carte" aria-labelledby="suivi-titre">
					<header class="si-suivi-tete">
						<div>
							<p class="si-suivi-num">Commande n° {{ commande.numero }}</p>
							<h2 id="suivi-titre">{{ carte.titre }}</h2>
						</div>
						<p class="si-pastille si-pastille-{{ pastille.ton }}">{{ pastille.texte }}</p>
					</header>

					{% if carte.annulee %}
						<p class="si-suivi-annulee">Cette commande a été annulée. Pour toute question, contactez l'atelier.</p>
					{% else %}
						<ol class="si-etapes" aria-label="Étapes de la commande">
							{% for e in etapes %}
								<li class="si-etape si-etape-{{ e.etat }}"{% if e.etat == 'en_cours' %} aria-current="step"{% endif %}>
									<span class="si-etape-rond" aria-hidden="true">
										{%- if e.etat == 'faite' -%}
											<svg viewBox="0 0 24 24"><path d="M9.5 16.2 5.3 12l-1.4 1.4 5.6 5.6 11-11-1.4-1.4z"/></svg>
										{%- else -%}
											{{ loop.index }}
										{%- endif -%}
									</span>
									<span class="si-etape-texte">
										<span class="si-etape-nom">{{ e.libelle }}<span class="si-visuel-cache"> : {{ e.etat == 'faite' ? 'fait' : (e.etat == 'en_cours' ? 'en cours' : 'à venir') }}</span></span>
										<span class="si-etape-quand">{{ e.quand ?? e.detail ?? '—' }}</span>
									</span>
								</li>
							{% endfor %}
						</ol>
					{% endif %}

					<div class="si-suivi-actions">
						{% set wa = site_whatsapp('Bonjour Succès Imprim, je souhaite être prévenu de l\'avancement de ma commande ' ~ commande.numero ~ '.') %}
						{% if wa and not carte.terminee and not carte.annulee %}
							<a href="{{ wa }}" class="si-bouton si-bouton-wa si-bouton-grand" target="_blank" rel="noopener">
								{{ include('site/_icone_whatsapp.svg.twig') }}
								Être prévenu sur WhatsApp
							</a>
						{% endif %}
						<a href="{{ path('app_espace_connexion') }}" class="si-bouton si-bouton-contour si-bouton-grand">Ouvrir mon espace client</a>
					</div>
					<p class="si-note si-suivi-note">Seules les étapes s'affichent ici. Le détail, les montants, les factures et les BAT à valider sont dans votre espace client.</p>
				</article>
			{% elseif not erreur %}
				<ul class="si-suivi-aide">
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16l3-2 3 2 3-2 3 2 3-2V8Zm-1 7V3.5L18.5 9Z"/></svg>
						<div><strong>Le numéro de commande</strong> est sur votre reçu et dans le SMS ou le WhatsApp de confirmation. « 0142 » suffit.</div>
					</li>
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17 1H7a2 2 0 0 0-2 2v18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2Zm0 18H7V5h10Z"/></svg>
						<div><strong>Le téléphone</strong> est celui donné à la commande, sans le +223.</div>
					</li>
					<li>
						<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 1 3 5v6c0 5.6 3.8 10.7 9 12 5.2-1.3 9-6.4 9-12V5Zm0 6a3 3 0 1 1 0 6 3 3 0 0 1 0-6Zm0 14c-2.4-.8-4.5-2.6-5.6-5 1.3-1.5 3.4-2.3 5.6-2.3s4.3.8 5.6 2.3c-1.1 2.4-3.2 4.2-5.6 5Z"/></svg>
						<div><strong>Seules les étapes</strong> s'affichent ici. Montants, factures et BAT : dans votre <a href="{{ path('app_espace_connexion') }}">espace client</a>.</div>
					</li>
				</ul>
			{% endif %}
		</div>
	</section>
{% endblock %}
