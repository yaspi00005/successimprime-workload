	{% set variante = variante|default('pied') %}
	<div class="si-reseaux si-reseaux-{{ variante }}">
		{% if titre|default(false) %}<p class="si-reseaux-titre">{{ titre }}</p>{% endif %}
		<ul aria-label="Succès Imprim sur les réseaux sociaux">
			{% for cle, reseau in reseaux %}
				<li><a href="{{ reseau.url }}" class="si-reseau si-reseau-{{ cle }}" target="_blank" rel="noopener{{ cle != 'whatsapp' ? ' me' }}" title="{{ reseau.libelle }}" aria-label="{{ reseau.libelle }} (s'ouvre dans un nouvel onglet)">
					<svg viewBox="{{ icones[cle].vue }}" aria-hidden="true" fill-rule="evenodd"><path d="{{ icones[cle].d }}"/></svg>
					{% if variante == 'contact' %}<span>{{ reseau.libelle }}</span>{% endif %}
				</a></li>
			{% endfor %}
		</ul>
	</div>
{% endif %}
