{#
	Bas de l'accueil (docs/site-vitrine.md) :
	- « Nos actions sociales » : les trois premières actions montrées, avec
	  le lien vers la page ; rien tant qu'aucune action publiée n'a un texte
	  et une photo ;
	- « Laisser un avis » : lien de l'avis Google (nouvel onglet) et, sur un
	  ordinateur, son QR code à scanner avec le téléphone ; rien quand le
	  lien est vidé dans Réglages › Site vitrine › Nous soutenir.
	Même texte pour tous : un avis est demandé à chacun, pas seulement aux
	clients contents (règles de Google).
#}
{% set actions = site_actions_sociales() %}
{% set soutien = site_soutien() %}
{% if actions or soutien %}
	{{ site_styles('css/site-social.css') }}
{% endif %}

{% if actions %}
	{% set page = site_lien('app_site_actions_sociales') %}
	<section class="si-social" aria-labelledby="si-social-titre">
		<div class="si-cadre">
			<div class="si-social-tete">
				<div>
					<h2 id="si-social-titre">Nos actions sociales</h2>
					<p>En dehors de l'atelier, l'équipe s'engage à Bamako.</p>
				</div>
				{% if page %}<a href="{{ page }}">Voir nos actions sociales <span aria-hidden="true">→</span></a>{% endif %}
			</div>
			<ul class="si-social-cartes">
				{% for a in actions %}
					{% set photo = site_image(a.imagePrincipale, 'petite') %}
					<li class="si-social-carte" data-revele>
						{% if photo %}<img src="{{ asset(photo.chemin) }}" width="{{ photo.largeur }}" height="{{ photo.hauteur }}" alt="" loading="lazy" decoding="async">{% endif %}
						<div class="si-social-carte-corps">
							<p class="si-social-meta"><time datetime="{{ a.dateAction|date('Y-m-d') }}">{{ a.dateAction|site_date }}</time>{% if a.lieu %} · {{ a.lieu }}{% endif %}</p>
							<h3>{% if page %}<a class="si-social-carte-lien" href="{{ page }}#action-{{ a.id }}">{{ a.titre }}</a>{% else %}{{ a.titre }}{% endif %}</h3>
							{% set extrait = a.texte|site_texte %}
							<p class="si-social-extrait">{{ extrait|length > 220 ? extrait|slice(0, 219)|trim ~ '…' : extrait }}</p>
						</div>
					</li>
				{% endfor %}
			</ul>
		</div>
	</section>
{% endif %}

{% if soutien %}
	<section class="si-soutien" aria-labelledby="si-soutien-titre">
		<div class="si-cadre">
			<div class="si-soutien-carte" data-revele>
				<span class="si-soutien-icone" aria-hidden="true"><svg viewBox="0 0 24 24" width="28" height="28"><path fill="currentColor" d="M4 3h16a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H9.4l-4.7 3.6A1 1 0 0 1 3 20.8V5a2 2 0 0 1 1-2Zm1 2v13.7l3.4-2.5A1 1 0 0 1 9 16h11V5H5Zm3 3h8v2H8V8Zm0 4h5v2H8v-2Z"/></svg></span>
				<div class="si-soutien-texte">
					<h2 id="si-soutien-titre">Laisser un avis</h2>
					<p>Vous avez travaillé avec nous&nbsp;? Dites-le sur Google&nbsp;: votre avis aide d'autres personnes à Bamako à trouver l'atelier et à savoir à quoi s'attendre.</p>
					<a href="{{ soutien.lien }}" class="si-bouton si-bouton-rouge" target="_blank" rel="noopener">Laisser un avis Google</a>
				</div>
				{% if soutien.qr %}
					<figure class="si-soutien-qr">
						<img src="{{ soutien.qr }}" width="116" height="116" alt="QR code du lien pour laisser un avis Google" loading="lazy">
						<figcaption>Ou scannez-le avec votre téléphone</figcaption>
					</figure>
				{% endif %}
			</div>
		</div>
	</section>
{% endif %}
