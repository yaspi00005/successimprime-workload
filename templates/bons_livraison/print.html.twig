<!DOCTYPE html>
<html lang="fr">
	<head>
		<meta charset="UTF-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<title>Bon de livraison {{ bon.numero }}</title>
		<style>
			@page {
				size: A4;
				margin: 15mm;
			}
			* {
				box-sizing: border-box;
			}
			html,
			body {
				margin: 0;
				padding: 0;
				background: #eef0f4;
				color: #111;
				font-family: Arial, Helvetica, sans-serif;
			}
			.print-toolbar {
				display: flex;
				justify-content: center;
				gap: 10px;
				padding: 15px;
			}
			.print-toolbar button,
			.print-toolbar a {
				padding: 10px 18px;
				border: 0;
				border-radius: 5px;
				color: #fff;
				background: #6259ca;
				font-size: 14px;
				text-decoration: none;
				cursor: pointer;
			}
			.print-toolbar a {
				background: #5b6470;
			}
			.sheet {
				width: 190mm;
				min-height: 260mm;
				margin: 0 auto 20px;
				padding: 10mm;
				background: #fff;
			}
			.header {
				display: flex;
				align-items: flex-start;
				justify-content: space-between;
				gap: 5mm;
				padding-bottom: 4mm;
				border-bottom: 1mm solid #111;
			}
			.company {
				font-size: 20px;
				font-weight: 800;
				text-transform: uppercase;
			}
			.document-title {
				margin-top: 1mm;
				font-size: 13px;
				font-weight: 700;
				letter-spacing: 1px;
				text-transform: uppercase;
			}
			.bon-numero {
				text-align: right;
				font-size: 11px;
			}
			.bon-numero strong {
				display: block;
				margin-top: 1mm;
				font-size: 16px;
			}
			.grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 4mm 8mm;
				margin: 5mm 0;
			}
			.field-label {
				display: block;
				margin-bottom: 0.5mm;
				font-size: 9px;
				font-weight: 700;
				color: #555;
				text-transform: uppercase;
			}
			.field-value {
				display: block;
				font-size: 12px;
				font-weight: 700;
				line-height: 1.3;
			}
			.statut {
				display: inline-block;
				margin-top: 5mm;
				padding: 1.5mm 4mm;
				border-radius: 3mm;
				font-size: 10px;
				font-weight: 700;
				text-transform: uppercase;
				background: #eee;
			}
			table {
				width: 100%;
				margin-top: 5mm;
				border-collapse: collapse;
				font-size: 11px;
			}
			th,
			td {
				padding: 2.5mm;
				border: 0.3mm solid #999;
				text-align: left;
			}
			th {
				background: #f2f2f5;
				font-size: 9px;
				text-transform: uppercase;
			}
			td.text-center,
			th.text-center {
				text-align: center;
			}
			.observation {
				margin-top: 5mm;
				padding: 3mm;
				border: 0.3mm dashed #999;
				font-size: 11px;
			}
			.signatures {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 8mm;
				margin-top: 12mm;
			}
			.signature-box {
				padding-top: 2mm;
				border-top: 0.3mm solid #111;
				font-size: 10px;
			}
			.signature-box strong {
				display: block;
				margin-bottom: 12mm;
				font-size: 11px;
			}
			.footer {
				display: flex;
				justify-content: space-between;
				gap: 4mm;
				margin-top: 10mm;
				padding-top: 3mm;
				border-top: 0.3mm solid #999;
				font-size: 8px;
				color: #666;
			}
			@media print {
				html,
				body {
					background: #fff;
				}
				.print-toolbar {
					display: none !important;
				}
				.sheet {
					width: auto;
					min-height: 0;
					margin: 0;
					padding: 0;
				}
			}
		</style>
	</head>
	<body>

		{% set commande = bon.commande %}
		{% set client = commande ? commande.clients : null %}

		<div class="print-toolbar">
			<a href="{{ path('app_bons_livraison_show', { id: bon.id }) }}">Retour au bon</a>
			<button type="button" onclick="window.print()">Imprimer</button>
		</div>

		<main class="sheet">

			<header class="header">
				<div>
					<div class="company">SUCCESS IMPRIM</div>
					<div class="document-title">Bon de livraison</div>
				</div>
				<div class="bon-numero">
					Numéro
					<strong>{{ bon.numero }}</strong>
					{{ bon.creeLe ? bon.creeLe|date('d/m/Y') : '—' }}
				</div>
			</header>

			<div class="grid">

				<div>
					<span class="field-label">Commande</span>
					<span class="field-value">
						{% if commande %}
							{{ commande.numero|default('#' ~ commande.id) }}
						{% else %}
							—
						{% endif %}
					</span>
				</div>

				<div>
					<span class="field-label">Client</span>
					<span class="field-value">
						{{ client ? client.nomComplet : '—' }}
					</span>
				</div>

				<div>
					<span class="field-label">Réceptionnaire</span>
					<span class="field-value">
						{{ bon.nomReceptionnaire|default(client ? client.nomComplet : '—') }}
					</span>
				</div>

				<div>
					<span class="field-label">Téléphone</span>
					<span class="field-value">
						{{ bon.telephoneReceptionnaire|default(client ? client.telephone : '—') }}
					</span>
				</div>

				<div>
					<span class="field-label">Adresse de livraison</span>
					<span class="field-value">
						{{ bon.adresseLivraison|default(client ? client.adresse : '—') }}
					</span>
				</div>

				<div>
					<span class="field-label">Statut</span>
					<span class="field-value">
						<span class="statut">
							{% if bon.statut == 'brouillon' %}
								Brouillon
							{% elseif bon.statut == 'valide' %}
								Validé
							{% elseif bon.statut == 'livre' %}
								Livré
							{% elseif bon.statut == 'annule' %}
								Annulé
							{% else %}
								{{ bon.statut|replace({'_': ' '})|capitalize }}
							{% endif %}
						</span>
					</span>
				</div>

			</div>

			<table>
				<thead>
					<tr>
						<th>#</th>
						<th>Désignation</th>
						<th class="text-center">Qté commandée</th>
						<th class="text-center">Qté livrée</th>
					</tr>
				</thead>
				<tbody>
					{% for ligne in bon.lignes %}
						<tr>
							<td class="text-center">{{ loop.index }}</td>
							<td>{{ ligne.designation }}</td>
							<td class="text-center">{{ ligne.quantiteCommandee }}</td>
							<td class="text-center">{{ ligne.quantiteLivree }}</td>
						</tr>
					{% else %}
						<tr>
							<td colspan="4" class="text-center">Aucune ligne.</td>
						</tr>
					{% endfor %}
				</tbody>
			</table>

			{% if bon.observation %}
				<div class="observation">
					<span class="field-label">Observation</span>
					{{ bon.observation|nl2br }}
				</div>
			{% endif %}

			<div class="signatures">

				<div class="signature-box">
					<strong>Livré par</strong>
					{{ bon.livrePar ? bon.livrePar.username : (bon.creePar ? bon.creePar.username : '—') }}
				</div>

				<div class="signature-box">
					<strong>Reçu par (signature)</strong>
					{{ bon.nomReceptionnaire|default('—') }}
				</div>

			</div>

			<footer class="footer">
				<span>Créé le {{ bon.creeLe ? bon.creeLe|date('d/m/Y H:i') : '—' }} par {{ bon.creePar ? bon.creePar.username : '—' }}</span>
				<span>Validé le {{ bon.valideLe ? bon.valideLe|date('d/m/Y H:i') : '—' }}</span>
				<span>Livré le {{ bon.livreLe ? bon.livreLe|date('d/m/Y H:i') : '—' }}</span>
			</footer>

		</main>

		<script>
			if (new URLSearchParams(window.location.search).get('autoPrint') === '1') {
window.addEventListener('load', function () {
window.print();
});
}
		</script>
	</body>
</html>
