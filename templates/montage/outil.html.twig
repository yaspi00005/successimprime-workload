  $('cmp').innerHTML=`<tr><th>Feuille</th><th class="n">Poses</th><th class="n">Feuilles</th><th class="n">Rendement</th></tr>`+rows.map(r=>`<tr class="${r[3]===best&&r[1]?'best':''}"><td>${r[0]}</td><td class="n">${r[1]||'—'}</td><td class="n">${r[2]||'—'}</td><td class="n">${r[1]?r[3]+' %':'—'}</td></tr>`).join('');
  [...$('viewSeg').children][1].disabled=!files.verso;
}

/* ---------- loading files ---------- */
let fid=0;
function near(a,b,t){return Math.abs(a-b)<=(t||0.6)}
function detectFormat(wmm,hmm,fbx,fby){ // PDF real size → preset
  const tw=wmm*(1-2*fbx),th=hmm*(1-2*fby);
  for(const f of FMTS){if(!f[2])continue;
    if(near(tw,f[2])&&near(th,f[3]))return {fmt:f[0],rot:0};if(near(tw,f[3])&&near(th,f[2]))return {fmt:f[0],rot:90};
    for(const b of [2,3,5]){if(near(wmm,f[2]+2*b)&&near(hmm,f[3]+2*b))return {fmt:f[0],rot:0,bleed:b};if(near(wmm,f[3]+2*b)&&near(hmm,f[2]+2*b))return {fmt:f[0],rot:90,bleed:b}}}
  return null}
function setFmt(k,w,h){S.fmt=k;fsel.value=k;if(k==='custom'){S.tw=w;S.th=h}else{const f=FMTS.find(x=>x[0]===k);S.tw=f[2];S.th=f[3]}$('tw').value=S.tw;$('th').value=S.th}
function setRot(r){S.frot=r;[...$('rotSeg').children].forEach((b,i)=>b.setAttribute('aria-pressed',String([0,90,180,270][i]===r)))}
function showFile(side,F){const th=$(side+'Th'),nm=$(side+'Name'),inf=$(side+'Info');
  if(!F){th.style.backgroundImage='';nm.textContent=side==='verso'?'Pas de verso':'—';inf.textContent=side==='verso'?'Le PDF aura une seule page':'';return}
  th.style.backgroundImage=`url("${F.url}")`;nm.textContent=F.name;
  const bl=F.fbx>0?`fond perdu ${fmtN(F.fbx*F.wmm)} mm`:'sans fond perdu';
  inf.textContent=F.kind==='pdf'?`PDF ${fmtN(F.wmm)} × ${fmtN(F.hmm)} mm · ${bl}`:`${F.kind==='sample'?'Exemple · ':''}${F.pxW} × ${F.pxH} px · ${bl}`;}
async function loadFile(side,file){
  const msg=$('expMsg');msg.textContent='';
  try{
    const buf=new Uint8Array(await file.arrayBuffer());let F;
    if(file.type==='application/pdf'||/\.pdf$/i.test(file.name)){
      const doc=await PDFLib.PDFDocument.load(buf,{ignoreEncryption:true});const pg=doc.getPage(0);const mb=pg.getBleedBox();const tb=pg.getTrimBox();const box={left:mb.x,bottom:mb.y,right:mb.x+mb.width,top:mb.y+mb.height};
      const wmm=mb.width/PT,hmm=mb.height/PT;const fbx=tb.width<mb.width-0.5?((mb.width-tb.width)/2)/mb.width:0,fby=tb.height<mb.height-0.5?((mb.height-tb.height)/2)/mb.height:0;
      const url=await pdfThumb(buf,wmm,hmm);
      F={id:++fid,name:file.name,kind:'pdf',wmm,hmm,fbx,fby,url,bytes:buf,box,full:pg.getMediaBox()};
      if(side==='recto'){const d=detectFormat(wmm,hmm,fbx,fby);if(d){if(d.bleed&&!fbx){F.fbx=d.bleed/wmm;F.fby=d.bleed/hmm}setFmt(d.fmt);setRot(d.rot)}else{setFmt('custom',+(wmm*(1-2*F.fbx)).toFixed(1),+(hmm*(1-2*F.fby)).toFixed(1));setRot(0)}}
    }else{
      const url=await new Promise((res,rej)=>{const r=new FileReader();r.onload=()=>res(r.result);r.onerror=rej;r.readAsDataURL(file)});
      const img=await loadImg(url);F=imgFile(file.name,img,url,buf,file.type,side);
    }
    files[side]=F;showFile(side,F);if(side==='verso'){S.view='verso';[...$('viewSeg').children].forEach((b,i)=>b.setAttribute('aria-pressed',String(i===1)))}update();
  }catch(err){msg.textContent=`Impossible de lire « ${file.name} » : ${err&&err.message?err.message:err}. Essayez un PDF non protégé, un JPG ou un PNG.`}
}
function loadImg(url){return new Promise((res,rej)=>{const i=new Image();i.onload=()=>res(i);i.onerror=()=>rej(new Error('image illisible'));i.src=url})}
function imgFile(name,img,url,bytes,mime,side,kind){
  const pxW=img.naturalWidth,pxH=img.naturalHeight,ar=pxW/pxH;let fbx=0,fby=0;
