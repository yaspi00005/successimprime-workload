{#
	Réglages › Site vitrine › Actions sociales (ActionSociale) : la liste.
	La partie « Nos actions sociales » du site reste cachée tant qu'aucune
	action publiée n'a un texte et une photo (ActionsSociales::visibles).
	Variables : elements (actions), actionsVisibles.
#}
<div class="si-sv-aide si-sv-actions-etat">
	{% if actionsVisibles %}
		<span class="si-pastille si-pastille-vert">Visible sur le site</span>
		La page <a href="{{ path('app_site_actions_sociales') }}" target="_blank" rel="noopener">Nos actions sociales</a>, le bloc de l'accueil et le lien du pied de page sont affichés.
	{% else %}
		<span class="si-pastille si-pastille-gris">Pas encore sur le site</span>
		La page, le bloc de l'accueil et le lien du pied de page apparaissent tout seuls dès qu'une action est publiée avec son texte et au moins une photo.
	{% endif %}
</div>
<p class="si-sv-aide"><strong>Photos de personnes reconnaissables, d'enfants surtout : seulement avec leur accord, ou celui des parents.</strong> Pas de nom d'enfant dans le texte.</p>
{% if elements is empty %}
	<p class="si-sv-vide">Aucune action pour le moment. Ajoutez la première quand vous avez ses photos et son texte.</p>
{% else %}
	<div class="table-responsive">
		<table class="table si-table align-middle mb-0">
			<thead>
				<tr><th></th><th>Action</th><th class="si-masque-mobile">Date</th><th class="si-masque-mobile">Ordre</th><th>État</th><th class="text-end"></th></tr>
			</thead>
			<tbody>
				{% for a in elements %}
					{% set manques = a.manques %}
					<tr>
						<td class="si-sv-col-vignette">{{ _self.vignette(a.imagePrincipale) }}</td>
						<td>
							<strong>{{ a.titre }}</strong>
							<small class="d-block text-muted">{{ a.lieu ? a.lieu ~ ' · ' }}{{ a.images|length }} photo{{ a.images|length > 1 ? 's' }}{% if manques is not empty %} · il manque {{ manques|join(' et ') }}{% endif %}</small>
						</td>
						<td class="si-masque-mobile text-nowrap">{{ a.dateAction|date('d/m/Y') }}</td>
						<td class="si-masque-mobile">{{ a.ordre }}</td>
						<td>
							{% if a.estVisible %}<span class="si-pastille si-pastille-vert">Publiée</span>
							{% elseif a.publie %}<span class="si-pastille si-pastille-orange">Incomplète</span>
							{% else %}<span class="si-pastille si-pastille-gris">Brouillon</span>{% endif %}
						</td>
						<td class="text-end"><a href="{{ path('app_site_contenu_fiche', {type: 'actions', id: a.id}) }}" class="btn btn-sm si-btn-discret">Modifier</a></td>
					</tr>
				{% endfor %}
			</tbody>
		</table>
	</div>
{% endif %}

{% macro vignette(image) %}
	{% set fichier = site_image(image, 'petite') %}
	{% if fichier %}
		<img src="{{ asset(fichier.chemin) }}" width="{{ fichier.largeur }}" height="{{ fichier.hauteur }}" alt="" class="si-sv-vignette" loading="lazy">
	{% else %}
		<span class="si-sv-vignette si-sv-vignette-vide" aria-hidden="true"><i class="far fa-image"></i></span>
	{% endif %}
{% endmacro %}
