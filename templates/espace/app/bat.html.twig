{% extends 'espace/app/_app.html.twig' %}

{% block title %}BAT · {{ titre }}{% endblock %}
{% block entete %}<a class="ec-retour" href="{{ path('app_espace_fichiers') }}"><span class="fl">‹</span>BAT · {{ titre }}</a>{% endblock %}

{% block contenu %}
	<p class="ec-sous">{{ conception and conception.versions > 0 ? 'Version ' ~ conception.versions ~ ' · ' }}commande {{ ligne.commande.numero }}{{ controle.traiteLe ? ' · envoyée le ' ~ controle.traiteLe|date('d/m à H:i') }}</p>

	{% for f in fichiers %}
		<div class="ec-apercu">
			{% if f.typeMime starts with 'image/' %}
				{% set rang = rangs[f.id] ?? 0 %}
				<div class="ec-bat-image" data-rang="{{ rang }}">
					<img src="{{ path('app_espace_bat_fichier', {id: f.id}) }}" alt="BAT {{ titre }}">
					{% if reperes %}
						{% for r in reperes.reperes %}{% if r.i == rang %}<span class="ec-repere ancien" style="left:{{ r.x * 100 }}%;top:{{ r.y * 100 }}%" title="{{ r.t }}">{{ loop.index }}</span>{% endif %}{% endfor %}
					{% endif %}
				</div>
			{% elseif f.typeMime == 'application/pdf' %}
				<iframe src="{{ path('app_espace_bat_fichier', {id: f.id}) }}" title="BAT {{ titre }}"></iframe>
			{% endif %}
			<div class="ec-ligne" style="margin-top:.6rem"><span class="ec-petit">{{ f.nomOriginal }}</span><a class="ec-lien" href="{{ path('app_espace_bat_fichier', {id: f.id, telecharger: 1}) }}">Télécharger</a></div>
		</div>
	{% else %}
		<div class="ec-carte ec-vide">Le fichier du BAT n'est pas encore en ligne. L'atelier vous l'envoie aussi par WhatsApp.</div>
	{% endfor %}

	{% if reperes %}
		<ul class="ec-reperes ec-carte" id="reperes-precedents">
			{% for r in reperes.reperes %}
				<li><span class="ec-num">{{ loop.index }}</span><span>« {{ r.t }} » <span class="ec-petit">· {{ reperes.corrigeeEn ? 'corrigé en version ' ~ reperes.corrigeeEn : 'en cours de correction' }}</span></span></li>
			{% endfor %}
		</ul>
	{% endif %}

	{% if frise is not empty %}
		<div class="ec-carte">
			<ul class="ec-liste">
				{% for e in frise %}<li><b>{{ e.titre }}</b> <span class="ec-petit">· {{ e.le|date('d/m H:i') }}</span>{% if e.detail %}<div class="ec-petit">« {{ e.detail }} »</div>{% endif %}{% for t in e.reperes ?? [] %}<div class="ec-petit">{{ loop.index }}. {{ t }}</div>{% endfor %}</li>{% endfor %}
			</ul>
		</div>
	{% endif %}

	{% if attente and app.user.estLectureSeule() %}
		{# Compte « Lecture · suivi » : il voit le BAT, une autre personne du compte le valide. #}
		<div class="ec-note">BAT en attente : une personne de votre entreprise le valide ou demande une modification.</div>
	{% elseif attente %}
		<form method="post">
			<input type="hidden" name="_token" value="{{ csrf_token('espace') }}">
			<div class="ec-boutons">
				<button class="ec-bouton vert" name="action" value="valider" data-confirmer="Valider ce BAT ? L'impression se fera tel quel.">✓ Valider le BAT</button>
				<details class="ec-modif">
					<summary class="ec-bouton clair">Demander une modification</summary>
					{% if rangs is not empty %}
						<p class="ec-astuce">Touchez l'image du BAT à l'endroit à changer : un repère numéroté s'y pose, écrivez ce qu'il faut faire.</p>
						<ol class="ec-reperes ec-saisie" id="reperes-saisie" aria-live="polite"></ol>
						<input type="hidden" name="reperes" id="reperes" value="[]">
					{% endif %}
					<label for="texte" class="ec-petit">{{ rangs is not empty ? 'Autre chose à préciser ?' : 'Que faut-il modifier ?' }}</label>
					<textarea id="texte" name="texte" class="ec-champ" maxlength="500" placeholder="Ex. : agrandir le logo de 20 %, corriger le numéro de téléphone"></textarea>
					<button class="ec-bouton bleu" name="action" value="modifier" style="margin-top:.6rem">Envoyer la demande</button>
				</details>
			</div>
			<p class="ec-petit" style="text-align:center">Votre accord est horodaté et archivé.</p>
		</form>
	{% elseif controle.batValide %}
		<div class="ec-flash ec-flash-ok">BAT validé{{ conception and conception.valideLe ? ' le ' ~ conception.valideLe|date('d/m à H:i') }}.</div>
	{% else %}
		<div class="ec-note">L'atelier prépare une nouvelle version. Vous serez prévenu dès qu'elle est prête.</div>
	{% endif %}
{% endblock %}

{% block scripts %}
	{% if attente and rangs is not empty %}
	<script>
	(function () {
		var panneau = document.querySelector('details.ec-modif');
		var liste = document.getElementById('reperes-saisie');
		var champ = document.getElementById('reperes');
		var images = document.querySelectorAll('.ec-bat-image');
		var reperes = [];
		var MAX = {{ constant('App\\Service\\EspaceClient\\EspaceClient::REPERES_MAX') }};

		function dessiner() {
			document.querySelectorAll('.ec-repere.nouveau').forEach(function (p) { p.remove(); });
			liste.innerHTML = '';
			reperes.forEach(function (r, n) {
				var pastille = document.createElement('span');
				pastille.className = 'ec-repere nouveau';
				pastille.style.left = (r.x * 100) + '%';
				pastille.style.top = (r.y * 100) + '%';
				pastille.textContent = n + 1;
				images[r.cadre].appendChild(pastille);

				var li = document.createElement('li');
				var num = document.createElement('span');
				num.className = 'ec-num';
				num.textContent = n + 1;
				var texte = document.createElement('input');
				texte.className = 'ec-champ';
				texte.maxLength = 200;
				texte.required = true;
				texte.placeholder = 'Que faut-il changer ici ?';
				texte.setAttribute('aria-label', 'Repère ' + (n + 1));
				texte.value = r.t;
				texte.addEventListener('input', function () { r.t = texte.value; });
				var retirer = document.createElement('button');
				retirer.type = 'button';
				retirer.className = 'ec-retirer';
				retirer.setAttribute('aria-label', 'Retirer le repère ' + (n + 1));
				retirer.textContent = '×';
				retirer.addEventListener('click', function () { reperes.splice(n, 1); dessiner(); });
				li.append(num, texte, retirer);
				liste.appendChild(li);
			});
		}

		panneau.addEventListener('toggle', function () {
			document.body.classList.toggle('ec-placer', panneau.open);
			if (panneau.open) { images[0].scrollIntoView({ behavior: 'smooth', block: 'center' }); }
		});
		images.forEach(function (cadre, k) {
			cadre.addEventListener('click', function (ev) {
				if (!panneau.open) { return; }
				if (reperes.length >= MAX) { alert(MAX + ' repères au plus : précisez le reste dans le texte.'); return; }
				var zone = cadre.querySelector('img').getBoundingClientRect();
				var x = (ev.clientX - zone.left) / zone.width;
				var y = (ev.clientY - zone.top) / zone.height;
				if (x < 0 || x > 1 || y < 0 || y > 1) { return; }
				reperes.push({ cadre: k, i: +cadre.dataset.rang, x: Math.round(x * 10000) / 10000, y: Math.round(y * 10000) / 10000, t: '' });
				dessiner();
				var champs = liste.querySelectorAll('input');
				champs[champs.length - 1].focus({ preventScroll: true });
			});
		});
		panneau.closest('form').addEventListener('submit', function () {
			champ.value = JSON.stringify(reperes.filter(function (r) { return r.t.trim() !== ''; }).map(function (r) { return { i: r.i, x: r.x, y: r.y, t: r.t }; }));
		});
	})();
	</script>
	{% endif %}
{% endblock %}
