{#
	Onglets des ecrans de la section courante (NavigationExtension::ONGLETS).
	Rien n'est affiche quand la section n'a qu'un ecran autorise.
#}
{% set rangActif = onglet_actif_admin(routeCourante) %}
{% set onglets = [] %}
{% for rang, onglet in onglets_section_admin(section_admin(routeCourante)) %}
	{% if onglet.role is null or is_granted(onglet.role) %}
		{% set onglets = onglets|merge([onglet|merge({actif: rang == rangActif and rangActif is not null})]) %}
	{% endif %}
{% endfor %}
{% if onglets|length > 1 %}
	<nav class="si-onglets" aria-label="Écrans de la section">
		{% for onglet in onglets %}
			<a href="{{ path(onglet.route, onglet.parametres|default({})) }}" class="{{ onglet.actif ? 'actif' }}" {% if onglet.actif %}aria-current="page"{% endif %}>{{ onglet.libelle }}</a>
		{% endfor %}
	</nav>
{% endif %}
