{#
	Contact (maquette 11) : message court (nom, téléphone, objet, message),
	WhatsApp, adresse, horaires (tuile Horaires) et plan seulement quand le
	lien du plan est réglé (tuile « Site : page Contact »).
#}
{% extends 'site/_site.html.twig' %}

{% set menu_actif = 'app_site_contact' %}
{% set entreprise = site_entreprise() %}
{% set wa = site_whatsapp() %}

{% block title %}Contact · Succès Imprim, imprimerie à Bamako{% endblock %}
{% block description %}Contactez Succès Imprim à Bamako : devis, question sur une commande, conseil sur un fichier. Téléphone, WhatsApp, adresse et horaires de la boutique.{% endblock %}

{% block entete %}
	<link rel="stylesheet" href="{{ asset('css/site-formulaires.css') }}">
{% endblock %}

{% block contenu %}
	{{ include('site/_bandeau.html.twig', {titre: 'Contactez-nous', ariane: 'Contact', accroche: 'Devis, question, conseil : réponse rapide pendant nos horaires d\'ouverture.'}) }}

	<section class="si-section si-contact">
		<div class="si-cadre si-contact-grille">
			<form method="post" action="{{ path('app_site_contact') }}" class="si-carte si-formulaire" novalidate>
				<h2 class="si-formulaire-titre">Écrivez-nous</h2>
				{{ include('site/_demande_protections.html.twig', {nature: 'contact'}) }}

				<div class="si-champs-2">
					{{ include('site/_champ.html.twig', {nom: 'nom', libelle: 'Nom', valeur: saisie.nom, attributs: 'autocomplete="name" maxlength="120" required', exemple: 'Moussa Traoré'}) }}
					{{ include('site/_champ_telephone.html.twig', {valeur: saisie.telephone}) }}
				</div>

				<div class="si-champ{{ erreurs.objet is defined ? ' si-champ-erreur' }}">
					<label for="champ-objet">Objet</label>
					<select id="champ-objet" name="objet">
						{% for cle, libelle in objets %}
							<option value="{{ cle }}"{% if cle == saisie.objet %} selected{% endif %}>{{ libelle }}</option>
						{% endfor %}
					</select>
					{% if site_lien('app_site_devis') %}
						<p class="si-aide" id="aide-objet">Pour un prix précis, le <a href="{{ path('app_site_devis') }}">formulaire de devis</a> demande la taille, la quantité et le fichier.</p>
					{% endif %}
				</div>

				<div class="si-champ{{ erreurs.message is defined ? ' si-champ-erreur' }}">
					<label for="champ-message">Message</label>
					<textarea id="champ-message" name="message" rows="5" maxlength="{{ constant('App\\Entity\\DemandeDevis::MESSAGE_MAX') }}" placeholder="Bonjour, je souhaite une enseigne pour ma boutique…" required{% if erreurs.message is defined %} aria-invalid="true" aria-describedby="erreur-message"{% endif %}>{{ saisie.message }}</textarea>
					{% if erreurs.message is defined %}<p class="si-erreur" id="erreur-message">{{ erreurs.message }}</p>{% endif %}
				</div>

				<div class="si-formulaire-actions">
					<button type="submit" class="si-bouton si-bouton-rouge si-bouton-grand">Envoyer</button>
					{% if wa %}
						<a href="{{ wa }}" class="si-bouton si-bouton-wa si-bouton-grand" target="_blank" rel="noopener">
							{{ include('site/_icone_whatsapp.svg.twig') }}
							Écrire sur WhatsApp
						</a>
					{% endif %}
				</div>
				<p class="si-note">Votre nom et votre numéro servent seulement à vous répondre.</p>
			</form>

			<div class="si-contact-infos">
				{% if lienPlan %}
					<a href="{{ lienPlan }}" class="si-plan" target="_blank" rel="noopener" aria-label="Voir l'itinéraire jusqu'à la boutique (s'ouvre dans une autre fenêtre)">
						<svg viewBox="0 0 560 200" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
							<rect width="560" height="200" fill="#EEF2F8"/>
							<g stroke="#D7DEEA" stroke-width="1.5">
								{% for x in range(0, 560, 46) %}<line x1="{{ x }}" y1="0" x2="{{ x }}" y2="200"/>{% endfor %}
								{% for y in range(0, 200, 40) %}<line x1="0" y1="{{ y }}" x2="560" y2="{{ y }}"/>{% endfor %}
							</g>
							<path d="M-10 190 L570 70" stroke="#fff" stroke-width="22"/>
							<path d="M180 -10 L250 210" stroke="#fff" stroke-width="12"/>
							<g transform="translate(262 52)">
								<ellipse cx="0" cy="44" rx="12" ry="4" fill="rgba(0,0,0,.15)"/>
								<path d="M0 44C-4 34-18 22-18 8a18 18 0 0 1 36 0c0 14-14 26-18 36Z" fill="#DE1028"/>
								<circle cx="0" cy="8" r="6" fill="#fff"/>
							</g>
						</svg>
						<span class="si-bouton si-bouton-bleu">
							<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21.7 11.3 12.7 2.3a1 1 0 0 0-1.4 0l-9 9a1 1 0 0 0 0 1.4l9 9a1 1 0 0 0 1.4 0l9-9a1 1 0 0 0 0-1.4ZM14 14.5V12h-4v3H8v-4a1 1 0 0 1 1-1h5V7.5l3.5 3.5Z"/></svg>
							Itinéraire
						</span>
					</a>
				{% endif %}

				<div class="si-contact-cartes">
					<div class="si-carte si-info">
						<svg class="si-info-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a7 7 0 0 0-7 7c0 5.2 7 13 7 13s7-7.8 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>
						<div>
							<h2>Adresse</h2>
							<p>Boutique {{ entreprise.nomAffiche ?? 'Succès Imprim' }}<br>{{ (entreprise.adresse ?? null) ?: 'Bamako, Mali' }}</p>
							{% if lienPlan %}<p><a href="{{ lienPlan }}" target="_blank" rel="noopener">Itinéraire</a></p>{% endif %}
						</div>
					</div>
					<div class="si-carte si-info">
						<svg class="si-info-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Zm.5-13H11v6l5.2 3.2.8-1.3-4.5-2.7Z"/></svg>
						<div>
							<h2>Horaires</h2>
							<p>{{ horaires.texte }}<br>WhatsApp aux heures d'ouverture</p>
							<p class="si-ouvert{{ horaires.ouvert ? ' si-ouvert-oui' }}"><span aria-hidden="true"></span>{{ horaires.etat }}</p>
						</div>
					</div>
					{% if entreprise and (entreprise.telephone or entreprise.email) %}
						<div class="si-carte si-info">
							<svg class="si-info-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.2 11.4 11.4 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.6 3.6a1 1 0 0 1-.3 1Z"/></svg>
							<div>
								<h2>Téléphone et e-mail</h2>
								<p>
									{% if entreprise.telephone %}<a href="tel:{{ entreprise.telephone|replace({' ': ''}) }}">{{ entreprise.telephone }}</a>{% endif %}
									{% if entreprise.telephone and entreprise.email %}<br>{% endif %}
									{% if entreprise.email %}<a href="mailto:{{ entreprise.email }}">{{ entreprise.email }}</a>{% endif %}
								</p>
							</div>
						</div>
					{% endif %}
					{% if site_lien('app_site_devis') %}
						<div class="si-carte si-info si-info-devis">
							<svg class="si-info-icone" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Zm-1 7V3.5L18.5 9ZM8 13h8v2H8Zm0 4h5v2H8Z"/></svg>
							<div>
								<h2>Besoin d'un devis ?</h2>
								<p>Taille, quantité, finitions et fichier : nous préparons votre devis.</p>
								<p><a href="{{ path('app_site_devis') }}" class="si-lien-fleche">Demander un devis</a></p>
							</div>
						</div>
					{% endif %}
				</div>
			</div>
		</div>
	</section>
{% endblock %}
