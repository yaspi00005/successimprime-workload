{% extends 'achats/_base.html.twig' %}
{% import 'achats/_macros.html.twig' as m %}

{% block title %}{{ fournisseur.nomCourt }}{% endblock %}

{% block header_actions %}
	{% if fournisseur.numeroWhatsapp %}
		<li class="nav-item">
			<a href="https://wa.me/{{ fournisseur.numeroWhatsapp }}" target="_blank" rel="noopener" class="btn btn-light btn-sm si-btn-entete"><i class="fab fa-whatsapp me-1"></i>WhatsApp</a>
		</li>
	{% endif %}
	{% if fournisseur.actif %}
		<li class="nav-item">
			<a href="{{ path('app_achat_new', {fournisseur: fournisseur.id}) }}" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Commande d'achat</a>
		</li>
	{% endif %}
{% endblock %}

{% block body %}
	<div class="ac-page">

		<div class="ac-grille">
			<div>
				<section class="ac-carte" aria-label="Identité et conditions">
					<div class="ac-identite">
						{{ m.avatar(fournisseur, true) }}
						<div>
							<h2>{{ fournisseur.nomCourt }}</h2>
							<p>{{ [fournisseur.fournit, fournisseur.origine]|filter(v => v)|join(' · ') ?: 'Fiche à compléter' }}</p>
						</div>
					</div>
					<div class="ac-ligne"><span>Contact</span><b>{{ [fournisseur.contactNom, fournisseur.contactTelephone ?? fournisseur.telephone]|filter(v => v)|join(' · ') ?: '—' }}</b></div>
					{% if fournisseur.email %}<div class="ac-ligne"><span>E-mail</span><b>{{ fournisseur.email }}</b></div>{% endif %}
					<div class="ac-ligne"><span>Paiement</span><b>{{ fournisseur.conditionsPaiement ?? (fournisseur.acomptePourcentage > 0 ? fournisseur.acomptePourcentage ~ ' % à la commande' : '—') }}</b></div>
					<div class="ac-ligne"><span>Transport</span><b>{{ fournisseur.transport ?? '—' }}</b></div>
					<div class="ac-ligne"><span>Délai promis</span><b>{{ fournisseur.delaiPromisJours is not null ? fournisseur.delaiPromisJours ~ ' jour' ~ (fournisseur.delaiPromisJours > 1 ? 's') : '—' }}</b></div>
					<div class="ac-ligne"><span>Délai réel moyen</span><b class="{{ conseil ? 'ac-rouge' }}">{{ stats.delaiReel is not null ? m.jours(stats.delaiReel)|replace({' j': ' jours'}) : '—' }}</b></div>
					{% if du and is_granted('ROLE_TRESORERIE_VOIR') %}
						<div class="ac-ligne"><span>Dû</span><b class="ac-bleu">{{ m.f(du.du) }}{{ du.echeance ? ' · échéance ' ~ du.echeance|date('d/m') }}</b></div>
					{% endif %}
					{% if not fournisseur.actif %}<p class="ac-note ac-rouge">Fournisseur désactivé : il n'est plus proposé dans les commandes.</p>{% endif %}
				</section>

				<section class="ac-carte" aria-label="Performance sur 12 mois">
					<h2>Performance sur 12 mois</h2>
					<div class="ac-perf">
						<div>
							<b class="{{ stats.aLHeure is null ? '' : (stats.aLHeure < 80 ? 'ac-rouge' : (stats.aLHeure < 90 ? 'ac-jaune' : 'ac-vert')) }}">{{ stats.aLHeure is not null ? stats.aLHeure ~ ' %' : '—' }}</b>
							<small>à l'heure</small>
						</div>
						<div>
							<b class="{{ stats.retardMoyen ? 'ac-rouge' : 'ac-vert' }}">{{ stats.retardMoyen is not null ? '+' ~ m.jours(stats.retardMoyen) : '—' }}</b>
							<small>retard moyen</small>
						</div>
						<div>
							<b class="{{ stats.abime ? 'ac-jaune' : 'ac-vert' }}">{{ stats.abime is not null ? stats.abime|number_format(1, ',', ' ') ~ ' %' : '—' }}</b>
							<small>marchandise abîmée</small>
						</div>
						<div>
							<b>{{ stats.commandes }}</b>
							<small>commande{{ stats.commandes > 1 ? 's' }}</small>
						</div>
					</div>
				</section>

				{% if conseil %}
					<div class="ac-conseil"><b>Conseil :</b> les livraisons arrivent en {{ conseil.reel }} jours en moyenne, pas en {{ conseil.promis }}{{ fournisseur.transport ? ' (' ~ fournisseur.transport ~ ')' }}. Compter {{ conseil.reel }} jours, pas {{ conseil.promis }}, dans les alertes : c'est ce que fait déjà la prochaine commande calculée.</div>
				{% endif %}

				<div class="ac-actions-pied mb-3">
					<form method="post" action="{{ path('app_fournisseur_toggle_actif', {id: fournisseur.id}) }}">
						<input type="hidden" name="_token" value="{{ csrf_token('toggle_actif' ~ fournisseur.id) }}">
						<button type="submit" class="ac-bouton">{{ fournisseur.actif ? 'Désactiver' : 'Réactiver' }}</button>
					</form>
					<a href="{{ path('app_fournisseur_edit', {id: fournisseur.id}) }}" class="ac-bouton">Modifier la fiche</a>
				</div>
			</div>

			<div>
				<section class="ac-carte" aria-label="Produits achetés">
					<h2>Produits achetés et évolution du prix</h2>
					{% if produits is empty %}
						<p class="ac-muet mb-0">Aucun article lié à ce fournisseur. Ajoutez-le sur la fiche article (Stock et achats › Articles et stock).</p>
					{% else %}
						<div class="ac-defile">
							<table class="ac-table">
								<thead>
									<tr><th>Produit</th><th>Unité</th><th class="num">Dernier prix</th><th>12 mois</th><th class="num">Variation</th><th class="num">Coût rendu Bamako</th></tr>
								</thead>
								<tbody>
									{% for p in produits %}
										{% set a = p.article %}
										{% set couleur = p.variation is null or p.variation == 0 ? '#1F9D55' : (p.variation > 0 ? '#DE1028' : '#1F9D55') %}
										<tr>
											<td class="ac-produit"><a class="ac-lien" href="{{ path('app_stock_articles_fiche', {id: a.id}) }}">{{ a.designation|split(' · ')|first }}</a>{% if ' · ' in a.designation %}<br><small class="ac-muet">{{ a.designation|split(' · ')|slice(1)|join(' · ') }}</small>{% endif %}</td>
											<td class="ac-muet ac-unite">{{ a.uniteAchat ?? a.uniteCourte }}{% if a.longueurUniteAchat %} {{ m.q(a.longueurUniteAchat) }} m{% elseif a.facteurConversion != 1 %} de {{ m.q(a.facteurConversion) }} {{ a.uniteCourte }}{% endif %}</td>
											<td class="num"><b>{{ m.f(p.dernierPrix) }}</b></td>
											<td>{% if p.points %}<svg class="ac-courbe" viewBox="0 0 90 24" role="img" aria-label="Prix sur 12 mois"><polyline points="{{ p.points }}" stroke="{{ couleur }}"/></svg>{% else %}<span class="ac-muet">—</span>{% endif %}</td>
											<td class="num"><b class="{{ p.variation is null ? '' : (p.variation > 0 ? 'ac-rouge' : 'ac-vert') }}">{{ p.variation is null ? '—' : (p.variation > 0 ? '+' : '') ~ p.variation ~ ' %' }}</b></td>
											<td class="num"><b>{{ p.coutRendu is not null ? p.coutRendu|number_format(0, ',', ' ') ~ ' F/' ~ a.uniteCourte : '—' }}</b></td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
						<p class="ac-note">Coût rendu = prix d'achat + transport + transit, ramené à l'unité de stock (m², litre…), sur la dernière commande.</p>
					{% endif %}
				</section>

				<section class="ac-carte" aria-label="Commandes">
					<h2>Commandes</h2>
					{% if commandes is empty %}
						<p class="ac-muet mb-0">Aucune commande pour l'instant.</p>
					{% else %}
						<div class="ac-defile">
							<table class="ac-table">
								<thead>
									<tr><th>N°</th><th>Date</th><th class="num">Montant rendu</th><th>Promis</th><th>Reçu</th><th>Écart</th></tr>
								</thead>
								<tbody>
									{% for c in commandes %}
										<tr>
											<td><a class="ac-lien" href="{{ path('app_achat_show', {id: c.achat.id}) }}">{{ c.achat.numero ?? 'Brouillon' }}</a></td>
											<td class="ac-muet">{{ c.date|date('d/m/y') }}</td>
											<td class="num"><b>{{ m.f(c.achat.totalRendu) }}</b></td>
											<td class="ac-muet">{{ c.achat.datePromise ? c.achat.datePromise|date('d/m') : '—' }}</td>
											<td class="ac-muet">{{ c.achat.dateReception ? c.achat.dateReception|date('d/m') : '—' }}</td>
											<td><span class="ac-badge {{ c.ecart.classe }}">{{ c.ecart.libelle }}</span></td>
										</tr>
									{% endfor %}
								</tbody>
							</table>
						</div>
					{% endif %}
				</section>
			</div>
		</div>
	</div>
{% endblock %}
