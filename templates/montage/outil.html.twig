    if(S.bleed>0){if(!G.missing)ck.push(['ok','Fond perdu présent',`${fmtN(Math.min(G.ebx,G.eby))} mm de dessin au-delà de la coupe.`]);
      else if(G.enl>1){bump('warn');ck.push(['warn',`Fond perdu créé en agrandissant de ${fmtN((G.enl-1)*100)} %`,'Le bord du dessin est légèrement rogné. Vérifiez qu\'aucun texte n\'est trop près du bord.'])}
      else if(G.mirrorExt){ck.push(['ok','Fond perdu créé par miroir des bords','Les bords de l\'image sont prolongés en miroir, sans rien rogner.'])}
      else if(!G.contain){bump('warn');ck.push(['warn','Fond perdu absent dans le fichier','Un filet blanc peut apparaître à la coupe. Choisissez « Agrandir » ou « Miroir des bords ».'])}
