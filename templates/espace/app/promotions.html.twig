{% extends 'espace/app/_app.html.twig' %}

{#
	Mes promotions (docs/promotions.md) : celles en cours qui concernent ce
	client et lui seul. Nom, articles, période, avantage et conditions ; ni
	code promo ni note interne. Lecture seule : la remise se pose d'elle-même
	sur la commande prise à l'atelier.
#}

{% block title %}Mes promotions{% endblock %}
{% block entete %}<a class="ec-retour" href="{{ path('app_espace_compte') }}"><span class="fl">‹</span>Mes promotions</a>{% endblock %}

{% block contenu %}
	{% if b2b %}
		<div class="ec-carte ec-vide">Vos prix de revendeur sont fixés avec Succès Imprim : les promotions ne s'y ajoutent pas.</div>
	{% elseif promotions is empty %}
		<div class="ec-carte ec-vide">Aucune promotion en cours pour vous en ce moment.</div>
	{% else %}
		{% for p in promotions %}
			<div class="ec-carte">
				<div class="ec-ligne" style="align-items:flex-start">
					<h2 style="margin:0">{{ p.nom }}</h2>
					<span class="ec-pastille {{ p.estAnniversaire ? 'ambre' : 'vert' }}">{{ p.libelleAvantage }}</span>
				</div>
				<ul class="ec-liste" style="margin-top:.5rem">
					<li class="ec-ligne"><span class="ec-petit">Articles</span><span style="text-align:right">{{ p.libelleArticles }}</span></li>
					<li class="ec-ligne"><span class="ec-petit">Période</span><span>du {{ p.debut|date('d/m/Y') }} au {{ p.fin|date('d/m/Y') }}</span></li>
					{% if p.quantiteMin or p.montantMin or p.utilisationsParClient %}
						<li class="ec-ligne"><span class="ec-petit">Conditions</span><span style="text-align:right">
							{{- [
								p.quantiteMin ? 'dès ' ~ p.quantiteMin|number_format(0, ',', ' ') ~ ' unités' : null,
								p.montantMin ? 'ligne de ' ~ p.montantMin|number_format(0, ',', ' ') ~ ' F au moins' : null,
								p.utilisationsParClient ? (p.utilisationsParClient == 1 ? 'une commande' : p.utilisationsParClient ~ ' commandes') ~ ' au plus' : null,
							]|filter(v => v)|join(' · ') -}}
						</span></li>
					{% endif %}
				</ul>
			</div>
		{% endfor %}
		<p class="ec-petit" style="margin:.2rem .2rem 0">L'atelier pose la remise sur votre commande quand il en confirme le prix : rien à demander.</p>
	{% endif %}
{% endblock %}
