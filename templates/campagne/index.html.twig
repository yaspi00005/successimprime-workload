{% extends 'base.html.twig' %}

{% set canaux = {whatsapp: 'WhatsApp', sms: 'SMS', email: 'E-mail'} %}

{% block title %}Campagnes WhatsApp et SMS{% endblock %}

{% block header_actions %}
	<li class="nav-item si-masque-mobile">
		<a href="{{ path('app_modele_message_index') }}" class="btn btn-light btn-sm si-btn-entete">Modèles</a>
	</li>
	<li class="nav-item">
		<a href="#si-campagne-form" class="btn btn-danger btn-sm si-btn-entete" data-si-focus="nom"><i class="fas fa-plus me-1"></i>Nouvelle campagne</a>
	</li>
{% endblock %}

{% block body %}
	<div class="si-campagnes">
		<section class="card si-campagne-nouvelle">
			<form id="si-campagne-form" method="post" action="{{ path('app_campagne_programmer') }}" data-comptes="{{ comptes|json_encode }}">
				<input type="hidden" name="_token" value="{{ csrf_token('campagne_programmer') }}">
				<h2><label for="si-campagne-nom">Nouvelle campagne</label> · <input id="si-campagne-nom" name="nom" type="text" maxlength="255" required placeholder="Nom, ex. Rentrée scolaire" class="si-campagne-nom"></h2>

				<div class="si-campagne-grille">
					<label class="si-campagne-champ">
						<span>Segment</span>
						<select name="segment" class="form-select" data-si-segment>
							{% for cle, libelle in constant('App\\Service\\SegmentsClients::SEGMENTS') %}
								<option value="{{ cle }}" {{ cle == 'tous' ? 'selected' }}>{{ libelle }}</option>
							{% endfor %}
						</select>
					</label>
					<fieldset class="si-campagne-champ">
						<legend>Canal</legend>
						<div class="si-campagne-canaux">
							{% for cle, libelle in canaux %}
								<label class="si-pilule">
									<input type="radio" name="canal" value="{{ cle }}" {{ loop.first ? 'checked' }}>
									<span>{{ libelle }}</span>
								</label>
							{% endfor %}
						</div>
					</fieldset>
				</div>

				<label class="si-campagne-champ">
					<span>Message</span>
					<textarea name="message" rows="5" class="form-control" required maxlength="1000" data-si-message>Bonjour {prénom} 👋 C'est la rentrée chez Succès Imprim : banderoles, roll-up et t-shirts DTF pour votre établissement. Demandez votre devis : succesimprim.com</textarea>
				</label>
				<p class="si-campagne-aide">
					<span>Variables : {prénom}, {nom}, {entreprise}.</span>
					<span data-si-longueur></span>
				</p>
				<p class="si-campagne-alerte" data-si-whatsapp-manuel {{ whatsapp_api ? 'hidden' }}>
					<i class="fab fa-whatsapp"></i> L’API WhatsApp n’est pas encore branchée : la campagne prépare un lien par client, à ouvrir depuis la page de la campagne.
				</p>

				<div class="si-campagne-grille">
					<label class="si-campagne-champ">
						<span>Envoi</span>
						<input type="datetime-local" name="envoi" class="form-control" min="{{ 'now'|date('Y-m-d\\TH:i') }}">
						<small>Vide : envoi tout de suite.</small>
					</label>
					<label class="si-campagne-champ">
						<span>Consentement</span>
						<select name="consentement" class="form-select" data-si-consentement>
							{% for cle, libelle in constant('App\\Service\\SegmentsClients::CONSENTEMENTS') %}
								<option value="{{ cle }}">{{ cle == 'accepte' ? '✓ ' }}{{ libelle }}</option>
							{% endfor %}
						</select>
					</label>
				</div>

				<div class="si-campagne-actions">
					<button type="submit" class="btn btn-success">Programmer l’envoi</button>
					<strong data-si-destinataires></strong>
				</div>
			</form>
		</section>

		<section class="card si-campagne-resultats">
			<h2>Résultats des campagnes</h2>
			{% if campagnes is empty %}
				<p class="si-campagne-vide">Aucune campagne pour l’instant.</p>
			{% else %}
				<table class="table si-campagne-table">
					<thead>
						<tr>
							<th>Campagne</th>
							<th class="text-end">Envoyés</th>
							<th class="text-end">Devis</th>
							<th class="text-end">Cdes</th>
						</tr>
					</thead>
					<tbody>
						{% for c in campagnes %}
							{% set r = resultats[c.id] %}
							<tr>
								<td>
									<a href="{{ path('app_campagne_show', {id: c.id}) }}">{{ c.nom }}</a>
									<small>
										{{ canaux[c.canal]|default(c.canal) }} ·
										{% if c.estProgrammee(date()) %}programmée le {{ c.envoiPrevuLe|date('d/m à H\\hi') }}
										{% elseif c.statut == 'terminee' %}terminée
										{% else %}{{ r.en_attente }} en attente{% endif %}
									</small>
								</td>
								<td class="text-end">{{ r.envoyes }}</td>
								<td class="text-end">{{ r.devis }}</td>
								<td class="text-end">{{ r.commandes }}</td>
							</tr>
						{% endfor %}
					</tbody>
				</table>
				{% if meilleure %}
					{% set m = campagnes|filter(c => c.id == meilleure)|first %}
					<div class="si-campagne-meilleure">
						<span>Meilleure campagne</span>
						<strong>{{ m.nom }} · {{ resultats[meilleure].devis }} devis, {{ resultats[meilleure].commandes }} commande{{ resultats[meilleure].commandes > 1 ? 's' }}</strong>
					</div>
				{% endif %}
				<p class="si-campagne-note">Devis et commandes des destinataires dans les {{ constant('App\\Service\\ResultatsCampagnes::JOURS_EFFET') }} jours qui suivent l’envoi. Les lectures s’afficheront avec l’API WhatsApp.</p>
			{% endif %}
			<a href="{{ path('app_campagne_new') }}" class="si-campagne-lien">Envoyer à une liste choisie à la main</a>
		</section>
	</div>

	<script>
		(() => {
			const form = document.getElementById('si-campagne-form');
			const comptes = JSON.parse(form.dataset.comptes);
			const sortie = form.querySelector('[data-si-destinataires]');
			const longueur = form.querySelector('[data-si-longueur]');
			const majCompte = () => {
				const canal = form.elements.canal.value;
				const n = comptes[form.elements.segment.value]?.[canal]?.[form.elements.consentement.value] ?? 0;
				sortie.textContent = `${n} destinataire${n > 1 ? 's' : ''}`;
				sortie.classList.toggle('text-danger', n === 0);
				form.querySelector('[data-si-whatsapp-manuel]').hidden = {{ whatsapp_api ? 'true' : 'false' }} || canal !== 'whatsapp';
				const texte = form.elements.message.value;
				longueur.textContent = canal === 'sms' ? `${texte.length} caractères · ${Math.max(1, Math.ceil(texte.length / 153))} SMS` : `${texte.length} caractères`;
			};
			form.addEventListener('input', majCompte);
			form.addEventListener('change', majCompte);
			majCompte();
			document.querySelector('[data-si-focus]')?.addEventListener('click', () => setTimeout(() => form.elements.nom.focus(), 50));
		})();
	</script>
{% endblock %}
