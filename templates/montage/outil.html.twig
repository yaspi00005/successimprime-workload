// source image (with optional mirrored bleed) for preview & export
const mirrorCache={};
function sourceFor(F,G){
  if(!G||!G.mirrorExt||!F.img)return {url:F.url,nw:G?G.nw:0,nh:G?G.nh:0,ext:0};
  const pxPerMm=F.pxW/G.nw;const e=Math.ceil(G.mirrorExt*pxPerMm);const key=F.id+':'+e;
  if(!mirrorCache[key]){const c=document.createElement('canvas');c.width=F.pxW+2*e;c.height=F.pxH+2*e;const x=c.getContext('2d');const im=F.img,W=F.pxW,H=F.pxH;
    x.drawImage(im,e,e);
    const strip=(sx,sy,sw,sh,dx,dy,fx,fy)=>{x.save();x.translate(dx+(fx?sw:0),dy+(fy?sh:0));x.scale(fx?-1:1,fy?-1:1);x.drawImage(im,sx,sy,sw,sh,0,0,sw,sh);x.restore()};
    strip(0,0,e,H,0,e,1,0);strip(W-e,0,e,H,W+e,e,1,0);strip(0,0,W,e,e,0,0,1);strip(0,H-e,W,e,e,H+e,0,1);
    strip(0,0,e,e,0,0,1,1);strip(W-e,0,e,e,W+e,0,1,1);strip(0,H-e,e,e,0,H+e,1,1);strip(W-e,H-e,e,e,W+e,H+e,1,1);
    mirrorCache[key]={url:c.toDataURL('image/png'),canvas:c};}
  const mm=e/pxPerMm;return {url:mirrorCache[key].url,canvas:mirrorCache[key].canvas,nw:G.nw+2*mm,nh:G.nh+2*mm,ext:mm};
}

/* ---------- preview ---------- */
function cellAngle(L,side){return L.rot?(side==='verso'?90:-90):0}
function render(L,G,side){
  const pad=16;const W=L.W,H=L.H;const F=files[side];const Gs=side==='verso'?geom(files.verso):G;
  const src=F&&Gs?sourceFor(F,Gs):null;
  let s=`<svg viewBox="${-pad} ${-pad} ${W+2*pad} ${H+2*pad}" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Aperçu du montage ${L.n} poses sur feuille ${fmtN(W,0)} × ${fmtN(H,0)} mm">`;
  s+=`<defs>`;if(src)s+=`<image id="art" href="${src.url}" x="${-src.nw/2}" y="${-src.nh/2}" width="${src.nw}" height="${src.nh}" preserveAspectRatio="none"/>`;
  const cs=cells(L);cs.forEach((c,i)=>{s+=`<clipPath id="cl${i}"><rect x="${c.clip.x}" y="${c.clip.y}" width="${c.clip.x2-c.clip.x}" height="${c.clip.y2-c.clip.y}"/></clipPath>`});s+=`</defs>`;
  s+=`<rect x="0.6" y="0.9" width="${W}" height="${H}" fill="#000" opacity=".18"/><rect x="0" y="0" width="${W}" height="${H}" fill="var(--sheet)"/>`;
  s+=`<rect x="${S.margin}" y="${S.margin}" width="${W-2*S.margin}" height="${H-2*S.margin}" fill="none" stroke="#9aa3b2" stroke-width=".35" stroke-dasharray="2 1.5"/>`;
  if(L.n>0){s+=`<rect x="${L.x0-S.bleed}" y="${L.y0-S.bleed}" width="${L.bw}" height="${L.bh}" fill="var(--bleed)"/>`;
    const ang=cellAngle(L,side);const m=S.mirror?-1:1;const dxv=side==='verso'?-S.dx:S.dx;
    cs.forEach((c,i)=>{const cx=c.x+c.w/2,cy=c.y+c.h/2;
      if(src){s+=`<g clip-path="url(#cl${i})"><g transform="translate(${cx} ${cy}) rotate(${ang}) translate(${dxv} ${S.dy}) scale(${m} 1) rotate(${S.frot})"><use href="#art"/></g></g>`}
      else s+=`<rect x="${c.x}" y="${c.y}" width="${c.w}" height="${c.h}" fill="#e8eef9" stroke="#b8c4da" stroke-width=".3"/>`;});
    if(S.guides){cs.forEach(c=>{s+=`<rect x="${c.x}" y="${c.y}" width="${c.w}" height="${c.h}" fill="none" stroke="var(--cut)" stroke-width=".3" stroke-dasharray="1.2 .8"/>`})}
    marks(L).forEach(l=>{s+=`<line x1="${l[0]}" y1="${l[1]}" x2="${l[2]}" y2="${l[3]}" stroke="#14213d" stroke-width=".25"/>`});
    // cotes
    const c0=cs[0];s+=`<g font-family="Figtree,system-ui,sans-serif" font-size="3.6" fill="#5b6478">`;
    s+=`<line x1="0" y1="${-8}" x2="${W}" y2="${-8}" stroke="#7b8599" stroke-width=".25"/><line x1="0" y1="-10" x2="0" y2="-6" stroke="#7b8599" stroke-width=".25"/><line x1="${W}" y1="-10" x2="${W}" y2="-6" stroke="#7b8599" stroke-width=".25"/>`;
    s+=`<text x="${W/2}" y="-10" text-anchor="middle" fill="currentColor" style="fill:#7b8599">${fmtN(W,0)} mm</text>`;
    s+=`<line x1="-8" y1="0" x2="-8" y2="${H}" stroke="#7b8599" stroke-width=".25"/><text x="-10" y="${H/2}" text-anchor="middle" transform="rotate(-90 -10 ${H/2})" style="fill:#7b8599">${fmtN(H,0)} mm</text>`;
    s+=`<text x="${c0.x+c0.w/2}" y="${c0.y-1.4-(S.cut==='common'||S.bleed>0?S.bleed:0)}" text-anchor="middle" font-size="3.2" style="fill:#7b8599">${fmtN(c0.w)} mm</text>`;
    s+=`</g>`;}
  else{s+=`<text x="${W/2}" y="${H/2}" text-anchor="middle" font-size="9" font-family="Archivo,Arial,sans-serif" font-weight="800" style="fill:#c81d34">Ne tient pas</text>`}
  s+=`</svg>`;return s;
}
function marks(L){
  if(!L.n)return [];const out=[];const off=1.5,len=5;const top=L.y0-S.bleed,bot=L.y0-S.bleed+L.bh,left=L.x0-S.bleed,right=L.x0-S.bleed+L.bw;
  const xs=new Set(),ys=new Set();for(let c=0;c<L.cols;c++){const x=L.x0+c*(L.cw+L.e);xs.add(+x.toFixed(3));xs.add(+(x+L.cw).toFixed(3))}
  for(let r=0;r<L.rows;r++){const y=L.y0+r*(L.ch+L.e);ys.add(+y.toFixed(3));ys.add(+(y+L.ch).toFixed(3))}
  const lim=S.margin;const tl=Math.min(len,top-off-lim),bl=Math.min(len,L.H-lim-(bot+off)),ll=Math.min(len,left-off-lim),rl=Math.min(len,L.W-lim-(right+off));
  xs.forEach(x=>{if(tl>0.5)out.push([x,top-off-tl,x,top-off]);if(bl>0.5)out.push([x,bot+off,x,bot+off+bl])});
  ys.forEach(y=>{if(ll>0.5)out.push([left-off-ll,y,left-off,y]);if(rl>0.5)out.push([right+off,y,right+off+rl,y])});
