<!doctype html>
<html lang="fr">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>Étiquettes {{ livraison.numero }}</title>
	<link href="{{ asset('css/poste-machiniste.css') }}" rel="stylesheet">
	<style>
		@page { size: 100mm 70mm; margin: 0; }
		body { margin: 0; background: #E2E8F0; font-family: system-ui, sans-serif; }
		.pages { display: flex; flex-direction: column; align-items: center; gap: 8mm; padding: 8mm; }
		.si-pm-etq { box-shadow: none; border-radius: 0; }
		@media print {
			body { background: #fff; }
			.pages { padding: 0; gap: 0; }
			.si-pm-etq { border: 0; page-break-after: always; break-after: page; }
			.si-pm-etq:last-child { page-break-after: auto; break-after: auto; }
		}
	</style>
</head>
<body>
	<div class="pages">
		{% for n in 1..colis %}
			{% include 'ma_file/_etiquette.html.twig' with {n: n, total: colis} %}
		{% endfor %}
	</div>
	<script>window.addEventListener('load', () => window.print());</script>
</body>
</html>
