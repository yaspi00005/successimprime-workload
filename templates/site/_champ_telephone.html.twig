{#
	Téléphone malien à 8 chiffres (+223 affiché devant), avec son erreur.
	Variable : valeur.
#}
{% set erreur = erreurs.telephone ?? null %}
<div class="si-champ{{ erreur ? ' si-champ-erreur' }}">
	<label for="champ-telephone">Téléphone</label>
	<div class="si-tel">
		<span aria-hidden="true">+223</span>
		<input type="tel" id="champ-telephone" name="telephone" value="{{ valeur }}" placeholder="7X XX XX XX" inputmode="tel" autocomplete="tel-national" maxlength="20" required{% if erreur %} aria-invalid="true" aria-describedby="erreur-telephone"{% endif %}>
	</div>
	{% if erreur %}<p class="si-erreur" id="erreur-telephone">{{ erreur }}</p>{% endif %}
</div>
