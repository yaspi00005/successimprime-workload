            }) }}

		</div>


		{# ====================================================
																																																																           QUANTITÉ / DIMENSIONS / PRIX
																																																																           ==================================================== #}

		<div class="travail-section">

			<div class="travail-section-title">
				<i class="fa fa-calculator"></i>
				Dimensions, quantité et prix
			</div>

			<div class="row">

				<div class="col-lg-3 js-zone-largeur">

					{{ form_row(detail.largeur, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'largeur',

                            min: 0,
                            step: '0.01'
                        }
                    }) }}

				</div>


				<div class="col-lg-3 js-zone-longueur">

					{{ form_row(detail.longueur, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'longueur',

                            min: 0,
                            step: '0.01'
                        }
                    }) }}

				</div>


				<div class="d-none js-zone-surface">

					{{ form_row(detail.surface, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'surface',

                            readonly: true
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.quantite, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'quantite',

                            min: 1
                        }
                    }) }}

					<small class="form-text text-muted
																																																																																																																																																																																																                        js-message-quantite"></small>

				</div>


				<div class="col-lg-3 js-zone-nombre-faces">

					{{ form_row(detail.nombreFaces, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'nombreFaces',

                            min: 1
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.modeCalcul, {
                        label:
                            'Mode de calcul',

                        attr: {
                            class:
                                'form-control js-mode-calcul js-calcul-detail',

                            'data-detail-field':
                                'modeCalcul'
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.prixUnitaire, {
                        label:
                            'Prix unitaire',

                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'prixUnitaire',

                            min: 0
                        }
                    }) }}

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.remise, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'remise',

                            min: 0
                        }
                    }) }}

					<small class="form-text text-muted js-remise-totale-detail">
						Remise totale : —
					</small>

				</div>


				<div class="col-lg-3">

					{{ form_row(detail.tva, {
                        attr: {
                            class:
                                'form-control js-calcul-detail',

                            'data-detail-field':
                                'tva',

                            min: 0
                        }
                    }) }}

				</div>


				<div class="d-none">

					{{ form_row(detail.totalHt, {
                        attr: {
                            'data-detail-field':
                                'totalHt',

                            readonly: true
                        }
                    }) }}

				</div>


				<div class="d-none">

					{{ form_row(detail.totalTtc, {
                        attr: {
                            'data-detail-field':
                                'totalTtc',

                            readonly: true
                        }
                    }) }}

				</div>

			</div>

			{# Petites pièces facturées au m² (docs/saisie-devis-commandes.md). #}
			{{ include('partials/_pieces_m2_ligne.html.twig', {detail: detail}) }}

			{#
				Promotion de la ligne (docs/promotions.md) : affichée par
				public/js/promotions-saisie.js, recalculée par le serveur à
				l'enregistrement. La case cachée garde le choix de l'agent de
				la retirer ; la classe js-calcul-detail relance le calcul.
			#}
			{% set ligneEnregistree = detail.vars.data %}
			<div hidden>{{ form_widget(detail.promotionRetiree) }}</div>
			<div class="si-pr-ligne js-promo-ligne js-calcul-detail" data-ligne="{{ ligneEnregistree ? ligneEnregistree.id }}" data-remise-promotion="{{ ligneEnregistree ? ligneEnregistree.remisePromotion : 0 }}" data-libelle="{{ ligneEnregistree ? ligneEnregistree.libellePromotion }}"></div>

			<div class="si-resume-ligne js-resume-ligne"></div>
			{% if ligneEnregistree and ligneEnregistree.totalFige %}<small class="d-block text-muted" title="Ligne d'avant la nouvelle version : son total enregistré reste tant que la quantité, le prix, la remise, les dimensions et les finitions ne changent pas. L'aperçu ci-dessus refait le calcul ; le total enregistré, lui, ne bouge pas.">Total d'origine conservé : recalculé seulement si la quantité, le prix, la remise, les dimensions ou les finitions changent.</small>{% endif %}

		</div>


		{# ====================================================
																																																																           FINITIONS
																																																																           ==================================================== #}

		<div class="travail-section js-zone-finitions">

			<div class="travail-section-title">
				<i class="fa fa-magic"></i>
				Finitions
			</div>


			<div class="js-zone-finitions-automatiques">

				<div class="finitions-box js-finitions-box" data-input-name="{{ detail.finitionsSelectionnees.vars.full_name }}">

					{{ form_widget(
                        detail.finitionsSelectionnees
                    ) }}

					{{ form_errors(
                        detail.finitionsSelectionnees
                    ) }}

				</div>

			</div>


			<div class="js-zone-finitions-manuelles" data-index="{{ detail.finitions|length }}" data-prototype="{{ _self.finition_manuelle( detail.finitions.vars.prototype, commandeVerrouillee )|e('html_attr') }}" style="display:none;">

				<div class="js-liste-finitions-manuelles">

					{% for finition in detail.finitions %}

						{{ _self.finition_manuelle(
                            finition,
                            commandeVerrouillee
                        ) }}

					{% endfor %}

				</div>


				{{ form_errors(
                    detail.finitions
                ) }}


				{% if not commandeVerrouillee %}

					<button type="button" class="btn btn-primary-light btn-sm js-ajouter-finition">
						<i class="fa fa-plus mr-1"></i>
						Ajouter une finition
					</button>

				{% endif %}

			</div>

		</div>


				{# Réglages moins courants, repliés (maquette C01 : la ligne reste courte). #}
		<details class="si-plus-options">
			<summary>Plus d'options : circuit, caractéristiques techniques, observation</summary>

{# ====================================================
																																																																           CIRCUIT
																																																																           ==================================================== #}

		<div class="travail-section js-zone-circuit">

			<div class="travail-section-title">
				<i class="fa fa-random"></i>
				Circuit de traitement
			</div>


			<div class="row">

				<div class="col-lg-6">

					{{ form_row(
                        detail.prePresseNecessaire,
                        {
                            label:
                                'Passage en prépresse',

                            attr: {
                                class:
                                    'js-prepresse-necessaire'
                            }
                        }
                    ) }}

				</div>


				<div class="col-lg-6">

					{{ form_row(
                        detail.productionNecessaire,
                        {
                            label:
                                'Passage en production',

                            attr: {
                                class:
                                    'js-production-necessaire'
                            }
                        }
                    ) }}

				</div>

			</div>


			<div class="alert alert-info mb-0">

				<i class="fa fa-info-circle mr-1"></i>

				<span class="js-message-circuit-texte">
					Circuit de traitement de cette ligne.
				</span>

			</div>

		</div>


		{# ====================================================
																																																																           TECHNIQUE
																																																																           ==================================================== #}

		<div class="travail-section js-zone-technique">

			<div class="travail-section-title">
				<i class="fa fa-sliders"></i>
				Caractéristiques techniques
			</div>

			<div class="row js-technique-champs">

				<div class="col-lg-3">
					{{ form_row(detail.profilCouleurs) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.resolution) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.grammage) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.epaisseur) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.laminage) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.pliage) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.priorite) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.tempsEstime) }}
				</div>

				<div class="col-lg-3">
					{{ form_row(detail.tempsReel) }}
				</div>


				<div class="col-md-3">
					{{ form_row(detail.rectoVerso) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.oeillets) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.decoupe) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.emballage) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.batValide) }}
				</div>

				<div class="col-md-3">
					{{ form_row(detail.etat) }}
				</div>

			</div>


			{{ form_row(
                detail.observation
            ) }}

		</div>


				</details>


{# ====================================================
																																																																           FICHIERS
																																																																           ==================================================== #}

		<div class="travail-section js-zone-fichiers">

			<div class="travail-section-title">
				<i class="fa fa-cloud-upload"></i>
				Fichiers du client
			</div>

			{{ form_widget(
                detail.jetonsFichiers,
                {
                    attr: {
                        class:
                            'js-jetons-fichiers'
                    }
                }
            ) }}

			<input type="file" class="form-control js-fichiers-client" multiple accept=".pdf,.png,.jpg,.jpeg,.tif,.tiff,.svg,.ai,.eps,.psd,.cdr">

			<small class="form-text text-muted">
				Les fichiers volumineux sont envoyés automatiquement.
			</small>

			<div class="js-liste-uploads mt-3">

				{% for fichierExistant in detail.vars.value.fichiers|default([]) %}

					<div class="d-flex align-items-center border rounded p-2 mb-2">

						{% if fichierExistant.typeMime starts with 'image/' %}

						{#
						 * Pas d'aperçu <img> ici : le navigateur
						 * téléchargerait le fichier ORIGINAL en entier
						 * (souvent très volumineux -- TIFF/PSD haute
						 * résolution) juste pour l'afficher en 40x40,
						 * ce qui rendait la page de commande très
						 * lente, voire impossible à charger. Utiliser
						 * le bouton "Voir le fichier" pour l'ouvrir à
						 * la demande.
						 #}
						<i class="fa fa-picture-o mr-2" style="font-size:24px;"></i>

						{% else %}

						<i class="fa fa-file-o mr-2" style="font-size:24px;"></i>

						{% endif %}

						<div class="flex-grow-1">

							<div class="small font-weight-bold">
								{{ fichierExistant.nomOriginal }}
							</div>

							<div class="small text-muted">
								Déjà envoyé
							</div>

						</div>

						<a href="{{ path('app_fichier_visualiser', {id: fichierExistant.id}) }}" target="_blank" class="btn btn-sm btn-light ml-2" title="Voir le fichier">
							<i class="fa fa-eye"></i>
						</a>

					</div>

				{% endfor %}

			</div>

		</div>

	</div>

{% endmacro %}


{# ============================================================
   URLS UPLOAD
   ============================================================ #}

{% set jetonTemporaire =
    'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'
%}

{% set indexTemporaire =
    999999999
%}


{% set modeleUrlMorceau = path(
    'app_fichier_upload_morceau',
    {
        jeton: jetonTemporaire,
        index: indexTemporaire
    }
) %}


{% set modeleUrlMorceau =
    modeleUrlMorceau|replace({
        (jetonTemporaire):
            '__JETON__',

        (indexTemporaire ~ ''):
            '__INDEX__'
    })
%}


{% set modeleUrlStatut = path(
    'app_fichier_upload_statut',
    {
        jeton: jetonTemporaire
    }
) %}


{% set modeleUrlStatut =
    modeleUrlStatut|replace({
        (jetonTemporaire):
            '__JETON__'
    })
%}


{% set modeleUrlSuppression = path(
    'app_fichier_upload_supprimer',
    {
        jeton: jetonTemporaire
    }
) %}


{% set modeleUrlSuppression =
    modeleUrlSuppression|replace({
        (jetonTemporaire):
            '__JETON__'
    })
%}


{# ============================================================
   FORMULAIRE
   ============================================================ #}

{{ form_start(form, {
    attr: {
        id:
            'commande-form',

        enctype:
            'multipart/form-data',

        'data-circuit-verrouille':
            commandeVerrouillee ? '1' : '0',

        'data-upload-csrf':
            csrf_token(
                'upload-commande'
            ),

        'data-upload-initialiser-url':
            path(
                'app_fichier_upload_initialiser'
            ),

        'data-upload-morceau-url':
            modeleUrlMorceau,

        'data-upload-statut-url':
            modeleUrlStatut,

        'data-upload-supprimer-url':
            modeleUrlSuppression,

        'data-brouillon-nouvelle':
            commande.id is null ? '1' : '0',

        'data-brouillon-csrf':
            csrf_token('brouillon-commande'),

        'data-brouillon-enregistrer-url':
            path('app_brouillon_enregistrer', {type: 'commande'}),

        'data-brouillon-verifier-url':
            path('app_brouillon_verifier', {type: 'commande'})
    }
}) }}


{#
	Saisie d'une commande (maquettes C01 web, C03 et C04 mobile).
	À gauche : client, lignes, configuration de la ligne choisie.
	À droite : livraison et délai, récapitulatif, acompte.
	Sur téléphone, les mêmes blocs passent en 3 étapes (data-etape).
#}
{% set estNouvelle = commande.id is null %}
{% set dejaConfirmee = not estNouvelle and commande.statut %}
{% set peutEncaisser = is_granted('ROLE_PAIEMENT_ENCAISSER') %}
{% set jours = ['dim.', 'lun.', 'mar.', 'mer.', 'jeu.', 'ven.', 'sam.'] %}

<div class="si-saisie" data-etape="lignes" data-delai-possible="{{ delaiPossible is defined ? delaiPossible|date('Y-m-d') : '' }}" data-delai-libelle="{{ delaiPossible is defined ? jours[delaiPossible|date('w')] ~ ' ' ~ delaiPossible|date('d/m') : '' }}">

	<div class="si-saisie-tete">
		<div class="si-saisie-retour d-md-none">
			<button type="button" class="si-rond js-etape-retour" aria-label="Retour"><i class="fas fa-chevron-left"></i></button>
			<div>
				<strong class="js-titre-etape">{{ estNouvelle ? 'Nouvelle commande' : commande.numero }}</strong>
