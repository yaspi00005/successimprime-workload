{% extends 'finances/_base.html.twig' %}
{% import 'finances/_macros.html.twig' as m %}

{% block title %}Fournisseurs et échéancier{% endblock %}
{% block page_title %}Fournisseurs{% endblock %}

{% block header_actions %}
	{% if droits.admin %}
		<li class="nav-item si-masque-mobile">
			<a href="{{ path('app_achat_index') }}" class="btn btn-light btn-sm si-btn-entete">Bons de commande</a>
		</li>
	{% endif %}
	{% if droits.saisie %}
		<li class="nav-item">
			<a href="{{ path('app_finances_depenses') }}#saisir-depense" class="btn btn-danger btn-sm si-btn-entete"><i class="fas fa-plus me-1"></i>Facture fournisseur</a>
		</li>
	{% endif %}
{% endblock %}

{% block body %}
	<div class="si-fin si-fin-fournisseurs">
		<section class="si-fin-kpis" aria-label="Ce qui est dû">
			<article class="card si-fin-kpi">
				<h2>Total dû</h2>
				<strong>{{ m.f(total_du) }}</strong>
				<span class="si-fin-vert">{{ creanciers }} fournisseur{{ creanciers > 1 ? 's' }}{% if total_a_approuver > 0 %}<small class="si-fin-gris d-block">+ {{ m.f(total_a_approuver) }} à approuver</small>{% endif %}</span>
			</article>
			<article class="card si-fin-kpi">
				<h2>Cette semaine</h2>
				<strong>{{ m.f(semaine.montant) }}</strong>
				{% if semaine.plus_gros %}
					<span class="{{ semaine.plus_gros.en_retard ? 'si-fin-rouge' : 'si-fin-orange' }}">{{ semaine.plus_gros.titre }} · {{ semaine.plus_gros.en_retard ? 'en retard' : semaine.plus_gros.date|date('d/m') }}</span>
				{% else %}
					<span class="si-fin-vert">rien à payer aux fournisseurs</span>
				{% endif %}
			</article>
			<article class="card si-fin-kpi">
				{% if gros_jour %}
					<h2>Le {{ m.date_longue(gros_jour.date) }}</h2>
					<strong>{{ m.f(gros_jour.total) }}</strong>
					<span class="si-fin-vert">{{ gros_jour.lignes|length > 1 ? 'paiement groupé · ' ~ gros_jour.lignes|length ~ ' échéances' : gros_jour.lignes[0].titre }}</span>
				{% else %}
					<h2>Prochaine échéance</h2>
					<strong>—</strong>
					<span class="si-fin-gris">rien sur {{ nombre_jours }} jours</span>
				{% endif %}
			</article>
			<article class="card si-fin-kpi">
				<h2>Achats du mois</h2>
				<strong>{{ m.f(achats.montant) }}</strong>
				<span class="si-fin-vert">{{ achats.nombre }} bon{{ achats.nombre > 1 ? 's' }} de commande reçu{{ achats.nombre > 1 ? 's' }}</span>
			</article>
		</section>

		<div class="si-fin-deux si-fin-four-grille">
			<section class="card" aria-label="Dettes fournisseurs">
				{% if dettes is empty %}
					<h2>Fournisseurs</h2>
					<p class="si-fin-vide">Aucune facture fournisseur à payer.</p>
				{% else %}
					<table class="table si-fin-table si-fin-four-table">
						<thead>
							<tr>
								<th scope="col">Fournisseur</th>
								<th scope="col" class="si-masque-mobile">Achats</th>
								<th scope="col" class="text-end">Dû</th>
								<th scope="col" class="text-center">Échéance</th>
							</tr>
						</thead>
						<tbody>
							{% for d in dettes %}
								{% set lien = d.depenses|length == 1 ? path('app_finances_depenses_voir', {id: d.depenses[0].id}) : null %}
								<tr>
									<td>
										<div class="si-fin-qui">
											<span class="si-fin-avatar" aria-hidden="true">{{ m.initiales(d.nom) }}</span>
											<span>
												{% if lien %}<a href="{{ lien }}">{{ d.nom }}</a>{% else %}<strong>{{ d.nom }}</strong>{% endif %}
												<small class="d-md-none">{{ d.achats|join(', ') }}</small>
											</span>
										</div>
									</td>
									<td class="si-masque-mobile si-fin-gris si-fin-achats">
										{% for depense in d.depenses %}<a href="{{ path('app_finances_depenses_voir', {id: depense.id}) }}">{{ depense.objet }}</a>{{ not loop.last ? ', ' }}{% endfor %}
									</td>
									<td class="text-end">
										{% if d.du > 0 %}<strong class="si-fin-f">{{ d.du|number_format(0, ',', ' ') }} F</strong>{% endif %}
										{% if d.a_approuver > 0 %}<small class="si-fin-gris">{{ d.a_approuver|number_format(0, ',', ' ') }} F à approuver</small>{% endif %}
									</td>
									<td class="text-center">
										{% if d.du == 0 %}
											<span class="si-fin-statut si-fin-statut-orange">à approuver</span>
										{% elseif d.echeance is null %}
											<span class="si-fin-statut si-fin-statut-gris">sans date</span>
										{% else %}
											{% set dans = (d.echeance|date('U') - aujourdhui|date('U')) / 86400 %}
											<span class="si-fin-statut si-fin-statut-{{ d.en_retard ? 'rouge' : (dans <= 7 ? 'orange' : 'bleu') }}">{{ d.en_retard ? 'en retard' : d.echeance|date('d/m') }}</span>
										{% endif %}
									</td>
								</tr>
							{% endfor %}
						</tbody>
					</table>
				{% endif %}
				<p class="si-fin-note">Les factures fournisseurs se saisissent dans Dépenses avec leur reçu ; une dépense « à payer » reste une dette jusqu’à son paiement. Rapprochez la facture du bon de commande et de la réception en stock avant de payer.</p>
			</section>

			<section class="card si-fin-echeancier" aria-label="Échéancier">
				<header class="si-fin-tete">
					<h2>Échéancier</h2>
					<span class="si-fin-unite">{{ nombre_jours }} prochains jours</span>
				</header>
				{% if jours is empty %}
					<p class="si-fin-vide">Rien à payer sur les {{ nombre_jours }} prochains jours.</p>
				{% else %}
					<ul>
						{% for j in jours %}
							{% set groupe = j.lignes|length > 1 %}
							<li class="{{ j.en_retard ? 'si-fin-point-rouge' : (groupe ? 'si-fin-point-rouge' : 'si-fin-point-bleu') }}">
								<div>
									<strong>{{ j.date == aujourdhui ? 'Aujourd’hui' : m.jour_court(j.date) }}{% if groupe %} · paiement groupé{% endif %}</strong>
									{% if groupe %}
										<small>{{ j.lignes|map(l => l.titre)|join(', ') }}</small>
									{% else %}
										{% set l = j.lignes[0] %}
										<small>{% if l.route and (l.type != 'salaires' or is_granted('ROLE_RH')) %}<a href="{{ path(l.route, l.parametres) }}">{{ l.titre }}</a>{% else %}{{ l.titre }}{% endif %}{% if l.detail %} · {{ l.detail }}{% endif %}</small>
									{% endif %}
								</div>
								<b>{% if j.total > 0 %}{{ m.f(j.total) }}{% endif %}{% if j.selon_declaration %}{{ j.total > 0 ? ' + ' }}<span class="si-fin-gris">selon déclaration</span>{% endif %}</b>
							</li>
						{% endfor %}
					</ul>
				{% endif %}
				<p class="si-fin-note">Dettes fournisseurs, charges récurrentes, tâches du planning avec un montant (impôts, achats prévus) et salaires nets au jour de paie. Les rappels partent du planning.</p>
			</section>
		</div>
	</div>
{% endblock %}
