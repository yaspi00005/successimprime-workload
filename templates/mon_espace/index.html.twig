{% extends 'base.html.twig' %}

{% block title %}Mon espace · {{ nom }}{% endblock %}

{% block header_actions %}
	<li class="nav-item"><a href="{{ path('app_pointer_index') }}" class="btn btn-light btn-sm si-btn-entete"><i class="fas fa-qrcode me-1"></i>Pointer</a></li>
{% endblock %}

{% block body %}
	{% set p = pointage %}
	<div class="si-me">
		<div class="si-ac-kpis">
			<article class="card">
				<h2>Présence ce mois</h2>
				<strong>{{ p.presents }} / {{ p.ouvres }} j</strong>
				<span class="si-p-neutre">{{ p.minutes > 0 ? p.minutes|duree_pointage ~ ' de présence' : 'pas encore de pointage' }}</span>
			</article>
			<a class="card text-reset text-decoration-none" href="{{ path('app_mon_espace_pointage') }}">
				<h2>Ponctualité · mes points</h2>
				<strong class="{{ p.note is null ? '' : (p.note >= 80 ? 'si-p-ok' : 'si-p-alerte') }}">{{ p.note is null ? '—' : p.note ~ ' / 100' }}</strong>
				<span class="{{ p.retards > 0 ? 'si-p-alerte' : 'si-p-neutre' }}">{{ p.retards }} retard{{ p.retards > 1 ? 's' }} · {{ p.points }} pts · le détail</span>
			</a>
			{% if actions %}
				<article class="card">
					<h2>Actions de caisse</h2>
					<strong class="{{ actions.points < 0 ? 'si-p-alerte' : 'si-p-ok' }}">{{ actions.points }} pts</strong>
					<span class="si-p-neutre">{{ actions.pourcentage is null ? 'aucune ligne' : actions.pourcentage ~ ' % dans les délais' }}</span>
				</article>
			{% endif %}
			{% if performance is not null %}
				<a class="card text-reset text-decoration-none" href="{{ path('app_mon_espace_performance') }}">
					<h2>Ma performance</h2>
					<strong>{{ performance.resultat.score ?? '—' }}{{ performance.resultat.score is defined and performance.resultat.score is not null ? ' / 100' }}</strong>
					<span class="si-p-neutre">{{ performance.resultat is defined ? 'prime estimée à ' ~ performance.resultat.taux ~ ' %' : 'voir ma note et ma prime' }}</span>
				</a>
			{% endif %}
			<article class="card">
				<h2>Congés</h2>
				{% if conge.actif %}
					<strong>{{ conge.solde|number_format(conge.solde == conge.solde|round ? 0 : 1, ',') }} j</strong>
					<span class="si-p-neutre">{{ conge.plageDebut ? 'à choisir du ' ~ conge.plageDebut|date('d/m') ~ ' au ' ~ conge.plageFin|date('d/m') ~ (conge.plageJours ? ', ' ~ conge.plageJours ~ ' j max' : '') : 'solde disponible' }}</span>
				{% else %}
					<strong>—</strong>
					<span class="si-p-neutre">droit pas encore activé par la RH</span>
				{% endif %}
			</article>
		</div>

		<section class="card si-ac-bloc">
			<h2>Faire une demande</h2>
			<div class="si-me-boutons">
				<a href="{{ path('app_mon_espace_demande', {type: 'absence'}) }}" class="btn btn-light si-btn-entete"><i class="fas fa-user-clock me-1"></i>Déclarer une absence</a>
				{% if conge.actif %}<a href="{{ path('app_mon_espace_demande', {type: 'conge'}) }}" class="btn btn-light si-btn-entete"><i class="fas fa-umbrella-beach me-1"></i>Demander un congé</a>{% endif %}
				<a href="{{ path('app_mon_espace_demande', {type: 'reclamation'}) }}" class="btn btn-light si-btn-entete"><i class="fas fa-hand-holding-usd me-1"></i>Réclamer une somme due</a>
				{% if reglage('avantages', 'frais_medicaux') > 0 %}<a href="{{ path('app_mon_espace_demande', {type: 'frais_medicaux'}) }}" class="btn btn-light si-btn-entete"><i class="fas fa-notes-medical me-1"></i>Frais médicaux ({{ reglage('avantages', 'frais_medicaux') }} % remboursés)</a>{% endif %}
				{% if performance is not null %}<a href="{{ path('app_mon_espace_prime') }}" class="btn btn-light si-btn-entete"><i class="fas fa-trophy me-1"></i>Ma prime</a>{% endif %}
				{% if biens > 0 %}<a href="{{ path('app_immobilisations_registre') }}" class="btn btn-light si-btn-entete"><i class="fas fa-laptop me-1"></i>Biens qui me sont confiés ({{ biens }})</a>{% endif %}
			</div>
		</section>

		<section class="card si-ac-bloc">
			<h2>Mes demandes</h2>
			{% if demandes is empty %}
				<p class="si-ac-vide">Aucune demande pour l'instant.</p>
			{% else %}
				<ul class="si-me-liste">
					{% for d in demandes %}{% include 'mon_espace/_demande.html.twig' %}{% endfor %}
				</ul>
			{% endif %}
		</section>

		{% if bulletins is not empty %}
			<section class="card si-ac-bloc">
				<h2>Mes bulletins de paie</h2>
				<ul class="si-me-liste">
					{% for b in bulletins %}
						<li class="si-me-demande">
							<span class="si-me-type">{{ b.mois|date_fr('MMMM yyyy')|capitalize }}</span>
							<div><b>{{ b.net|number_format(0, ',', ' ') }} F net</b><small>{{ b.libelleEtat }}</small></div>
							<a href="{{ path('app_mon_espace_bulletin', {id: b.id}) }}" class="btn btn-light btn-sm si-btn-entete">Voir</a>
						</li>
					{% endfor %}
				</ul>
			</section>
		{% endif %}
	</div>
{% endblock %}
